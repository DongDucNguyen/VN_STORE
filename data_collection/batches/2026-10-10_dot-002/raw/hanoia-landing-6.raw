="{}" data-element="main" data-pb-style="RDKYBW4"></div></div><div class="pagebuilder-column-line" data-content-type="column-line" data-element="main" data-pb-style="UWGFWYY"><div class="pagebuilder-column" data-content-type="column" data-appearance="full-height" data-background-images="{}" data-element="main" data-pb-style="X9GC1NQ"><figure data-content-type="image" data-appearance="full-width" data-element="main" data-pb-style="XO5F325"><img loading="lazy" height="100%" class="pagebuilder-mobile-hidden lazy" src="data&#x3A;image&#x2F;svg&#x2B;xml&#x3B;utf8,&lt;svg&#x20;xmlns&#x3D;&quot;http&#x3A;&#x2F;&#x2F;www.w3.org&#x2F;2000&#x2F;svg&quot;&#x20;viewBox&#x3D;&quot;0&#x20;0&#x20;1&#x20;1&quot;&#x20;width&#x3D;&quot;1&quot;&#x20;height&#x3D;&quot;1&quot;&gt;&lt;&#x2F;svg&gt;" data-original="https://dytbw3ui6vsu6.cloudfront.net/media/wysiwyg/HaNoiA_Vinhome1037.JPG" alt="" title="" data-element="desktop_image" data-pb-style="D33OIJ0"><img loading="lazy" height="100%" class="pagebuilder-mobile-only lazy" src="data&#x3A;image&#x2F;svg&#x2B;xml&#x3B;utf8,&lt;svg&#x20;xmlns&#x3D;&quot;http&#x3A;&#x2F;&#x2F;www.w3.org&#x2F;2000&#x2F;svg&quot;&#x20;viewBox&#x3D;&quot;0&#x20;0&#x20;1&#x20;1&quot;&#x20;width&#x3D;&quot;1&quot;&#x20;height&#x3D;&quot;1&quot;&gt;&lt;&#x2F;svg&gt;" data-original="https://dytbw3ui6vsu6.cloudfront.net/media/wysiwyg/HaNoiA_Vinhome1037.JPG" alt="" title="" data-element="mobile_image" data-pb-style="CIXJHEV"></figure><div data-content-type="text" data-appearance="default" data-element="main" data-pb-style="X0LYTGA"><p dir="ltr" style="text-align: center;"><em>Nghi th&#7913;c pha ch&#7871; tr&#7903; n&ecirc;n thi v&#7883; h&#417;n v&#7899;i b&#7897; d&#7909;ng c&#7909; pha ch&#7871; s&aacute;ng t&#7841;o</em></p></div><div data-content-type="text" data-appearance="default" data-element="main" data-pb-style="KUDN967"><p style="text-align: center;">B&#7857;ng c&aacute;ch k&#7871;t h&#7907;p s&#7855;c m&agrave;u r&#7921;c r&#7905;, k&#7929; thu&#7853;t t&#7841;o h&igrave;nh tinh x&#7843;o v&agrave; nh&#7919;ng h&#7885;a ti&#7871;t v&#7869; tay t&#7881; m&#7881;, Parrot-dise bi&#7871;n &lsquo;nghi th&#7913;c th&#432;&#7901;ng ng&agrave;y&rsquo; th&agrave;nh tr&#7843;i nghi&#7879;m g&#7907;i h&#7913;ng th&uacute;.&nbsp;</p></div><div data-content-type="products" data-appearance="carousel" data-autoplay="false" data-autoplay-speed="4000" data-infinite-loop="false" data-show-arrows="false" data-show-dots="true" data-carousel-mode="default" data-center-padding="90px" data-element="main"></div></div></div></div></div></div><div data-content-type="row" data-appearance="contained" data-element="main"><div data-enable-parallax="0" data-parallax-speed="0.5" data-background-images="{}" data-background-type="image" data-video-loop="true" data-video-play-only-visible="true" data-video-lazy-load="true" data-video-fallback-src="" data-element="inner" data-pb-style="UV3MJR9"><div data-content-type="divider" data-appearance="default" data-element="main"><hr data-element="line" data-pb-style="TAQS5EV"></div><div data-content-type="text" data-appearance="default" data-element="main"><p dir="ltr" style="text-align: center;"><strong><span style="font-size: 18px;">Innate</span></strong></p></div><div class="pagebuilder-column-group" data-background-images="{}" data-content-type="column-group" data-appearance="default" data-grid-size="12" data-element="main" data-pb-style="EKCG24O"><div class="pagebuilder-column-line" data-content-type="column-line" data-element="main" data-pb-style="AK6KOCN"><div class="pagebuilder-column" data-content-type="column" data-appearance="full-height" data-background-images="{}" data-element="main" data-pb-style="A4F6ROT"></div><div class="pagebuilder-column" data-content-type="column" data-appearance="full-height" data-background-images="{}" data-element="main" data-pb-style="VGNHPNN"><div data-content-type="text" data-appearance="default" data-element="main"><p style="text-align: center;">Innate t&#7853;p