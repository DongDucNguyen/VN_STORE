	<div class="breakdance-image-container">
		<div class="breakdance-image-clip"><img loading="lazy" decoding="async" class="breakdance-image-object" src="http://hanhsilk.giahanweb.com/wp-content/uploads/sites/273/2023/12/z4632540035165_ee7c84847b3d31cd98cc72d1389d9311.jpg" width="1080" height="721" srcset="https://hanhsilk.com/wp-content/uploads/sites/273/2023/12/z4632540035165_ee7c84847b3d31cd98cc72d1389d9311.jpg 1080w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/12/z4632540035165_ee7c84847b3d31cd98cc72d1389d9311-300x200.jpg 300w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/12/z4632540035165_ee7c84847b3d31cd98cc72d1389d9311-1024x684.jpg 1024w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/12/z4632540035165_ee7c84847b3d31cd98cc72d1389d9311-768x513.jpg 768w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/12/z4632540035165_ee7c84847b3d31cd98cc72d1389d9311-600x401.jpg 600w" sizes="auto, (max-width: 1080px) 100vw, 1080px"></div>
	</div></figure>

</div><div class="bde-image-104-429 bde-image">
