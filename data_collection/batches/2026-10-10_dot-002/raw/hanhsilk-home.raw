	<div class="breakdance-image-container">
		<div class="breakdance-image-clip"><img loading="lazy" decoding="async" class="breakdance-image-object" src="http://hanhsilk.giahanweb.com/wp-content/uploads/sites/273/2023/08/334195530_243521238012197_7213555044854527730_n.jpg" width="2048" height="1537" srcset="https://hanhsilk.com/wp-content/uploads/sites/273/2023/08/334195530_243521238012197_7213555044854527730_n.jpg 2048w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/08/334195530_243521238012197_7213555044854527730_n-300x225.jpg 300w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/08/334195530_243521238012197_7213555044854527730_n-1024x769.jpg 1024w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/08/334195530_243521238012197_7213555044854527730_n-768x576.jpg 768w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/08/334195530_243521238012197_7213555044854527730_n-1536x1153.jpg 1536w, https://hanhsilk.com/wp-content/uploads/sites/273/2023/08/334195530_243521238012197_7213555044854527730_n-600x450.jpg 600w" sizes="auto, (max-width: 2048px) 100vw, 2048px"></div>
	</div></figure>

