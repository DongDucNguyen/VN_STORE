wholesale-baskets\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Rattan Storage Basket \u2013 Black Color, Made in Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/rattan-storage-basket-black-color-made-in-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1097","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1097&per_page=10"}]}},{"id":1090,"name":"Flower Pot Made of Rattan Cane Webbing in Vietnam","slug":"flower-pot-made-of-rattan-cane-webbing-in-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/flower-pot-made-of-rattan-cane-webbing-in-vietnam\/","sku":"VH24060","short_description":"<p>Handmade <strong data-start=\"1981\" data-end=\"2034\">flower pot made of rattan cane webbing in Vietnam<\/strong>, eco-friendly, lightweight, and perfect for home d\u00e9cor or as a planter cover.<\/p>","description":"<p data-start=\"167\" data-end=\"196\">Handmade <strong data-start=\"2348\" data-end=\"2401\">flower pot made of rattan cane webbing in Vietnam<\/strong>. Eco-friendly, durable, and stylish \u2013 perfect for home d\u00e9cor and wholesale supply worldwide.<\/p>\n<h3 data-start=\"167\" data-end=\"196\"><strong data-start=\"171\" data-end=\"194\">Product Description<\/strong><\/h3>\n<p data-start=\"197\" data-end=\"605\">This handcrafted <strong data-start=\"214\" data-end=\"228\">flower pot<\/strong> is made from <strong data-start=\"242\" data-end=\"265\">rattan cane webbing<\/strong>, a natural and sustainable material sourced in Vietnam. Designed by skilled artisans, the pot features a breathable woven structure that adds a warm, rustic touch to any living space. Perfect for both indoor and outdoor decoration, this rattan cane webbing pot can hold plant pots, dried flowers, or serve as a natural storage container.<\/p>\n<p data-start=\"607\" data-end=\"847\">Each piece is carefully handwoven, highlighting Vietnam\u2019s rich tradition of craftsmanship. The natural honey tones of rattan blend seamlessly with modern, boho, or eco-friendly home styles, making it an ideal choice for sustainable d\u00e9cor.<\/p>\n<h3 data-start=\"849\" data-end=\"871\"><strong data-start=\"853\" data-end=\"869\">Key Features<\/strong><\/h3>\n<ul data-start=\"872\" data-end=\"1148\">\n<li data-start=\"872\" data-end=\"918\">\n<p data-start=\"874\" data-end=\"918\">Material: 100% natural rattan cane webbing<\/p>\n<\/li>\n<li data-start=\"919\" data-end=\"954\">\n<p data-start=\"921\" data-end=\"954\">Handmade by Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"955\" data-end=\"982\">\n<p data-start=\"957\" data-end=\"982\">Lightweight yet durable<\/p>\n<\/li>\n<li data-start=\"983\" data-end=\"1031\">\n<p data-start=\"985\" data-end=\"1031\">Eco-friendly, biodegradable, and sustainable<\/p>\n<\/li>\n<li data-start=\"1032\" data-end=\"1104\">\n<p data-start=\"1034\" data-end=\"1104\">Suitable for indoor decoration, dried flowers, or as a planter cover<\/p>\n<\/li>\n<li data-start=\"1105\" data-end=\"1148\">\n<p data-start=\"1107\" data-end=\"1148\">Available in various sizes upon request<\/p>\n<\/li>\n<\/ul>\n<h3 data-start=\"1150\" data-end=\"1184\"><strong data-start=\"1154\" data-end=\"1182\">Cultural &amp; Social Impact<\/strong><\/h3>\n<p data-start=\"1185\" data-end=\"1503\">By choosing this handcrafted flower pot, you are not only bringing natural beauty into your home but also supporting Vietnamese artisans. These products create jobs for rural farmers during their free time between crops, help preserve traditional weaving techniques, and generate export income for the local economy.<\/p>\n<h3 data-start=\"1505\" data-end=\"1549\"><strong data-start=\"1509\" data-end=\"1547\">Supplier &amp; Manufacturer in Vietnam<\/strong><\/h3>\n<p data-start=\"1550\" data-end=\"1793\">We are a leading <strong data-start=\"1567\" data-end=\"1629\">manufacturer and supplier of rattan handicrafts in Vietnam<\/strong>, providing wholesale and bulk orders worldwide. Our products are exported mainly to Europe and America, where eco-friendly and handmade items are in high demand.<\/p>\n<p data-start=\"1795\" data-end=\"1929\">For bulk or wholesale inquiries, please contact us at:<br data-start=\"1849\" data-end=\"1852\" \/>\ud83d\udce7 <a class=\"decorated-link cursor-pointer\" rel=\"noopener\" data-start=\"1855\" data-end=\"1878\">vietcraft2006@gmail.com<\/a> | \ud83c\udf10 <a class=\"decorated-link cursor-pointer\" target=\"_new\" rel=\"noopener\" data-start=\"1884\" data-end=\"1927\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1094,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24060-flower-pot.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24060-flower-pot.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24060-flower-pot.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vie