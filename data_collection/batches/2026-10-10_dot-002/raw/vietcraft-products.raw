aining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Bamboo Basket \u2013 Handwoven Eco-Friendly Storage Basket from Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/bamboo-basket-handwoven-eco-friendly-storage-basket-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/782","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=782&per_page=10"}]}},{"id":775,"name":"Rattan Ceramic Coaster \u2013 Handcrafted Drink Coaster from Vietnam","slug":"rattan-ceramic-coaster-handcrafted-drink-coaster-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/rattan-ceramic-coaster-handcrafted-drink-coaster-from-vietnam\/","sku":"VH24101","short_description":"<p>Elegant coaster made of natural rattan and ceramic \u2013 heat-resistant and handcrafted in Vietnam for sustainable wholesale supply.<\/p>","description":"<p data-start=\"288\" data-end=\"619\">This <strong data-start=\"293\" data-end=\"319\">rattan ceramic coaster<\/strong> is a refined blend of natural handwoven rattan and durable ceramic, handcrafted in Vietnam. The outer rattan ring is tightly woven by skilled artisans, offering a warm, organic touch, while the ceramic center provides a smooth, heat-resistant surface that protects tables from hot or cold beverages.<\/p>\n<p data-start=\"621\" data-end=\"822\">Elegant, functional, and sustainable, these coasters are perfect for caf\u00e9s, restaurants, hotels, or home use. Available in various patterns and sizes, they serve both decorative and practical purposes.<\/p>\n<p data-start=\"824\" data-end=\"964\"><strong data-start=\"824\" data-end=\"855\">Vietnam Handicraft Co., Ltd<\/strong> offers <strong data-start=\"863\" data-end=\"874\">OEM\/ODM<\/strong> services, custom branding, and wholesale supply to global importers and lifestyle brands.<\/p>\n<hr data-start=\"966\" data-end=\"969\" \/>\n<h2 data-start=\"971\" data-end=\"993\">\u2705 <strong data-start=\"976\" data-end=\"993\">Key Features:<\/strong><\/h2>\n<ul data-start=\"994\" data-end=\"1307\">\n<li data-start=\"994\" data-end=\"1039\">\n<p data-start=\"996\" data-end=\"1039\">Combination of ceramic and natural rattan<\/p>\n<\/li>\n<li data-start=\"1040\" data-end=\"1096\">\n<p data-start=\"1042\" data-end=\"1096\">Heat-resistant, moisture-absorbing, and scratch-free<\/p>\n<\/li>\n<li data-start=\"1097\" data-end=\"1143\">\n<p data-start=\"1099\" data-end=\"1143\">Handwoven frame with sturdy ceramic center<\/p>\n<\/li>\n<li data-start=\"1144\" data-end=\"1198\">\n<p data-start=\"1146\" data-end=\"1198\">Customizable logo, size, colors, or gift packaging<\/p>\n<\/li>\n<li data-start=\"1199\" data-end=\"1256\">\n<p data-start=\"1201\" data-end=\"1256\">Ideal for home, office, restaurants, cafes, or hotels<\/p>\n<\/li>\n<li data-start=\"1257\" data-end=\"1307\">\n<p data-start=\"1259\" data-end=\"1307\">Eco-friendly, biodegradable, and made in Vietnam<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1309\" data-end=\"1312\" \/>\n<h2 data-start=\"1314\" data-end=\"1341\">\ud83c\udf3f <strong data-start=\"1320\" data-end=\"1339\">Why It Matters:<\/strong><\/h2>\n<p data-start=\"1342\" data-end=\"1365\">Every coaster supports:<\/p>\n<ul data-start=\"1367\" data-end=\"1667\">\n<li data-start=\"1367\" data-end=\"1412\">\n<p data-start=\"1369\" data-end=\"1412\"><strong data-start=\"1369\" data-end=\"1410\">Local Vietnamese artisans and farmers<\/strong><\/p>\n<\/li>\n<li data-start=\"1413\" data-end=\"1477\">\n<p data-start=\"1415\" data-end=\"1477\"><strong data-start=\"1415\" data-end=\"1454\">Full use of local natural materials<\/strong> \u2013 ceramic and rattan<\/p>\n<\/li>\n<li data-start=\"1478\" data-end=\"1547\">\n<p data-start=\"1480\" data-end=\"1547\"><strong data-start=\"1480\" data-end=\"1504\">Export-driven income<\/strong> for Vietnam\u2019s traditional craft industry<\/p>\n<\/li>\n<li data-start=\"1548\" data-end=\"1612\">\n<p data-start=\"1550\" data-end=\"1612\"><strong data-start=\"1550\" data-end=\"1592\">Plastic-free, sustainable alternatives<\/strong> for global buyers<\/p>\n<\/li>\n<li data-start=\"1613\" data-end=\"1667\">\n<p data-start=\"1615\" data-end=\"1667\"><strong data-start=\"1615\" data-end=\"1640\">Cultural preservation<\/strong> through handcrafted design<\/p>\n<\/li>\n<\/ul>\n<p data-start=\"1669\" data-end=\"1801\">As a <strong data-start=\"1674\" data-end=\"1730\">manufacturer, factory, and global wholesale exporter<\/strong>, Vietnam Handicraft Co., Ltd delivers both quality and cultural value.<\/p>\n<hr data-start=\"1803\" data-end=\"1806\" \/>\n<h2 data-start=\"1808\" data-end=\"1842\">\u2709\ufe0f <strong data-start=\"1814\" data-end=\"1840\">Contact for Wholesale:<\/strong><\/h2>\n<p data-start=\"1843\" data-end=\"1934\">\ud83d\udce7 Email: <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1853\" data-end=\"1876\">vietcraft2006@gmail.com<\/a><br data-start=\"1876\" data-end=\"1879\" \/>\ud83c\udf10 Website: <a class=\"\" href=\"http:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1891\" data-end=\"1934\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[