rder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;High-Quality Woven Bamboo Basket from Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/high-quality-woven-bamboo-basket-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/836","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=836&per_page=10"}]}},{"id":829,"name":"Rectangle Seagrass Door Mat \u2013 Handwoven Eco-Friendly Mat from Vietnam","slug":"rectangle-seagrass-door-mat-handwoven-eco-friendly-mat-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/rectangle-seagrass-door-mat-handwoven-eco-friendly-mat-from-vietnam\/","sku":"VH24091","short_description":"<p>Eco-friendly rectangle mat handwoven from seagrass in Vietnam. A natural, sustainable choice for home decor and wholesale importers<\/p>","description":"<p data-start=\"254\" data-end=\"613\">Bring a touch of natural charm into your home with our <strong data-start=\"309\" data-end=\"340\">rectangle seagrass door mat<\/strong>, handcrafted in Vietnam using 100% natural seagrass. This eco-friendly mat is ideal for indoor entrances, hallways, or bathroom floors. Its tightly woven structure ensures durability, while the natural fibers provide a warm, earthy aesthetic that complements any interior.<\/p>\n<p data-start=\"615\" data-end=\"881\">Each mat is handwoven by skilled artisans in rural Vietnam, making every piece a symbol of cultural heritage and sustainable craftsmanship. Seagrass is a biodegradable and renewable material, making this mat a responsible choice for environmentally conscious buyers.<\/p>\n<p data-start=\"883\" data-end=\"1034\">Whether you&#8217;re a retailer, importer, or wholesaler looking for sustainable homeware solutions, this product delivers style, function, and story in one.<\/p>\n<hr data-start=\"1036\" data-end=\"1039\" \/>\n<h3 data-start=\"1041\" data-end=\"1066\">\u2705 <strong data-start=\"1047\" data-end=\"1064\">Key Features:<\/strong><\/h3>\n<ul data-start=\"1067\" data-end=\"1250\">\n<li data-start=\"1067\" data-end=\"1102\">\n<p data-start=\"1069\" data-end=\"1102\">Material: 100% natural seagrass<\/p>\n<\/li>\n<li data-start=\"1103\" data-end=\"1123\">\n<p data-start=\"1105\" data-end=\"1123\">Shape: Rectangle<\/p>\n<\/li>\n<li data-start=\"1124\" data-end=\"1167\">\n<p data-start=\"1126\" data-end=\"1167\">Handmade by skilled Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"1168\" data-end=\"1197\">\n<p data-start=\"1170\" data-end=\"1197\">Durable and biodegradable<\/p>\n<\/li>\n<li data-start=\"1198\" data-end=\"1250\">\n<p data-start=\"1200\" data-end=\"1250\">Custom sizes and OEM\/ODM available for wholesale<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1252\" data-end=\"1255\" \/>\n<h3 data-start=\"1257\" data-end=\"1304\">\ud83c\udf3f <strong data-start=\"1264\" data-end=\"1302\">Crafting Value Beyond the Product:<\/strong><\/h3>\n<p data-start=\"1305\" data-end=\"1603\">At Vietnam Handicraft Co., Ltd, we\u2019re proud to export products that use nearly 100% locally sourced materials and labor. Handicrafts like this <strong data-start=\"1448\" data-end=\"1464\">seagrass mat<\/strong> help generate foreign currency for Vietnam, create rural jobs during non-harvest seasons, and preserve our traditional weaving techniques.<\/p>\n<hr data-start=\"1605\" data-end=\"1608\" \/>\n<h3 data-start=\"1610\" data-end=\"1652\">\ud83d\udce6 <strong data-start=\"1617\" data-end=\"1650\">Contact for Wholesale Orders:<\/strong><\/h3>\n<p data-start=\"1653\" data-end=\"1791\">\ud83d\udce7 <strong data-start=\"1656\" data-end=\"1666\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1667\" data-end=\"1690\">vietcraft2006@gmail.com<\/a><br data-start=\"1690\" data-end=\"1693\" \/>\ud83d\udcf1 <strong data-start=\"1696\" data-end=\"1714\">WhatsApp\/Zalo:<\/strong> +84-975810168<br data-start=\"1728\" data-end=\"1731\" \/>\ud83c\udf10 <strong data-start=\"1734\" data-end=\"1746\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1747\" data-end=\"1791\">www.vietcraft.vn<\/a><\/p>\n<p>&nbsp;<\/p>\n<p data-start=\"2252\" data-end=\"2435\">","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":833,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24091-rectangle-seagrass-door-mat.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24091-rectangle-seagrass-door-mat.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24091-rectangle-seagrass-door-mat.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24091-rectangle-seagrass-door-mat.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24091-rectangle-seagrass-door-mat.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24091-rectangle-seagrass-door-mat.jpg?resize=300%2C30