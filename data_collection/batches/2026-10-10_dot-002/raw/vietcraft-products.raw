.vn\/product-category\/home-living\/lighting\/"},{"id":70,"name":"Materials","slug":"materials","link":"https:\/\/vietcraft.vn\/product-category\/materials\/"},{"id":167,"name":"Product Type","slug":"product-type","link":"https:\/\/vietcraft.vn\/product-category\/product-type\/"}],"tags":[{"id":1219,"name":"B2BSourcing","slug":"b2bsourcing","link":"https:\/\/vietcraft.vn\/product-tag\/b2bsourcing\/"},{"id":1226,"name":"bamboo factory","slug":"bamboo-factory","link":"https:\/\/vietcraft.vn\/product-tag\/bamboo-factory\/"},{"id":1221,"name":"BambooLampshades","slug":"bamboolampshades","link":"https:\/\/vietcraft.vn\/product-tag\/bamboolampshades\/"},{"id":1223,"name":"ContainerSupply","slug":"containersupply","link":"https:\/\/vietcraft.vn\/product-tag\/containersupply\/"},{"id":1224,"name":"NaturalHomeDecor","slug":"naturalhomedecor","link":"https:\/\/vietcraft.vn\/product-tag\/naturalhomedecor\/"},{"id":1225,"name":"RattanWholesale","slug":"rattanwholesale","link":"https:\/\/vietcraft.vn\/product-tag\/rattanwholesale\/"},{"id":1222,"name":"VietnamExport","slug":"vietnamexport","link":"https:\/\/vietcraft.vn\/product-tag\/vietnamexport\/"},{"id":1220,"name":"WholesaleLighting","slug":"wholesalelighting","link":"https:\/\/vietcraft.vn\/product-tag\/wholesalelighting\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Woven Bamboo &#038; Natural Lighting from Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/woven-bamboo-natural-lighting-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1318","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1318&per_page=10"}]}},{"id":1300,"name":"WHOLESALE\u00a0Hand-Woven Bamboo Pendant Light\u00a0\u2013 Natural\u00a0Slats &#038; Bohemian\u00a0Supplier","slug":"wholesale-hand-woven-bamboo-pendant-light-natural-slats-bohemian-supplier","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/wholesale-hand-woven-bamboo-pendant-light-natural-slats-bohemian-supplier\/","sku":"VH24038","short_description":"","description":"<p><b>Premier Wholesale Supplier of Natural Bamboo Woven Lampshades<\/b><\/p>\n<p>Partner with Vietnam Handicraft to enrich your inventory with our authentic, sustainably crafted lighting solutions. Our Bamboo Lampshade is meticulously hand-woven from fine, natural bamboo slats, offering retailers an exclusive product that captures the high-demand aesthetic of Coastal, Bohemian, and Modern Farmhouse interior design.<\/p>\n<p>As a wholesale manufacturer, we guarantee a consistent supply of high-quality fixtures that appeal to environmentally conscious consumers and interior designers globally.<\/p>\n<p><b>Product Excellence &amp; Design Specifications<\/b><\/p>\n<p>The unique selling points of our bamboo lampshade are rooted in its craftsmanship and material integrity:<\/p>\n<p><b>100% Natural Bamboo Slats:<\/b>\u00a0Woven from carefully selected, treated bamboo strips (nan tre) for a smooth finish and excellent durability. The natural finish may be customized upon request (e.g., stained or lacquered). <b>Hand-Woven Precision:<\/b>\u00a0Each shade is crafted by Vietnamese artisans, ensuring unique detail and structural integrity, differentiating it from mass-produced items.<\/p>\n<p><b>Ambient &amp; Textural Lighting:<\/b>\u00a0The open-weave structure creates a warm, diffused light pattern, highly sought after for creating inviting atmospheres in living rooms, dining areas, hotels, and cafes. The shadow play is a key retail marketing feature.<\/p>\n<p><b>Ready for Installation:<\/b>\u00a0Designed to fit standard lamp cord kits (hardware not included, unless specified for OEM). The structure is lightweight, yet resilient, minimizing freight costs while maximizing appeal.<\/p>\n<p>We offer <b>OEM\/Private Label<\/b> services, including variations in weaving density, size customization (diameter\/height), and custom packaging designed to your brand&#8217;s specifications.<\/p>\n<p><b style=\"font-size: 14.4px\">Supply Chain &amp; Wholesale Inquiries<\/b><\/p>\n<p>VIETCRAFT is committed to being your reliable long-term partner:<\/p>\n<p><b>Certification &amp; Compliance:<\/b>\u00a0Our production processes adhere to international standards, with a focus on ethical sourcing and responsible manufacturing.<\/p>\n<p><b>Logistics:<\/b>\u00a0We have optimized packaging for secure global shipping, providing competitive freight solutions.<\/p>\n<p><b>Minimum Order Quantity (MOQ):<\/b>\u00a0Please contact our B2B team to receive our current wholesale price list and MOQ requirements. We offer tiered pricing for volume purchases.<\/p>\n<p><b>Contact Us Today:<\/b>\u00a0To request a full catalog of our lighting collection or discuss your specific OEM project, please reach out to our dedicated B2B sales desk.<\/p>\n<p>Email: vietcraft2006@gmail.com \u2013\u00a0 or call us at +84 975810168<br \/>\n<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1304,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/