n_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Oval Spun Bamboo Bowl Made in Vietnam \u2013 Eco-Friendly &#038; Handmade&rdquo;","url":"https:\/\/vietcraft.vn\/product\/oval-spun-bamboo-bowl-made-in-vietnam-eco-friendly-handmade\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1062","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1062&per_page=10"}]}},{"id":1055,"name":"Acacia Wooden Spoon from Vietnam \u2013 Sustainable &#038; Handmade","slug":"acacia-wooden-spoon-from-vietnam-sustainable-handmade","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/acacia-wooden-spoon-from-vietnam-sustainable-handmade\/","sku":"VH24071","short_description":"<p>Handmade <strong data-start=\"1643\" data-end=\"1679\">acacia wooden spoon from Vietnam<\/strong>, crafted by local artisans. Durable, eco-friendly, and food-safe \u2013 perfect for cooking and serving. Wholesale supply available.<\/p>","description":"<h3 data-start=\"177\" data-end=\"203\">Product Description:<\/h3>\n<p data-start=\"204\" data-end=\"556\">Our <strong data-start=\"208\" data-end=\"231\">Acacia wooden spoon<\/strong> is handcrafted by skilled Vietnamese artisans using sustainably sourced <strong data-start=\"304\" data-end=\"319\">acacia wood<\/strong>, known for its durability, smooth texture, and natural golden-brown color. Each piece is carefully carved, sanded, and polished to ensure a <strong data-start=\"460\" data-end=\"501\">comfortable grip and food-safe finish<\/strong>, making it perfect for cooking, serving, or gifting.<\/p>\n<p data-start=\"558\" data-end=\"846\">Vietnam\u2019s rich tradition of woodcraft is reflected in this eco-friendly product, blending natural beauty with everyday functionality. By choosing our wooden utensils, you not only bring warmth and elegance into your kitchen but also support local farmers and craftsmen in rural Vietnam.<\/p>\n<p data-start=\"848\" data-end=\"1175\">Exporting acacia wooden spoons creates jobs for artisans, helps maintain traditional craft skills, and contributes to Vietnam\u2019s cultural heritage and sustainable development. Almost all materials and labor are locally sourced, making these products a proud representation of Vietnam\u2019s handicraft industry on the global stage.<\/p>\n<p data-start=\"1177\" data-end=\"1268\">For bulk orders or wholesale inquiries, please contact us at <strong data-start=\"1238\" data-end=\"1265\"><a class=\"decorated-link cursor-pointer\" rel=\"noopener\" data-start=\"1240\" data-end=\"1263\">vietcraft2006@gmail.com<\/a><\/strong>.<\/p>\n<hr data-start=\"1270\" data-end=\"1273\" \/>\n<h3 data-start=\"1275\" data-end=\"1294\">Key Features:<\/h3>\n<ul data-start=\"1295\" data-end=\"1602\">\n<li data-start=\"1295\" data-end=\"1349\">\n<p data-start=\"1297\" data-end=\"1349\">Material: 100% sustainably sourced <strong data-start=\"1332\" data-end=\"1347\">acacia wood<\/strong><\/p>\n<\/li>\n<li data-start=\"1350\" data-end=\"1400\">\n<p data-start=\"1352\" data-end=\"1400\">Finish: Smooth, food-safe, eco-friendly polish<\/p>\n<\/li>\n<li data-start=\"1401\" data-end=\"1444\">\n<p data-start=\"1403\" data-end=\"1444\">Handmade by skilled Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"1445\" data-end=\"1489\">\n<p data-start=\"1447\" data-end=\"1489\">Durable, heat-resistant, and lightweight<\/p>\n<\/li>\n<li data-start=\"1490\" data-end=\"1536\">\n<p data-start=\"1492\" data-end=\"1536\">Ideal for cooking, serving, and home d\u00e9cor<\/p>\n<\/li>\n<li data-start=\"1537\" data-end=\"1602\">\n<p data-start=\"1539\" data-end=\"1602\">Wholesale &amp; bulk orders available for importers and retailers<\/p>\n<\/li>\n<\/ul>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1061,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Accacia-wooden-spoon-from-Vietnam.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Accacia-wooden-spoon-from-Vietnam.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Accacia-wooden-spoon-from-Vietnam.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Accacia-wooden-spoon-from-Vietnam.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Accacia-wooden-spoon-from-Vietnam.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Accacia-wooden-spoon-from-Vietnam.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Accacia-wooden-spoon-from-Vietnam.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH24071-Accacia-wooden-spoon-from-Vietnam","alt":""},{"id":1059,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24071-Acacia-wood-spoon-Vietnam.jpg?fit=1080%2C1080&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uplo