:\/\/vietcraft.vn\/product-tag\/round-bamboo-dish-with-mother-of-pearl\/"},{"id":725,"name":"Vietnamese dish set manufacturer","slug":"vietnamese-dish-set-manufacturer","link":"https:\/\/vietcraft.vn\/product-tag\/vietnamese-dish-set-manufacturer\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;MOP Bamboo Round Dish Set \u2013 Handmade Tableware from Vietnam Manufacturer &#038; Wholesale Supplier&rdquo;","url":"https:\/\/vietcraft.vn\/product\/mop-bamboo-round-dish-set-handmade-tableware-from-vietnam-manufacturer-wholesale-supplier\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/904","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=904&per_page=10"}]}},{"id":894,"name":"Rattan and ceramic basket made in Vietnam","slug":"rattan-and-ceramic-basket-made-in-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/rattan-and-ceramic-basket-made-in-vietnam\/","sku":"VH24086","short_description":"<p>Beautifully handwoven rattan basket paired with a hand-painted ceramic bowl. A functional and decorative handicraft from Vietnam.<\/p>","description":"<p><strong>Vietnam Handicraft<\/strong><\/p>\n<p><strong>Storage basket<\/strong><\/p>\n<p data-start=\"241\" data-end=\"534\">Discover the perfect blend of rustic charm and refined elegance with this <strong data-start=\"315\" data-end=\"340\">rattan ceramic basket<\/strong>, handcrafted by Vietnamese artisans. The inner ceramic bowl features intricate hand-painted designs, while the outer basket is woven from natural rattan for durability and a warm, organic feel.<\/p>\n<p data-start=\"536\" data-end=\"800\">Ideal for serving bread, fruits, or snacks, this basket also doubles as a beautiful tabletop d\u00e9cor piece. The combination of <strong data-start=\"661\" data-end=\"684\">traditional weaving<\/strong> and <strong data-start=\"689\" data-end=\"719\">fine ceramic craftsmanship<\/strong> makes it a unique addition to any kitchen, dining space, or hospitality setting.<\/p>\n<hr data-start=\"802\" data-end=\"805\" \/>\n<h3 data-start=\"807\" data-end=\"832\">\u2705 <strong data-start=\"813\" data-end=\"830\">Key Features:<\/strong><\/h3>\n<ul data-start=\"833\" data-end=\"1172\">\n<li data-start=\"833\" data-end=\"911\">\n<p data-start=\"835\" data-end=\"911\">Material: Hand-painted ceramic inner bowl with natural rattan outer basket<\/p>\n<\/li>\n<li data-start=\"912\" data-end=\"968\">\n<p data-start=\"914\" data-end=\"968\">Use: Multi-purpose \u2013 serving, storage, or decoration<\/p>\n<\/li>\n<li data-start=\"969\" data-end=\"1023\">\n<p data-start=\"971\" data-end=\"1023\">Finish: Smooth ceramic and handwoven natural fiber<\/p>\n<\/li>\n<li data-start=\"1024\" data-end=\"1067\">\n<p data-start=\"1026\" data-end=\"1067\">Eco-friendly, sustainable, and reusable<\/p>\n<\/li>\n<li data-start=\"1068\" data-end=\"1129\">\n<p data-start=\"1070\" data-end=\"1129\">Custom sizes, colors, and patterns available upon request<\/p>\n<\/li>\n<li data-start=\"1130\" data-end=\"1172\">\n<p data-start=\"1132\" data-end=\"1172\">Handmade in Vietnam by skilled craftsmen<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1174\" data-end=\"1177\" \/>\n<h3 data-start=\"1179\" data-end=\"1226\">\ud83c\udf3f <strong data-start=\"1186\" data-end=\"1224\">Why Choose Vietnamese Handicrafts?<\/strong><\/h3>\n<p data-start=\"1227\" data-end=\"1562\">By choosing this product, you&#8217;re supporting a tradition that uses <strong data-start=\"1293\" data-end=\"1327\">100% local materials and labor<\/strong>. These handcrafted goods <strong data-start=\"1353\" data-end=\"1382\">generate foreign currency<\/strong> for Vietnam, <strong data-start=\"1396\" data-end=\"1435\">create employment for rural farmers<\/strong> during non-harvest seasons, and <strong data-start=\"1468\" data-end=\"1508\">preserve traditional cultural values<\/strong> through artisanal skills passed down for generations.<\/p>\n<hr data-start=\"1564\" data-end=\"1567\" \/>\n<h3 data-start=\"1569\" data-end=\"1611\">\ud83d\udce6 <strong data-start=\"1576\" data-end=\"1609\">Contact for Wholesale Orders:<\/strong><\/h3>\n<p data-start=\"1612\" data-end=\"1751\">\ud83d\udce7 <strong data-start=\"1615\" data-end=\"1625\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1626\" data-end=\"1649\">vietcraft2006@gmail.com<\/a><br data-start=\"1649\" data-end=\"1652\" \/>\ud83d\udcf1 <strong data-start=\"1655\" data-end=\"1674\">Phone\/WhatsApp:<\/strong> +84-975810168<br data-start=\"1688\" data-end=\"1691\" \/>\ud83c\udf10 <strong data-start=\"1694\" data-end=\"1706\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1707\" data-end=\"1751\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":898,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24086-rattan-ceramic-basket.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com