ducts"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1055&per_page=10"}]}},{"id":1050,"name":"Black Rattan Lampshade from Vietnam","slug":"black-rattan-lampshade-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/black-rattan-lampshade-from-vietnam\/","sku":"VH24072","short_description":"<p>Handwoven <strong data-start=\"1596\" data-end=\"1635\">black rattan lampshade from Vietnam<\/strong>, crafted by local artisans with eco-friendly materials. A perfect lighting accessory for homes, caf\u00e9s, and resorts. Wholesale supply available.<\/p>","description":"<h3 data-start=\"185\" data-end=\"214\"><strong data-start=\"189\" data-end=\"212\">Product Description<\/strong><\/h3>\n<p data-start=\"215\" data-end=\"486\">Our <strong data-start=\"219\" data-end=\"245\">Black Rattan Lampshade<\/strong> is handwoven by skilled Vietnamese artisans using sustainable rattan materials. Each piece reflects a blend of traditional weaving techniques and contemporary design, creating a natural yet modern lighting solution for any interior space.<\/p>\n<p data-start=\"488\" data-end=\"756\">The deep black finish highlights the texture of the woven rattan, casting warm and organic shadows when the light is turned on. Perfect for living rooms, dining spaces, restaurants, caf\u00e9s, or resorts, this lampshade adds both elegance and authenticity to your d\u00e9cor.<\/p>\n<p data-start=\"758\" data-end=\"958\">By sourcing directly from Vietnam, you not only receive a beautiful handmade product but also support local artisans, preserve cultural heritage, and contribute to job creation in rural communities.<\/p>\n<p data-start=\"960\" data-end=\"1198\"><strong data-start=\"960\" data-end=\"999\">Supplier &amp; Manufacturer in Vietnam:<\/strong><br data-start=\"999\" data-end=\"1002\" \/>We provide wholesale and bulk orders of handcrafted rattan lampshades for retailers, importers, and interior designers worldwide. For inquiries, please contact us at <strong data-start=\"1168\" data-end=\"1195\"><a class=\"decorated-link cursor-pointer\" rel=\"noopener\" data-start=\"1170\" data-end=\"1193\">vietcraft2006@gmail.com<\/a><\/strong>.<\/p>\n<hr data-start=\"1200\" data-end=\"1203\" \/>\n<h3 data-start=\"1205\" data-end=\"1227\"><strong data-start=\"1209\" data-end=\"1225\">Key Features<\/strong><\/h3>\n<ul data-start=\"1228\" data-end=\"1551\">\n<li data-start=\"1228\" data-end=\"1272\">\n<p data-start=\"1230\" data-end=\"1272\">Material: 100% natural rattan, handwoven<\/p>\n<\/li>\n<li data-start=\"1273\" data-end=\"1325\">\n<p data-start=\"1275\" data-end=\"1325\">Color: Matte black finish (eco-friendly coating)<\/p>\n<\/li>\n<li data-start=\"1326\" data-end=\"1374\">\n<p data-start=\"1328\" data-end=\"1374\">Style: Pendant lampshade \/ ceiling lampshade<\/p>\n<\/li>\n<li data-start=\"1375\" data-end=\"1421\">\n<p data-start=\"1377\" data-end=\"1421\">Origin: Vietnam \u2013 made by skilled artisans<\/p>\n<\/li>\n<li data-start=\"1422\" data-end=\"1464\">\n<p data-start=\"1424\" data-end=\"1464\">Eco-friendly, lightweight, and durable<\/p>\n<\/li>\n<li data-start=\"1465\" data-end=\"1517\">\n<p data-start=\"1467\" data-end=\"1517\">Available in various sizes &amp; shapes upon request<\/p>\n<\/li>\n<li data-start=\"1518\" data-end=\"1551\">\n<p data-start=\"1520\" data-end=\"1551\">Customization for bulk orders<\/p>\n<\/li>\n<\/ul>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1054,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24072-Black-rattan-lampshade-from-Vietnam.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i