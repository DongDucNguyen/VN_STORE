e\/v1\/products?related=915&per_page=10"}]}},{"id":904,"name":"MOP Bamboo Round Dish Set \u2013 Handmade Tableware from Vietnam Manufacturer &#038; Wholesale Supplier","slug":"mop-bamboo-round-dish-set-handmade-tableware-from-vietnam-manufacturer-wholesale-supplier","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/mop-bamboo-round-dish-set-handmade-tableware-from-vietnam-manufacturer-wholesale-supplier\/","sku":"VH24085","short_description":"<p>Elegant round dish set made of spun bamboo and Mother of Pearl inlay. Perfect for eco-conscious dining and d\u00e9cor, handcrafted in Vietnam.<\/p>","description":"<p>Vietnam Handicraft<\/p>\n<h3 data-start=\"218\" data-end=\"251\">\ud83d\udcdd <strong data-start=\"225\" data-end=\"249\">Product Description:<\/strong><\/h3>\n<p data-start=\"252\" data-end=\"591\">Elevate your dining experience with our <strong data-start=\"292\" data-end=\"321\">MOP Bamboo Round Dish Set<\/strong>, a stunning fusion of natural bamboo and Mother of Pearl (MOP) inlay. Each dish is carefully handcrafted by skilled Vietnamese artisans, using eco-friendly spun bamboo as the base and intricately inlaid with shimmering seashells to create a sophisticated, organic look.<\/p>\n<p data-start=\"593\" data-end=\"754\">Perfect for serving snacks, salads, or as decorative accents, this dish set is a functional work of art that reflects both cultural heritage and modern elegance.<\/p>\n<p data-start=\"756\" data-end=\"901\">Whether you&#8217;re sourcing for homeware retail, hospitality, or gifting collections, this handmade dish set adds value and beauty to any collection.<\/p>\n<hr data-start=\"903\" data-end=\"906\" \/>\n<h3 data-start=\"908\" data-end=\"933\">\u2705 <strong data-start=\"914\" data-end=\"931\">Key Features:<\/strong><\/h3>\n<ul data-start=\"934\" data-end=\"1252\">\n<li data-start=\"934\" data-end=\"989\">\n<p data-start=\"936\" data-end=\"989\">Set includes: 1 or more round dishes (customizable)<\/p>\n<\/li>\n<li data-start=\"990\" data-end=\"1044\">\n<p data-start=\"992\" data-end=\"1044\">Materials: Spun bamboo base with natural MOP inlay<\/p>\n<\/li>\n<li data-start=\"1045\" data-end=\"1096\">\n<p data-start=\"1047\" data-end=\"1096\">Finish: Smooth lacquer for durability and shine<\/p>\n<\/li>\n<li data-start=\"1097\" data-end=\"1159\">\n<p data-start=\"1099\" data-end=\"1159\">Handcrafted by artisans in traditional Vietnamese villages<\/p>\n<\/li>\n<li data-start=\"1160\" data-end=\"1207\">\n<p data-start=\"1162\" data-end=\"1207\">Sustainable, lightweight, and biodegradable<\/p>\n<\/li>\n<li data-start=\"1208\" data-end=\"1252\">\n<p data-start=\"1210\" data-end=\"1252\">Food-safe and customizable in size\/color<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1254\" data-end=\"1257\" \/>\n<h3 data-start=\"1259\" data-end=\"1295\">\ud83d\udca1 <strong data-start=\"1266\" data-end=\"1293\">Why Handicraft Matters:<\/strong><\/h3>\n<p data-start=\"1296\" data-end=\"1603\">Vietnamese handicrafts like this MOP bamboo dish set are <strong data-start=\"1353\" data-end=\"1401\">made entirely with local materials and labor<\/strong>, generating <strong data-start=\"1414\" data-end=\"1432\">foreign income<\/strong> for the country while <strong data-start=\"1455\" data-end=\"1479\">providing rural jobs<\/strong> between harvest seasons. Each purchase helps preserve centuries-old craftsmanship and promotes <strong data-start=\"1575\" data-end=\"1602\">sustainable development<\/strong>.<\/p>\n<hr data-start=\"1605\" data-end=\"1608\" \/>\n<h3 data-start=\"1610\" data-end=\"1655\">\ud83d\udcde <strong data-start=\"1617\" data-end=\"1653\">Contact for Wholesale Inquiries:<\/strong><\/h3>\n<p data-start=\"1656\" data-end=\"1786\"><strong data-start=\"1656\" data-end=\"1666\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1667\" data-end=\"1690\">vietcraft2006@gmail.com<\/a><br data-start=\"1690\" data-end=\"1693\" \/><strong data-start=\"1693\" data-end=\"1712\">Phone\/WhatsApp:<\/strong> +84-975810168<br data-start=\"1726\" data-end=\"1729\" \/><strong data-start=\"1729\" data-end=\"1741\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1742\" data-end=\"1786\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":908,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH24085-MOP-bamboo-round-dish","alt":""},{"id":910,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish-set.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24085-MOP-bamboo-round-dish-set.jpg?