ck"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Wholesale Hand-Painted Lacquer Coconut Bowls from Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/wholesale-hand-painted-lacquer-coconut-bowls-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1533","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1533&per_page=10"}]}},{"id":1528,"name":"Wholesale Acacia Wood Leaf Trays from Vietnam","slug":"wholesale-acacia-wood-leaf-trays-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/wholesale-acacia-wood-leaf-trays-from-vietnam\/","sku":"VH2614","short_description":"<h1 data-path-to-node=\"2\">Premium Wholesale Acacia Wood Leaf Trays \u2013 Solid Plantation Wood Manufacturer in Vietnam<\/h1>","description":"<p data-path-to-node=\"3\">Looking for a reliable, eco-friendly, and high-quality manufacturer of wooden tableware and home decor? We are a leading OEM\/ODM Vietnam-based manufacturer specializing in <b data-path-to-node=\"3\" data-index-in-node=\"172\">solid Acacia wood trays<\/b>, crafted directly from sustainable plantation forests in Vietnam.<\/p>\n<h2 data-path-to-node=\"5\">Key Features &amp; Specifications<\/h2>\n<ul data-path-to-node=\"6\">\n<li>\n<p data-path-to-node=\"6,0,0\"><b data-path-to-node=\"6,0,0\" data-index-in-node=\"0\">Material:<\/b> 100% Solid Plantation Acacia Wood (Sourced locally in Vietnam)<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"6,1,0\"><b data-path-to-node=\"6,1,0\" data-index-in-node=\"0\">Design:<\/b> Unique leaf-shaped carve with natural wood grain patterns (Custom designs available)<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"6,2,0\"><b data-path-to-node=\"6,2,0\" data-index-in-node=\"0\">Finish:<\/b> Food-safe oil\/lacquer coating (Free from toxic chemicals, moisture-resistant)<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"6,3,0\"><b data-path-to-node=\"6,3,0\" data-index-in-node=\"0\">Customization (OEM\/ODM):<\/b> Custom sizes, shapes, engravings, logos, and packaging tailored to your brand specifications<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"6,4,0\"><b data-path-to-node=\"6,4,0\" data-index-in-node=\"0\">Origin:<\/b> Made in Vietnam<\/p>\n<\/li>\n<\/ul>\n<h2 data-path-to-node=\"8\">Why Source Acacia Wood Trays from Vietnam?<\/h2>\n<h3 data-path-to-node=\"9\">1. 100% Sustainable Plantation Acacia Wood<\/h3>\n<p data-path-to-node=\"10\">Acacia is one of Vietnam\u2019s primary plantation woods, known for its rapid growth, exceptional strength, and rich, varied grain structure. By sourcing plantation-grown Acacia, we help protect natural forests while ensuring a continuous, reliable supply chain for large-volume wholesale orders.<\/p>\n<h3 data-path-to-node=\"11\">2. Superior Quality &amp; Craftsmanship<\/h3>\n<p data-path-to-node=\"12\">Each tray is crafted from a single block of solid Acacia wood, carefully kiln-dried to achieve optimal moisture content. This process prevents warping, cracking, or splitting under varying climate conditions worldwide.<\/p>\n<h3 data-path-to-node=\"13\">3. Full Customization for Wholesale &amp; Importers<\/h3>\n<p data-path-to-node=\"14\">We understand the needs of global retailers, distributors, and importers. Whether you require specific dimensions, custom branding (laser-engraved logo), or custom eco-friendly packaging, our engineering and design team can bring your concepts to life.<\/p>\n<h3 data-path-to-node=\"15\">4. Strict Quality Assurance &amp; Timely Delivery<\/h3>\n<ul data-path-to-node=\"16\">\n<li>\n<p data-path-to-node=\"16,0,0\"><b data-path-to-node=\"16,0,0\" data-index-in-node=\"0\">Quality Control:<\/b> Every production batch undergoes rigorous inspection at each stage\u2014from wood selection and carving to final polishing and packing.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"16,1,0\"><b data-path-to-node=\"16,1,0\" data-index-in-node=\"0\">On-Time Logistics:<\/b> We guarantee strict adherence to production timelines, ensuring on-time container shipments (FOB \/ CIF \/ Door-to-Door).<\/p>\n<\/li>\n<\/ul>\n<h2 data-path-to-node=\"18\">Applications &amp; Market Appeal<\/h2>\n<p data-path-to-node=\"19\">This leaf-shaped solid wood tray is ideal for:<\/p>\n<ul data-path-to-node=\"20\">\n<li>\n<p data-path-to-node=\"20,0,0\"><b data-path-to-node=\"20,0,0\" data-index-in-node=\"0\">Tableware &amp; Servingware:<\/b> Appetizer platters, charcuterie boards, snack trays, and fruit bowls.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"20,1,0\"><b data-path-to-node=\"20,1,0\" data-index-in-node=\"0\">Home &amp; Hotel Decor:<\/b> Luxury decorative accents for living rooms, resorts, and hospitality venues.<\/p>\n<\/li>\n<li>\n<p data-path-to-node=\"20,2,0\"><b data-path-to-node=\"20,2,0\" data-index-in-node=\"0\">Giftware &amp; Eco-friendly Line:<\/b> Perfect for eco-conscious retail brands, holiday gift sets, and corporate promotional items.<\/p>\n<\/li>\n<\/ul>\n<h2 data-path-to-node=\"22\">Contact Us for Factory-Direct Wholesale Quotes<\/h2>\n<p data-path-to-node=\"23\">Expand your product line with premium, sustainably made Vietnamese woodenware. Contact our sales team today to request samples, catalog updates, or a competitive quotation for your custom manufacturing needs.<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"}