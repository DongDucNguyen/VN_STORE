"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Round Serving Tray Made of MOP in Vietnam \u2013 Handmade Luxury D\u00e9cor&rdquo;","url":"https:\/\/vietcraft.vn\/product\/round-serving-tray-made-of-mop-in-vietnam-handmade-luxury-decor\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1069","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1069&per_page=10"}]}},{"id":1062,"name":"Oval Spun Bamboo Bowl Made in Vietnam \u2013 Eco-Friendly &#038; Handmade","slug":"oval-spun-bamboo-bowl-made-in-vietnam-eco-friendly-handmade","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/oval-spun-bamboo-bowl-made-in-vietnam-eco-friendly-handmade\/","sku":"VH24070","short_description":"<p>Handmade <strong data-start=\"1645\" data-end=\"1683\">oval spun bamboo bowl from Vietnam<\/strong>, eco-friendly and food-safe. Perfect for serving or decoration. Available for wholesale orders worldwide.<\/p>","description":"<h3 data-start=\"189\" data-end=\"215\">Product Description:<\/h3>\n<figure id=\"attachment_1068\" aria-describedby=\"caption-attachment-1068\" style=\"width: 400px\" class=\"wp-caption alignnone\"><img loading=\"lazy\" class=\"size-medium wp-image-1068\" src=\"https:\/\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Vietnam-Oval-Spun-Bamboo-Bowl-400x400.jpg\" alt=\"\" width=\"400\" height=\"400\" \/><figcaption id=\"caption-attachment-1068\" class=\"wp-caption-text\">Spun bamboo bowl made in Vietnam<\/figcaption><\/figure>\n<p data-start=\"216\" data-end=\"599\">Our <strong data-start=\"220\" data-end=\"245\">oval spun bamboo bowl<\/strong> is beautifully handcrafted in Vietnam by skilled artisans using natural <strong data-start=\"318\" data-end=\"335\">bamboo strips<\/strong>. Through a meticulous spinning and layering process, the bowl is shaped into a smooth, elegant oval form. The surface is carefully polished and finished with food-safe coatings, showcasing the natural beauty of bamboo while ensuring durability and practicality.<\/p>\n<p data-start=\"601\" data-end=\"888\">Perfect for serving salads, fruits, snacks, or as a decorative piece, this bowl combines <strong data-start=\"690\" data-end=\"730\">traditional Vietnamese craftsmanship<\/strong> with modern eco-friendly living. Bamboo is a sustainable material that grows rapidly, making it an excellent alternative to plastic or ceramic kitchenware.<\/p>\n<p data-start=\"890\" data-end=\"1213\">By choosing our spun bamboo bowls, you are not only bringing sustainable elegance to your home but also supporting rural communities in Vietnam. Each purchase creates job opportunities for farmers and artisans during their free time, preserves cultural traditions, and contributes to Vietnam\u2019s handicraft export industry.<\/p>\n<p data-start=\"1215\" data-end=\"1299\">For bulk or wholesale inquiries, please contact us at <strong data-start=\"1269\" data-end=\"1296\"><a class=\"decorated-link cursor-pointer\" rel=\"noopener\" data-start=\"1271\" data-end=\"1294\">vietcraft2006@gmail.com<\/a><\/strong>.<\/p>\n<hr data-start=\"1301\" data-end=\"1304\" \/>\n<h3 data-start=\"1306\" data-end=\"1325\">Key Features:<\/h3>\n<ul data-start=\"1326\" data-end=\"1604\">\n<li data-start=\"1326\" data-end=\"1359\">\n<p data-start=\"1328\" data-end=\"1359\">Material: 100% natural bamboo<\/p>\n<\/li>\n<li data-start=\"1360\" data-end=\"1394\">\n<p data-start=\"1362\" data-end=\"1394\">Shape: Oval spun bamboo design<\/p>\n<\/li>\n<li data-start=\"1395\" data-end=\"1431\">\n<p data-start=\"1397\" data-end=\"1431\">Finish: Smooth, food-safe polish<\/p>\n<\/li>\n<li data-start=\"1432\" data-end=\"1474\">\n<p data-start=\"1434\" data-end=\"1474\">Lightweight, durable, and eco-friendly<\/p>\n<\/li>\n<li data-start=\"1475\" data-end=\"1510\">\n<p data-start=\"1477\" data-end=\"1510\">Handmade by Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"1511\" data-end=\"1562\">\n<p data-start=\"1513\" data-end=\"1562\">Ideal for salads, fruits, snacks, or home d\u00e9cor<\/p>\n<\/li>\n<li data-start=\"1563\" data-end=\"1604\">\n<p data-start=\"1565\" data-end=\"1604\">Available for bulk &amp; wholesale orders<\/p>\n<\/li>\n<\/ul>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1066,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Oval-Spun-Bamboo-Bowl.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Oval-Spun-Bamboo-Bowl.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Oval-Spun-Bamboo-Bowl.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Oval-Spun-Bamboo-Bowl.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Oval-Spun-Bamboo-Bowl.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Oval-Spun-Bamboo-Bowl.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24070-Oval-Spun-Bamboo-Bowl.jpg?resize=100%2C100&ssl=1 100w","thumbnail