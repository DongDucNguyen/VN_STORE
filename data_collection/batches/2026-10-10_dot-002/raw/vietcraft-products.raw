wholesale\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/866","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=866&per_page=10"}]}},{"id":859,"name":"Woven Rattan Mirror \u2013 Handcrafted Decorative Mirror from","slug":"woven-rattan-mirror-handcrafted-decorative-mirror-from","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/woven-rattan-mirror-handcrafted-decorative-mirror-from\/","sku":"","short_description":"<p>Round woven rattan mirror handmade in Vietnam. Stylish and eco-friendly home d\u00e9cor for rustic or coastal interiors. Available for wholesale.<\/p>","description":"<p data-start=\"261\" data-end=\"590\">Bring a touch of <strong data-start=\"278\" data-end=\"319\">natural beauty and artisanal elegance<\/strong> to your living space with this <strong data-start=\"351\" data-end=\"383\">handmade woven rattan mirror<\/strong>. Expertly crafted by skilled Vietnamese artisans, this round mirror features a stunning braided rattan frame in a contrasting natural and black pattern \u2014 making it a perfect centerpiece for your wall d\u00e9cor.<\/p>\n<p data-start=\"592\" data-end=\"861\">Ideal for <strong data-start=\"602\" data-end=\"650\">boho, coastal, rustic, or tropical interiors<\/strong>, this eco-friendly mirror is not only functional but also an expression of Vietnam\u2019s traditional craftsmanship. Whether placed in a bedroom, hallway, or hotel lobby, it adds depth and warmth to any environment.<\/p>\n<p data-start=\"863\" data-end=\"1043\">As a trusted <strong data-start=\"876\" data-end=\"926\">manufacturer and wholesale supplier in Vietnam<\/strong>, <strong data-start=\"928\" data-end=\"959\">Vietnam Handicraft Co., Ltd<\/strong> offers bulk supply options and custom sizes to suit your business or project needs.<\/p>\n<hr data-start=\"1045\" data-end=\"1048\" \/>\n<h3 data-start=\"1050\" data-end=\"1075\">\u2705 <strong data-start=\"1056\" data-end=\"1073\">Key Features:<\/strong><\/h3>\n<ul data-start=\"1076\" data-end=\"1369\">\n<li data-start=\"1076\" data-end=\"1137\">\n<p data-start=\"1078\" data-end=\"1137\">Material: Natural rattan (dyed and raw) with glass mirror<\/p>\n<\/li>\n<li data-start=\"1138\" data-end=\"1202\">\n<p data-start=\"1140\" data-end=\"1202\">Design: Round, handwoven with black-natural contrast pattern<\/p>\n<\/li>\n<li data-start=\"1203\" data-end=\"1252\">\n<p data-start=\"1205\" data-end=\"1252\">Size: Customizable diameter options available<\/p>\n<\/li>\n<li data-start=\"1253\" data-end=\"1299\">\n<p data-start=\"1255\" data-end=\"1299\">Style: Rustic, Boho, Coastal, Scandinavian<\/p>\n<\/li>\n<li data-start=\"1300\" data-end=\"1369\">\n<p data-start=\"1302\" data-end=\"1369\">Usage: Wall mirror, decorative mirror, bathroom or hallway accent<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1371\" data-end=\"1374\" \/>\n<h3 data-start=\"1376\" data-end=\"1430\">\ud83c\udf3f <strong data-start=\"1383\" data-end=\"1428\">The Meaning Behind Vietnamese Handicrafts<\/strong><\/h3>\n<p data-start=\"1431\" data-end=\"1828\">Each rattan mirror we produce reflects not only the artisan\u2019s craftsmanship but also the spirit of Vietnam\u2019s <strong data-start=\"1540\" data-end=\"1563\">handicraft heritage<\/strong>. Made using <strong data-start=\"1576\" data-end=\"1610\">100% local materials and labor<\/strong>, these products <strong data-start=\"1627\" data-end=\"1654\">generate foreign income<\/strong> and provide <strong data-start=\"1667\" data-end=\"1695\">extra income for farmers<\/strong> during off-season periods. This promotes <strong data-start=\"1737\" data-end=\"1763\">sustainable employment<\/strong> and helps preserve cultural traditions through timeless designs.<\/p>\n<hr data-start=\"1830\" data-end=\"1833\" \/>\n<h3 data-start=\"1835\" data-end=\"1877\">\ud83d\udce6 <strong data-start=\"1842\" data-end=\"1875\">Contact for Wholesale Orders:<\/strong><\/h3>\n<p data-start=\"1878\" data-end=\"2017\">\ud83d\udce7 <strong data-start=\"1881\" data-end=\"1891\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1892\" data-end=\"1915\">vietcraft2006@gmail.com<\/a><br data-start=\"1915\" data-end=\"1918\" \/>\ud83d\udcf1 <strong data-start=\"1921\" data-end=\"1940\">Phone\/WhatsApp:<\/strong> +84-975810168<br data-start=\"1954\" data-end=\"1957\" \/>\ud83c\udf10 <strong data-start=\"1960\" data-end=\"1972\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1973\" data-end=\"2017\">www.vietcraft.vn<\/a><\/p>\n<p data-start=\"2064\" data-end=\"2204\">","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":863,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24087-woven-rattan-mirrorin-Vietnam.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24087-woven-rattan-mirrorin-Vietnam.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24087-woven-rattan-mirrorin-Vietnam.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24087-woven-rattan-mirrorin-Vietnam.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24087-woven-rattan-mirror