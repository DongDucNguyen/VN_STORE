s\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Flower Pot Made of Rattan Cane Webbing in Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/flower-pot-made-of-rattan-cane-webbing-in-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1090","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1090&per_page=10"}]}},{"id":1083,"name":"Rattan Tray with Mother of Pearl Inlay \u2013 Handmade in Vietnam","slug":"rattan-tray-with-mother-of-pearl-inlay-handmade-in-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/rattan-tray-with-mother-of-pearl-inlay-handmade-in-vietnam\/","sku":"","short_description":"<p>Handwoven rattan tray with elegant mother of pearl inlay, made in Vietnam. Ideal for serving or decoration, crafted from sustainable materials.<\/p>","description":"<div class=\"video video-fit mb\" style=\"padding-top:56.25%\"><p><\/p>\n<\/div>\n<p data-start=\"150\" data-end=\"179\">Discover handmade <strong data-start=\"1385\" data-end=\"1441\">rattan trays with mother of pearl inlay from Vietnam<\/strong>. Sustainable, eco-friendly, and perfect for wholesale, retail, or home d\u00e9cor.<\/p>\n<h3 data-start=\"150\" data-end=\"179\"><strong data-start=\"154\" data-end=\"177\">Product Description<\/strong><\/h3>\n<p data-start=\"180\" data-end=\"571\">This <strong data-start=\"185\" data-end=\"243\">handwoven rattan tray with mother of pearl (MOP) inlay<\/strong> is a masterpiece of Vietnamese craftsmanship. Skilled artisans carefully braid natural rattan into a strong yet lightweight frame, then adorn it with shimmering seashell inlay for a luxurious finish. The combination of earthy textures and elegant shell details makes this tray perfect for <strong data-start=\"533\" data-end=\"568\">serving, home d\u00e9cor, or gifting<\/strong>.<\/p>\n<p data-start=\"573\" data-end=\"860\">Each tray reflects the dedication of Vietnamese craft villages, where traditional weaving skills are passed down through generations. By choosing this tray, you not only bring a <strong data-start=\"751\" data-end=\"782\">unique eco-friendly product<\/strong> into your home but also support sustainable livelihoods for rural artisans.<\/p>\n<hr data-start=\"862\" data-end=\"865\" \/>\n<h3 data-start=\"867\" data-end=\"889\"><strong data-start=\"871\" data-end=\"887\">Key Features<\/strong><\/h3>\n<ul data-start=\"890\" data-end=\"1153\">\n<li data-start=\"890\" data-end=\"945\">\n<p data-start=\"892\" data-end=\"945\">Material: Natural rattan with mother of pearl inlay<\/p>\n<\/li>\n<li data-start=\"946\" data-end=\"995\">\n<p data-start=\"948\" data-end=\"995\">Finish: Handwoven and polished for durability<\/p>\n<\/li>\n<li data-start=\"996\" data-end=\"1052\">\n<p data-start=\"998\" data-end=\"1052\">Usage: Serving tray, decorative tray, or centerpiece<\/p>\n<\/li>\n<li data-start=\"1053\" data-end=\"1109\">\n<p data-start=\"1055\" data-end=\"1109\">Eco-friendly: 100% natural and sustainable materials<\/p>\n<\/li>\n<li data-start=\"1110\" data-end=\"1153\">\n<p data-start=\"1112\" data-end=\"1153\">Handmade in Vietnam by skilled artisans<\/p>\n<\/li>\n<\/ul>\n<p data-start=\"1367\" data-end=\"1521\">","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1087,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH24061-rattan-tray-from-Rattan-MOP","alt":""},{"id":1089,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP-from-Vietnam.jpg?fit=1080%2C1080&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP-from-Vietnam.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP-from-Vietnam.jpg?w=1080&ssl=1 1080w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24061-rattan-tray-from-Rattan-MOP-from-Vietnam.jpg?resize=400%2C400&s