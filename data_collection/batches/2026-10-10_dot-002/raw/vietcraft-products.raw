":"https:\/\/vietcraft.vn\/product-tag\/woven-bamboo-storage-basket\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Woven Bamboo Storage Basket \u2013 Manufacturer in Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/woven-bamboo-storage-basket-manufacturer-in-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/931","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=931&per_page=10"}]}},{"id":915,"name":"Square Woven Bamboo Food Tent Basket \u2013 Handmade &#038; Eco-Friendly Cover from Vietnam Manufacturer","slug":"square-woven-bamboo-food-tent-basket-handmade-eco-friendly-cover-from-vietnam-manufacturer","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/square-woven-bamboo-food-tent-basket-handmade-eco-friendly-cover-from-vietnam-manufacturer\/","sku":"Vh24084","short_description":"<p>Square bamboo food tent basket with dome cover, handwoven in Vietnam for sustainable food protection and rustic presentation.<\/p>","description":"<h3 data-start=\"240\" data-end=\"273\">\ud83d\udcdd <strong data-start=\"247\" data-end=\"271\">Product Description:<\/strong><\/h3>\n<p data-start=\"274\" data-end=\"577\">Protect your food in style with our <strong data-start=\"310\" data-end=\"350\">Square Woven Bamboo Food Tent Basket<\/strong>, handcrafted by skilled Vietnamese artisans using sustainable bamboo. This unique design features a handwoven bamboo tray with a fitted dome-shaped cover, making it ideal for outdoor dining, buffet setups, or home kitchen use.<\/p>\n<p data-start=\"579\" data-end=\"876\">The food tent helps keep insects and debris away while allowing breathability. Lightweight yet durable, it&#8217;s perfect for both functional and decorative purposes. Designed with export quality in mind, it\u2019s an essential item for eco-conscious brands, homeware retailers, and hospitality wholesalers.<\/p>\n<hr data-start=\"878\" data-end=\"881\" \/>\n<h3 data-start=\"883\" data-end=\"908\">\u2705 <strong data-start=\"889\" data-end=\"906\">Key Features:<\/strong><\/h3>\n<ul data-start=\"909\" data-end=\"1208\">\n<li data-start=\"909\" data-end=\"966\">\n<p data-start=\"911\" data-end=\"966\">Product type: Bamboo tray with dome cover (food tent)<\/p>\n<\/li>\n<li data-start=\"967\" data-end=\"984\">\n<p data-start=\"969\" data-end=\"984\">Shape: Square<\/p>\n<\/li>\n<li data-start=\"985\" data-end=\"1024\">\n<p data-start=\"987\" data-end=\"1024\">Material: 100% natural woven bamboo<\/p>\n<\/li>\n<li data-start=\"1025\" data-end=\"1081\">\n<p data-start=\"1027\" data-end=\"1081\">Function: Protects food while adding rustic elegance<\/p>\n<\/li>\n<li data-start=\"1082\" data-end=\"1116\">\n<p data-start=\"1084\" data-end=\"1116\">Customizable sizes and designs<\/p>\n<\/li>\n<li data-start=\"1117\" data-end=\"1151\">\n<p data-start=\"1119\" data-end=\"1151\">Foldable tent for easy storage<\/p>\n<\/li>\n<li data-start=\"1152\" data-end=\"1208\">\n<p data-start=\"1154\" data-end=\"1208\">Biodegradable and sustainable alternative to plastic<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1210\" data-end=\"1213\" \/>\n<h3 data-start=\"1215\" data-end=\"1263\">\ud83d\udca1 <strong data-start=\"1222\" data-end=\"1261\">The Meaning Behind Handicraft Work:<\/strong><\/h3>\n<p data-start=\"1264\" data-end=\"1523\">This product is made using <strong data-start=\"1291\" data-end=\"1325\">100% local materials and labor<\/strong>, helping generate <strong data-start=\"1344\" data-end=\"1371\">foreign currency income<\/strong> and provide jobs for <strong data-start=\"1393\" data-end=\"1415\">Vietnamese farmers<\/strong> during off-seasons. It contributes to maintaining cultural traditions through sustainable craft production.<\/p>\n<hr data-start=\"1525\" data-end=\"1528\" \/>\n<h3 data-start=\"1530\" data-end=\"1572\">\ud83d\udcde <strong data-start=\"1537\" data-end=\"1570\">Contact for Wholesale Orders:<\/strong><\/h3>\n<p data-start=\"1573\" data-end=\"1703\"><strong data-start=\"1573\" data-end=\"1583\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1584\" data-end=\"1607\">vietcraft2006@gmail.com<\/a><br data-start=\"1607\" data-end=\"1610\" \/><strong data-start=\"1610\" data-end=\"1629\">Phone\/WhatsApp:<\/strong> +84-975810168<br data-start=\"1643\" data-end=\"1646\" \/><strong data-start=\"1646\" data-end=\"1658\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1659\" data-end=\"1703\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":921,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24084-square-Woven-bamboo-food-tent-basket-Vietnam.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24084-square-Woven-bamboo-food-tent-basket-Vietnam.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH2408