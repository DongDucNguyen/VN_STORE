korder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Bamboo Pendant Light Supplier in Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/bamboo-pendant-light-supplier-in-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1125","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1125&per_page=10"}]}},{"id":1114,"name":"Rattan Bread Basket \u2013 Supplier in Vietnam","slug":"rattan-bread-basket-supplier-in-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/rattan-bread-basket-supplier-in-vietnam\/","sku":"VH24056","short_description":"<p>Handwoven <strong data-start=\"1447\" data-end=\"1471\">rattan bread baskets<\/strong> from Vietnam \u2013 eco-friendly, durable, and perfect for serving bread, fruits, or pastries. Wholesale and bulk supply available.<\/p>","description":"<h3 data-start=\"198\" data-end=\"227\"><strong data-start=\"202\" data-end=\"225\">Product Description<\/strong><\/h3>\n<p><img loading=\"lazy\" class=\"alignnone size-medium wp-image-1124\" src=\"https:\/\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-oval-rattan-tray-400x400.jpg\" alt=\"\" width=\"400\" height=\"400\" \/><\/p>\n<p data-start=\"228\" data-end=\"622\">Our <strong data-start=\"232\" data-end=\"266\">handwoven rattan bread baskets<\/strong> are crafted by skilled Vietnamese artisans using sustainably sourced natural rattan. With their lightweight yet sturdy structure, these baskets are perfect for serving bread, fruits, or pastries at restaurants, hotels, bakeries, or for home dining. The natural texture and warm tones of rattan bring a rustic and eco-friendly charm to any table setting.<\/p>\n<p data-start=\"624\" data-end=\"869\">Each basket is carefully woven for durability and finished to highlight the beauty of traditional craftsmanship. Available in multiple sizes and shapes (round, oval, or rectangular), they are versatile for both serving and decorative purposes.<\/p>\n<p data-start=\"871\" data-end=\"1069\">By choosing our rattan baskets, you not only get a high-quality functional product but also contribute to preserving Vietnam\u2019s traditional handicraft culture and providing jobs for rural artisans.<\/p>\n<hr data-start=\"1071\" data-end=\"1074\" \/>\n<h3 data-start=\"1076\" data-end=\"1096\"><strong data-start=\"1080\" data-end=\"1096\">Key Features<\/strong><\/h3>\n<ul data-start=\"1097\" data-end=\"1402\">\n<li data-start=\"1097\" data-end=\"1154\">\n<p data-start=\"1099\" data-end=\"1154\">Material: 100% natural rattan, sustainably harvested.<\/p>\n<\/li>\n<li data-start=\"1155\" data-end=\"1192\">\n<p data-start=\"1157\" data-end=\"1192\">Handwoven by Vietnamese artisans.<\/p>\n<\/li>\n<li data-start=\"1193\" data-end=\"1236\">\n<p data-start=\"1195\" data-end=\"1236\">Lightweight, durable, and eco-friendly.<\/p>\n<\/li>\n<li data-start=\"1237\" data-end=\"1302\">\n<p data-start=\"1239\" data-end=\"1302\">Multipurpose: serving bread, pastries, fruits, or as storage.<\/p>\n<\/li>\n<li data-start=\"1303\" data-end=\"1345\">\n<p data-start=\"1305\" data-end=\"1345\">Available in various shapes and sizes.<\/p>\n<\/li>\n<li data-start=\"1346\" data-end=\"1402\">\n<p data-start=\"1348\" data-end=\"1402\">Wholesale &amp; bulk supply direct from Vietnam factory.<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1792\" data-end=\"1795\" \/>\n<p>\ud83d\udccc <strong style=\"color: #555555;font-size: 14.4px\" data-start=\"2343\" data-end=\"2382\">Supplier &amp; Manufacturer in Vietnam:<\/strong><\/p>\n<p data-start=\"2340\" data-end=\"2618\">We provide high-quality, handmade <strong data-start=\"2419\" data-end=\"2443\">rattan bread baskets<\/strong> in bulk and wholesale. Perfect for retailers, hotels, restaurants, and decorators.<br data-start=\"2526\" data-end=\"2529\" \/>\ud83d\udce9 For inquiries, please contact: <strong data-start=\"2563\" data-end=\"2616\"><a class=\"decorated-link cursor-pointer\" rel=\"noopener\" data-start=\"2565\" data-end=\"2588\">vietcraft2006@gmail.com<\/a> | WhatsApp: +84-975810168<\/strong><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1122,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-rattan-bread-tray.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-rattan-bread-tray.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-rattan-bread-tray.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-rattan-bread-tray.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-rattan-bread-tray.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-rattan-bread-tray.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/09\/VH24056-rattan-bread-tray.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH24056-ra