slug":"seagrass-rug-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/seagrass-rug-supplier\/"},{"id":596,"name":"seagrass supplier Vietnam","slug":"seagrass-supplier-vietnam","link":"https:\/\/vietcraft.vn\/product-tag\/seagrass-supplier-vietnam\/"},{"id":77,"name":"sustainable homeware","slug":"sustainable-homeware","link":"https:\/\/vietcraft.vn\/product-tag\/sustainable-homeware\/"},{"id":604,"name":"sustainable mat factory","slug":"sustainable-mat-factory","link":"https:\/\/vietcraft.vn\/product-tag\/sustainable-mat-factory\/"},{"id":606,"name":"Vietnam handicraft supplier","slug":"vietnam-handicraft-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/vietnam-handicraft-supplier\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Rectangle Seagrass Door Mat \u2013 Handwoven Eco-Friendly Mat from Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/rectangle-seagrass-door-mat-handwoven-eco-friendly-mat-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/829","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=829&per_page=10"}]}},{"id":822,"name":"Elegant Serving Tray Made of Rattan and Wood \u2013 Handcrafted in Vietnam for Wholesale &#038; Export","slug":"elegant-serving-tray-made-of-rattan-and-wood-handcrafted-in-vietnam-for-wholesale-export","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/elegant-serving-tray-made-of-rattan-and-wood-handcrafted-in-vietnam-for-wholesale-export\/","sku":"VH24092","short_description":"<p>Handmade tray featuring a woven rattan base and wooden frame, ideal for serving or decorating. Wholesale available directly from Vietnam.<\/p>","description":"<p data-start=\"293\" data-end=\"668\">This stylish serving tray combines the natural warmth of rattan with the durability of solid wood to create a functional yet elegant home accessory. The base features handwoven <strong data-start=\"470\" data-end=\"485\">rattan mesh<\/strong>, set within a sturdy wooden frame with smooth cut-out handles for easy carrying. Ideal for serving drinks, snacks, or as a decorative tabletop item in homes, hotels, and restaurants.<\/p>\n<p data-start=\"670\" data-end=\"973\">Crafted by skilled artisans in Vietnam, this tray is more than just a household item\u2014it reflects generations of craftsmanship and a commitment to sustainable materials. Whether you&#8217;re a wholesale buyer, interior designer, or retailer, this product fits effortlessly into any eco-conscious, modern space.<\/p>\n<hr data-start=\"975\" data-end=\"978\" \/>\n<h2 data-start=\"980\" data-end=\"1004\">\u2705 <strong data-start=\"985\" data-end=\"1002\">Key Features:<\/strong><\/h2>\n<ul data-start=\"1005\" data-end=\"1234\">\n<li data-start=\"1005\" data-end=\"1059\">\n<p data-start=\"1007\" data-end=\"1059\">Material: Natural rattan base &amp; premium wood frame<\/p>\n<\/li>\n<li data-start=\"1060\" data-end=\"1100\">\n<p data-start=\"1062\" data-end=\"1100\">Handwoven, eco-friendly, and durable<\/p>\n<\/li>\n<li data-start=\"1101\" data-end=\"1142\">\n<p data-start=\"1103\" data-end=\"1142\">Comfortable side handles for easy use<\/p>\n<\/li>\n<li data-start=\"1143\" data-end=\"1189\">\n<p data-start=\"1145\" data-end=\"1189\">Suitable for serving or decorative display<\/p>\n<\/li>\n<li data-start=\"1190\" data-end=\"1234\">\n<p data-start=\"1192\" data-end=\"1234\">Available for OEM\/ODM &amp; private labeling<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1236\" data-end=\"1239\" \/>\n<h2 data-start=\"1241\" data-end=\"1279\">\ud83c\udf0d <strong data-start=\"1247\" data-end=\"1277\">Cultural &amp; Economic Value:<\/strong><\/h2>\n<p data-start=\"1280\" data-end=\"1681\">By choosing handcrafted trays from Vietnam, you&#8217;re supporting an industry that relies almost entirely on <strong data-start=\"1385\" data-end=\"1414\">locally sourced materials<\/strong> and <strong data-start=\"1419\" data-end=\"1434\">local labor<\/strong>. Our artisans, many of whom are farmers working in their free time, help preserve traditional skills while contributing to the export economy. Every tray is a part of Vietnam\u2019s cultural heritage, promoting sustainability and community livelihood.<\/p>\n<hr data-start=\"1683\" data-end=\"1686\" \/>\n<h2 data-start=\"1688\" data-end=\"1722\">\u2709\ufe0f <strong data-start=\"1694\" data-end=\"1720\">Contact for Wholesale:<\/strong><\/h2>\n<p data-start=\"1723\" data-end=\"1846\">\ud83d\udce7 Email: <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1733\" data-end=\"1756\">vietcraft2006@gmail.com<\/a><br data-start=\"1756\" data-end=\"1759\" \/>\ud83c\udf10 Website: <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1771\" data-end=\"1815\">www.vietcraft.vn<\/a><br data-start=\"1815\" data-end=\"1818\" \/>\ud83d\udcf1 WhatsApp: +84-975810168<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":826,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2