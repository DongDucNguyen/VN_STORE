-category\/product-type\/tableware-dining\/"}],"tags":[{"id":702,"name":"handmade charger Vietnam","slug":"handmade-charger-vietnam","link":"https:\/\/vietcraft.vn\/product-tag\/handmade-charger-vietnam\/"},{"id":703,"name":"luxury tableware manufacturer","slug":"luxury-tableware-manufacturer","link":"https:\/\/vietcraft.vn\/product-tag\/luxury-tableware-manufacturer\/"},{"id":706,"name":"MOP plate supplier","slug":"mop-plate-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/mop-plate-supplier\/"},{"id":701,"name":"MOP round plate","slug":"mop-round-plate","link":"https:\/\/vietcraft.vn\/product-tag\/mop-round-plate\/"},{"id":700,"name":"mother of pearl charger plate","slug":"mother-of-pearl-charger-plate","link":"https:\/\/vietcraft.vn\/product-tag\/mother-of-pearl-charger-plate\/"},{"id":704,"name":"shell inlay plate","slug":"shell-inlay-plate","link":"https:\/\/vietcraft.vn\/product-tag\/shell-inlay-plate\/"},{"id":620,"name":"Vietnam handicraft factory","slug":"vietnam-handicraft-factory","link":"https:\/\/vietcraft.vn\/product-tag\/vietnam-handicraft-factory\/"},{"id":705,"name":"wedding charger plate wholesale","slug":"wedding-charger-plate-wholesale","link":"https:\/\/vietcraft.vn\/product-tag\/wedding-charger-plate-wholesale\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Round Charger Plate Made of Mother of Pearl \u2013 from Vietnam Manufacturer&rdquo;","url":"https:\/\/vietcraft.vn\/product\/round-charger-plate-made-of-mother-of-pearl-from-vietnam-manufacturer\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protect