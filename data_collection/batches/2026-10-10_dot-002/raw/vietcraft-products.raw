roducts"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1083&per_page=10"}]}},{"id":1076,"name":"Round Rattan Basket Set from Vietnam","slug":"round-rattan-basket-set-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/round-rattan-basket-set-from-vietnam\/","sku":"VH24062","short_description":"<p>Handwoven <strong data-start=\"1219\" data-end=\"1246\">round rattan basket set<\/strong> from Vietnam, made with natural materials for sustainable living. Perfect for storage and home decoration.<\/p>","description":"<p data-start=\"159\" data-end=\"529\">Discover our <strong data-start=\"1573\" data-end=\"1613\">Round Rattan Basket Set from Vietnam<\/strong> \u2013 handmade, eco-friendly, and durable. Wholesale available directly from the manufacturer. Ideal for home storage &amp; d\u00e9cor.<\/p>\n<p data-start=\"159\" data-end=\"529\"><strong data-start=\"159\" data-end=\"182\">Product Description<\/strong><br data-start=\"182\" data-end=\"185\" \/>Our <strong data-start=\"189\" data-end=\"216\">Round Rattan Basket Set<\/strong> is handwoven by skilled Vietnamese artisans using 100% natural rattan. Each basket is lightweight yet sturdy, perfect for home storage, organizing, or as a decorative accent. The smooth, round design highlights the beauty of traditional Vietnamese craftsmanship while blending seamlessly into modern interiors.<\/p>\n<p data-start=\"531\" data-end=\"857\">Rattan is a sustainable and eco-friendly material, making this basket set not only practical but also environmentally responsible. By choosing these baskets, you support rural communities in Vietnam, where local farmers and artisans earn additional income during their free time, helping preserve traditional craft heritage.<\/p>\n<p data-start=\"859\" data-end=\"877\"><strong data-start=\"859\" data-end=\"875\">Key Features<\/strong><\/p>\n<ul data-start=\"878\" data-end=\"1183\">\n<li data-start=\"878\" data-end=\"943\">\n<p data-start=\"880\" data-end=\"943\">Material: 100% natural rattan, sustainably sourced in Vietnam<\/p>\n<\/li>\n<li data-start=\"944\" data-end=\"1004\">\n<p data-start=\"946\" data-end=\"1004\">Handmade with fine weaving for durability and aesthetics<\/p>\n<\/li>\n<li data-start=\"1005\" data-end=\"1055\">\n<p data-start=\"1007\" data-end=\"1055\">Nesting set design saves space when not in use<\/p>\n<\/li>\n<li data-start=\"1056\" data-end=\"1133\">\n<p data-start=\"1058\" data-end=\"1133\">Multi-functional: storage, laundry, planter covers, or decorative display<\/p>\n<\/li>\n<li data-start=\"1134\" data-end=\"1183\">\n<p data-start=\"1136\" data-end=\"1183\">Eco-friendly, biodegradable, and long-lasting<\/p>\n<\/li>\n<\/ul>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1082,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24062-round-rattan-basket-Vietnam.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24062-round-rattan-basket-Vietnam.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24062-round-rattan-basket-Vietnam.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24062-round-rattan-basket-Vietnam.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24062-round-rattan-basket-Vietnam.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/08\/VH24062-round-rattan-basket-Vietnam.jpg?resize=300%2C300&