/vietcraft.vn\/product\/bamboo-wall-lamp-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/847","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=847&per_page=10"}]}},{"id":836,"name":"High-Quality Woven Bamboo Basket from Vietnam","slug":"high-quality-woven-bamboo-basket-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/high-quality-woven-bamboo-basket-from-vietnam\/","sku":"","short_description":"<p>Handwoven bamboo basket from Vietnam. Durable, eco-friendly, and stylish\u2014ideal for home storage or decor. Wholesale and custom orders available.<\/p>","description":"<p data-start=\"272\" data-end=\"582\">Elevate your home decor and storage with this <strong data-start=\"318\" data-end=\"354\">high-quality woven bamboo basket<\/strong>, handcrafted by skilled artisans in Vietnam. Made from sustainably sourced bamboo, this basket combines strength, flexibility, and natural beauty\u2014perfect for storing laundry, toys, towels, or even as a decorative planter cover.<\/p>\n<p data-start=\"584\" data-end=\"895\">Each basket is carefully handwoven using traditional techniques passed down through generations. The natural bamboo fibers give it a warm, organic look that complements both modern and rustic interiors. Lightweight yet durable, this eco-friendly basket is a practical and stylish choice for conscious consumers.<\/p>\n<p data-start=\"897\" data-end=\"1040\">As a direct <strong data-start=\"909\" data-end=\"949\">manufacturer and supplier in Vietnam<\/strong>, we offer competitive wholesale prices and customization options for international buyers.<\/p>\n<hr data-start=\"1042\" data-end=\"1045\" \/>\n<h3 data-start=\"1047\" data-end=\"1072\">\u2705 <strong data-start=\"1053\" data-end=\"1070\">Key Features:<\/strong><\/h3>\n<ul data-start=\"1073\" data-end=\"1296\">\n<li data-start=\"1073\" data-end=\"1106\">\n<p data-start=\"1075\" data-end=\"1106\">Material: 100% natural bamboo<\/p>\n<\/li>\n<li data-start=\"1107\" data-end=\"1157\">\n<p data-start=\"1109\" data-end=\"1157\">Style: Handwoven with sturdy rim and structure<\/p>\n<\/li>\n<li data-start=\"1158\" data-end=\"1204\">\n<p data-start=\"1160\" data-end=\"1204\">Sizes: Customizable (small to extra-large)<\/p>\n<\/li>\n<li data-start=\"1205\" data-end=\"1247\">\n<p data-start=\"1207\" data-end=\"1247\">Use: Home storage, laundry, decoration<\/p>\n<\/li>\n<li data-start=\"1248\" data-end=\"1296\">\n<p data-start=\"1250\" data-end=\"1296\">Eco-friendly, biodegradable, and lightweight<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1298\" data-end=\"1301\" \/>\n<h3 data-start=\"1303\" data-end=\"1358\">\ud83c\udf3f <strong data-start=\"1310\" data-end=\"1356\">Cultural &amp; Economic Impact of Handicrafts:<\/strong><\/h3>\n<p data-start=\"1359\" data-end=\"1705\">By exporting bamboo baskets like this, Vietnam Handicraft Co., Ltd contributes to earning foreign currency for the country. Our products are made from almost 100% domestic materials and labor. These baskets provide employment for rural communities, especially farmers during non-harvest seasons, and preserve traditional Vietnamese craftsmanship.<\/p>\n<hr data-start=\"1707\" data-end=\"1710\" \/>\n<h3 data-start=\"1712\" data-end=\"1754\">\ud83d\udce6 <strong data-start=\"1719\" data-end=\"1752\">Contact for Wholesale Orders:<\/strong><\/h3>\n<p data-start=\"1755\" data-end=\"1894\">\ud83d\udce7 <strong data-start=\"1758\" data-end=\"1768\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1769\" data-end=\"1792\">vietcraft2006@gmail.com<\/a><br data-start=\"1792\" data-end=\"1795\" \/>\ud83d\udcf1 <strong data-start=\"1798\" data-end=\"1817\">Phone\/WhatsApp:<\/strong> +84-975810168<br data-start=\"1831\" data-end=\"1834\" \/>\ud83c\udf10 <strong data-start=\"1837\" data-end=\"1849\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1850\" data-end=\"1894\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":840,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH24090-woven-bamboo-basket","alt":""},{"id":842,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-basket-set.jpg?fit=1080%2C1080&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24090-woven-bamboo-