egory\/home-living\/tableware\/"},{"id":176,"name":"Tray","slug":"tray","link":"https:\/\/vietcraft.vn\/product-category\/product-type\/storage-containers\/tray\/"}],"tags":[{"id":712,"name":"handicraft tray manufacturer","slug":"handicraft-tray-manufacturer","link":"https:\/\/vietcraft.vn\/product-tag\/handicraft-tray-manufacturer\/"},{"id":75,"name":"handmade tray Vietnam","slug":"handmade-tray-vietnam","link":"https:\/\/vietcraft.vn\/product-tag\/handmade-tray-vietnam\/"},{"id":709,"name":"luxury decorative tray","slug":"luxury-decorative-tray","link":"https:\/\/vietcraft.vn\/product-tag\/luxury-decorative-tray\/"},{"id":708,"name":"MOP round tray","slug":"mop-round-tray","link":"https:\/\/vietcraft.vn\/product-tag\/mop-round-tray\/"},{"id":707,"name":"mother of pearl serving tray","slug":"mother-of-pearl-serving-tray","link":"https:\/\/vietcraft.vn\/product-tag\/mother-of-pearl-serving-tray\/"},{"id":710,"name":"shell inlay tray","slug":"shell-inlay-tray","link":"https:\/\/vietcraft.vn\/product-tag\/shell-inlay-tray\/"},{"id":711,"name":"Vietnam MOP tray supplier","slug":"vietnam-mop-tray-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/vietnam-mop-tray-supplier\/"},{"id":713,"name":"wholesale mother of pearl products","slug":"wholesale-mother-of-pearl-products","link":"https:\/\/vietcraft.vn\/product-tag\/wholesale-mother-of-pearl-products\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Round serving tray made of MOP in Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/round-serving-tray-made-of-mop-in-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/887","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=887&per_page=10"}]}},{"id":878,"name":"Round Charger Plate Made of Mother of Pearl \u2013 from Vietnam Manufacturer","slug":"round-charger-plate-made-of-mother-of-pearl-from-vietnam-manufacturer","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/round-charger-plate-made-of-mother-of-pearl-from-vietnam-manufacturer\/","sku":"VH24064","short_description":"<p>Elegant round charger plate made from natural Mother of Pearl (MOP) with hand-inlay detailing. Perfect for luxury dining and special occasions.<\/p>","description":"<p data-start=\"329\" data-end=\"601\">Add timeless elegance to your dining experience with this <strong data-start=\"387\" data-end=\"448\">round charger plate made of genuine Mother of Pearl (MOP)<\/strong>. Handcrafted in Vietnam by skilled artisans, this plate features delicate inlays of shimmering nacre that catch the light and elevate any table setting.<\/p>\n<p data-start=\"603\" data-end=\"791\">Perfect as a decorative <strong data-start=\"627\" data-end=\"641\">underplate<\/strong> for formal dining, weddings, or upscale hospitality services, the plate showcases the beauty of natural shell materials and Vietnamese craftsmanship.<\/p>\n<p data-start=\"793\" data-end=\"941\">This piece is not only a table accessory but also a work of art, combining <strong data-start=\"868\" data-end=\"905\">traditional hand-inlay techniques<\/strong> with a modern, luxurious aesthetic.<\/p>\n<hr data-start=\"943\" data-end=\"946\" \/>\n<h3 data-start=\"948\" data-end=\"973\">\u2705 <strong data-start=\"954\" data-end=\"971\">Key Features:<\/strong><\/h3>\n<ul data-start=\"974\" data-end=\"1230\">\n<li data-start=\"974\" data-end=\"1023\">\n<p data-start=\"976\" data-end=\"1023\">Material: Natural Mother of Pearl (MOP) inlay<\/p>\n<\/li>\n<li data-start=\"1024\" data-end=\"1040\">\n<p data-start=\"1026\" data-end=\"1040\">Shape: Round<\/p>\n<\/li>\n<li data-start=\"1041\" data-end=\"1101\">\n<p data-start=\"1043\" data-end=\"1101\">Diameter: Standard charger size (custom sizes available)<\/p>\n<\/li>\n<li data-start=\"1102\" data-end=\"1140\">\n<p data-start=\"1104\" data-end=\"1140\">Finish: Polished for elegant shine<\/p>\n<\/li>\n<li data-start=\"1141\" data-end=\"1206\">\n<p data-start=\"1143\" data-end=\"1206\">Usage: Decorative plate, underplate, event or wedding charger<\/p>\n<\/li>\n<li data-start=\"1207\" data-end=\"1230\">\n<p data-start=\"1209\" data-end=\"1230\">Handmade in Vietnam<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1232\" data-end=\"1235\" \/>\n<h3 data-start=\"1237\" data-end=\"1290\">\ud83c\udf3f <strong data-start=\"1244\" data-end=\"1288\">Cultural &amp; Economic Value of Handicrafts<\/strong><\/h3>\n<p data-start=\"1291\" data-end=\"1678\">By choosing handcrafted products like this MOP charger plate, you support Vietnam\u2019s <strong data-start=\"1375\" data-end=\"1404\">local artisan communities<\/strong>, <strong data-start=\"1406\" data-end=\"1433\">generate foreign income<\/strong>, and help preserve <strong data-start=\"1453\" data-end=\"1485\">traditional inlay techniques<\/strong>. Made entirely with <strong data-start=\"1506\" data-end=\"1538\">domestic materials and labor<\/strong>, these products also offer work opportunities for farmers during agricultural off-seasons, ensuring sustainability and cultural continuity.<\/p>\n<hr data-start=\"1680\" data-end=\"1683\" \/>\n<h3 data-start=\"1685\" data-end=\"1727\">\ud83d\udce6 <strong data-start=\"1692\" data-end=\"1725\">Contact for Wholesale Orders:<\/strong><\/h3>\n<p data-start=\"1728\" data-end=\"1867\">\ud83d\udce7 <strong data-start=\"1731\" data-end=\"1741\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1742\" data-end=\"1765\">vietcraft2006@gmail.com<\/a><br data-start=\"1765\" data-end=\"1768\" \/>\ud83d\udcf1 <strong data-start=\"1771\" data-end=\"1790\">Phone\/WhatsApp:<\/strong> +84-975810168<br data-start=\"1804\" data-end=\"1807\" \/>\ud83c\udf10 <strong data-start=\"1810\" data-end=\"1822\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1823\" data-end=\"1867\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":882,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24064-round-charger-plate-made-of-MOP.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24064-round-charger-plate-made-of-MOP.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24064-round-charger-plate-made-of-MOP.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24064-round-charger-plate-made-of-MOP.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24064-round-charger-plate-made-of-MOP.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24064-round-charger-plate-made-of-MOP.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24064-round-charger-plate-made-of-MOP.jpg?resize=100%2C100&ssl=1 100w","thumbnail_size