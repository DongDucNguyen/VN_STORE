lesale","slug":"rattan-bamboo-chandelier-wholesale","link":"https:\/\/vietcraft.vn\/product-tag\/rattan-bamboo-chandelier-wholesale\/"},{"id":1214,"name":"Supplier of hand-woven ceiling lamps for retailers","slug":"supplier-of-hand-woven-ceiling-lamps-for-retailers","link":"https:\/\/vietcraft.vn\/product-tag\/supplier-of-hand-woven-ceiling-lamps-for-retailers\/"},{"id":1207,"name":"Sustainable lighting supplier","slug":"sustainable-lighting-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/sustainable-lighting-supplier\/"},{"id":1213,"name":"Vietnam factory price bamboo lampshade","slug":"vietnam-factory-price-bamboo-lampshade","link":"https:\/\/vietcraft.vn\/product-tag\/vietnam-factory-price-bamboo-lampshade\/"},{"id":1200,"name":"Wholesale bamboo lampshade supplier","slug":"wholesale-bamboo-lampshade-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/wholesale-bamboo-lampshade-supplier\/"},{"id":1208,"name":"Wicker and bamboo lighting bulk","slug":"wicker-and-bamboo-lighting-bulk","link":"https:\/\/vietcraft.vn\/product-tag\/wicker-and-bamboo-lighting-bulk\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;WHOLESALE\u00a0Hand-Woven Bamboo Pendant Light\u00a0\u2013 Natural\u00a0Slats &#038; Bohemian\u00a0Supplier&rdquo;","url":"https:\/\/vietcraft.vn\/product\/wholesale-hand-woven-bamboo-pendant-light-natural-slats-bohemian-supplier\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1300","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1300&per_page=10"}]}},{"id":1295,"name":"WHOLESALE Woven Rattan Core Basket \u2013 Iron Frame &#038; Candle Lantern Supplier","slug":"wholesale-woven-rattan-core-basket-iron-frame-candle-lantern-supplier","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/wholesale-woven-rattan-core-basket-iron-frame-candle-lantern-supplier\/","sku":"VH24039","short_description":"","description":"<p><b>Premium Wholesale Rattan &amp; Iron Multi-Use Basket<\/b><\/p>\n<p>Partner with Vietnam Handicraft to source a highly versatile and structurally superior rattan basket designed for modern retail markets. This product uniquely combines the aesthetic of traditional, natural weaving with the durability of contemporary industrial design, making it a standout item for home d\u00e9cor, wellness, and organization categories.<\/p>\n<p>Our basket is constructed with a dual-material design: a hand-woven <b>rattan core<\/b>\u00a0exterior for texture and natural appeal, supported by a hidden, robust <b>iron frame<\/b>\u00a0for exceptional strength and shape retention.<\/p>\n<p><b>Dual-Functionality &amp; Commercial Appeal<\/b><\/p>\n<p>The inherent strength and unique design allow retailers to market this single item across multiple high-demand categories:<\/p>\n<p><b>High-Capacity Organization:<\/b>\u00a0The durable iron frame ensures the basket maintains its shape even when heavily loaded, making it ideal for cosmetics, toiletries, small books, craft supplies, and other compact items. Perfect for retail lines focused on bathroom or desk organization.<\/p>\n<p><b>Candle Lantern \/ Votive Holder:<\/b>\u00a0The open-weave rattan core and internal structure are perfectly suited for developing the product into a decorative lighting piece. When a candle or votive is placed inside (in a separate glass holder for safety), the basket casts a beautiful, textured ambient light.<\/p>\n<p><b>Production, Quality, and Ordering<\/b><\/p>\n<p>We guarantee consistent quality and efficient supply management for your bulk orders:<\/p>\n<ul>\n<li><b>Materials &amp; Build:<\/b>\u00a0Woven with natural rattan core (highly durable and smooth finish) over a powder-coated iron frame (rust-resistant). This combination ensures longevity and reduces transportation damage.<\/li>\n<li><b>Customization:<\/b>\u00a0We welcome inquiries for custom frame dimensions, specific weave patterns, and metal finishes. Private labeling and tailored packaging solutions are available for brand differentiation.<\/li>\n<li><b>Quality Control:<\/b>\u00a0Each batch is inspected for weaving consistency, frame integrity, and adherence to dimension specifications before shipment.<\/li>\n<li><b>Logistics:<\/b>\u00a0We provide efficient export and freight services, with product specifications optimized for pallet and container loading. <b>Please inquire for our latest MOQ and wholesale pricing catalog.<\/b><\/li>\n<\/ul>\n<p><b>Contact Us:<\/b> Discuss your wholesale needs and request a product sample by contacting us at vietcraft2006@gmail.com \u2013\u00a0 or call us at +84 975810168<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1298,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2026\/03\/VH24039-woven-storage-basket.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2026\/03\/VH24039-woven-storage-basket.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2026\/03\/VH