\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1257&per_page=10"}]}},{"id":1246,"name":"Seagrass Storage Basket \u2013 Sustainable Home Organization from Vietnam","slug":"seagrass-storage-basket-sustainable-home-organization-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/seagrass-storage-basket-sustainable-home-organization-from-vietnam\/","sku":"VH24042","short_description":"<p>Handwoven seagrass storage basket crafted by skilled Vietnamese artisans. Durable, lightweight, and eco-friendly \u2014 perfect for organizing living rooms, bathrooms, closets, and retail spaces. Available in multiple sizes with customizable designs, handles, and colors. Ideal for wholesalers, retailers, hotels, and home d\u00e9cor brands.<\/p>","description":"<p data-start=\"425\" data-end=\"789\">The <strong data-start=\"429\" data-end=\"456\">Seagrass Storage Basket<\/strong> is one of Vietcraft\u2019s best-selling natural home d\u00e9cor products, handcrafted by skilled artisans in the coastal regions of Vietnam. Made from 100% natural seagrass, each basket is tightly woven to create a strong, lightweight, and eco-friendly storage solution suitable for homes, resorts, retail stores, and interior d\u00e9cor projects.<\/p>\n<p data-start=\"791\" data-end=\"1142\">Seagrass is a durable natural fiber known for its warm, organic texture and pleasant natural scent. The baskets bring a simple yet elegant charm to any living space, making them perfect for both modern and rustic interior styles. With multiple sizes and shapes available, our seagrass storage baskets are ideal for organizing every corner of the home.<\/p>\n<hr data-start=\"1144\" data-end=\"1147\" \/>\n<h2 data-start=\"1149\" data-end=\"1168\"><strong data-start=\"1152\" data-end=\"1168\">Key Features<\/strong><\/h2>\n<ul data-start=\"1169\" data-end=\"1671\">\n<li data-start=\"1169\" data-end=\"1231\">\n<p data-start=\"1171\" data-end=\"1231\"><strong data-start=\"1171\" data-end=\"1206\">Handwoven from natural seagrass<\/strong> by Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"1232\" data-end=\"1284\">\n<p data-start=\"1234\" data-end=\"1284\"><strong data-start=\"1234\" data-end=\"1282\">Eco-friendly, sustainable, and biodegradable<\/strong><\/p>\n<\/li>\n<li data-start=\"1285\" data-end=\"1332\">\n<p data-start=\"1287\" data-end=\"1332\"><strong data-start=\"1287\" data-end=\"1313\">Strong yet lightweight<\/strong> for everyday use<\/p>\n<\/li>\n<li data-start=\"1333\" data-end=\"1388\">\n<p data-start=\"1335\" data-end=\"1388\"><strong data-start=\"1335\" data-end=\"1360\">Warm, natural texture<\/strong> adds beauty to home d\u00e9cor<\/p>\n<\/li>\n<li data-start=\"1389\" data-end=\"1458\">\n<p data-start=\"1391\" data-end=\"1458\"><strong data-start=\"1391\" data-end=\"1427\">Various shapes &amp; sizes available<\/strong> \u2013 round, square, rectangular<\/p>\n<\/li>\n<li data-start=\"1459\" data-end=\"1522\">\n<p data-start=\"1461\" data-end=\"1522\"><strong data-start=\"1461\" data-end=\"1520\">Optional cotton lining, lids, handles, labels, and tags<\/strong><\/p>\n<\/li>\n<li data-start=\"1523\" data-end=\"1609\">\n<p data-start=\"1525\" data-end=\"1609\"><strong data-start=\"1525\" data-end=\"1607\">Perfect for B2B wholesale, retail chains, interior brands, hotels, and resorts<\/strong><\/p>\n<\/li>\n<li data-start=\"1610\" data-end=\"1671\">\n<p data-start=\"1612\" data-end=\"1671\"><strong data-start=\"1612\" data-end=\"1628\">Customizable<\/strong>: size, color, weaving pattern, and packing<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1673\" data-end=\"1676\" \/>\n<h2 data-start=\"1678\" data-end=\"1697\"><strong data-start=\"1681\" data-end=\"1697\">Popular Uses<\/strong><\/h2>\n<ul data-start=\"1698\" data-end=\"1962\">\n<li data-start=\"1698\" data-end=\"1732\">\n<p data-start=\"1700\" data-end=\"1732\">Closet &amp; wardrobe organization<\/p>\n<\/li>\n<li data-start=\"1733\" data-end=\"1779\">\n<p data-start=\"1735\" data-end=\"1779\">Bathroom storage for towels and toiletries<\/p>\n<\/li>\n<li data-start=\"1780\" data-end=\"1799\">\n<p data-start=\"1782\" data-end=\"1799\">Laundry baskets<\/p>\n<\/li>\n<li data-start=\"1800\" data-end=\"1831\">\n<p data-start=\"1802\" data-end=\"1831\">Toy storage for kids\u2019 rooms<\/p>\n<\/li>\n<li data-start=\"1832\" data-end=\"1867\">\n<p data-start=\"1834\" data-end=\"1867\">Kitchen and pantry organization<\/p>\n<\/li>\n<li data-start=\"1868\" data-end=\"1889\">\n<p data-start=\"1870\" data-end=\"1889\">Living room d\u00e9cor<\/p>\n<\/li>\n<li data-start=\"1890\" data-end=\"1925\">\n<p data-start=\"1892\" data-end=\"1925\">Hotel &amp; resort room accessories<\/p>\n<\/li>\n<li data-start=\"1926\" data-end=\"1962\">\n<p data-start=\"1928\" data-end=\"1962\">Retail displays and gift packaging<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1964\" data-end=\"1967\" \/>\n<h2 data-start=\"1969\" data-end=\"2006\"><strong data-start=\"1972\" data-end=\"2006\">Available Sizes (Customizable)<\/strong><\/h2>\n<ul data-start=\"2007\" data-end=\"2132\">\n<li data-start=\"2007\" data-end=\"2026\">\n<p data-start=\"2009\" data-end=\"2026\">Small: 20\u201325 cm<\/p>\n<\/li>\n<li data-start=\"2027\" data-end=\"2047\">\n<p data-start=\"2029\" data-end=\"2047\">Medium: 30\u201335 cm<\/p>\n<\/li>\n<li data-start=\"2048\" data-end=\"2132\">\n<p data-start=\"2050\" data-end=\"2132\">Large: 40\u201350 cm<br data-start=\"2065\" data-end=\"2068\" \/>(Height and width adjustable according to customer requirements)<\/p>\n<\/li>\n<\/ul>\n<p data-start=\"2134\" data-end=\"2205\">We accept <strong data-start=\"2144\" data-end=\"2179\">OEM design and private labeling<\/strong> for international buyers.<\/p>\n<hr data-start=\"2207\" data-end=\"2210\" \/>\n<h2 data-start=\"2212\" data-end=\"2241\"><strong data-start=\"2215\" data-end=\"2241\">Production Information<\/strong><\/h2>\n<ul data-start=\"2242\" data-end=\"2526\">\n<li data-start=\"2242\" data-end=\"2277\">\n<p data-start=\"2244\" data-end=\"2277\">Material: 100% natural seagrass<\/p>\n<\/li>\n<li data-start=\"2278\" data-end=\"2336\">\n<p data-start=\"2280\" data-end=\"2336\">Handmade in: Thai Binh, Ninh Binh, Thanh H\u00f3a (Vietnam)<\/p>\n<\/li>\n<li data-start=\"2337\" data-end=\"2375\">\n<p data-start=\"2339\" data-end=\"2375\">MOQ: 200\u2013500 pcs depending on size<\/p>\n<\/li>\n<li data-start=\"2376\" data-end=\"2401\">\n<p data-start=\"2378\" data-end=\"2401\">Lead Time: 30\u201345 days<\/p>\n<\/li>\n<li data-start=\"2402\" data-end=\"2469\">\n<p data-start=\"2404\" data-end=\"2469\">Packing: Standard export carton, mail-order packaging available<\/p>\n<\/li>\n<li data-start=\"2470\" data-end=\"2526\">\n<p data-start=\"2472\" data-end=\"2526\">Quality: Export-standard for EU, US, and Japan markets<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"2528\" data-end=\"2531\" \/>\n<h2 data-start=\"2533\" data-end=\"2561\"><strong data-start=\"2536\" data-end=\"2561\">Why Choose Vietcraft?<\/strong><\/h2>\n<p data-start=\"2562\" data-end=\"2806\">Vietcraft is a leading exporter of handcrafted home d\u00e9cor made from natural and recycled materials such as seagrass, water hyacinth, rattan, bamboo, and more. With over 18 years of experience serving importers in Europe and America, we provide:<\/p>\n<ul data-start=\"2808\" data-end=\"2957\">\n<li data-start=\"2808\" data-end=\"2826\">\n<p data-start=\"2810\" data-end=\"2826\">Stable quality<\/p>\n<\/li>\n<li data-start=\"2827\" data-end=\"2860\">\n<p data-start=\"2829\" data-end=\"2860\">Competitive wholesale pricing<\/p>\n<\/li>\n<li data-start=\"2861\" data-end=\"2891\">\n<p data-start=\"2863\" data-end=\"2891\">Strong production capacity<\/p>\n<\/li>\n<li data-start=\"2892\" data-end=\"2915\">\n<p data-start=\"2894\" data-end=\"2915\">Reliable lead times<\/p>\n<\/li>\n<li data-start=\"2916\" data-end=\"2957\">\n<p data-start=\"2918\" data-end=\"2957\">Custom designs for brands &amp; retailers<\/p>\n<\/li>\n<\/ul>\n<p data-start=\"2959\" data-end=\"3107\">Our seagrass storage baskets combine traditional craftsmanship with modern design, offering a beautiful, sustainable solution for home organization.<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1250,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24042-seagrass-storage-basket.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24042-seagrass-storage-basket.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24042-seagrass-storage-basket.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24042-seagrass-storage-basket.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24042-seagrass-storage-basket.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24042-seagrass-storage-basket.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24042-seagrass-storage-basket.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH24042-seagrass-storage-basket","alt":""}],"categories":[{"id":173,"name":"Basket","slug":"basket","link":"https:\/\/vietcraft.vn\/product-category\/product-type\/storage-containers\/basket\/"},{"id":205,"name":"Gift &amp; Craft","slug":"gift-craft","link":"https:\/\/vietcraft.vn\/product-category\/home-living\/gift-craft\/"},{"id":202,"name":"Home Living","slug":"home-living","link":"https:\/\/vietcraft.vn\/product-category\/home-living\/"},{"id":70,"name":"Materials","slug":"materials","link":"https:\/\/vietcraft.vn\/product-category\/materials\/"},{"id":167,"name":"Product Type","slug":"product-type","link":"https:\/\/vietcraft.vn\/product-category\/product-type\/"},{"id":155,"name":"Seagrass","slug":"seagrass","link":"https:\/\/vietcraft.vn\/product-category\/materials\/seagrass\/"},{"id":168,"name":"Storage &amp; Containers","slug":"storage-containers","link":"https:\/\/vietcraft.vn\/product-category\/product-type\/storage-containers\/"}],"tags":[{"id":1144,"name":"natural seagrass basket wholesale","slug":"natural-seagrass-basket-wholesale","link":"https:\/\/vietcraft.vn\/product-tag\/natural-seagrass-basket-wholesale\/"},{"id":1145,"name":"seagrass basket","slug":"seagrass-basket","link":"https:\/\/vietcraft.vn\/product-tag\/seagrass-basket\/"},{"id":1146,"name":"seagrass basket factory","slug":"seagrass-basket-factory","link":"https:\/\/vietcraft.vn\/product-tag\/seagrass-basket-factory\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Seagrass Storage Basket \u2013 Sustainable Home Organization from Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/seagrass-storage-basket-sustainable-home-organization-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/1246","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1246&per_page=10"}]}},{"id":1241,"name":"Pendant Light from Woven Bamboo","slug":"pendant-light-from-woven-bamboo","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/pendant-light-from-woven-bamboo\/","sku":"VH24043","short_description":"<p>A handcrafted pendant light made from sustainably sourced bamboo. Each piece is woven by skilled Vietnamese artisans to create warm, natural lighting for homes, caf\u00e9s, hotels, and resorts. Lightweight, eco-friendly, and customizable for B2B orders.<\/p>","description":"<h2 data-start=\"394\" data-end=\"420\"><strong data-start=\"397\" data-end=\"420\">Product Description<\/strong><\/h2>\n<p data-start=\"421\" data-end=\"777\">The <strong data-start=\"425\" data-end=\"460\">Pendant Light from Woven Bamboo<\/strong> is a beautifully handcrafted lighting solution made by skilled Vietnamese artisans. Using sustainably harvested bamboo from Northern Vietnam, each lampshade is carefully woven by hand to create a warm, natural aesthetic suitable for modern interiors, eco-friendly home d\u00e9cor, caf\u00e9s, restaurants, hotels, and resorts.<\/p>\n<p data-start=\"779\" data-end=\"1083\">The natural bamboo pattern provides soft, diffused lighting that creates a cozy and inviting atmosphere. With its lightweight construction and timeless design, this pendant light is an excellent choice for importers, wholesalers, and interior designers looking for sustainable and unique d\u00e9cor solutions.<\/p>\n<hr data-start=\"1085\" data-end=\"1088\" \/>\n<h2 data-start=\"1090\" data-end=\"1109\"><strong data-start=\"1093\" data-end=\"1109\">Key Features<\/strong><\/h2>\n<ul data-start=\"1110\" data-end=\"1607\">\n<li data-start=\"1110\" data-end=\"1185\">\n<p data-start=\"1112\" data-end=\"1185\"><strong data-start=\"1112\" data-end=\"1148\">Handwoven by Vietnamese artisans<\/strong> using traditional craft techniques<\/p>\n<\/li>\n<li data-start=\"1186\" data-end=\"1235\">\n<p data-start=\"1188\" data-end=\"1235\"><strong data-start=\"1188\" data-end=\"1213\">Sustainable material:<\/strong> 100% natural bamboo<\/p>\n<\/li>\n<li data-start=\"1236\" data-end=\"1284\">\n<p data-start=\"1238\" data-end=\"1284\"><strong data-start=\"1238\" data-end=\"1263\">Lightweight &amp; durable<\/strong> frame construction<\/p>\n<\/li>\n<li data-start=\"1285\" data-end=\"1349\">\n<p data-start=\"1287\" data-end=\"1349\"><strong data-start=\"1287\" data-end=\"1310\">Eco-friendly finish<\/strong> with water-based coatings (optional)<\/p>\n<\/li>\n<li data-start=\"1350\" data-end=\"1401\">\n<p data-start=\"1352\" data-end=\"1401\"><strong data-start=\"1352\" data-end=\"1375\">Soft, warm lighting<\/strong> ideal for cozy ambiance<\/p>\n<\/li>\n<li data-start=\"1402\" data-end=\"1446\">\n<p data-start=\"1404\" data-end=\"1446\"><strong data-start=\"1404\" data-end=\"1444\">Compatible with E26\/E27 bulb holders<\/strong><\/p>\n<\/li>\n<li data-start=\"1447\" data-end=\"1520\">\n<p data-start=\"1449\" data-end=\"1520\"><strong data-start=\"1449\" data-end=\"1466\">Customizable:<\/strong> colors, sizes, shapes, and weave patterns available<\/p>\n<\/li>\n<li data-start=\"1521\" data-end=\"1607\">\n<p data-start=\"1523\" data-end=\"1607\"><strong data-start=\"1523\" data-end=\"1557\">Suitable for various interiors<\/strong> \u2014 home, caf\u00e9, restaurant, resort, hotel, showroom<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1609\" data-end=\"1612\" \/>\n<h2 data-start=\"1614\" data-end=\"1633\"><strong data-start=\"1617\" data-end=\"1633\">Applications<\/strong><\/h2>\n<ul data-start=\"1634\" data-end=\"1864\">\n<li data-start=\"1634\" data-end=\"1691\">\n<p data-start=\"1636\" data-end=\"1691\">Home d\u00e9cor (living room, dining room, kitchen island)<\/p>\n<\/li>\n<li data-start=\"1692\" data-end=\"1715\">\n<p data-start=\"1694\" data-end=\"1715\">Restaurants &amp; caf\u00e9s<\/p>\n<\/li>\n<li data-start=\"1716\" data-end=\"1751\">\n<p data-start=\"1718\" data-end=\"1751\">Eco-resorts, beach hotels, spas<\/p>\n<\/li>\n<li data-start=\"1752\" data-end=\"1792\">\n<p data-start=\"1754\" data-end=\"1792\">Retail stores &amp; decoration boutiques<\/p>\n<\/li>\n<li data-start=\"1793\" data-end=\"1837\">\n<p data-start=\"1795\" data-end=\"1837\">Interior design &amp; architectural projects<\/p>\n<\/li>\n<li data-start=\"1838\" data-end=\"1864\">\n<p data-start=\"1840\" data-end=\"1864\">Gift &amp; craft wholesalers<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1866\" data-end=\"1869\" \/>\n<h2 data-start=\"1871\" data-end=\"1915\"><strong data-start=\"1874\" data-end=\"1915\">Available Size Options (Customizable)<\/strong><\/h2>\n<ul data-start=\"1916\" data-end=\"2089\">\n<li data-start=\"1916\" data-end=\"1942\">\n<p data-start=\"1918\" data-end=\"1942\">Diameter: <strong data-start=\"1928\" data-end=\"1940\">20\u201360 cm<\/strong><\/p>\n<\/li>\n<li data-start=\"1943\" data-end=\"1967\">\n<p data-start=\"1945\" data-end=\"1967\">Height: <strong data-start=\"1953\" data-end=\"1965\">18\u201340 cm<\/strong><\/p>\n<\/li>\n<li data-start=\"1968\" data-end=\"2000\">\n<p data-start=\"1970\" data-end=\"2000\">Cable length: <strong data-start=\"1984\" data-end=\"1998\">Adjustable<\/strong><\/p>\n<\/li>\n<li data-start=\"2001\" data-end=\"2089\">\n<p data-start=\"2003\" data-end=\"2089\">Color: Natural, dark brown, smoke brown, whitewash, black (custom finishes on request)<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"2091\" data-end=\"2094\" \/>\n<h2 data-start=\"2096\" data-end=\"2121\"><strong data-start=\"2099\" data-end=\"2121\">Production Details<\/strong><\/h2>\n<ul data-start=\"2122\" data-end=\"2466\">\n<li data-start=\"2122\" data-end=\"2174\">\n<p data-start=\"2124\" data-end=\"2174\">Material: Natural bamboo (from Northern Vietnam)<\/p>\n<\/li>\n<li data-start=\"2175\" data-end=\"2197\">\n<p data-start=\"2177\" data-end=\"2197\">Weaving: Handwoven<\/p>\n<\/li>\n<li data-start=\"2198\" data-end=\"2240\">\n<p data-start=\"2200\" data-end=\"2240\">Finish: Natural, varnished, or painted<\/p>\n<\/li>\n<li data-start=\"2241\" data-end=\"2271\">\n<p data-start=\"2243\" data-end=\"2271\">MOQ: 50\u2013100 pcs per design<\/p>\n<\/li>\n<li data-start=\"2272\" data-end=\"2319\">\n<p data-start=\"2274\" data-end=\"2319\">Lead Time: 30\u201345 days depending on quantity<\/p>\n<\/li>\n<li data-start=\"2320\" data-end=\"2400\">\n<p data-start=\"2322\" data-end=\"2400\">Packaging: Individual carton or bulk packing; eco-friendly options available<\/p>\n<\/li>\n<li data-start=\"2401\" data-end=\"2466\">\n<p data-start=\"2403\" data-end=\"2466\">Export Standards: Strong packaging suitable for EU &amp; US markets<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"2468\" data-end=\"2471\" \/>\n<h2 data-start=\"2473\" data-end=\"2501\"><strong data-start=\"2476\" data-end=\"2501\">Why Choose Vietnam Handicraft?<\/strong><\/h2>\n<p data-start=\"2502\" data-end=\"2792\">Vietnam Handicraft is a leading manufacturer and exporter of handcrafted home d\u00e9cor from natural and recycled materials. With over 18 years of experience exporting to Europe and the US, we ensure consistent quality, competitive pricing, and strong production capacity for long-term B2B partnerships.<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1245,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24043-pendant-light-from-woven-bamboo.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24043-pendant-light-from-woven-bamboo.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/11\/VH24043-pe