ata-end=\"1139\">\n<p data-start=\"1098\" data-end=\"1139\">Handmade by skilled Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"1140\" data-end=\"1201\">\n<p data-start=\"1142\" data-end=\"1201\">Unique dolphin shape \u2013 ideal for beach and coastal themes<\/p>\n<\/li>\n<li data-start=\"1202\" data-end=\"1244\">\n<p data-start=\"1204\" data-end=\"1244\">Lightweight, durable, and eco-friendly<\/p>\n<\/li>\n<li data-start=\"1245\" data-end=\"1297\">\n<p data-start=\"1247\" data-end=\"1297\">Suitable for home decor, resorts, and gift shops<\/p>\n<\/li>\n<li data-start=\"1298\" data-end=\"1354\">\n<p data-start=\"1300\" data-end=\"1354\">OEM &amp; ODM orders accepted \u2013 direct from manufacturer<\/p>\n<\/li>\n<li data-start=\"1355\" data-end=\"1407\">\n<p data-start=\"1357\" data-end=\"1407\">Factory, supplier, and exporter based in Vietnam<\/p>\n<\/li>\n<\/ul>\n<p data-start=\"1409\" data-end=\"1685\"><strong data-start=\"1409\" data-end=\"1434\">Contact for Wholesale<\/strong><br data-start=\"1434\" data-end=\"1437\" \/>We are a trusted <strong data-start=\"1454\" data-end=\"1512\">rattan handicraft manufacturer and exporter in Vietnam<\/strong>, supplying high-quality woven decor worldwide.<br data-start=\"1559\" data-end=\"1562\" \/>\ud83d\udce7 Email: <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1572\" data-end=\"1595\">vietcraft2006@gmail.com<\/a><br data-start=\"1595\" data-end=\"1598\" \/>\ud83d\udcf1 WhatsApp: +84-975810168<br data-start=\"1624\" data-end=\"1627\" \/>\ud83c\udf10 Website: <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1639\" data-end=\"1683\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_ra