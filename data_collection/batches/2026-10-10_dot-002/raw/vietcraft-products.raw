\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=1205&per_page=10"}]}},{"id":1195,"name":"MOP Rattan Tray \u2013 Round Shape, Handmade in Vietnam","slug":"mop-rattan-tray-round-shape-handmade-in-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/mop-rattan-tray-round-shape-handmade-in-vietnam\/","sku":"VH24049","short_description":"<p>Discover the elegance of our <strong data-start=\"1804\" data-end=\"1829\">round MOP rattan tray<\/strong>, handmade in Vietnam from natural rattan and Mother of Pearl. Perfect for serving or decoration. Sustainable, stylish, and crafted by skilled artisans.<\/p>","description":"<p data-start=\"256\" data-end=\"523\">This <strong data-start=\"261\" data-end=\"280\">MOP Rattan Tray<\/strong> is a beautiful combination of natural rattan weaving and <strong data-start=\"338\" data-end=\"369\">Mother of Pearl (MOP) inlay<\/strong>, handcrafted by skilled Vietnamese artisans. The tray features a <strong data-start=\"435\" data-end=\"450\">round shape<\/strong>, offering both elegance and durability for home serving or decoration.<\/p>\n<p data-start=\"525\" data-end=\"742\">Each piece is <strong data-start=\"539\" data-end=\"584\">handwoven from sustainably sourced rattan<\/strong> and meticulously <strong data-start=\"602\" data-end=\"645\">decorated with polished seashell inlays<\/strong>, reflecting a natural shimmer that enhances any interior style \u2014 from coastal to contemporary.<\/p>\n<p data-start=\"744\" data-end=\"912\">Made in traditional Vietnamese craft villages, this tray is not only a practical serving piece but also a work of art that showcases Vietnam\u2019s rich cultural heritage.<\/p>\n<p data-start=\"914\" data-end=\"1065\">By purchasing our handcrafted trays, you support rural artisans and contribute to sustainable livelihoods while preserving traditional craftsmanship.<\/p>\n<hr data-start=\"1067\" data-end=\"1070\" \/>\n<h3 data-start=\"1072\" data-end=\"1095\"><strong data-start=\"1076\" data-end=\"1093\">Key Features:<\/strong><\/h3>\n<ul data-start=\"1096\" data-end=\"1346\">\n<li data-start=\"1096\" data-end=\"1150\">\n<p data-start=\"1098\" data-end=\"1150\">Material: Natural rattan and Mother of Pearl inlay<\/p>\n<\/li>\n<li data-start=\"1151\" data-end=\"1167\">\n<p data-start=\"1153\" data-end=\"1167\">Shape: Round<\/p>\n<\/li>\n<li data-start=\"1168\" data-end=\"1204\">\n<p data-start=\"1170\" data-end=\"1204\">Finish: Polished, smooth surface<\/p>\n<\/li>\n<li data-start=\"1205\" data-end=\"1245\">\n<p data-start=\"1207\" data-end=\"1245\">Handwoven and handcrafted in Vietnam<\/p>\n<\/li>\n<li data-start=\"1246\" data-end=\"1289\">\n<p data-start=\"1248\" data-end=\"1289\">Eco-friendly and sustainable production<\/p>\n<\/li>\n<li data-start=\"1290\" data-end=\"1346\">\n<p data-start=\"1292\" data-end=\"1346\">Ideal for serving, home decor, hotels, or gift shops<\/p>\n<\/li>\n<\/ul>\n<p>&nbsp;<\/p>\n<hr data-start=\"2131\" data-end=\"2134\" \/>\n<h3 data-start=\"2136\" data-end=\"2190\"><strong data-start=\"2140\" data-end=\"2188\">Additional Section (for your product posts):<\/strong><\/h3>\n<p data-start=\"2191\" data-end=\"2520\"><strong data-start=\"2191\" data-end=\"2230\">Supplier &amp; Manufacturer in Vietnam:<\/strong><br data-start=\"2230\" data-end=\"2233\" \/>We provide high-quality handmade rattan and Mother of Pearl trays from Vietnam, offering bulk and wholesale options for retailers, decorators, and hospitality projects.<br data-start=\"2401\" data-end=\"2404\" \/>For inquiries, please contact us at <strong data-start=\"2440\" data-end=\"2467\"><a class=\"decorated-link cursor-pointer\" rel=\"noopener\" data-start=\"2442\" data-end=\"2465\">vietcraft2006@gmail.com<\/a><\/strong> or visit <a class=\"decorated-link cursor-pointer\" target=\"_new\" rel=\"noopener\" data-start=\"2477\" data-end=\"2517\">www.vietcraft.vn<\/a>.<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":1202,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH24049-MOP-rattan-tray","alt":""},{"id":1204,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray-set.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray-set.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray-set.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/10\/VH24049-MOP-rattan-tray-set.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"ht