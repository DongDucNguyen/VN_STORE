n\/wp-json\/wc\/store\/v1\/products\/760","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=760&per_page=10"}]}},{"id":753,"name":"Candle Holder Bamboo Basket \u2013 Handwoven Natural Lantern from Vietnam","slug":"candle-holder-bamboo-basket-handwoven-natural-lantern-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/candle-holder-bamboo-basket-handwoven-natural-lantern-from-vietnam\/","sku":"","short_description":"<p>Handwoven bamboo basket candle holder with glass insert \u2013 eco-friendly and elegant lighting d\u00e9cor made in Vietnam for wholesale buyers.<\/p>","description":"<p data-start=\"310\" data-end=\"596\">This <strong data-start=\"315\" data-end=\"346\">candle holder bamboo basket<\/strong> is a beautifully handwoven lantern made from 100% natural bamboo by skilled Vietnamese artisans. Designed to hold tea lights or small candles, it emits a soft, warm glow through its intricate weaving pattern\u2014adding a cozy, rustic charm to any space.<\/p>\n<p data-start=\"598\" data-end=\"831\">Perfect for indoor or outdoor use, it serves as an elegant home d\u00e9cor piece for living rooms, patios, restaurants, hotels, spas, and event decorations. The inner glass holder ensures safe use while maintaining the handmade aesthetic.<\/p>\n<p data-start=\"833\" data-end=\"992\">At <strong data-start=\"836\" data-end=\"867\">Vietnam Handicraft Co., Ltd<\/strong>, we provide OEM\/ODM options, customization in size, shape, and color, and <strong data-start=\"942\" data-end=\"967\">bulk wholesale supply<\/strong> to international buyers.<\/p>\n<hr data-start=\"994\" data-end=\"997\" \/>\n<h2 data-start=\"999\" data-end=\"1021\">\u2705 <strong data-start=\"1004\" data-end=\"1021\">Key Features:<\/strong><\/h2>\n<ul data-start=\"1022\" data-end=\"1335\">\n<li data-start=\"1022\" data-end=\"1059\">\n<p data-start=\"1024\" data-end=\"1059\">Handwoven from sustainable bamboo<\/p>\n<\/li>\n<li data-start=\"1060\" data-end=\"1109\">\n<p data-start=\"1062\" data-end=\"1109\">Includes inner glass holder for candle safety<\/p>\n<\/li>\n<li data-start=\"1110\" data-end=\"1173\">\n<p data-start=\"1112\" data-end=\"1173\">Emits warm ambient light \u2013 perfect for relaxation and decor<\/p>\n<\/li>\n<li data-start=\"1174\" data-end=\"1218\">\n<p data-start=\"1176\" data-end=\"1218\">Available in multiple sizes and finishes<\/p>\n<\/li>\n<li data-start=\"1219\" data-end=\"1274\">\n<p data-start=\"1221\" data-end=\"1274\">Suitable for home, hospitality, or event decoration<\/p>\n<\/li>\n<li data-start=\"1275\" data-end=\"1335\">\n<p data-start=\"1277\" data-end=\"1335\">Eco-friendly, biodegradable, and ethically made in Vietnam<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1337\" data-end=\"1340\" \/>\n<h2 data-start=\"1342\" data-end=\"1369\">\ud83c\udf3f <strong data-start=\"1348\" data-end=\"1367\">Why It Matters:<\/strong><\/h2>\n<p data-start=\"1370\" data-end=\"1424\">This bamboo candle holder represents more than beauty:<\/p>\n<ul data-start=\"1426\" data-end=\"1709\">\n<li data-start=\"1426\" data-end=\"1488\">\n<p data-start=\"1428\" data-end=\"1488\"><strong data-start=\"1428\" data-end=\"1468\">Supports Vietnam\u2019s rural communities<\/strong> with extra income<\/p>\n<\/li>\n<li data-start=\"1489\" data-end=\"1542\">\n<p data-start=\"1491\" data-end=\"1542\"><strong data-start=\"1491\" data-end=\"1540\">Uses 100% locally sourced materials and labor<\/strong><\/p>\n<\/li>\n<li data-start=\"1543\" data-end=\"1607\">\n<p data-start=\"1545\" data-end=\"1607\"><strong data-start=\"1545\" data-end=\"1571\">Generates export value<\/strong> for Vietnam\u2019s handicraft industry<\/p>\n<\/li>\n<li data-start=\"1608\" data-end=\"1659\">\n<p data-start=\"1610\" data-end=\"1659\"><strong data-start=\"1610\" data-end=\"1657\">Preserves traditional bamboo weaving skills<\/strong><\/p>\n<\/li>\n<li data-start=\"1660\" data-end=\"1709\">\n<p data-start=\"1662\" data-end=\"1709\">Promotes <strong data-start=\"1671\" data-end=\"1709\">eco-conscious, plastic-free living<\/strong><\/p>\n<\/li>\n<\/ul>\n<p data-start=\"1711\" data-end=\"1844\">As a certified <strong data-start=\"1726\" data-end=\"1782\">manufacturer, factory, and global wholesale exporter<\/strong>, Vietnam Handicraft Co., Ltd ensures both quality and impact.<\/p>\n<hr data-start=\"1846\" data-end=\"1849\" \/>\n<h2 data-start=\"1851\" data-end=\"1885\">\u2709\ufe0f <strong data-start=\"1857\" data-end=\"1883\">Contact for Wholesale:<\/strong><\/h2>\n<p data-start=\"1886\" data-end=\"1977\">\ud83d\udce7 Email: <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1896\" data-end=\"1919\">vietcraft2006@gmail.com<\/a><br data-start=\"1919\" data-end=\"1922\" \/>\ud83c\udf10 Website: <a class=\"\" href=\"http:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1934\" data-end=\"1977\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":757,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24104-candle-holder-bamboo-basket.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24104-candle-holder-bamboo-basket.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24104-candle-holder-bamboo-basket.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH24104-candle-holder-bamboo-basket.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 5