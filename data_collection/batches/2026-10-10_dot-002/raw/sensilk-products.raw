ilk ch\u1ecbu 100% chi ph\u00ed v\u1eadn chuy\u1ec3n tr\u1ea3 l\u1ea1i h\u00e0ng cho s\u1ea3n ph\u1ea9m l\u1ed7i do nh\u00e0 s\u1ea3n xu\u1ea5t.\n\u2013 \u0110\u1ed5i h\u00e0ng trong v\u00f2ng 02 ng\u00e0y k\u1ec3 t\u1eeb ng\u00e0y kh\u00e1ch h\u00e0ng nh\u1eadn \u0111\u01b0\u1ee3c s\u1ea3n ph\u1ea9m\n\u2013 S\u1ea3n ph\u1ea9m c\u00f2n trong t\u00ecnh tr\u1ea1ng ban \u0111\u1ea7u khi nh\u1eadn h\u00e0ng, c\u00f2n nguy\u00ean tem v\u00e0 nh\u00e3n m\u00e1c.","slug":"\u2013 SenSilk ch\u1ecbu 100% chi ph\u00ed v\u1eadn chuy\u1ec3n tr\u1ea3 l\u1ea1i h\u00e0ng cho s\u1ea3n ph\u1ea9m l\u1ed7i do nh\u00e0 s\u1ea3n xu\u1ea5t.\n\u2013 \u0110\u1ed5i h\u00e0ng trong v\u00f2ng 02 ng\u00e0y k\u1ec3 t\u1eeb ng\u00e0y kh\u00e1ch h\u00e0ng nh\u1eadn \u0111\u01b0\u1ee3c s\u1ea3n ph\u1ea9m\n\u2013 S\u1ea3n ph\u1ea9m c\u00f2n trong t\u00ecnh tr\u1ea1ng ban \u0111\u1ea7u khi nh\u1eadn h\u00e0ng, c\u00f2n nguy\u00ean tem v\u00e0 nh\u00e3n m\u00e1c."}]},{"id":0,"name":"M\u00e0u kh\u0103n n\u1ec1n","taxonomy":null,"has_variations":false,"terms":[{"id":0,"name":"Nude, Tr\u1eafng, Xanh, H\u1ed3ng","slug":"Nude, Tr\u1eafng, Xanh, H\u1ed3ng"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"C\u00f2n 23 trong kho","class":"in-stock"},"sold_individually":false,"weight":"400","dimensions":{"length":"30","width":"16","height":"6"},"formatted_weight":"400 g","formatted_dimensions":"30 \u00d7 16 \u00d7 6 cm","add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng: &ldquo;Kh\u0103n L\u1ee5a V\u1ebd Tay Ngh\u1ec7 Thu\u1eadt Hoa Sen \u2013 BEST SELLER | SenSilk&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?per_page=100&#038;page=1&#038;add-to-cart=14609","single_text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/sensilk.vn\/wp-json\/wc\/store\/v1\/products\/14609","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/sensilk.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/sensilk.vn\/wp-json\/wc\/store\/v1\/products?related=14609&per_page=10"}]}},{"id":14576,"name":"Kh\u0103n L\u1ee5a Cao C\u1ea5p SenSilk V\u1ebd Tay Hoa Sen &#8211; Qu\u1ed1c Hoa Vi\u1ec7t Nam","slug":"khan-lua-sensilk-ve-tay-hoa-sen-quoc-hoa-viet-nam-handmade-gift","parent":0,"type":"simple","variation":"","permalink":"https:\/\/sensilk.vn\/product\/khan-lua-sensilk-ve-tay-hoa-sen-quoc-hoa-viet-nam-handmade-gift\/","sku":"KLVTLIMITED HONG HOASEN","short_description":"<p data-start=\"63\" data-end=\"365\">Kh\u0103n L\u1ee5a Cao C\u1ea5p SenSilk V\u1ebd Tay Hoa Sen l\u00e0 m\u1ed9t t\u00e1c ph\u1ea9m thu\u1ed9c d\u00f2ng Kh\u0103n L\u1ee5a V\u1ebd Tay Ngh\u1ec7 Thu\u1eadt \u2013 Limited, l\u1ea5y h\u00ecnh \u1ea3nh hoa sen l\u00e0m c\u1ea3m h\u1ee9ng ch\u1ee7 \u0111\u1ea1o. Tr\u00ean n\u1ec1n l\u1ee5a t\u01a1 t\u1eb1m m\u1ec1m m\u1ea1i, t\u1eebng \u0111\u00f3a sen \u0111\u01b0\u1ee3c th\u1ec3 hi\u1ec7n b\u1eb1ng n\u00e9t v\u1ebd th\u1ee7 c\u00f4ng, t\u1ea1o n\u00ean v\u1ebb \u0111\u1eb9p thanh tao, gi\u00e0u t\u00ednh h\u1ed9i h\u1ecda v\u00e0 mang d\u1ea5u \u1ea5n v\u0103n h\u00f3a Vi\u1ec7t Nam.<\/p>\n<p data-start=\"367\" data-end=\"680\">L\u1ea5y c\u1ea3m h\u1ee9ng t\u1eeb hoa sen \u2013 h\u00ecnh \u1ea3nh g\u1eafn li\u1ec1n v\u1edbi v\u1ebb \u0111\u1eb9p thanh khi\u1ebft v\u00e0 t\u00e2m h\u1ed3n Vi\u1ec7t \u2013 thi\u1ebft k\u1ebf k\u1ebft h\u1ee3p gi\u1eefa ngh\u1ec7 thu\u1eadt th\u1ee7 c\u00f4ng truy\u1ec1n th\u1ed1ng v\u00e0 tinh th\u1ea7n Art Luxury \u0111\u01b0\u01a1ng \u0111\u1ea1i. S\u1eafc h\u1ed3ng c\u1ee7a hoa sen t\u1ea1o \u0111i\u1ec3m nh\u1ea5n n\u1eef t\u00ednh, trong khi n\u1ec1n l\u1ee5a nh\u1eb9 nh\u00e0ng gi\u00fap t\u1ed5ng th\u1ec3 gi\u1eef \u0111\u01b0\u1ee3c s\u1ef1 sang tr\u1ecdng, tinh t\u1ebf v\u00e0 kh\u00f4ng ph\u00f4 tr\u01b0\u01a1ng.<\/p>\n<h2 data-section-id=\"txs4j9\" data-start=\"682\" data-end=\"703\">Th\u00f4ng tin s\u1ea3n ph\u1ea9m<\/h2>\n<p data-start=\"705\" data-end=\"1786\">. <strong data-start=\"707\" data-end=\"724\">T\u00ean s\u1ea3n ph\u1ea9m:<\/strong> KLVTLIMITED HONG HOASEN<br data-start=\"748\" data-end=\"751\" \/>. <strong data-start=\"753\" data-end=\"822\">T\u00ean v\u00e0 \u0111\u1ecba ch\u1ec9 c\u1ee7a t\u1ed5 ch\u1ee9c, c\u00e1 nh\u00e2n ch\u1ecbu tr\u00e1ch nhi\u1ec7m v\u1ec1 h\u00e0ng h\u00f3a:<\/strong> C\u00d4NG TY C\u1ed4 PH\u1ea6N SEN SILK VI\u1ec6T NAM<br data-start=\"856\" data-end=\"859\" \/>. <strong data-start=\"861\" data-end=\"873\">Xu\u1ea5t x\u1ee9:<\/strong> Vi\u1ec7t Nam<br data-start=\"882\" data-end=\"885\" \/>. <strong data-start=\"887\" data-end=\"905\">D\u00f2ng s\u1ea3n ph\u1ea9m:<\/strong> Kh\u0103n L\u1ee5a V\u1ebd Tay Ngh\u1ec7 Thu\u1eadt \u2013 Limited<br data-start=\"942\" data-end=\"945\" \/>. <strong data-start=\"947\" data-end=\"962\">K\u00edch th\u01b0\u1edbc:<\/strong> 180 \u00d7 55 cm<br data-start=\"974\" data-end=\"977\" \/>. <strong data-start=\"979\" data-end=\"993\">Ch\u1ea5t li\u1ec7u:<\/strong> 100% l\u1ee5a t\u01a1 t\u1eb1m<br data-start=\"1009\" data-end=\"1012\" \/>. <strong data-start=\"1014\" data-end=\"1027\">H\u1ecda ti\u1ebft:<\/strong> Hoa sen<br data-start=\"1035\" data-end=\"1038\" \/>. <strong data-start=\"1040\" data-end=\"1053\">K\u1ef9 thu\u1eadt:<\/strong> V\u1ebd tay th\u1ee7 c\u00f4ng tr\u00ean n\u1ec1n l\u1ee5a t\u01a1 t\u1eb1m<br data-start=\"1089\" data-end=\"1092\" \/>. <strong data-start=\"1094\" data-end=\"1119\">Nguy\u00ean li\u1ec7u nhu\u1ed9m v\u1ebd:<\/strong> M\u00e0u n\u01b0\u1edbc chuy\u00ean d\u1ee5ng cho v\u1ea3i, m\u00e0u m\u1ec1m m\u1ecbn, gi\u1eb7t kh\u00f4ng phai<br data-start=\"1178\" data-end=\"1181\" \/>. <strong data-start=\"1183\" data-end=\"1195\">M\u00e0u s\u1eafc:<\/strong> H\u1ed3ng thanh nh\u00e3 k\u1ebft h\u1ee3p s\u1eafc sen v\u00e0 c\u00e1c gam m\u00e0u t\u1ef1 nhi\u00ean<br data-start=\"1250\" data-end=\"1253\" \/>. <strong data-start=\"1255\" data-end=\"1270\">Phong c\u00e1ch:<\/strong> Art Luxury, thanh l\u1ecbch v\u00e0 tinh t\u1ebf; ph\u00f9 h\u1ee3p v\u1edbi \u00e1o d\u00e0i, trang ph\u1ee5c c\u00f4ng s\u1edf, \u0111\u1ea7m v\u00e0 phong c\u00e1ch Quiet Luxury.<br data-start=\"1377\" data-end=\"1380\" \/>. <strong data-start=\"1382\" data-end=\"1395\">\u1ee8ng d\u1ee5ng:<\/strong> Qu\u00e0ng c\u1ed5, cho\u00e0ng vai, ph\u1ed1i c\u00f9ng \u00e1o d\u00e0i ho\u1eb7c th\u1eaft tr\u00ean quai t\u00fai; ph\u00f9 h\u1ee3p s\u1eed d\u1ee5ng h\u1eb1ng ng\u00e0y v\u00e0 trong nh\u1eefng d\u1ecbp \u0111\u1eb7c bi\u1ec7t.<br data-start=\"1514\" data-end=\"1517\" \/>. <strong data-start=\"1519\" data-end=\"1532\">Qu\u00e0 t\u1eb7ng:<\/strong> Ph\u00f9 h\u1ee3p d\u00e0nh t\u1eb7ng m\u1eb9, v\u1ee3, ng\u01b0\u1eddi th\u00e2n, \u0111\u1ed1i t\u00e1c, kh\u00e1ch h\u00e0ng ho\u1eb7c nh\u1eefng ng\u01b0\u1eddi ph\u1ee5 n\u1eef \u0111\u1eb7c bi\u1ec7t; th\u00edch h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng Vi\u1ec7t Nam, qu\u00e0 tri \u00e2n v\u00e0 qu\u00e0 t\u1eb7ng doanh nghi\u1ec7p cao c\u1ea5p.<br data-start=\"1702\" data-end=\"1705\" \/>. <strong data-start=\"1707\" data-end=\"1720\">\u0110\u00f3ng g\u00f3i:<\/strong> H\u1ed9p \u0111\u1ef1ng cao c\u1ea5p, t\u00fai v\u00e0 thi\u1ec7p SenSilk<br data-start=\"1759\" data-end=\"1762\" \/>. <strong data-start=\"1764\" data-end=\"1781\">N\u0103m s\u1ea3n xu\u1ea5t:<\/strong> 2026<\/p>","description":"<h2 class=\"PDq2pG_selectionAnchorContainer\" data-section-id=\"4mqifb\" data-start=\"1788\" data-end=\"1840\">Hoa Sen \u2013 Qu\u1ed1c hoa trong c\u1ea3m h\u1ee9ng ngh\u1ec7 thu\u1eadt Vi\u1ec7t<\/h2>\n<p data-start=\"1842\" data-end=\"2007\">Hoa sen t\u1eeb l\u00e2u \u0111\u00e3 tr\u1edf th\u00e0nh m\u1ed9t h\u00ecnh \u1ea3nh quen thu\u1ed9c trong \u0111\u1eddi s\u1ed1ng v\u0103n h\u00f3a v\u00e0 ngh\u1ec7 thu\u1eadt Vi\u1ec7t Nam. V\u1ebb \u0111\u1eb9p c\u1ee7a sen g\u1eafn v\u1edbi s\u1ef1 thanh khi\u1ebft, gi\u1ea3n d\u1ecb v\u00e0 s\u1ee9c s\u1ed1ng b\u1ec1n b\u1ec9.<\/p>\n<p data-start=\"2009\" data-end=\"2197\">Tr\u00ean n\u1ec1n l\u1ee5a SenSilk, h\u00ecnh \u1ea3nh hoa sen \u0111\u01b0\u1ee3c chuy\u1ec3n th\u1ec3 b\u1eb1ng ng\u00f4n ng\u1eef h\u1ed9i h\u1ecda m\u1ec1m m\u1ea1i. Nh\u1eefng c\u00e1nh sen \u0111\u01b0\u1ee3c th\u1ec3 hi\u1ec7n v\u1edbi \u0111\u01b0\u1eddng n\u00e9t uy\u1ec3n chuy\u1ec3n, t\u1ea1o c\u1ea3m gi\u00e1c nh\u1eb9 nh\u00e0ng nh\u01b0ng v\u1eabn c\u00f3 chi\u1ec1u s\u00e2u.<\/p>\n<p data-start=\"2199\" data-end=\"2350\">S\u1eafc h\u1ed3ng c\u1ee7a hoa mang \u0111\u1ebfn v\u1ebb n\u1eef t\u00ednh v\u00e0 trang nh\u00e3, gi\u00fap h\u00ecnh \u1ea3nh sen tr\u1edf n\u00ean g\u1ea7n g\u0169i v\u1edbi th\u1eddi trang \u0111\u01b0\u01a1ng \u0111\u1ea1i m\u00e0 v\u1eabn gi\u1eef \u0111\u01b0\u1ee3c tinh th\u1ea7n v\u0103n h\u00f3a v\u1ed1n c\u00f3.<\/p>\n<p data-start=\"2352\" data-end=\"2479\">Chi\u1ebfc kh\u0103n v\u00ec th\u1ebf kh\u00f4ng ch\u1ec9 l\u00e0 m\u1ed9t ph\u1ee5 ki\u1ec7n th\u1eddi trang m\u00e0 c\u00f2n l\u00e0 m\u1ed9t c\u00e1ch mang h\u00ecnh \u1ea3nh Vi\u1ec7t Nam v\u00e0o \u0111\u1eddi s\u1ed1ng m\u1ed9t c\u00e1ch tinh t\u1ebf.<\/p>\n<p><a href=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/SenSilk-9-scaled.jpg\"><img class=\"alignnone wp-image-7678\" src=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/SenSilk-9-1024x877.jpg\" alt=\"\" width=\"303\" height=\"259\" \/><\/a><\/p>\n<h2 class=\"PDq2pG_selectionAnchorContainer\" data-section-id=\"1segeki\" data-start=\"2481\" data-end=\"2521\">Ngh\u1ec7 thu\u1eadt v\u1ebd tay tr\u00ean n\u1ec1n l\u1ee5a t\u01a1 t\u1eb1m<\/h2>\n<p data-start=\"2523\" data-end=\"2700\">V\u1ebd tay tr\u00ean l\u1ee5a \u0111\u00f2i h\u1ecfi s\u1ef1 ki\u1ec3m so\u00e1t tinh t\u1ebf v\u1ec1 \u0111\u01b0\u1eddng n\u00e9t, l\u01b0\u1ee3ng m\u00e0u v\u00e0 b\u1ed1 c\u1ee5c. \u0110\u1eb7c t\u00ednh m\u1ec1m m\u1ea1i c\u1ee7a l\u1ee5a khi\u1ebfn m\u1ed7i n\u00e9t v\u1ebd c\u00f3 s\u1ef1 lan t\u1ecfa ri\u00eang, t\u1ea1o n\u00ean nh\u1eefng chuy\u1ec3n s\u1eafc t\u1ef1 nhi\u00ean.<\/p>\n<p data-start=\"2702\" data-end=\"2810\">V\u1edbi ch\u1ea5t li\u1ec7u 100% l\u1ee5a t\u01a1 t\u1eb1m, \u00e1nh s\u00e1ng tr\u00ean b\u1ec1 m\u1eb7t v\u1ea3i l\u00e0m s\u1eafc m\u00e0u tr\u1edf n\u00ean s\u1ed1ng \u0111\u1ed9ng theo t\u1eebng chuy\u1ec3n \u0111\u1ed9ng.<\/p>\n<p data-start=\"2812\" data-end=\"2931\">Khi ng\u01b0\u1eddi s\u1eed d\u1ee5ng qu\u00e0ng kh\u0103n, nh\u1eefng \u0111\u00f3a sen kh\u00f4ng c\u00f2n n\u1eb1m c\u1ed1 \u0111\u1ecbnh tr\u00ean m\u1ed9t m\u1eb7t ph\u1eb3ng m\u00e0 chuy\u1ec3n \u0111\u1ed9ng c\u00f9ng \u0111\u1ed9 r\u1ee7 c\u1ee7a l\u1ee5a.<\/p>\n<p data-start=\"2933\" data-end=\"3055\">\u0110\u00e2y ch\u00ednh l\u00e0 v\u1ebb \u0111\u1eb9p \u0111\u1eb7c tr\u01b0ng c\u1ee7a kh\u0103n l\u1ee5a v\u1ebd tay: m\u1ed9t t\u00e1c ph\u1ea9m ngh\u1ec7 thu\u1eadt c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c m\u1eb7c, s\u1eed d\u1ee5ng v\u00e0 mang theo b\u00ean m\u00ecnh.<\/p>\n<p><a href=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/SenSilk-15-scaled.jpg\"><img class=\"alignnone wp-image-7682\" src=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/SenSilk-15-1024x683.jpg\" alt=\"\" width=\"301\" height=\"201\" \/><\/a><\/p>\n<h2 class=\"PDq2pG_selectionAnchorContainer\" data-section-id=\"3inknn\" data-start=\"3057\" data-end=\"3092\">Tinh th\u1ea7n Art Luxury c\u1ee7a SenSilk<\/h2>\n<p data-start=\"3094\" data-end=\"3151\">SenSilk theo \u0111u\u1ed5i m\u1ed9t v\u1ebb \u0111\u1eb9p sang tr\u1ecdng c\u00f3 t\u00ednh ti\u1ebft ch\u1ebf.<\/p>\n<p data-start=\"3153\" data-end=\"3285\">V\u1edbi thi\u1ebft k\u1ebf Hoa Sen, s\u1ef1 cao c\u1ea5p \u0111\u1ebfn t\u1eeb ch\u1ea5t li\u1ec7u l\u1ee5a t\u01a1 t\u1eb1m, k\u1ef9 thu\u1eadt v\u1ebd tay v\u00e0 c\u00e1ch x\u1eed l\u00fd h\u00ecnh \u1ea3nh hoa sen theo h\u01b0\u1edbng thanh tho\u00e1t.<\/p>\n<p data-start=\"3287\" data-end=\"3371\">Kh\u00f4ng c\u1ea7n qu\u00e1 nhi\u1ec1u chi ti\u1ebft, s\u1eafc h\u1ed3ng c\u1ee7a hoa tr\u00ean n\u1ec1n l\u1ee5a \u0111\u00e3 \u0111\u1ee7 t\u1ea1o n\u00ean \u0111i\u1ec3m nh\u1ea5n.<\/p>\n<p data-start=\"3373\" data-end=\"3470\">\u0110\u00e2y l\u00e0 tinh th\u1ea7n Quiet Luxury: \u0111\u1ec3 ch\u1ea5t li\u1ec7u, k\u1ef9 ngh\u1ec7 th\u1ee7 c\u00f4ng v\u00e0 c\u00e2u chuy\u1ec7n v\u0103n h\u00f3a t\u1ef1 l\u00ean ti\u1ebfng.<\/p>\n<p><a href=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/Art-of-Silk-SenSilk-Silk-Painting-2021-4-scaled.jpg\"><img class=\"alignnone wp-image-5710\" src=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/Art-of-Silk-SenSilk-Silk-Painting-2021-4-1024x803.jpg\" alt=\"\" width=\"296\" height=\"232\" \/><\/a><\/p>\n<h2 class=\"PDq2pG_selectionAnchorContainer\" data-section-id=\"155zi0a\" data-start=\"3472\" data-end=\"3502\">Phong c\u00e1ch Kh\u0103n L\u1ee5a Hoa Sen<\/h2>\n<p data-start=\"3504\" data-end=\"3580\">Thi\u1ebft k\u1ebf ph\u00f9 h\u1ee3p v\u1edbi phong c\u00e1ch thanh l\u1ecbch, n\u1eef t\u00ednh v\u00e0 sang tr\u1ecdng nh\u1eb9 nh\u00e0ng.<\/p>\n<p data-start=\"3582\" data-end=\"3701\">Khi ph\u1ed1i c\u00f9ng \u00e1o d\u00e0i tr\u1eafng, h\u1ed3ng nh\u1ea1t, kem, be ho\u1eb7c c\u00e1c gam m\u00e0u pastel, s\u1eafc sen t\u1ea1o n\u00ean t\u1ed5ng th\u1ec3 h\u00e0i h\u00f2a v\u00e0 duy\u00ean d\u00e1ng.<\/p>\n<p data-start=\"3703\" data-end=\"3807\">V\u1edbi trang ph\u1ee5c c\u00f4ng s\u1edf, kh\u0103n c\u00f3 th\u1ec3 qu\u00e0ng nh\u1eb9 quanh c\u1ed5 c\u00f9ng s\u01a1 mi tr\u1eafng, blazer ho\u1eb7c trang ph\u1ee5c \u0111\u01a1n s\u1eafc.<\/p>\n<p data-start=\"3809\" data-end=\"3935\">V\u1edbi phong c\u00e1ch Quiet Luxury, c\u00f3 th\u1ec3 \u0111\u1ec3 kh\u0103n bu\u00f4ng t\u1ef1 nhi\u00ean tr\u00ean vai ho\u1eb7c qu\u00e0ng m\u1ed9t v\u00f2ng nh\u1eb9 quanh c\u1ed5 c\u00f9ng trang ph\u1ee5c t\u1ed1i gi\u1ea3n.<\/p>\n<p data-start=\"3937\" data-end=\"4030\">Kh\u0103n c\u0169ng c\u00f3 th\u1ec3 cu\u1ed9n g\u1ecdn v\u00e0 th\u1eaft tr\u00ean quai t\u00fai x\u00e1ch \u0111\u1ec3 t\u1ea1o m\u1ed9t \u0111i\u1ec3m nh\u1ea5n th\u1eddi trang tinh t\u1ebf.<\/p>\n<div><a href=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/Art-of-Silk-SenSilk-Silk-Painting-2021-3-scaled.jpg\"><img class=\"alignnone wp-image-5708\" src=\"https:\/\/sensilk.vn\/wp-content\/uploads\/2020\/10\/Art-of-Silk-SenSilk-Silk-Painting-2021-3-1024x787.jpg\" alt=\"\" width=\"306\" height=\"235\" \/><\/a><\/div>\n<div>\n<div style=\"text-align: center\">\n<div>\n<div style=\"text-align: left\">\n<h2 class=\"PDq2pG_selectionAnchorContainer\" data-section-id=\"9h10r3\" data-start=\"4032\" data-end=\"4068\">\u1ee8ng d\u1ee5ng c\u1ee7a kh\u0103n l\u1ee5a 180 \u00d7 55 cm<\/h2>\n<p data-start=\"4070\" data-end=\"4136\">K\u00edch th\u01b0\u1edbc 180 \u00d7 55 cm cho ph\u00e9p chi\u1ebfc kh\u0103n \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng linh ho\u1ea1t:<\/p>\n<p data-start=\"4138\" data-end=\"4173\">Qu\u00e0ng c\u1ed5 trong trang ph\u1ee5c h\u1eb1ng ng\u00e0y<\/p>\n<p data-start=\"4175\" data-end=\"4194\">Cho\u00e0ng nh\u1eb9 tr\u00ean vai<\/p>\n<p data-start=\"4196\" data-end=\"4212\">Ph\u1ed1i c\u00f9ng \u00e1o d\u00e0i<\/p>\n<p data-start=\"4214\" data-end=\"4244\">K\u1ebft h\u1ee3p v\u1edbi trang ph\u1ee5c c\u00f4ng s\u1edf<\/p>\n<p data-start=\"4246\" data-end=\"4267\">Ph\u1ed1i c\u00f9ng \u0111\u1ea7m d\u1ef1 ti\u1ec7c<\/p>\n<p data-start=\"4269\" data-end=\"4292\">Th\u1eaft tr\u00ean quai t\u00fai x\u00e1ch<\/p>\n<p data-start=\"4294\" data-end=\"4340\">S\u1eed d\u1ee5ng khi \u0111i du l\u1ecbch, ngh\u1ec9 d\u01b0\u1ee1ng v\u00e0 ch\u1ee5p \u1ea3nh<\/p>\n<p data-start=\"4342\" data-end=\"4392\">L\u00e0m ph\u1ee5 ki\u1ec7n trong nh\u1eefng s\u1ef1 ki\u1ec7n ho\u1eb7c d\u1ecbp \u0111\u1eb7c bi\u1ec7t<\/p>\n<\/div>\n<div>\n<div dir=\"auto\">\n<p style=\"text-align: left\">\n<\/div>\n<\/div>\n<\/div>\n<h2 class=\"PDq2pG_selectionAnchorContainer\" data-section-id=\"10j48d\" data-start=\"4394\" data-end=\"4440\">Qu\u00e0 T\u1eb7ng Vi\u1ec7t Nam \u2013 Mang h\u00ecnh \u1ea3nh Sen \u0111i xa<\/h2>\n<p data-start=\"4442\" data-end=\"4576\">M\u1ed9t m\u00f3n qu\u00e0 mang d\u1ea5u \u1ea5n Vi\u1ec7t Nam s\u1ebd tr\u1edf n\u00ean \u0111\u1eb7c bi\u1ec7t h\u01a1n khi c\u00e2u chuy\u1ec7n v\u0103n h\u00f3a \u0111\u01b0\u1ee3c k\u1ebft h\u1ee3p v\u1edbi gi\u00e1 tr\u1ecb s\u1eed d\u1ee5ng v\u00e0 th\u1ea9m m\u1ef9 \u0111\u01b0\u01a1ng \u0111\u1ea1i.<\/p>\n<p data-start=\"4578\" data-end=\"4685\">Kh\u0103n L\u1ee5a V\u1ebd Tay Hoa Sen h\u1ed9i t\u1ee5 nh\u1eefng y\u1ebfu t\u1ed1 \u1ea5y: l\u1ee5a t\u01a1 t\u1eb1m Vi\u1ec7t Nam, ngh\u1ec7 thu\u1eadt v\u1ebd tay v\u00e0 h\u00ecnh \u1ea3nh hoa sen.<\/p>\n<p data-start=\"4687\" data-end=\"4846\">\u0110\u00e2y l\u00e0 l\u1ef1a ch\u1ecdn ph\u00f9 h\u1ee3p d\u00e0nh t\u1eb7ng m\u1eb9, v\u1ee3, ng\u01b0\u1eddi y\u00eau, ch\u1ecb em g\u00e1i, b\u1ea1n b\u00e8 n\u1eef, \u0111\u1ed1i t\u00e1c, kh\u00e1ch h\u00e0ng, l\u00e3nh \u0111\u1ea1o, gi\u00e1o vi\u00ean ho\u1eb7c nh\u1eefng ng\u01b0\u1eddi \u0111\u1eb7c bi\u1ec7t \u0111\u01b0\u1ee3c tr\u00e2n tr\u1ecdng.<\/p>\n<p data-start=\"4848\" data-end=\"5017\">S\u1ea3n ph\u1ea9m c\u0169ng ph\u00f9 h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng cho \u0111\u1ed1i t\u00e1c v\u00e0 b\u1ea1n b\u00e8 qu\u1ed1c t\u1ebf, nh\u01b0 m\u1ed9t c\u00e1ch gi\u1edbi thi\u1ec7u h\u00ecnh \u1ea3nh hoa sen v\u00e0 ngh\u1ec7 thu\u1eadt l\u1ee5a Vi\u1ec7t Nam qua m\u1ed9t m\u00f3n qu\u00e0 th\u1eddi trang cao c\u1ea5p.<\/p>\n<p data-start=\"5019\" data-end=\"5128\">\u0110\u1eb7c bi\u1ec7t ph\u00f9 h\u1ee3p cho qu\u00e0 T\u1ebft, 8\/3, 20\/10, sinh nh\u1eadt, k\u1ef7 ni\u1ec7m, qu\u00e0 tri \u00e2n kh\u00e1ch h\u00e0ng v\u00e0 qu\u00e0 t\u1eb7ng doanh nghi\u1ec7p.<\/p>\n<h2 data-section-id=\"ky131h\" data-start=\"5130\" data-end=\"5148\">H\u1ed9p qu\u00e0 SenSilk<\/h2>\n<p data-start=\"5150\" data-end=\"5218\">S\u1ea3n ph\u1ea9m \u0111\u01b0\u1ee3c ho\u00e0n thi\u1ec7n v\u1edbi h\u1ed9p \u0111\u1ef1ng cao c\u1ea5p, t\u00fai v\u00e0 thi\u1ec7p SenSilk.<\/p>\n<p data-start=\"5220\" data-end=\"5339\">C\u00e1ch \u0111\u00f3ng g\u00f3i gi\u1eef tinh th\u1ea7n trang nh\u00e3 v\u00e0 ch\u1ec9n chu, gi\u00fap chi\u1ebfc kh\u0103n tr\u1edf th\u00e0nh m\u1ed9t m\u00f3n qu\u00e0 ho\u00e0n ch\u1ec9nh ngay khi trao t\u1eb7ng.<\/p>\n<p data-start=\"5341\" data-end=\"5499\">T\u1eeb t\u00e1c ph\u1ea9m v\u1ebd tay b\u00ean trong \u0111\u1ebfn c\u00e1ch tr\u00ecnh b\u00e0y b\u00ean ngo\u00e0i, m\u1ed7i chi ti\u1ebft \u0111\u1ec1u h\u01b0\u1edbng \u0111\u1ebfn tr\u1ea3i nghi\u1ec7m tinh t\u1ebf v\u00e0 ph\u00f9 h\u1ee3p v\u1edbi \u0111\u1ecbnh v\u1ecb qu\u00e0 t\u1eb7ng cao c\u1ea5p c\u1ee7a SenSilk.<\/p>\n<h2 data-section-id=\"14q46y2\" data-start=\"5501\" data-end=\"5549\">Gi\u00e1 tr\u1ecb Limited \u2013 Ngh\u1ec7 thu\u1eadt c\u00f3 th\u1ec3 mang theo<\/h2>\n<p data-start=\"5551\" data-end=\"5648\">Kh\u0103n L\u1ee5a V\u1ebd Tay Ngh\u1ec7 Thu\u1eadt \u2013 Limited mang gi\u00e1 tr\u1ecb kh\u00e1c bi\u1ec7t t\u1eeb ch\u00ednh qu\u00e1 tr\u00ecnh s\u00e1ng t\u1ea1o th\u1ee7 c\u00f4ng.<\/p>\n<p data-start=\"5650\" data-end=\"5758\">Ng\u01b0\u1eddi ngh\u1ec7 nh\u00e2n ph\u1ea3i c\u00e2n \u0111\u1ed1i \u0111\u01b0\u1eddng n\u00e9t, s\u1eafc m\u00e0u, b\u1ed1 c\u1ee5c v\u00e0 \u0111\u1eb7c t\u00ednh c\u1ee7a l\u1ee5a \u0111\u1ec3 t\u1ea1o n\u00ean m\u1ed9t t\u1ed5ng th\u1ec3 h\u00e0i h\u00f2a.<\/p>\n<p data-start=\"5760\" data-end=\"5890\">Khi h\u00ecnh \u1ea3nh hoa sen \u0111\u01b0\u1ee3c th\u1ec3 hi\u1ec7n b\u1eb1ng k\u1ef9 thu\u1eadt v\u1ebd tay, s\u1ea3n ph\u1ea9m tr\u1edf th\u00e0nh s\u1ef1 giao thoa gi\u1eefa h\u1ed9i h\u1ecda, th\u1eddi trang v\u00e0 v\u0103n h\u00f3a Vi\u1ec7t.<\/p>\n<p data-start=\"5892\" data-end=\"6009\">Ng\u01b0\u1eddi s\u1edf h\u1eefu kh\u00f4ng ch\u1ec9 c\u00f3 m\u1ed9t chi\u1ebfc kh\u0103n \u0111\u1ec3 s\u1eed d\u1ee5ng m\u00e0 c\u00f2n c\u00f3 m\u1ed9t t\u00e1c ph\u1ea9m ngh\u1ec7 thu\u1eadt \u1ee9ng d\u1ee5ng mang c\u00e2u chuy\u1ec7n ri\u00eang.<\/p>\n<h2 data-section-id=\"69br7c\" data-start=\"6011\" data-end=\"6031\">H\u01b0\u1edbng d\u1eabn s\u1eed d\u1ee5ng<\/h2>\n<p data-start=\"6033\" data-end=\"6132\">Qu\u00e0ng c\u1ed5: G\u1ea5p ho\u1eb7c cu\u1ed9n kh\u0103n theo chi\u1ec1u d\u00e0i r\u1ed3i qu\u00e0ng nh\u1eb9 quanh c\u1ed5, c\u00f3 th\u1ec3 th\u1eaft n\u00fat m\u1ec1m ph\u00eda tr\u01b0\u1edbc.<\/p>\n<p data-start=\"6134\" data-end=\"6235\">Cho\u00e0ng vai: \u0110\u1ec3 kh\u0103n bu\u00f4ng t\u1ef1 nhi\u00ean tr\u00ean vai khi k\u1ebft h\u1ee3p c\u00f9ng \u00e1o d\u00e0i, \u0111\u1ea7m ho\u1eb7c trang ph\u1ee5c trang tr\u1ecdng.<\/p>\n<p data-start=\"6237\" data-end=\"6301\">Th\u1eaft t\u00fai: Cu\u1ed9n kh\u0103n g\u1ecdn v\u00e0 bu\u1ed9c quanh quai t\u00fai \u0111\u1ec3 t\u1ea1o \u0111i\u1ec3m nh\u1ea5n.<\/p>\n<p data-start=\"6303\" data-end=\"6440\">Ph\u1ed1i \u00e1o d\u00e0i: C\u00f3 th\u1ec3 th\u1eaft nh\u1eb9 quanh c\u1ed5 ho\u1eb7c \u0111\u1ec3 kh\u0103n bu\u00f4ng hai t\u00e0, \u0111\u1eb7c bi\u1ec7t ph\u00f9 h\u1ee3p v\u1edbi \u00e1o d\u00e0i tr\u1eafng, h\u1ed3ng nh\u1ea1t, kem v\u00e0 c\u00e1c gam m\u00e0u pastel.<\/p>\n<h2 data-section-id=\"1cvkcll\" data-start=\"6442\" data-end=\"6463\">H\u01b0\u1edbng d\u1eabn b\u1ea3o qu\u1ea3n<\/h2>\n<p data-start=\"6465\" data-end=\"6505\">\u01afu ti\u00ean gi\u1eb7t tay nh\u1eb9 nh\u00e0ng v\u1edbi n\u01b0\u1edbc m\u00e1t.<\/p>\n<p data-start=\"6507\" data-end=\"6543\">Kh\u00f4ng ng\u00e2m kh\u0103n trong th\u1eddi gian d\u00e0i.<\/p>\n<p data-start=\"6545\" data-end=\"6589\">Kh\u00f4ng v\u00f2, xo\u1eafn ho\u1eb7c ch\u00e0 m\u1ea1nh l\u00ean b\u1ec1 m\u1eb7t l\u1ee5a.<\/p>\n<p data-start=\"6591\" data-end=\"6619\">Kh\u00f4ng s\u1eed d\u1ee5ng ch\u1ea5t t\u1ea9y m\u1ea1nh.<\/p>\n<p data-start=\"6621\" data-end=\"6669\">Ph\u01a1i \u1edf n\u01a1i tho\u00e1ng m\u00e1t, tr\u00e1nh \u00e1nh n\u1eafng tr\u1ef1c ti\u1ebfp.<\/p>\n<p data-start=\"6671\" data-end=\"6707\">Kh\u00f4ng l\u00e0 ho\u1eb7c \u1ee7i \u1edf nhi\u1ec7t \u0111\u1ed9 qu\u00e1 cao.<\/p>\n<p data-start=\"6709\" data-end=\"6776\">Khi kh\u00f4ng s\u1eed d\u1ee5ng, n\u00ean g\u1ea5p nh\u1eb9 v\u00e0 b\u1ea3o qu\u1ea3n trong h\u1ed9p ho\u1eb7c t\u00fai s\u1ea1ch.<\/p>\n<p data-start=\"6778\" data-end=\"6847\">H\u1ea1n ch\u1ebf \u0111\u1ec3 kh\u0103n ti\u1ebfp x\u00fac tr\u1ef1c ti\u1ebfp v\u1edbi n\u01b0\u1edbc hoa, m\u1ef9 ph\u1ea9m v\u00e0 h\u00f3a ch\u1ea5t.<\/p>\n<h2 data-section-id=\"ly38sn\" data-start=\"6849\" data-end=\"6870\">C\u00e2u h\u1ecfi th\u01b0\u1eddng g\u1eb7p<\/h2>\n<h3 data-section-id=\"1cit2jh\" data-start=\"6872\" data-end=\"6926\">Kh\u0103n l\u1ee5a hoa sen SenSilk \u0111\u01b0\u1ee3c l\u00e0m t\u1eeb ch\u1ea5t li\u1ec7u g\u00ec?<\/h3>\n<p data-start=\"6928\" data-end=\"7021\">S\u1ea3n ph\u1ea9m \u0111\u01b0\u1ee3c l\u00e0m t\u1eeb 100% l\u1ee5a t\u01a1 t\u1eb1m, c\u00f3 \u0111\u1ed9 m\u1ec1m m\u1ea1i, nh\u1eb9 v\u00e0 \u0111\u1ed9 r\u1ee7 t\u1ef1 nhi\u00ean \u0111\u1eb7c tr\u01b0ng c\u1ee7a l\u1ee5a.<\/p>\n<h3 data-section-id=\"9dgtsf\" data-start=\"7023\" data-end=\"7061\">\u0110\u00e2y c\u00f3 ph\u1ea3i kh\u0103n l\u1ee5a v\u1ebd tay kh\u00f4ng?<\/h3>\n<p data-start=\"7063\" data-end=\"7215\">\u0110\u00fang. S\u1ea3n ph\u1ea9m thu\u1ed9c d\u00f2ng Kh\u0103n L\u1ee5a V\u1ebd Tay Ngh\u1ec7 Thu\u1eadt \u2013 Limited c\u1ee7a SenSilk, v\u1edbi h\u1ecda ti\u1ebft hoa sen \u0111\u01b0\u1ee3c th\u1ec3 hi\u1ec7n b\u1eb1ng k\u1ef9 thu\u1eadt v\u1ebd tay tr\u00ean n\u1ec1n l\u1ee5a t\u01a1 t\u1eb1m.<\/p>\n<h3 data-section-id=\"1wernnm\" data-start=\"7217\" data-end=\"7250\">Kh\u0103n c\u00f3 k\u00edch th\u01b0\u1edbc bao nhi\u00eau?<\/h3>\n<p data-start=\"7252\" data-end=\"7353\">Kh\u0103n c\u00f3 k\u00edch th\u01b0\u1edbc 180 \u00d7 55 cm, ph\u00f9 h\u1ee3p \u0111\u1ec3 qu\u00e0ng c\u1ed5, cho\u00e0ng vai, ph\u1ed1i \u00e1o d\u00e0i ho\u1eb7c th\u1eaft tr\u00ean quai t\u00fai.<\/p>\n<h3 data-section-id=\"j4ezr6\" data-start=\"7355\" data-end=\"7396\">Hoa sen c\u00f3 \u00fd ngh\u0129a g\u00ec trong thi\u1ebft k\u1ebf?<\/h3>\n<p data-start=\"7398\" data-end=\"7593\">Hoa sen g\u1eafn v\u1edbi v\u1ebb \u0111\u1eb9p thanh khi\u1ebft, s\u1ef1 tinh t\u1ebf v\u00e0 l\u00e0 m\u1ed9t h\u00ecnh \u1ea3nh ti\u00eau bi\u1ec3u trong v\u0103n h\u00f3a, ngh\u1ec7 thu\u1eadt Vi\u1ec7t Nam. Thi\u1ebft k\u1ebf \u0111\u01b0a h\u00ecnh \u1ea3nh sen l\u00ean l\u1ee5a theo h\u01b0\u1edbng hi\u1ec7n \u0111\u1ea1i nh\u01b0ng v\u1eabn gi\u1eef tinh th\u1ea7n Vi\u1ec7t.<\/p>\n<h3 data-section-id=\"bidug2\" data-start=\"7595\" data-end=\"7643\">Kh\u0103n c\u00f3 ph\u00f9 h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng Vi\u1ec7t Nam kh\u00f4ng?<\/h3>\n<p data-start=\"7645\" data-end=\"7764\">C\u00f3. S\u1ef1 k\u1ebft h\u1ee3p gi\u1eefa l\u1ee5a t\u01a1 t\u1eb1m, ngh\u1ec7 thu\u1eadt v\u1ebd tay v\u00e0 h\u00ecnh \u1ea3nh hoa sen t\u1ea1o n\u00ean m\u1ed9t m\u00f3n qu\u00e0 gi\u00e0u d\u1ea5u \u1ea5n v\u0103n h\u00f3a Vi\u1ec7t Nam.<\/p>\n<h3 data-section-id=\"ogyly2\" data-start=\"7766\" data-end=\"7824\">Kh\u0103n c\u00f3 ph\u00f9 h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng \u0111\u1ed1i t\u00e1c n\u01b0\u1edbc ngo\u00e0i kh\u00f4ng?<\/h3>\n<p data-start=\"7826\" data-end=\"7976\">C\u00f3. Thi\u1ebft k\u1ebf l\u00e0 l\u1ef1a ch\u1ecdn ph\u00f9 h\u1ee3p \u0111\u1ec3 gi\u1edbi thi\u1ec7u h\u00ecnh \u1ea3nh hoa sen v\u00e0 ngh\u1ec7 thu\u1eadt th\u1ee7 c\u00f4ng Vi\u1ec7t Nam th\u00f4ng qua m\u1ed9t s\u1ea3n ph\u1ea9m th\u1eddi trang cao c\u1ea5p, d\u1ec5 s\u1eed d\u1ee5ng.<\/p>\n<h3 data-section-id=\"fwikbl\" data-start=\"7978\" data-end=\"8016\">Kh\u0103n c\u00f3 th\u1ec3 ph\u1ed1i v\u1edbi \u00e1o d\u00e0i kh\u00f4ng?<\/h3>\n<p data-start=\"8018\" data-end=\"8119\">C\u00f3. S\u1eafc h\u1ed3ng c\u1ee7a hoa sen \u0111\u1eb7c bi\u1ec7t ph\u00f9 h\u1ee3p v\u1edbi \u00e1o d\u00e0i tr\u1eafng, h\u1ed3ng nh\u1ea1t, kem, be v\u00e0 c\u00e1c gam m\u00e0u pastel.<\/p>\n<h3 data-section-id=\"1e5rcm7\" data-start=\"8121\" data-end=\"8173\">Kh\u0103n c\u00f3 ph\u00f9 h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng doanh nghi\u1ec7p kh\u00f4ng?<\/h3>\n<p data-start=\"8175\" data-end=\"8316\">C\u00f3. S\u1ea3n ph\u1ea9m ph\u00f9 h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng \u0111\u1ed1i t\u00e1c, kh\u00e1ch h\u00e0ng, l\u00e3nh \u0111\u1ea1o, qu\u1ea3n l\u00fd v\u00e0 nh\u00e2n s\u1ef1 n\u1eef trong c\u00e1c ch\u01b0\u01a1ng tr\u00ecnh tri \u00e2n ho\u1eb7c nh\u1eefng d\u1ecbp \u0111\u1eb7c bi\u1ec7t.<\/p>\n<h3 style=\"text-align: left\"><\/h3>\n<\/div>\n<\/div>","on_sale":true,"prices":{"price":"2560000","regular_price":"2850000","sale_price":"2560000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":".","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<del aria-hidden=\"true\"><span class=\"woocommerce-Price-amount amount\">2.850.000<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#8363;<\/span><\/span><\/del> <span class=\"screen-reader-text\">Gi\u00e1 g\u1ed1c l\u00e0: 2.850.000&#8363;.<\/span><ins aria-hidden=\"true\"><span class=\"woocommerce-Price-amount amount\">2.560.000<span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&#8363;<\/span><\/span><\/ins><span class=\"screen-reader-text\">Gi\u00e1 hi\u1ec7n t\u1ea1i l\u00e0: 2.560.000&#8363;.<\/span>","average_rating":"0","review_count":0,"images":[{"id":14595,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/SenSilk-27.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/SenSilk-27-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"SenSilk (27)","alt":""},{"id":14601,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/SenSilk-5-scaled-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/SenSilk-5-scaled-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 1511px) 100vw, 1511px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"SenSilk (5)","alt":""},{"id":14597,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-2-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-2-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"Art of Silk &#8211; SenSilk Silk Painting 2021 (2)","alt":""},{"id":14603,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-1-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-1-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"Art of Silk &#8211; SenSilk Silk Painting 2021 (1)","alt":""},{"id":14599,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-4-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-4-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"Art of Silk &#8211; SenSilk Silk Painting 2021 (4)","alt":""},{"id":14605,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-6-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2024\/04\/Art-of-Silk-SenSilk-Silk-Painting-2021-6-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"Art of Silk &#8211; SenSilk Silk Painting 2021 (6)","alt":""}],"categories":[{"id":2214,"name":"Kh\u0103n L\u1ee5a V\u1ebd Tay Ngh\u1ec7 Thu\u1eadt","slug":"khan-lua-ve-tay-cao-cap","link":"https:\/\/sensilk.vn\/product-category\/khan-lua-ve-tay-cao-cap\/"}],"tags":[{"id":1968,"name":"100% silk","slug":"100-silk","link":"h