-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"l\u1ee5a v\u1ebd hoa mai SenSilk (1)","alt":""},{"id":7722,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2019\/01\/khan-lua-ve-hoa-mai-SenSilk-Limited-3-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2019\/01\/khan-lua-ve-hoa-mai-SenSilk-Limited-3-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 2007px) 100vw, 2007px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"kh\u0103n l\u1ee5a v\u1ebd hoa mai SenSilk Limited (3)","alt":""},{"id":7546,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2021\/01\/SenSilk-Limited-lua-ve-tay-Hoa-Mai-32-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2021\/01\/SenSilk-Limited-lua-ve-tay-Hoa-Mai-32-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"SenSilk Limited l\u1ee5a v\u1ebd tay Hoa Mai (32)","alt":""},{"id":12156,"src":"https:\/\/sensilk.vn\/wp-content\/uploads\/2023\/01\/khan-lua-ve-hoa-mai-SenSilk-8-scaled.jpg","thumbnail":"https:\/\/sensilk.vn\/wp-content\/uploads\/2023\/01\/khan-lua-ve-hoa-mai-SenSilk-8-scaled-247x296.jpg","srcset":"","sizes":"(max-width: 2048px) 100vw, 2048px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"khan-lua-ve-hoa-mai-SenSilk-8","alt":""}],"categories":[{"id":2214,"name":"Kh\u0103n L\u1ee5a V\u1ebd Tay Ngh\u1ec7 Thu\u1eadt","slug":"khan-lua-ve-tay-cao-cap","link":"https:\/\/sensilk.vn\/product-category\/khan-lua-ve-tay-cao-cap\/"}],"tags":[{"id":1968,"name":"100% silk","slug":"100-silk","link":"https:\/\/sensilk.vn\/tag\/100-silk\/"},{"id":703,"name":"kh\u0103n l\u1ee5a cao c\u1ea5p","slug":"khan-lua-cao-cap","link":"https:\/\/sensilk.vn\/tag\/khan-lua-cao-cap\/"},{"id":793,"name":"kh\u0103n l\u1ee5a sensilk","slug":"khan-lua-s