\/khan-lua-vuong-in-3d-giang-huong-sen-sensilk-247x296.jpg","srcset":"","sizes":"(max-width: 1200px) 100vw, 1200px","thumbnail_srcset":"","thumbnail_sizes":"(max-width: 247px) 100vw, 247px","name":"H\u1ed9p Qu\u00e0 Kh\u0103n L\u1ee5a Gi\u00e1ng H\u01b0\u01a1ng Sen","alt":"H\u1ed9p qu\u00e0 cao c\u1ea5p c\u1ee7a Kh\u0103n L\u1ee5a Vu\u00f4ng In 3D Gi\u00e1ng H\u01b0\u01a1ng Sen SenSilk, ph\u00f9 h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng doanh nghi\u1ec7p v\u00e0 \u0111\u1ed1i t\u00e1c"}],"categories":[{"id":2120,"name":"Kh\u0103n L\u1ee5a in 3D","slug":"khan-lua-in","link":"https:\/\/sensilk.vn\/product-category\/khan-lua-in\/"},{"id":2874,"name":"Kh\u0103n L\u1ee5a Vu\u00f4ng In 3D","slug":"khan-lua-vuong-in-3d","link":"https:\/\/sensilk.vn\/product-category\/khan-lua-in\/khan-lua-vuong-in-3d\/"}],"tags":[{"id":703,"name":"kh\u0103n l\u1ee5a cao c\u1ea5p","slug":"khan-lua-cao-cap","link":"https:\/\/sensilk.vn\/tag\/khan-lua-cao-cap\/"},{"id":2451,"name":"kh\u0103n l\u1ee5a hoa sen","slug":"khan-lua-hoa-sen","link":"https:\/\/sensilk.vn\/tag\/khan-lua-hoa-sen\/"},{"id":2740,"name":"kh\u0103n l\u1ee5a in 3d","slug":"khan-lua-in-3d","link":"https:\/\/sensilk.vn\/tag\/khan-lua-in-3d\/"},{"id":609,"name":"kh\u0103n l\u1ee5a t\u01a1 t\u1eb1m","slug":"khan-lua-to-tam","link":"https:\/\/sensilk.vn\/tag\/khan-lua-to-tam\/"},{"id":1610,"name":"kh\u0103n l\u1ee5a t\u01a1 t\u1eb1m cao c\u1ea5p","slug":"khan-lua-to-tam-cao-cap-en","link":"https:\/\/sensilk.vn\/tag\/khan-lua-to-tam-cao-cap-en\/"},{"id":750,"name":"kh\u0103n l\u1ee5a vu\u00f4ng","slug":"khan-lua-vuong","link":"https:\/\/sensilk.vn\/tag\/khan-lua-vuong\/"},{"id":560,"name":"l\u1ee5a t\u01a1 t\u1eb1m","slug":"lua-to-tam","link":"https:\/\/sensilk.vn\/tag\/lua-to-tam\/"},{"id":2867,"name":"Ph\u1ee5 ki\u1ec7n th\u1eddi trang n\u1eef","slug":"phu-kien-thoi-trang-nu","link":"https:\/\/sensilk.vn\/tag\/phu-kien-thoi-trang-nu\/"},{"id":564,"name":"Qu\u00e0 t\u1eb7ng cao c\u1ea5p","slug":"qua-tang-cao-cap","link":"https:\/\/se