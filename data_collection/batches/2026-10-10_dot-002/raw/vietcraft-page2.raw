roduct-category\/product-type\/storage-containers\/basket\/"},{"id":305,"name":"Fern","slug":"fern","link":"https:\/\/vietcraft.vn\/product-category\/materials\/fern\/"},{"id":205,"name":"Gift &amp; Craft","slug":"gift-craft","link":"https:\/\/vietcraft.vn\/product-category\/home-living\/gift-craft\/"},{"id":202,"name":"Home Living","slug":"home-living","link":"https:\/\/vietcraft.vn\/product-category\/home-living\/"},{"id":70,"name":"Materials","slug":"materials","link":"https:\/\/vietcraft.vn\/product-category\/materials\/"},{"id":167,"name":"Product Type","slug":"product-type","link":"https:\/\/vietcraft.vn\/product-category\/product-type\/"},{"id":89,"name":"Rattan","slug":"rattan","link":"https:\/\/vietcraft.vn\/product-category\/materials\/rattan\/"},{"id":168,"name":"Storage &amp; Containers","slug":"storage-containers","link":"https:\/\/vietcraft.vn\/product-category\/product-type\/storage-containers\/"},{"id":209,"name":"Tableware","slug":"tableware","link":"https:\/\/vietcraft.vn\/product-category\/home-living\/tableware\/"}],"tags":[{"id":314,"name":"artisan rattan crafts","slug":"artisan-rattan-crafts","link":"https:\/\/vietcraft.vn\/product-tag\/artisan-rattan-crafts\/"},{"id":311,"name":"eco storage wholesale","slug":"eco-storage-wholesale","link":"https:\/\/vietcraft.vn\/product-tag\/eco-storage-wholesale\/"},{"id":307,"name":"handmade storage basket","slug":"handmade-storage-basket","link":"https:\/\/vietcraft.vn\/product-tag\/handmade-storage-basket\/"},{"id":312,"name":"home d\u00e9cor basket","slug":"home-decor-basket","link":"https:\/\/vietcraft.vn\/product-tag\/home-decor-basket\/"},{"id":310,"name":"natural basket manufacturer","slug":"natural-basket-manufacturer","link":"https:\/\/vietcraft.vn\/product-tag\/natural-basket-manufacturer\/"},{"id":308,"name":"rattan basket supplier","slug":"rattan-basket-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/rattan-basket-supplier\/"},{"id":306,"name":"rattan basket Vietnam","slug":"rattan-basket-vietnam","link":"https:\/\/vietcraft.vn\/product-tag\/rattan-basket-vietnam\/"},{"id":313,"name":"Vietnamese handicraft basket","slug":"vietnamese-handicraft-basket","link":"https:\/\/vietcraft.vn\/product-tag\/vietnamese-handicraft-basket\/"},{"id":309,"name":"woven basket for home","slug":"woven-basket-for-home","link":"https:\/\/vietcraft.vn\/product-tag\/woven-basket-for-home\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;High-Quality Woven Rattan Basket \u2013 Handmade Storage &#038; D\u00e9cor from Vietnam&rdquo;","url":"https:\/\/vietcraft.vn\/product\/high-quality-woven-rattan-basket-handmade-storage-decor-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/699","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=699&per_page=10"}]}},{"id":688,"name":"Ceramic and Rattan Plate \u2013 Handmade Natural Tableware from Vietnam","slug":"ceramic-and-rattan-plate-handmade-natural-tableware-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/ceramic-and-rattan-plate-handmade-natural-tableware-from-vietnam\/","sku":"VH240901","short_description":"<p>Handcrafted ceramic plate with a woven rattan border \u2013 ideal for sustainable tableware collections. Made in Vietnam with customization available.<\/p>","description":"<p data-start=\"372\" data-end=\"669\">This beautifully crafted <strong data-start=\"397\" data-end=\"425\">Ceramic and Rattan Plate<\/strong> combines the elegance of glazed ceramic with the warmth of natural handwoven rattan. The inner plate is made from durable ceramic\u2014smooth, glossy, and food-safe\u2014while the outer frame is woven entirely by hand using sustainably harvested rattan.<\/p>\n<p data-start=\"671\" data-end=\"957\">Perfect for serving snacks, fruits, desserts, or as a decorative piece in modern and rustic interiors, this plate brings together both <strong data-start=\"806\" data-end=\"839\">function and aesthetic appeal<\/strong>. Its natural materials and artisan finish make it a unique choice for eco-conscious consumers and hospitality brands.<\/p>\n<p data-start=\"959\" data-end=\"1177\">We offer <strong data-start=\"968\" data-end=\"993\">OEM\/ODM customization<\/strong> in size, color, pattern, and packaging. Whether you are a homeware retailer, restaurant, hotel, or distributor, this plate is an excellent addition to your eco-friendly product range.<\/p>\n<hr data-start=\"1179\" data-end=\"1182\" \/>\n<h2 data-start=\"1184\" data-end=\"1206\">\u2705 <strong data-start=\"1189\" data-end=\"1206\">Key Features:<\/strong><\/h2>\n<ul data-start=\"1207\" data-end=\"1612\">\n<li data-start=\"1207\" data-end=\"1280\">\n<p data-start=\"1209\" data-end=\"1280\">Combination of glazed <strong data-start=\"1231\" data-end=\"1249\">ceramic center<\/strong> and handwoven <strong data-start=\"1264\" data-end=\"1278\">rattan rim<\/strong><\/p>\n<\/li>\n<li data-start=\"1281\" data-end=\"1348\">\n<p data-start=\"1283\" data-end=\"1348\">Elegant and natural appearance suitable for serving and display<\/p>\n<\/li>\n<li data-start=\"1349\" data-end=\"1400\">\n<p data-start=\"1351\" data-end=\"1400\">100% handcrafted by skilled Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"1401\" data-end=\"1442\">\n<p data-start=\"1403\" data-end=\"1442\">Food-safe, durable, and easy to clean<\/p>\n<\/li>\n<li data-start=\"1443\" data-end=\"1499\">\n<p data-start=\"1445\" data-end=\"1499\">Available in multiple sizes, shapes, and color tones<\/p>\n<\/li>\n<li data-start=\"1500\" data-end=\"1554\">\n<p data-start=\"1502\" data-end=\"1554\">Custom branding and packaging for wholesale buyers<\/p>\n<\/li>\n<li data-start=\"1555\" data-end=\"1612\">\n<p data-start=\"1557\" data-end=\"1612\">Ideal for homeware stores, hotels, resorts, and gifting<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1614\" data-end=\"1617\" \/>\n<h2 data-start=\"1619\" data-end=\"1646\">\ud83c\udf31 <strong data-start=\"1625\" data-end=\"1644\">Why It Matters:<\/strong><\/h2>\n<p data-start=\"1647\" data-end=\"2109\">This product represents the <strong data-start=\"1675\" data-end=\"1724\">spirit of Vietnam\u2019s traditional craftsmanship<\/strong>, using almost entirely <strong data-start=\"1748\" data-end=\"1787\">local raw materials and local labor<\/strong>. It supports <strong data-start=\"1801\" data-end=\"1822\">rural communities<\/strong>, creating extra income for farmers during off-seasons, and preserves a cultural heritage of hand weaving and ceramic art.<br data-start=\"1944\" data-end=\"1947\" \/>At Vietnam Handicraft Co., Ltd, we are proud to export sustainable craft products that generate foreign income while carrying the beauty of our culture worldwide.<\/p>\n<hr data-start=\"2111\" data-end=\"2114\" \/>\n<h2 data-start=\"2116\" data-end=\"2150\">\u2709\ufe0f <strong data-start=\"2122\" data-end=\"2148\">Contact for Wholesale:<\/strong><\/h2>\n<p data-start=\"2151\" data-end=\"2331\">Looking for a <strong data-start=\"2165\" data-end=\"2236\">reliable ceramic &amp; rattan plate manufacturer or supplier in Vietnam<\/strong>?<br data-start=\"2237\" data-end=\"2240\" \/>\ud83d\udce7 Email: <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"2250\" data-end=\"2273\">vietcraft2006@gmail.com<\/a><br data-start=\"2273\" data-end=\"2276\" \/>\ud83c\udf10 Website: <a class=\"\" href=\"http:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"2288\" data-end=\"2331\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separator":".","currency_prefix":"","currency_suffix":" \u20ab"},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":692,"src":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH240901-ceramic-with-rattan-plate.jpg?fit=510%2C600&ssl=1","thumbnail":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH240901-ceramic-with-rattan-plate.jpg?resize=300%2C300&ssl=1","srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH240901-ceramic-with-rattan-plate.jpg?w=510&ssl=1 510w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH240901-ceramic-with-rattan-plate.jpg?resize=340%2C400&ssl=1 340w","sizes":"(max-width: 510px) 100vw, 510px","thumbnail_srcset":"https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH240901-ceramic-with-rattan-plate.jpg?resize=280%2C280&ssl=1 280w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH240901-ceramic-with-rattan-plate.jpg?resize=300%2C300&ssl=1 300w, https:\/\/i0.wp.com\/vietcraft.vn\/wp-content\/uploads\/2025\/07\/VH240901-ceramic-with-rattan-plate.jpg?resize=100%2C100&ssl=1 100w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"VH240901-ceramic-with-rattan-plate","alt":""}],"categories":[{"id":296,"name":"Ceramic","slug":"ceramic","link":"https:\/\/vietcraft.vn\/product-category\/materials\/ceramic\/"},{"id":207,"name":"Hotel &amp; Restaurant","slug":"hotel-restaurant","link":"https:\/\/vietcraft.vn\/product-category\/home-living\/hotel-restaurant\/"},{"id":70,"name":"Materials","slug":"materials","link":"https