/wp-json\/wc\/store\/v1\/products?related=636&per_page=10"}]}},{"id":629,"name":"Handwoven Rattan Laundry Basket \u2013 Eco-Friendly Storage from Vietnam","slug":"handwoven-rattan-laundry-basket-eco-friendly-storage-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/handwoven-rattan-laundry-basket-eco-friendly-storage-from-vietnam\/","sku":"VH25023","short_description":"<p data-start=\"1755\" data-end=\"1899\">Handwoven rattan laundry basket made in Vietnam. Durable, natural, and stylish \u2014 perfect for laundry storage at home or in hospitality settings.<\/p>","description":"<p data-start=\"321\" data-end=\"597\">This beautifully <strong data-start=\"338\" data-end=\"373\">handwoven rattan laundry basket<\/strong> combines natural aesthetics with functional storage. Crafted by skilled artisans in Vietnam using sustainable rattan, it offers exceptional durability and breathability \u2014 ideal for storing laundry, towels, or toys in style.<\/p>\n<p data-start=\"599\" data-end=\"825\">The basket features a spacious interior, optional lid, and strong woven handles for easy transport. Its clean, natural look makes it suitable for use in <strong data-start=\"752\" data-end=\"792\">bedrooms, bathrooms, hotels, resorts<\/strong>, or eco-conscious retail stores.<\/p>\n<p data-start=\"827\" data-end=\"931\">Available in various sizes and shapes, this basket supports <strong data-start=\"887\" data-end=\"912\">OEM\/ODM customization<\/strong> for global buyers.<\/p>\n<hr data-start=\"933\" data-end=\"936\" \/>\n<h2 data-start=\"938\" data-end=\"960\">\u2705 <strong data-start=\"943\" data-end=\"960\">Key Features:<\/strong><\/h2>\n<ul data-start=\"962\" data-end=\"1303\">\n<li data-start=\"962\" data-end=\"1015\">\n<p data-start=\"964\" data-end=\"1015\">100% handwoven from natural <strong data-start=\"992\" data-end=\"1013\">Vietnamese rattan<\/strong><\/p>\n<\/li>\n<li data-start=\"1016\" data-end=\"1063\">\n<p data-start=\"1018\" data-end=\"1063\">Strong frame and ventilated weave structure<\/p>\n<\/li>\n<li data-start=\"1064\" data-end=\"1107\">\n<p data-start=\"1066\" data-end=\"1107\">Lightweight, durable, and biodegradable<\/p>\n<\/li>\n<li data-start=\"1108\" data-end=\"1152\">\n<p data-start=\"1110\" data-end=\"1152\">Optional lid and handles for convenience<\/p>\n<\/li>\n<li data-start=\"1153\" data-end=\"1206\">\n<p data-start=\"1155\" data-end=\"1206\">Ideal for <strong data-start=\"1165\" data-end=\"1204\">home, hotel, resort, and retail use<\/strong><\/p>\n<\/li>\n<li data-start=\"1207\" data-end=\"1255\">\n<p data-start=\"1209\" data-end=\"1255\">Custom sizes, colors, and branding available<\/p>\n<\/li>\n<li data-start=\"1256\" data-end=\"1303\">\n<p data-start=\"1258\" data-end=\"1303\">Supports local artisan communities in Vietnam<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1305\" data-end=\"1308\" \/>\n<h2 data-start=\"1310\" data-end=\"1344\">\ud83d\udce6 <strong data-start=\"1316\" data-end=\"1342\">Contact for Wholesale:<\/strong><\/h2>\n<p data-start=\"1345\" data-end=\"1499\">Looking for a <strong data-start=\"1359\" data-end=\"1404\">rattan laundry basket supplier in Vietnam<\/strong>?<br data-start=\"1405\" data-end=\"1408\" \/>We welcome OEM &amp; bulk inquiries.<br data-start=\"1440\" data-end=\"1443\" \/>\ud83d\udce7 <strong data-start=\"1446\" data-end=\"1473\"><a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"1448\" data-end=\"1471\">vietcraft2006@gmail.com<\/a><\/strong><br data-start=\"1473\" data-end=\"1476\" \/>\ud83c\udf10 <strong data-start=\"1479\" data-end=\"1499\"><a class=\"\" href=\"http:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"1481\" data-end=\"1497\">www.vietcraft.vn<\/a><\/strong><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":",","currency_thousand_separato