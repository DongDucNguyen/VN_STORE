\/product\/ceramic-and-rattan-plate-handmade-natural-tableware-from-vietnam\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/688","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=688&per_page=10"}]}},{"id":668,"name":"Handwoven Bamboo Hanging Lampshade \u2013 Natural Lighting for Eco Interiors","slug":"handwoven-bamboo-hanging-lampshade-natural-lighting-for-eco-interiors","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/handwoven-bamboo-hanging-lampshade-natural-lighting-for-eco-interiors\/","sku":"VH240902","short_description":"<p>Eco-friendly bamboo hanging lampshade handcrafted in Vietnam. Ideal for home or commercial interiors, available for wholesale and custom production.<\/p>","description":"<p data-start=\"335\" data-end=\"636\">Elevate your interior space with this stunning <strong data-start=\"382\" data-end=\"410\">bamboo hanging lampshade<\/strong>, handwoven by skilled Vietnamese artisans. Made from sustainably sourced bamboo, each piece offers a harmonious blend of <strong data-start=\"532\" data-end=\"580\">natural texture, warmth, and light diffusion<\/strong>, ideal for modern, rustic, boho, or tropical interiors.<\/p>\n<p data-start=\"638\" data-end=\"890\">Perfect for living rooms, caf\u00e9s, restaurants, resorts, and boutique hotels, our bamboo pendant lights bring an organic touch while reducing plastic and synthetic use. The open-weave design casts beautiful shadows, creating a cozy and inviting ambiance.<\/p>\n<p data-start=\"892\" data-end=\"1078\">As a direct <strong data-start=\"904\" data-end=\"931\">manufacturer in Vietnam<\/strong>, we offer <strong data-start=\"942\" data-end=\"964\">OEM\/ODM production<\/strong> for custom shapes, sizes, weaving patterns, and electrical fittings to suit your brand or project specifications.<\/p>\n<hr data-start=\"1080\" data-end=\"1083\" \/>\n<h2 data-start=\"1085\" data-end=\"1107\">\u2705 <strong data-start=\"1090\" data-end=\"1107\">Key Features:<\/strong><\/h2>\n<ul data-start=\"1109\" data-end=\"1547\">\n<li data-start=\"1109\" data-end=\"1149\">\n<p data-start=\"1111\" data-end=\"1149\"><strong data-start=\"1111\" data-end=\"1149\">Handwoven from 100% natural bamboo<\/strong><\/p>\n<\/li>\n<li data-start=\"1150\" data-end=\"1192\">\n<p data-start=\"1152\" data-end=\"1192\">Lightweight, durable, and eco-friendly<\/p>\n<\/li>\n<li data-start=\"1193\" data-end=\"1255\">\n<p data-start=\"1195\" data-end=\"1255\">Compatible with E27 bulb fittings (optional customization)<\/p>\n<\/li>\n<li data-start=\"1256\" data-end=\"1321\">\n<p data-start=\"1258\" data-end=\"1321\">Available in various shapes: round, bell, dome, drum, cone&#8230;<\/p>\n<\/li>\n<li data-start=\"1322\" data-end=\"1382\">\n<p data-start=\"1324\" data-end=\"1382\">Suitable for home d\u00e9cor, hospitality, or retail lighting<\/p>\n<\/li>\n<li data-start=\"1383\" data-end=\"1447\">\n<p data-start=\"1385\" data-end=\"1447\">Custom sizes, colors, and branding available for bulk orders<\/p>\n<\/li>\n<li data-start=\"1448\" data-end=\"1496\">\n<p data-start=\"1450\" data-end=\"1496\">Made by artisan communities in rural Vietnam<\/p>\n<\/li>\n<li data-start=\"1497\" data-end=\"1547\">\n<p data-start=\"1499\" data-end=\"1547\">Packed flat or assembled for shipping efficiency<\/p>\n<\/li>\n<\/ul>\n<hr data-start=\"1549\" data-end=\"1552\" \/>\n<h2 data-start=\"1554\" data-end=\"1586\">\u2709\ufe0f <strong data-start=\"1560\" data-end=\"1586\">Contact for Wholesale:<\/strong><\/h2>\n<p data-start=\"1588\" data-end=\"1753\">We welcome international bulk orders, retailer partnerships, and hotel\/resort procurement.<br data-start=\"1678\" data-end