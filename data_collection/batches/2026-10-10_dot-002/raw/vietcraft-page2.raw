:129,"name":"rattan tray Vietnam factory","slug":"rattan-tray-vietnam-factory","link":"https:\/\/vietcraft.vn\/product-tag\/rattan-tray-vietnam-factory\/"},{"id":135,"name":"rustic tray for home","slug":"rustic-tray-for-home","link":"https:\/\/vietcraft.vn\/product-tag\/rustic-tray-for-home\/"},{"id":136,"name":"Vietnamese craft tray","slug":"vietnamese-craft-tray","link":"https:\/\/vietcraft.vn\/product-tag\/vietnamese-craft-tray\/"},{"id":130,"name":"wholesale tray supplier","slug":"wholesale-tray-supplier","link":"https:\/\/vietcraft.vn\/product-tag\/wholesale-tray-supplier\/"}],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":false,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Handwoven Rattan Serving Tray \u2013 Wholesale from Vietnam Manufacturer&rdquo;","url":"https:\/\/vietcraft.vn\/product\/handwoven-rattan-serving-tray-wholesale-from-vietnam-manufacturer\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products\/466","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/vietcraft.vn\/wp-json\/wc\/store\/v1\/products?related=466&per_page=10"}]}},{"id":461,"name":"Handwoven Bamboo Pendant Light \u2013 Sustainable Lighting from Vietnam","slug":"handwoven-bamboo-pendant-light-sustainable-lighting-from-vietnam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/vietcraft.vn\/product\/handwoven-bamboo-pendant-light-sustainable-lighting-from-vietnam\/","sku":"VH25012","short_description":"<p>Sustainable handwoven bamboo pendant light from Vietnam. Perfect for wholesalers, interior projects, and eco-conscious retail markets.<\/p>","description":"<p data-start=\"331\" data-end=\"519\">Add warmth and texture to your interior design collection with our <strong data-start=\"398\" data-end=\"432\">handwoven bamboo pendant light<\/strong>, expertly crafted in Vietnam by local artisans using traditional weaving techniques.<\/p>\n<p data-start=\"521\" data-end=\"835\">Each pendant is made from <strong data-start=\"547\" data-end=\"570\">100% natural bamboo<\/strong>, offering a lightweight yet sturdy structure that casts soft, ambient light through its intricate pattern. Perfect for interior designers, importers, and retailers seeking <strong data-start=\"743\" data-end=\"778\">eco-friendly lighting solutions<\/strong>, this piece blends sustainability with artisan elegance.<\/p>\n<p data-start=\"837\" data-end=\"1017\">Ideal for caf\u00e9s, restaurants, resorts, and modern homes, these hanging lights bring a cozy, nature-inspired aesthetic while supporting responsible sourcing and rural craftsmanship.<\/p>\n<p data-start=\"1019\" data-end=\"1116\">We offer <strong data-start=\"1028\" data-end=\"1048\">OEM\/ODM services<\/strong>, bulk production, and private labeling to meet your market\u2019s needs.<\/p>\n<hr data-start=\"1118\" data-end=\"1121\" \/>\n<h3 data-start=\"1123\" data-end=\"1148\">\u2705 <strong data-start=\"1129\" data-end=\"1146\">Key Features:<\/strong><\/h3>\n<ul data-start=\"1149\" data-end=\"1559\">\n<li data-start=\"1149\" data-end=\"1233\">\n<p data-start=\"1151\" data-end=\"1233\">\ud83c\udf3f <strong data-start=\"1154\" data-end=\"1177\">100% Natural Bamboo<\/strong> \u2013 Renewable, biodegradable, and sustainably harvested<\/p>\n<\/li>\n<li data-start=\"1234\" data-end=\"1305\">\n<p data-start=\"1236\" data-end=\"1305\">\u270b <strong data-start=\"1238\" data-end=\"1265\">Handwoven Craftsmanship<\/strong> \u2013 Made by skilled Vietnamese artisans<\/p>\n<\/li>\n<li data-start=\"1306\" data-end=\"1388\">\n<p data-start=\"1308\" data-end=\"1388\">\ud83d\udca1 <strong data-start=\"1311\" data-end=\"1337\">Soft, Ambient Lighting<\/strong> \u2013 Beautiful shadow patterns through bamboo weave<\/p>\n<\/li>\n<li data-start=\"1389\" data-end=\"1469\">\n<p data-start=\"1391\" data-end=\"1469\">\ud83d\udee0\ufe0f <strong data-start=\"1395\" data-end=\"1411\">Customizable<\/strong> \u2013 Sizes, shapes, and finishes tailored for B2B partners<\/p>\n<\/li>\n<li data-start=\"1470\" data-end=\"1559\">\n<p data-start=\"1472\" data-end=\"1559\">\ud83d\udce6 <strong data-start=\"1475\" data-end=\"1509\">Ideal for Hospitality &amp; Retail<\/strong> \u2013 Perfect for hotels, spas, boutiques, eco-stores<\/p>\n<\/li>\n<\/ul>\n<p data-start=\"2081\" data-end=\"2272\">\n<hr data-start=\"2274\" data-end=\"2277\" \/>\n<h3 data-start=\"2279\" data-end=\"2312\"><strong data-start=\"2283\" data-end=\"2310\">For Buyers &amp; Importers:<\/strong><\/h3>\n<p data-start=\"2313\" data-end=\"2453\">We specialize in supplying <strong data-start=\"2340\" data-end=\"2355\">bulk orders<\/strong> and <strong data-start=\"2360\" data-end=\"2394\">custom-designed pendant lights<\/strong> for B2B clients in the EU, US, Japan, Australia, and more.<\/p>\n<p data-start=\"2455\" data-end=\"2595\">\ud83d\udce7 <strong data-start=\"2458\" data-end=\"2468\">Email:<\/strong> <a class=\"cursor-pointer\" rel=\"noopener\" data-start=\"2469\" data-end=\"2492\">vietcraft2006@gmail.com<\/a><br data-start=\"2492\" data-end=\"2495\" \/>\ud83d\udcde <strong data-start=\"2498\" data-end=\"2516\">WhatsApp\/Zalo:<\/strong> +84-975-810-168<br data-start=\"2532\" data-end=\"2535\" \/>\ud83c\udf10 <strong data-start=\"2538\" data-end=\"2550\">Website:<\/strong> <a class=\"\" href=\"https:\/\/www.vietcraft.vn\" target=\"_new\" rel=\"noopener\" data-start=\"2551\" data-end=\"2595\">www.vietcraft.vn<\/a><\/p>","on_sale":false,"pr