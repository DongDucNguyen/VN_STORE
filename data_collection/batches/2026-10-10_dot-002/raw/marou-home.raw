<link rel="stylesheet" href="//maisonmarou.com/cdn/shop/t/2/assets/product-grid.css?v=76661001529552437441784626781" media="print" onload="this.media='all'">
<link rel="stylesheet" href="//maisonmarou.com/cdn/shop/t/2/assets/location-drawer.css?v=150565906294825741791785991634" media="print" onload="this.media='all'">
<link rel="stylesheet" href="//maisonmarou.com/cdn/shop/t/2/assets/shop-location-marou-vn.css?v=23019246591090461331773823257" media="print" onload="this.media='all'">

<script src="//maisonmarou.com/cdn/shop/t/2/assets/shop-location-marou-vn.js?v=78429713434514933371788762223" defer="defer"></script>
<shop-location></shop-location>
<noscript>
	<link href="//maisonmarou.com/cdn/shop/t/2/assets/product-grid.css?v=76661001529552437441784626781" rel="stylesheet" type="text/css" media="all" />
	<link href="//maisonmarou.com/cdn/shop/t/2/assets/location-drawer.css?v=150565906294825741791785991634" rel="stylesheet" type="text/css" media="all" />
	<link href="//maisonmarou.com/cdn/shop/t/2/assets/shop-location-marou-vn.css?v=23019246591090461331773823257" rel="stylesheet" type="text/css" media="all" />
</noscript>

<script type="application/json" id="geo-mapping-data">
  {"Khánh Hoà":["Nha Trang"],"Hồ Chí Minh":["Hồ Chí Minh","Bình Dương"]}
</script>

<script>
	const locale = Shopify.locale !== 'vi' ? {
		"unable_to_retrieve": "Unable to retrieve location. Please select manually.",
		"detected_city": "Detected city/province",
		"not_in_vietnam": "You're not in Vietnam. Please select your location manually.",
		"additional_option_desc_1": "It seems like you are near",
  		"additional_option_desc_2": "Please select your exact area to view accurate stock availability."
	} : {
		"unable_to_retrieve": "Không thể lấy vị trí. Vui lòng chọn thủ công.",
		"detected_city": "Thành phố/Tỉnh",
		"not_in_vietnam": "Bạn không ở Việt Nam. Vui lòng chọn vị trí của bạn thủ công.",
		"additional_option_desc_1": "Có vẻ bạn đang ở gần",
  		"additional_option_desc_2": "Chọn chính xác vị trí hiện tại để xem tình trạng còn hàng của sản phẩm."
	}

	const geoMappingScript = document.getElementById('geo-mapping-data');
	const rawJson = geoMappingScript?.textContent;
	let geoMapping;
	try {
		geoMapping = JSON.parse(rawJson);
	} catch (error) {
		// Malformed geoMapping metafield — drawer falls back to the full store list.
	}

	const updateLocationToCart = async (location, trust = false, province) => {
		const orderFromContentText = document.querySelector('.order-from-content-text');

		const data = {
			attributes: {
				'shop_id': location,
				'shop_id_trust': trust,
				'shop_id_auto_detect': true,
			}
		};
	
		// Gửi yêu cầu POST đến endpoint /cart/update.js của Shopify
		fetch('/cart/update.js', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json'
			},
			body: JSON.stringify(data)
		});

		orderFromContentText.textContent = province;
	}

	function getCurrentLocation(autoDetecting = false) {
		// if (!navigator.geolocation) {
		// 	alert('Geolocation is not supported by your browser.');
		// 	return;
		// }

		navigator.geolocation.getCurrentPosition(
			(position) => {
				const { latitude, longitude } = position.coords;
				reverseGeocode(latitude, longitude, autoDetecting);
			},
			(error) => {
				// Permission denied or timeout — user picks their location manually.
			}
		);
	}

	function toSlug(text) {
		return text
			.toLowerCase() // convert to lowercase
			.normalize('NFD') // decompose combined letters into base letters + diacritics
			.replace(/[\u0300-\u036f]/g, '') // remove diacritics
			.replace(/đ/g, 'd') // convert special Vietnamese letter
			.replace(/[^a-z0-9\s-]/g, '') // remove all non-word characters
			.trim() // trim whitespace
			.replace(/\s+/g, '-') // replace spaces with hyphens
			.replace(/-+/g, '-'); // collapse multiple hyphens
	}

	const checkValidLocation = (value, autoDetecting = false, trust = false, province) => {
		let found = false;
		const select = document.querySelector('.location-drawer #select-location');
		const additionalOptions = document.querySelector('.additional-options');
		const locationMessage = document.querySelector('.location-message');
		const options = Array.from(select.options);

		options.forEach(option => {
			if (value.includes(toSlug(option.textContent))) {
				option.selected = true;
				select.dispatchEvent(new Event('change'));
				found = true;
				if (autoDetecting) {
					updateLocationToCart(option.value, trust, province);
				}
			}
		});

		const time = found ? 1000 : 5000;

		if (!found) {
			locationMessage.textContent = locale.unable_to_retrieve;
			locationMessage.classList.add('visible');
		}
		setTimeout(() => {
			locationMessage.classList.remove('visible');
			additionalOptions.classList.remove('visible');
		}, time);

	}

	function reverseGeocode(lat, lon, autoDetecting = false) {
		const url = `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json`;
		// const url = `https://nominatim.openstreetmap.org/reverse?lat=10.866578&lon=106.607261&format=json`; // HCM
		// const url = `https://nominatim.openstreetmap.org/reverse?lat=11.726971&lon=108.902767&format=json`; // Khánh hòa
		// const url = `https://nominatim.openstreetmap.org/reverse?lat=15.939952&lon=107.963940&format=json`; //đà nẵng
		// const url = `https://nominatim.openstreetmap.org/reverse?lat=13.067802&lon=109.014941&format=json`; //phú yên

		const locationMessage = document.querySelector('.location-message');
		const additionalOptions = document.querySelector('.additional-options');
		const additionalOptionListWrapper = document.querySelector('.additional-option-list-wrapper');
		const additionalOptionDesc = document.querySelector('.additional-options-desc');

		fetch(url)
			.then((res) => res.json())
			.then((data) => {
				const normalizeCountry = toSlug(data.address.country.toLowerCase()).replace('-','');
				if (normalizeCountry === "vietnam") {
					const province =
						data.address.city ||
						data.address.state ||
						data.address.region ||
						data.address.county ||
						'Unknown';

					const provinceSlug = toSlug(province);
					let found = false;
					const matchingKey = Object.keys(geoMapping).find(key => provinceSlug.includes(toSlug(key)));

					if (matchingKey) {
						additionalOptionDesc.textContent = `${locale.additional_option_desc_1} ${province}. ${locale.additional_option_desc_2}`;
						const oldCities = geoMapping[matchingKey];
						
						if (oldCities.length > 1) {
							if (autoDetecting) {
								document.querySelector('.location-drawer')?.classList.add('active');
								document.body.classList.add('open-cc');
								document.querySelector('.additional-options')?.classList.add('visible');
							}
							additionalOptionListWrapper.innerHTML = '';
							additionalOptions.classList.add('visible');

							oldCities.forEach(item => {
								additionalOptionListWrapper.innerHTML += `
									<button class="additional-option" value=${toSlug(item)} data-value="${item}">
										<span class="radio">
											<span class="selected-radio"></span>
										</span>
										<span class="label">${item}</span>
									</button>
								`;
							});

							const additionalOptionList = additionalOptions.querySelectorAll('.additional-option');
							additionalOptionList.forEach(item => {
								item.addEventListener('click', () => {
									additionalOptionList.forEach(btn => {
										btn.classList.remove('selected');
									});
									item.classList.add('selected');

									checkValidLocation(item.value, autoDetecting, true, item.dataset.value);
								});
							})
						} else if (oldCities.length === 1) {
							checkValidLocation(toSlug(oldCities[0]), autoDetecting, false, oldCities[0]);
						}
					} else {
						checkValidLocation(provinceSlug, autoDetecting, false, province);
					}
				} else {
					locationMessage.textContent = locale.not_in_vietnam;
					locationMessage.classList.add('visible');
				}
			})
			.catch(() => {
				// Reverse geocoding failed — user picks their location manually.
			});
	}

	async function getCart() {
		const response = await fetch('/cart.js', {
			method: 'GET',
			headers: {
				'Content-Type': 'application/json'
			}
		});
		const cart = await response.json();
		
		if (!cart.attributes.shop_id_auto_detect && !cart.attributes.shop_id_trust) {
			getCurrentLocation(true);
		}
	}

	// Auto-detect (and its browser location permission prompt) is only useful for
	// Vietnam stock. marouDetectedCountry lives in shop-location-marou-vn.js, which
	// is deferred, so wait for DOMContentLoaded before calling it.
	// Pages with the custom.disable_geolocation metafield skip the prompt entirely
	// (e.g. pages embedded in Instagram's in-app browser, where it breaks the page).
	
	document.addEventListener('DOMContentLoaded', () => {
		const detected = window.marouDetectedCountry ? window.marouDetectedCountry() : Promise.resolve('');
		detected.then((country) => {
			if (window.marouIsVietnamOrUnknown && !window.marouIsVietnamOrUnknown(country)) return;
			getCart();
		});
	});
	

	document.querySelector('.use-current-location').addEventListener('click', () => {
		getCurrentLocation();
	});
</script>
