<script>
document.addEventListener('click', function(e) {
  var btn = e.target.closest('.thb-quick-search');
  if (!btn) return;
  e.preventDefault();
  if (window.__predictiveSearchReady) return;
  var drawer = document.getElementById('Search-Drawer');
  if (!drawer) return;
  document.body.classList.toggle('open-cc');
  document.body.classList.toggle('open-search-box');
  drawer.classList.toggle('active');
}, true);

document.addEventListener('click', function(e) {
  if (e.target.closest('.order-from-inner-close') || e.target.closest('.order-from-inner__tooltip')) return;
  var btn = e.target.closest('order-from-inner');
  if (!btn) return;
  var drawer = document.getElementById('Location-Drawer');
  if (!drawer) return;
  if (!drawer.classList.contains('active')) {
    drawer.classList.add('active');
    document.body.classList.add('open-cc');
  }
}, true);
</script>


	
	<script>
		try {
			var marouCountry = sessionStorage.getItem('marou_detected_country');
			if (marouCountry && marouCountry !== 'VN') {
				document.documentElement.classList.add('country-outside-vn');
			}
		} catch (e) {
			// sessionStorage blocked (private mode) — the deferred script handles it.
		}
	</script>

