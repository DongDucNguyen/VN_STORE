        <g clip-path="url(#clip0_1065_199)">
        <path d="M10.5 13.63C11.3726 13.6301 12.2094 13.2836 12.8265 12.6667C13.4436 12.0498 13.7904 11.213 13.7905 10.3405C13.7906 9.46793 13.4441 8.63105 12.8272 8.01396C12.2103 7.39687 11.3736 7.05012 10.501 7.04999C9.62844 7.04999 8.79161 7.39661 8.17462 8.01361C7.55762 8.6306 7.211 9.46743 7.211 10.34C7.211 11.2125 7.55762 12.0494 8.17462 12.6664C8.79161 13.2834 9.62844 13.63 10.501 13.63H10.5Z" stroke="white" stroke-miterlimit="10"></path>
        <path d="M10.73 0.5C16.23 0.5 20.69 4.95 20.69 10.44C20.69 10.44 21.1 17.48 10.69 24.63H10.51C0.100023 17.48 0.500023 10.44 0.500023 10.44C0.500023 4.95 4.96002 0.5 10.46 0.5H10.73Z" stroke="white" stroke-linecap="round" stroke-linejoin="round"></path>
        </g>
        <defs>
        <clipPath id="clip0_1065_199">
        <rect width="22" height="26" fill="white"></rect>
