<script>
  class ProductMenuMarouVN extends HTMLElement {
    connectedCallback() {
      //console.log("Test cusom element");
      if (!this.swipersInitialized) {
        this.swipersInitialized = true;
        const swiperElement = this.querySelector('.swiper');
        if (!swiperElement.swiper) {
          swiperElement.swiper = new Swiper(swiperElement, {
            loop: true,
            slidesPerView: 4,
            spaceBetween: 30,
            pagination: {
              el: swiperElement.querySelector('.swiper-pagination'),
              dynamicBullets: true
            },
            breakpoints: {
              0: {
                slidesPerView: 1,
              },
              375: {
                slidesPerView: 2,
                spaceBetween: 16
              },
              1440: {
                slidesPerView: 4,
                spaceBetween: 30
              }
            }
          });
        }
      }
    }
  }
  if (!customElements.get('product-menu-marou-vn')) {
    customElements.define('product-menu-marou-vn', ProductMenuMarouVN)
  }
</script><style> #shopify-section-sections--16841236152528__footer .widget--text a.button {margin-top: 0px;} </style></div>
