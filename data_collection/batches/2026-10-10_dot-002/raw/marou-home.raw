function updateFooterHeight() {
  const footer = document.querySelector('.side-panel-footer');
  if (footer) {
    const height = footer.offsetHeight;
    document.documentElement.style.setProperty('--panel-footer-height', `${height}px`);
  }
}

function onResizeOrLoad() {
  updateFooterHeight();
}

window.addEventListener('resize', onResizeOrLoad);
window.addEventListener('orientationchange', onResizeOrLoad);
document.addEventListener('DOMContentLoaded', onResizeOrLoad);

</script>



		

