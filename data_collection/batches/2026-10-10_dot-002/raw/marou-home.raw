<!-- END app block --><!-- BEGIN app block: shopify://apps/addingwell/blocks/aw-gtm/c8ed21e7-0ac8-4249-8c91-cbdde850b5b8 --><script
  type="module"
>
  setTimeout(async function () {
    const keySessionStorage = 'aw_settings';
    let __AW__settings = JSON.parse(sessionStorage.getItem(keySessionStorage));
    if(!__AW__settings) {
      const awSettings = await fetch(
              "/apps/addingwell-proxy",
              {
                method: "GET",
                redirect: "follow",
                headers: {'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*'}
              }
      );
      if (awSettings.ok) {
        __AW__settings = await awSettings.json();
        sessionStorage.setItem(keySessionStorage, JSON.stringify(__AW__settings));
      } else {
        console.error('Addingwell - Loading proxy error', awSettings.status);
        return;
      }
    }

    if(__AW__settings.insertGtmTag && __AW__settings.gtmId) {
      let __AW__gtmUrl = 'https://www.googletagmanager.com/gtm.js';
      let __AW__isAddingwellCdn = false;
      if(__AW__settings.insertGtmUrl && __AW__settings.gtmUrl) {
        __AW__gtmUrl = __AW__settings.gtmUrl;
        __AW__isAddingwellCdn = __AW__settings.isAddingwellCdn;
      }

      (function(w,d,s,l,i){
        w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
        j.async=true;
        j.src=`${__AW__gtmUrl}?${__AW__isAddingwellCdn ? 'awl' : 'id'}=`+(__AW__isAddingwellCdn ? i.replace(/^GTM-/, '') : i)+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script',`${__AW__settings.dataLayerVariableName}`,`${__AW__settings.gtmId}`);
    }

    const __AW__getEventNameWithSuffix = (eventName) => {
      return eventName + (__AW__settings.dataLayerEventSuffix ? "_" + __AW__settings.dataLayerEventSuffix : "");
    }

    function __AW__waitForShopifyYCookie(maxAttempts, intervalMs) {
      return new Promise(function(resolve) {
        let attempts = 0;
        maxAttempts = maxAttempts || 5;
        intervalMs = intervalMs || 200;
        function check() {
          const match = document.cookie.match(/(?:^|;\s*)_shopify_y=([^;]*)/);
          if (match) {
            resolve(match[1]);
          } else if (attempts < maxAttempts) {
            attempts++;
            setTimeout(check, intervalMs);
          } else {
            console.warn('[AW] _shopify_y cookie not found after consent');
            resolve(null);
          }
        }
        check();
      });
    }

    const __AW__CONSENT_KEY = 'aw_consent_state';

    function __AW__getConsentState() {
      try {
        if (window.Shopify?.customerPrivacy?.currentVisitorConsent) {
          return JSON.stringify(window.Shopify.customerPrivacy.currentVisitorConsent());
        }
      } catch(e) {}
      return null;
    }

    function __AW__isEmptyConsent(stateStr) {
      try {
        return Object.values(JSON.parse(stateStr)).every(v => v === '');
      } catch(e) {}
      return true;
    }

    let __AW__prevConsentState = __AW__getConsentState() ?? localStorage.getItem(__AW__CONSENT_KEY);

    document.addEventListener('visitorConsentCollected', async function(event) {
      const currentConsentState = __AW__getConsentState();

      if (currentConsentState !== null && currentConsentState === __AW__prevConsentState) {
        return;
      }

      __AW__prevConsentState = currentConsentState;

      if (currentConsentState !== null) {
        if (__AW__isEmptyConsent(currentConsentState)) {
          localStorage.removeItem(__AW__CONSENT_KEY);
        } else {
          localStorage.setItem(__AW__CONSENT_KEY, currentConsentState);
        }
      }

      window.Shopify.analytics.publish('addingwell:shopify_update_consent', {visitorConsentCollected: true});

      const shopifyY = await __AW__waitForShopifyYCookie();
      if (!shopifyY) return;

      window[__AW__settings.dataLayerVariableName] = window[__AW__settings.dataLayerVariableName] || [];
      window[__AW__settings.dataLayerVariableName].push({
        event: __AW__getEventNameWithSuffix('shopify_consent_updated'),
      });
    });

    if(__AW__settings.enableDataLayer) {
      const MAX_ITEMS_BATCH = 10;
      const sendBatchEvents = (items, eventName, eventObject) => {
        let batch = [];
        for(let i  = 0; i < items.length; i++) {
          batch.push(items[i]);
          if(batch.length === MAX_ITEMS_BATCH || i === items.length - 1) {
            const eventClone = {
              ...eventObject,
              ecommerce: {
                ...eventObject.ecommerce,
                items: [...batch]
              }
            };
            window[__AW__settings.dataLayerVariableName].push({ ecommerce: null });
            window[__AW__settings.dataLayerVariableName].push({
              ...{'event': __AW__getEventNameWithSuffix(eventName)},
              ...eventClone
            });

            batch = [];
          }
        }
      }

      function __AW__filterNullOrEmpty(obj) {
        let filteredObj = {};

        for (let key in obj) {
          if (obj.hasOwnProperty(key)) {
            let value = obj[key];

            // If value is an object (and not null), recursively filter sub-elements
            if (typeof value === "object" && value !== null && value !== undefined) {
              let filteredSubObject = __AW__filterNullOrEmpty(value);

              // Add the filtered sub-object only if it's not empty
              if (Object.keys(filteredSubObject).length > 0) {
                filteredObj[key] = filteredSubObject;
              }
            } else {
              // Add the value only if it's neither null nor an empty string
              if (value !== null && value !== "" && value !== undefined) {
                filteredObj[key] = value;
              }
            }
          }
        }
        return filteredObj;
      }

      function getPageType(value) {
        const pageTypeMapping = {
          404: '404',
          article: 'article',
          blog: 'blog',
          cart: 'cart',
          collection: 'collection',
          gift_card: 'gift_card',
          index: 'homepage',
          product: 'product',
          search: 'searchresults',
          'customers/login': 'login',
          'customers/register': 'sign_up'
        };
        return pageTypeMapping[value] || 'other';
      }
      let __AW__cartReady = false;
      const cartRegex = /\/cart\/(add|change|update)(\.js|\.json)?(\?.*)?$/;
      const pendingCartEventName = "aw_pending_cart_event";
      let awCartQueue = Promise.resolve();

      function pushDataLayerEvents() {
        initCart();
        window[__AW__settings.dataLayerVariableName] = window[__AW__settings.dataLayerVariableName] || [];  // init data layer if doesn't already exist
        const templateName = "index";

        const getFormattedPrice = (priceInCents) => priceInCents/100;
        /**********************
         * DATALAYER SECTIONS
         ***********************/
        /**
         * DATALAYER: User Data
         * Build user_data properties.
         */
        let newCustomer = true;
        window.__AW__CommonData = {
          user_data: {
            new_customer: newCustomer,
          }
        };

        

        window.__AW__CommonData.country = "VN"
        window.__AW__CommonData.market = "vietnam"
        window.__AW__CommonData.marketId = 18350440656

        
          window.__AW__CommonData.language = "en-VN";
        
        window.__AW__CommonData = __AW__filterNullOrEmpty(window.__AW__CommonData);

        // Ajout du hash SHA256 des champs sensibles de user_data (version robuste)
        async function sha256(str) {
          if (!str) return undefined;
          if (!(window.crypto && window.crypto.subtle)) {
            console.error('Crypto.subtle non supporté, hash impossible pour :', str);
            return undefined;
          }
          try {
            const buf = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
            return Array.from(new Uint8Array(buf)).map(x => x.toString(16).padStart(2, '0')).join('');
          } catch (e) {
            console.error('Erreur lors du hash SHA256 pour', str, e);
            return undefined;
          }
        }
        async function getUserDataHash(user_data) {
          const hashObj = {};
          if (!user_data) return hashObj;
          try {
            if (user_data.email_address) hashObj.email_address = await sha256(user_data.email_address);
            if (user_data.phone_number) hashObj.phone_number = await sha256(user_data.phone_number);
            if (user_data.address && typeof user_data.address === 'object') {
              hashObj.address = {};
              if (user_data.address.first_name) hashObj.address.first_name = await sha256(user_data.address.first_name);
              if (user_data.address.last_name) hashObj.address.last_name = await sha256(user_data.address.last_name);
              if (user_data.address.street) hashObj.address.street = await sha256(user_data.address.street);
              if (user_data.address.city) hashObj.address.city = await sha256(user_data.address.city);
              if (user_data.address.region) hashObj.address.region = await sha256(user_data.address.region);
              if (user_data.address.postal_code) hashObj.address.postal_code = await sha256(user_data.address.postal_code);
              if (user_data.address.country) hashObj.address.country = await sha256(user_data.address.country);
            }
          } catch (e) {
            console.error('Erreur lors du hash user_data_hashed', e);
          }
          return __AW__filterNullOrEmpty(hashObj);
        }
        (async function() {
          if (window.__AW__CommonData && window.__AW__CommonData.user_data) {
            window.__AW__CommonData.user_data_hashed = await getUserDataHash(window.__AW__CommonData.user_data);
          }
        })();

        window.__AW__CommonData["page_type"] = getPageType(templateName);
        window.__AW__CommonData["theme"] = window?.Shopify?.theme;
        window[__AW__settings.dataLayerVariableName].push(window.__AW__CommonData);

        window[__AW__settings.dataLayerVariableName].push({"event": __AW__getEventNameWithSuffix("page_view")});

        /** DATALAYER: select_item handoff */
        const pendingSelectItemName = "aw_pending_select_item";

        const __AW__pushSelectItem = (payload) => {
          window[__AW__settings.dataLayerVariableName].push({ ecommerce: null });
          window[__AW__settings.dataLayerVariableName].push(payload);
        };

        const __AW__flushPendingSelectItem = () => {
          let pending = null;
          try {
            pending = sessionStorage.getItem(pendingSelectItemName);
            sessionStorage.removeItem(pendingSelectItemName);
          } catch (e) {
            return;
          }
          if (!pending) return;
          try {
            __AW__pushSelectItem(JSON.parse(pending));
          } catch (e) {
            console.warn('[AW] pending select_item error', e);
          }
        };

        __AW__flushPendingSelectItem();


        /**
         * DATALAYER: 404 Pages
         * Fire on 404 Pages */
        


        /**
         * DATALAYER: Blog Articles
         * Fire on Blog Article Pages */
        

        

        

        /** DATALAYER: Product List Page (Collections, Category)
         * Fire on all product listing pages. */

        const __AW__transformNumberToString = (value) => {
          if (value !== null && value !== undefined && typeof value === 'number') {
            return value.toString();
          }
          /** By Default return the current value */
          return value;
        };

        let discountPrice = 0.00;
        

        /** DATALAYER: Product Page
         * Fire on all Product View pages. */
        

        /** DATALAYER: Cart View
         * Fire anytime a user views their cart (non-dynamic) */
        

        let drawerCartAlreadyOpened = false;
        let pendingViewCartTimeout = null;

        let stateObserver = null;
        let domObserver = null;

        function initCart() {
          fetch(`${window.Shopify?.routes?.root || "/"}cart.js?adw=1&init=1`, {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
          }).then(r => r.ok ? r.json() : null)
            .then(freshCart => {
              if (freshCart) {
                window.__AW__slaveShopifyCart = freshCart;
              } else {
                window.__AW__slaveShopifyCart = { items: [] };
              }
              __AW__cartReady = true;
            })
            .catch(e => {
              console.warn('[AW] Cart hydration failed', e);
              window.__AW__slaveShopifyCart = { items: [] };
              __AW__cartReady = true;
            })
            .finally(() => {
              // A snapshot left by a non-AJAX add to cart (form submit + reload) can only be synced once the cart is ready
              if (sessionStorage.getItem(pendingCartEventName)) {
                scheduleCartSync();
              }
            });
        }

        function fireViewCartOncePerOpen() {
          if (pendingViewCartTimeout) return;

          drawerCartAlreadyOpened = true;

          pendingViewCartTimeout = setTimeout(() => {
            pendingViewCartTimeout = null;
            if (!__AW__cartReady) return;
            const ecommerceDataLayer = {
              ecommerce: {
                currency: window.__AW__slaveShopifyCart.currency,
                value: window.__AW__slaveShopifyCart.total_price / 100,
                items: window.__AW__slaveShopifyCart.items.map(item => {
                  const price = (item.discounted_price ?? item.price) / 100;
                  const discount = (item.price - (item.discounted_price ?? 0)) / 100;

                  let coupon = "";
                  if (Array.isArray(item?.discounts)) {
                    coupon = item.discounts
                            .filter(d => typeof d?.title === "string")
                            .map(d => d.title)
                            .join(", ");
                  }

                  return {
                    item_id: __AW__transformNumberToString(item.product_id),
                    item_variant: item.variant_title,
                    item_variant_title: item.variant_title,
                    item_variant_id: __AW__transformNumberToString(item.variant_id),
                    item_product_id: __AW__transformNumberToString(item.product_id),
                    item_product_title: item.product_title,
                    item_name: item.product_title,
                    price,
                    discount,
                    item_brand: item.vendor,
                    item_category: item.product_type,
                    item_list_name: item.collection || "",
                    item_list_id: "",
                    quantity: item.quantity,
                    sku: __AW__transformNumberToString(item.sku),
                    coupon,
                    url: item.url,
                    selling_plan_id     : item?.selling_plan_allocation?.selling_plan?.id,
                    selling_plan_name   : item?.selling_plan_allocation?.selling_plan?.name

                  };
                })
              }
            };

            window[__AW__settings.dataLayerVariableName].push({ ecommerce: null });
            window[__AW__settings.dataLayerVariableName].push({
              event: __AW__getEventNameWithSuffix("view_cart"),
              ...ecommerceDataLayer
            });
          }, 1000);
        }

        function resetOnClose() {
          drawerCartAlreadyOpened = false;
          if (pendingViewCartTimeout) {
            clearTimeout(pendingViewCartTimeout);
            pendingViewCartTimeout = null;
          }
        }

        function getTargets() {
          const cartDrawer = document.querySelector("cart-drawer");
          const dialog =
                  document.querySelector("cart-drawer dialog") ||
                  document.querySelector("cart-drawer-component dialog") ||
                  document.querySelector("cart-drawer-component dialog[ref='dialog']");

          return { cartDrawer, dialog };
        }

        function isCartOpen({ cartDrawer, dialog }) {
          const openByDialog = !!dialog && (dialog.open || dialog.hasAttribute("open"));
          const openByClass = !!cartDrawer && cartDrawer.classList.contains("active");
          const openByAttr = !!cartDrawer && cartDrawer.hasAttribute("open");
          return openByDialog || openByClass || openByAttr;
        }

        function attachStateObserver() {
          const { cartDrawer, dialog } = getTargets();

          if (stateObserver) stateObserver.disconnect();

          stateObserver = new MutationObserver(() => {
            const openNow = isCartOpen(getTargets());

            if (openNow) {
              if (!drawerCartAlreadyOpened) fireViewCartOncePerOpen();
            } else {
              resetOnClose();
            }
          });

          if (cartDrawer) {
            stateObserver.observe(cartDrawer, {
              attributes: true,
              attributeFilter: ["class", "open"]
            });
          }

          if (dialog) {
            stateObserver.observe(dialog, {
              attributes: true,
              attributeFilter: ["open"]
            });
          }

          const openNow = isCartOpen(getTargets());
          if (openNow) {
            if (!drawerCartAlreadyOpened) fireViewCartOncePerOpen();
          } else {
            resetOnClose();
          }
        }

        function observeCartDrawerOpen() {
          attachStateObserver();

          if (domObserver) domObserver.disconnect();

          domObserver = new MutationObserver(() => {
            attachStateObserver();
          });

          domObserver.observe(document.documentElement, {
            childList: true,
            subtree: true
          });
        }

        observeCartDrawerOpen();


        /** DATALAYER: Search Results */
        var searchPage = new RegExp("search", "g");
        if(document.location.pathname.match(searchPage)){
          var __AW__items = [];
          

          const awEcommerceSearch = {
            search_term: null,
            results_count: null,
            ecommerce: {
              currency: "VND",
              items : []
            }
          };
          sendBatchEvents(__AW__items, "search", awEcommerceSearch);
        }


        document.addEventListener('click', async function(e) {
          const btn = e.target.closest('[href*="/cart/add"], [action*="/cart/add"], button[name="add"]');
          if (!btn || !__AW__cartReady) return;
          snapshotCart();
        }, true);

        patchFetch();
        patchXhr();

        function snapshotCart() {
          try {
            sessionStorage.setItem(
              pendingCartEventName,
              JSON.stringify(window.__AW__slaveShopifyCart ?? { items: [] })
            );
          } catch (e) {
            console.warn('[AW] snapshot error', e);
          }
        }

        function patchXhr() {
          const nativeSend = typeof XMLHttpRequest === 'function' ? XMLHttpRequest.prototype?.send : null;
          if (typeof nativeSend !== 'function' || nativeSend.__AW__patched) return;

          XMLHttpRequest.prototype.send = function(body) {
            this.addEventListener('load', () => {
              try {
                const abs = this.responseURL || '';
                const u = new URL(abs, location.origin);
                const mt = u.pathname + (u.search || '');
                if (this.status === 200 && cartRegex.test(mt)) {
                  scheduleCartSync();
                }
              } catch (e) {
                console.error('[AW] XHR handler error', e);
              }
            });
            return nativeSend.apply(this, arguments);
          };

          XMLHttpRequest.prototype.send.__AW__patched = true;
        }

        function patchFetch() {
          const previousFetch = window.fetch;
          if (typeof previousFetch !== 'function' || previousFetch.__AW__patched) return;

          window.fetch = async function (...args) {
            const resource = args[0];
            try {

              const url = resource instanceof Request ? resource.url  : resource instanceof URL ? resource.href : String(resource);
              if (cartRegex.test(url)) {
                const response = await previousFetch.apply(this, args);
                if (response.ok) {
                  scheduleCartSync();
                } else {
                  console.warn(`Fetch for ${url} failed with status: ${response.status}`);
                }
                return response;
              }
            } catch (error) {
              console.error('[AW] Fetch Wrapper Error:', error);
            }

            return previousFetch.apply(this, args);
          };

          window.fetch.__AW__patched = true;
        }

        function scheduleCartSync() {
          if (!__AW__cartReady) return;
          awCartQueue = awCartQueue
            .then(() => {
              if (!sessionStorage.getItem(pendingCartEventName)) snapshotCart();
              return runCartSyncOnce();
            }).catch(e => {
              console.error('[AW] scheduleCartSync error', e);
            });
        }

        async function runCartSyncOnce() {
          try {
            const response = await fetch(`${window.Shopify.routes.root || "/"}cart.js?adw=1`, {
              credentials: 'same-origin',
              headers: { 'Accept': 'application/json' }
            });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            const newCart = await response.json();
            await compareCartData(newCart);
          } catch (error) {
            console.error('[AW] Error fetching /cart.js (singleton):', error);
          }
        }

        function compareCartData(newCartData) {
          return new Promise((resolve) => {
            setTimeout(() => {
              try {
                const oldCartData = sessionStorage.getItem(pendingCartEventName) ? JSON.parse(sessionStorage.getItem(pendingCartEventName)) : {items: []};
                newCartData = newCartData || {items: []};
                const cartItemKey = item => `${item.variant_id ?? item.id}:${item.selling_plan_allocation?.selling_plan?.id ?? ''}`;
                const oldItems = new Map(oldCartData.items.map(item => [cartItemKey(item), item]));
                const newItems = new Map(newCartData.items.map(item => [cartItemKey(item), item]));

                newItems.forEach((newItem, key) => {
                  const oldItem = oldItems.get(key);
                  const eventName = "add_to_cart";
                  if (!oldItem) {
                    handleCartDataLayer(eventName, newItem.quantity, newItem);
                  } else if (newItem.quantity > oldItem.quantity) {
                    handleCartDataLayer(eventName, newItem.quantity - oldItem.quantity, newItem);
                  }
                });

                oldItems.forEach((oldItem, key) => {
                  const newItem = newItems.get(key);
                  const eventName = "remove_from_cart";
                  if (!newItem) {
                    handleCartDataLayer(eventName, oldItem.quantity, oldItem);
                  } else if (oldItem.quantity > newItem.quantity) {
                    handleCartDataLayer(eventName, oldItem.quantity - newItem.quantity, newItem);
                  }
                });

                sessionStorage.removeItem(pendingCartEventName);
                window.__AW__slaveShopifyCart = newCartData;
              } catch(e) {
                console.error('[AW] compareCartData error', e);
                sessionStorage.removeItem(pendingCartEventName);
              } finally {
                resolve();
              }
            }, 500);
          });
        }

        function handleCartDataLayer(eventName, quantity, item) {
          const price = (item.discounted_price ?? item.price) / 100;
          const discount = (item.price - (item.discounted_price ?? 0)) / 100;
          const totalValue = price * quantity;
          let coupon = "";
          if(Array.isArray(item?.discounts)) {
            coupon = item.discounts
                    .filter(discount => typeof discount?.title === 'string')
                    .map(discount => discount.title)
                    .join(', ');
          }

          const ecommerceCart = {
            ecommerce: {
              currency: "VND",
              value: totalValue,
              items: [{
                item_id: __AW__transformNumberToString(item.product_id),
                item_variant: item.variant_title || "Default Variant",
                item_variant_id: __AW__transformNumberToString(item.variant_id),
                item_variant_title: item.variant_title || "Default Variant",
                item_name: item.product_title,
                item_product_id: __AW__transformNumberToString(item.product_id),
                item_product_title: item.product_title,
                sku: __AW__transformNumberToString(item.sku),
                discount: discount,
                price: price,
                item_brand: item.vendor,
                item_category: item.product_type,
                quantity: quantity,
                coupon: coupon,
                url: item?.url,
                selling_plan_id     : item?.selling_plan_allocation?.selling_plan?.id,
                selling_plan_name   : item?.selling_plan_allocation?.selling_plan?.name
              }]
            }
          };

          window[__AW__settings.dataLayerVariableName].push({ ecommerce: null });
          window[__AW__settings.dataLayerVariableName].push({
            ...{ 'event': __AW__getEventNameWithSuffix(eventName) },
            ...ecommerceCart
          });

        }
      }

      if (document.readyState === 'loading') {
        // document still loading...
        document.addEventListener('DOMContentLoaded', () => {
          pushDataLayerEvents();
        });
      } else {
        // already loaded, chocs away!
        pushDataLayerEvents();
      }
    }
  }, 0);
</script>


