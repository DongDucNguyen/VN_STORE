	</script><script type="module">
		import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';
		window.Shopify = window.Shopify || {};
		window.Shopify.StandardEvents = StandardEvents;

		const dispatchViewEvents = () => {
			document.dispatchEvent(new StandardEvents.PageViewEvent({
				page: {
					template: "index",
					title: document.title,
					url: window.location.href
				}
			}));
		};
		// Static module scripts always execute before DOMContentLoaded fires,
		// so the listener is guaranteed to run. Waiting for DOMContentLoaded
		// gives app pixels registered by other deferred scripts time to attach.
		document.addEventListener('DOMContentLoaded', dispatchViewEvents);
	</script>
	<script>
		// Standard-events debug logger. Toggle per browser: append ?se_debug=1
		// to any URL to enable, ?se_debug=0 to disable. Off by default.
		(function () {
			const params = new URLSearchParams(location.search);
			if (params.has('se_debug')) localStorage.setItem('se_debug', params.get('se_debug'));
			if (localStorage.getItem('se_debug') !== '1') return;
			[
				'shopify:page:view', 'shopify:product:view', 'shopify:product:select',
				'shopify:cart:view', 'shopify:cart:lines-update', 'shopify:cart:note-update',
				'shopify:cart:discount-update', 'shopify:cart:error',
				'shopify:collection:view', 'shopify:collection:update', 'shopify:search:update'
			].forEach((name) => {
				document.addEventListener(name, (event) => {
					console.log('Shopify event:', name, event.detail || event);
				});
			});
		})();
	</script>
