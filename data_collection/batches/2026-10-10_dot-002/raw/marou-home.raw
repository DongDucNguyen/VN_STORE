  <script>
(function() {
	function trackSelectItem(event) {
		if (!(event.target instanceof Element)) return;
		var link = event.target.closest('a[href*="/products/"]');
		if (!link) return;
		var itemEl = link.closest('[data-select-item]');
		if (!itemEl) return;
		var item;
		try {
			item = JSON.parse(itemEl.getAttribute('data-select-item'));
		} catch (e) {
			return;
		}
		var list = itemEl.closest('[data-select-item-list]');
		if (list) {
			item.item_list_id = list.getAttribute('data-select-item-list-id') || '';
			item.item_list_name = list.getAttribute('data-select-item-list-name') || '';
		}
		window.dataLayer = window.dataLayer || [];
		window.dataLayer.push({ ecommerce: null });
		window.dataLayer.push({
			event: 'select_item',
			ecommerce: {
				currency: "VND",
				item_list_id: item.item_list_id || '',
				item_list_name: item.item_list_name || '',
				items: [item]
			}
		});
	}
	document.addEventListener('click', trackSelectItem, true);
	document.addEventListener('auxclick', function(event) {
		if (event.button === 1) trackSelectItem(event);
	}, true);
})();
</script>

