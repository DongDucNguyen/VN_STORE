        <span class="order-from-content-text">Hồ Chí Minh</span>
      </div>
      
        <span class="order-from-inner__tooltip mobile-tooltip" role="tooltip">
          <button class="order-from-inner-close" aria-label="Close location prompt">
            <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex: none;width: 12px;"><path d="M12 1L1 12M12 12L1 1" stroke="#FFFFFF" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
          <strong class="order-from-inner__tooltip-title">Shopping from Hồ Chí Minh</strong>
          <p class="order-from-inner__tooltip-desc">Delivery options and stock availability vary by region.</p>
          <button class="order-from-inner__tooltip-cta order-from-inner-open" aria-label="Update location">Update location</button>
        </span>
        <script>
        document.addEventListener('DOMContentLoaded', function () {
          function shouldShowTooltip() {
            const lastHidden = localStorage.getItem("tooltip_last_hidden");
            if (!lastHidden) return true;
            const now = Date.now();
            const fourteenDays = 14 * 24 * 60 * 60 * 1000;
            return (now - lastHidden) > fourteenDays;
          }

          function dismissTooltips() {
            localStorage.setItem("tooltip_last_hidden", Date.now());
            document.querySelectorAll('.order-from-inner__tooltip').forEach(function(tooltip) {
              tooltip.classList.remove('active');
            });
          }

          document.querySelectorAll('.order-from-inner-close').forEach(function(btn) {
            btn.addEventListener('click', dismissTooltips);
          });

          document.querySelectorAll('.order-from-inner__tooltip-cta').forEach(function(btn) {
            btn.addEventListener('click', function() {
              dismissTooltips();
              document.getElementById('Country-Drawer').classList.add('active');
              document.body.classList.add('open-cc');
            });
          });

          if (!shouldShowTooltip()) {
            document.querySelectorAll('.order-from-inner__tooltip').forEach(function(tooltip) {
              tooltip.classList.remove('active');
            });
          }
        });
        </script>
      
    </order-from-inner>
  </div>
  

</div>
