i hi\u1EC7n h\u00ECnh t\u01B0\u1EE3ng Ng\u1EF1a qua","variants":[{"id":1164835451,"barcode":"A001_442084563","available":true,"price":298080000,"sku":"A001_442084563","option1":"20 cm","option2":"L\u01B0u Ly Xanh","option3":"","options":["20 cm","L\u01B0u Ly Xanh"],"inventory_quantity":20,"old_inventory_quantity":20,"title":"20 cm / L\u01B0u Ly Xanh","weight":1906,"compare_at_price":0,"inventory_management":"haravan","inventory_policy":"deny","selected":false,"url":null,"featured_image":null}],"vendor":"Minh Long","published_at":"2026-04-01T02:43:00Z","created_at":"2026-01-19T09:22:51.656Z","not_allow_promotion":false,"sole_quantity":115}