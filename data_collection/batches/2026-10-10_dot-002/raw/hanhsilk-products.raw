h-muc-san-pham\/decor\/"},{"id":154,"name":"G\u1ed1i b\u00ed\/ G\u1ed1i vu\u00f4ng","slug":"goi-bi-goi-vuong","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/decor\/goi-bi-goi-vuong\/"}],"tags":[{"id":90,"name":"g\u1ed1i \u0111\u0169i t\u01a1 t\u1eb1m","slug":"goi-dui-to-tam","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/goi-dui-to-tam\/"},{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"xanh n\u01b0\u1edbc bi\u1ec3n","slug":"xanh n\u01b0\u1edbc bi\u1ec3n"},{"id":0,"name":"h\u1ed3ng","slug":"h\u1ed3ng"},{"id":0,"name":"v\u00e0ng","slug":"v\u00e0ng"},{"id":0,"name":"xanh l\u00e1 c\u00e2y","slug":"xanh l\u00e1 c\u00e2y"}]}],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;G\u1ed0I VU\u00d4NG \u0110\u0168I T\u01a0 T\u1eb0M V\u1ebc TAY&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=1046","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":1042,"name":"R\u00e8m l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m h\u1ecda s\u0129 v\u1ebd tay","slug":"rem-lua-dui-to-tam-hoa-si-ve-tay","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/rem-lua-dui-to-tam-hoa-si-ve-tay\/","sku":"","short_description":"<p>R\u00e8m kh\u00e1 quan tr\u1ecdng trong ng\u00f4i nh\u00e0 c\u1ee7a ch\u00fang ta. T\u00f4 \u0111i\u1ec3m v\u00e0 l\u00e0m n\u1ed5i b\u1eadt, \u1ea5m \u00e1p kh\u00f4ng gian ph\u00f2ng, l\u00e0m \u0111i\u1ec3m nh\u1ea5n.<\/p>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">R\u00e8m v\u1ebd hoa, th\u00eau tr\u00ean ch\u1ea5t li\u1ec7u t\u01a1 t\u1eb1m, t\u1ec9 m\u1ec9 ch\u1ec9n chu. Ch\u1ea5t li\u1ec7u 100% t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean d\u1ec7t th\u1ee7 c\u00f4ng, h\u1ecda ti\u1ebft hoa v\u0103n, ki\u1ec3u d\u00e1ng \u0111\u01b0\u1ee3c thi\u1ebft k\u00ea ri\u00eang bi\u1ec7t theo y\u00eau c\u1ea7u kh\u00e1ch h\u00e0ng.<\/div>\n<\/div>","description":"<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">R\u00c8M L\u1ee4A \u0110\u0168I V\u1ebc TAY T\u01a0 T\u1eb0M &#8211; N\u00c9T \u0110\u1ed8C \u0110\u00c1O TRONG TRANG TR\u00cd N\u1ed8I TH\u1ea4T<\/div>\n<div dir=\"auto\"><\/div>\n<\/div>\n<div dir=\"auto\">\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Ch\u1ea5t li\u1ec7u r\u00e8m 100% v\u1ea3i t\u01a1 t\u1eb1m, m\u00e0u t\u1ef1 nhi\u00ean l\u00e0m ho\u00e0n to\u00e0n th\u1ee7 c\u00f4ng s\u1ee3i t\u01a1 t\u1eb1m Vi\u1ec7t Nam.<\/div>\n<div dir=\"auto\"><\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">C\u00f4ng n\u0103ng: \u1ea4m m\u00f9a \u0111\u00f4ng, m\u00e1t m\u00f9a h\u00e8, \u0111\u1eb7c bi\u1ec7t ch\u1ed1ng tia UV t\u1ef1 nhi\u00ean, kh\u00f4ng b\u00e1m b\u1ee5i&#8230;<\/div>\n<div dir=\"auto\"><\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Trang tr\u00ed: Ph\u00f2ng kh\u00e1ch, b\u00e0n th\u1edd, ph\u00f2ng thi\u1ec1n, th\u01b0\u1edfng tr\u00e0, \u0111i\u1ec3m nh\u1ea5n b\u1ee9c t\u01b0\u1eddng, l\u00e0m b\u00ecnh phong ng\u0103n c\u00e1c kh\u00f4ng gian&#8230; T\u1ea1o \u0111i\u1ec3m nh\u1ea5n \u1ea5n t\u01b0\u1ee3ng v\u1edbi h\u1ecda ti\u1ebft v\u1ebd theo y\u00eau c\u1ea7u kh\u00e1ch h\u00e0ng.<\/div>\n<div dir=\"auto\"><\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">T\u1ea1o n\u00ean t\u1ea5m R\u00e8m l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m nh\u1eefng ng\u01b0\u1eddi ngh\u1ec7 nh\u00e2n HanhSilk ph\u1ea3i l\u00e0m 30-40 ng\u00e0y t\u1eeb c\u00f4ng \u0111o\u1ea1n tr\u1ed3ng d\u00e2u nu\u00f4i t\u1eb1m, d\u1ec7t v\u1ea3i v\u00e0 may ra s\u1ea3n ph\u1ea9m. Nh\u1eefng t\u1ea5m v\u1ea3i l\u1ee5a \u0111\u0169i \u0111\u01b0\u1ee3c l\u00e0m t\u1eeb t\u00ecnh y\u00eau v\u00e0 tr\u00e1i tim m\u1ec9 t\u1eebng chi ti\u1ebft nh\u1ecf.<\/div>\n<\/div>\n<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">K\u00edch th\u01b0\u1edbc: 80*250cm<\/div>","on_sale":false,"prices":{"price":"3500000","regular_price":"3500000","sale_price":"3500000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">3,500,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":4158,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/08\/1wupukz1u2pydjlcmc7qnhkfp8mat26smcuzdmdjffa2nz7r9chbzwcixr1dtctfsie5.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/08\/1wupukz1u2pydjlcmc7qnhkfp8mat26smcuzdmdjffa2nz7r9chbzwcixr1dtctfsie5-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/1wupukz1u2pydjlcmc7qnhkfp8mat26smcuzdmdjffa2nz7r9chbzwcixr1dtctfsie5.jpg 810w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/1wupukz1u2pydjlcmc7qnhkfp8mat26smcuzdmdjffa2nz7r9chbzwcixr1dtctfsie5-225x300.jpg 225w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/1wupukz1u2pydjlcmc7qnhkfp8mat26smcuzdmdjffa2nz7r9chbzwcixr1dtctfsie5-768x1024.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/1wupukz1u2pydjlcmc7qnhkfp8mat26smcuzdmdjffa2nz7r9chbzwcixr1dtctfsie5-9x12.jpg 9w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/1wupukz1u2pydjlcmc7qnhkfp8mat26smcuzdmdj