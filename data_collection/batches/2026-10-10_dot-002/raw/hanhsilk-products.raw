0\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[{"id":0,"name":"M\u00e0u","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"Tr\u1eafng kem","slug":"Tr\u1eafng kem"},{"id":0,"name":"Xanh c\u1ed5 v\u1ecbt","slug":"Xanh c\u1ed5 v\u1ecbt"}]}],"variations":[{"id":3127,"attributes":[{"name":"M\u00e0u","value":"Tr\u1eafng kem"}]},{"id":3128,"attributes":[{"name":"M\u00e0u","value":"Xanh c\u1ed5 v\u1ecbt"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;\u00c1o v\u00e1y truy\u1ec1n th\u1ed1ng &#8211; Traditional Shirt Dress&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/ao-vay-truyen-thong-traditional-shirt-dress\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3108,"name":"\u00c1o s\u01a1 mi v\u1ebd tay &amp; Qu\u1ea7n l\u1ee5a Satin \u1ed1ng r\u1ed9ng","slug":"ao-so-mi-ve-tay-quan-lua-satin-ong-rong","parent":0,"type":"variable","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/ao-so-mi-ve-tay-quan-lua-satin-ong-rong\/","sku":"","short_description":"<h3 data-start=\"272\" data-end=\"336\">\ud83c\uddfb\ud83c\uddf3 <strong data-start=\"281\" data-end=\"334\">\u00c1o s\u01a1 mi v\u1ebd tay &amp; Qu\u1ea7n l\u1ee5a Satin \u1ed1ng r\u1ed9ng Malaika<\/strong><\/h3>\n<p data-start=\"338\" data-end=\"497\">\u00c1o s\u01a1 mi tay d\u00e0i v\u1edbi <strong data-start=\"359\" data-end=\"389\">\u0111\u01b0\u1eddng c\u1eaft vai truy\u1ec1n th\u1ed1ng<\/strong>, gi\u1ed1ng m\u1eabu v\u00e1y l\u1ee5a Satin \u0111en\/v\u00e0ng \u0111\u1eb7c tr\u01b0ng c\u1ee7a Hanhsilk, \u0111\u01b0\u1ee3c <strong data-start=\"453\" data-end=\"473\">v\u1ebd tay ho\u00e0n to\u00e0n<\/strong> tr\u00ean n\u1ec1n l\u1ee5a cao c\u1ea5p.<\/p>\n<p data-start=\"499\" data-end=\"756\">K\u1ebft h\u1ee3p c\u00f9ng <strong data-start=\"512\" data-end=\"552\">qu\u1ea7n l\u1ee5a Satin \u1ed1ng r\u1ed9ng phom Malaika<\/strong>, thi\u1ebft k\u1ebf c\u1ea1p th\u1ea5p, t\u00fai tr\u00f2n ph\u1ed1i m\u00e0u t\u01b0\u01a1ng ph\u1ea3n. <strong data-start=\"603\" data-end=\"657\">\u0110ai l\u01b0ng b\u1eb1ng v\u1ea3i th\u1ed5 c\u1ea9m th\u1ee7 c\u00f4ng c\u1ee7a ng\u01b0\u1eddi M\u01b0\u1eddng<\/strong> t\u1ea1o \u0111i\u1ec3m nh\u1ea5n m\u1ec1m m\u1ea1i, mang l\u1ea1i t\u1ed5ng th\u1ec3 v\u1eeba ngh\u1ec7 thu\u1eadt v\u1eeba hi\u1ec7n \u0111\u1ea1i, \u0111\u1ea7y ph\u00f3ng kho\u00e1ng v\u00e0 c\u00e1 t\u00ednh.<\/p>","description":"<h3 data-start=\"763\" data-end=\"843\">\ud83c\uddec\ud83c\udde7 <strong data-start=\"772\" data-end=\"841\">Hand-Painted Long-Sleeved Shirt &amp; Malaika Wide-Leg Satin Trousers<\/strong><\/h3>\n<p data-start=\"845\" data-end=\"1025\">This long-sleeved shirt features a <strong data-start=\"880\" data-end=\"908\">traditional shoulder cut<\/strong>\u2014inspired by Hanhsilk\u2019s signature Black\/Yellow Silk Satin Dresses\u2014and is <strong data-start=\"981\" data-end=\"1006\">entirely hand-painted<\/strong> on premium silk.<\/p>\n<p data-start=\"1027\" data-end=\"1303\">Paired with <strong data-start=\"1039\" data-end=\"1074\">Malaika-style wide-leg trousers<\/strong> in flowing satin, designed with a low-waist fit and rounded contrast pockets. A <strong data-start=\"1155\" data-end=\"1206\">handmade brocade belt by the Muong ethnic group<\/strong> adds a soft yet striking accent, bringing together artistry, modernity, and effortless elegance.<\/p>","on_sale":false,"prices":{"price":"10000000","regular_price":"10000000","sale_price":"10000000","price