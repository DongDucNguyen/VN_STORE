nk":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/khan-nu\/"},{"id":80,"name":"Th\u1eddi trang n\u1eef","slug":"thoi-trang-nu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/"}],"tags":[{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":35,"name":"kh\u0103n l\u1ee5a","slug":"khan-lua","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/khan-lua\/"},{"id":139,"name":"kh\u0103n l\u1ee5a th\u00eau","slug":"khan-lua-theu","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/khan-lua-theu\/"},{"id":141,"name":"kh\u0103n l\u1ee5a v\u1ebd hoa","slug":"khan-lua-ve-hoa","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/khan-lua-ve-hoa\/"},{"id":133,"name":"kh\u0103n l\u1ee5a vu\u00f4ng Th\u1ee7y \u1ea4n","slug":"khan-lua-vuong-thuy-an","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/khan-lua-vuong-thuy-an\/"},{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"}],"attributes":[{"id":0,"name":"M\u1eabu kh\u0103n","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"1","slug":"1"},{"id":0,"name":"2","slug":"2"},{"id":0,"name":"3","slug":"3"},{"id":0,"name":"4","slug":"4"},{"id":0,"name":"5","slug":"5"}]}],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;KH\u0102N L\u1ee4A V\u1ebc HOA&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=666","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":650,"name":"\u00c1O D\u00c0I L\u1ee4A TH\u00caU H\u1eccA TI\u1ebeT","slug":"ao-dai-theu","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/ao-dai-theu\/","sku":"","short_description":"<div dir=\"auto\">B\u1ec1 m\u1eb7t v\u1ea3i l\u1ee5a m\u1ec1m, m\u1ecbn v\u00e0 m\u01b0\u1ee3t, s\u1edd v\u00e0o th\u1ea5y m\u00e1t tay kh\u00f4ng gi\u1ed1ng nh\u01b0 c\u00e1c lo\u1ea1i v\u1ea3i d\u1ec7t t\u1eeb s\u1ee3i nh\u00e2n t\u1ea1o, \u0111\u00f3 ch\u00ednh l\u00e0 \u0111i\u1ec3m \u0111\u1eb7c tr\u01b0ng c\u1ee7a v\u1ea3i l\u1ee5a. Trang ph\u1ee5c b\u1eb1ng t\u01a1 t\u1eb1m v\u1eeba nh\u1eb9, v\u1eeba b\u1ec1n, c\u00f3 m\u00e0u s\u00e1ng b\u00f3ng t\u1ef1 nhi\u00ean, khi m\u1eb7c v\u00e0o m\u00f9a h\u00e8 cho ta c\u1ea3m gi\u00e1c tho\u00e1ng m\u00e1t, m\u00f9a \u0111\u00f4ng th\u00ec s\u1ebd c\u00f3 c\u1ea3m gi\u00e1c \u1ea5m \u00e1p v\u00ec l\u1ee5a d\u1eabn nhi\u1ec7t k\u00e9m l\u00e0m cho ng\u01b0\u1eddi m\u1eb7c \u1ea5m h\u01a1n.<\/div>","description":"<p>Bao gi\u1edd c\u0169ng v\u1eady, \u00e1o d\u00e0i th\u00eau mang l\u1ea1i cho c\u00e1c b\u1ea1n g\u00e1i,\u00a0c\u00f4, c\u00e1c m\u1eb9 m\u1ed9t n\u00e9t \u0111\u1eb9p duy\u00ean d\u00e1ng, nh\u1eb9 nh\u00e0ng v\u00e0 sang tr\u1ecdng, b\u1edfi \u00e1o d\u00e0i th\u00eau l\u00e0 s\u1ef1 k\u1ebft h\u1ee3p gi\u1eefa th\u1ee7 c\u00f4ng v\u00e0 s\u1ef1 t\u1ec9 m\u1ec9 tr\u00ean t\u1eebng \u0111\u01b0\u1eddng kim, kh\u00f4ng qu\u00e1 l\u1ea5p l\u00e1nh b\u1edfi c\u01b0\u1eddm \u0111\u00e1 nh\u01b0ng \u00e1o d\u00e0i th\u00eau lu\u00f4n mang l\u1ea1i s\u1ef1 quy\u1ebfn r\u0169 kh\u00e1c bi\u1ec7t<\/p>\n<p>Tr\u00ean n\u1ec1n nhi\u1ec1u ch\u1ea5t li\u1ec7u ph\u00f9 h\u1ee3p v\u1edbi nhi\u1ec1u d\u00e1ng ng\u01b0\u1eddi, ng\u01b0\u1eddi th\u1ee3 c\u1ee7a Hanhsilk v\u1edbi s\u1ef1 kh\u00e9o l\u00e9o c\u1ee7a m\u00ecnh \u0111\u00e3 l\u00e0m n\u00ean nh\u1eefng chi ti\u1ebft t\u1ea1o \u0111i\u1ec3m nh\u1ea5n cho t\u1eebng chi\u1ebfc \u00e1o. M\u1ed7i chi\u1ebfc \u00e1o l\u00e0 m\u1ed9t t\u00ecnh y\u00eau m\u00e0 nh\u1eefng ngh\u1ec7 nh\u00e2n c\u1ee7a ch\u00fang t\u00f4i g\u1eedi g\u1eafm bao t\u00e2m huy\u1ebft. Trang ph\u1ee5c \u00e1o d\u00e0i th\u00eau c\u00f2n l\u00e0 qu\u1ed1c ph\u1ee5c \u0111\u01b0a n\u1ec1n v\u0103n h\u00f3a truy\u1ec1n th\u1ed1ng gi\u1edbi thi\u1ec7u v\u1edbi b\u1ea1n b\u00e8 qu\u1ed1c t\u1ebf.<\/p>\n<p>V\u1edbi c\u00e1c thi\u1ebft k\u1ebf \u0111\u01b0\u1ee3c th\u00eau tay t\u1ec9 m\u1ec9, chau chu\u1ed1t tr\u00ean n\u1ec1n Ch\u1ea5t li\u1ec7u L\u1ee5a t\u01a1 t\u1eb1m cao c\u1ea5p, m\u00e0u s\u1eafc ch\u1ec9 th\u00eau \u0111\u01b0\u1ee3c ph\u1ed1i m\u00e0u m\u1ed9t c\u00e1ch tinh t\u1ebf, t\u1ed1i gi\u1ea3n v\u00e0 sang tr\u1ecdng, \u00e1o d\u00e0i th\u00eau tay Hanhsilk \u0111\u01b0\u1ee3c c\u00e1c T\u1eadp \u0111o\u00e0n, ng\u00e2n h\u00e0ng l\u1edbn l\u1ef1a ch\u1ecdn l\u00e0m qu\u00e0 t\u1eb7ng \u0111\u1ed1i t\u00e1c, qu\u00e0 t\u1eb7ng ngo\u1ea1i giao, qu\u00e0 t\u1eb7ng VIP\u2026<\/p>\n<div dir=\"auto\">B\u1ec1 m\u1eb7t v\u1ea3i l\u1ee5a m\u1ec1m, m\u1ecbn v\u00e0 m\u01b0\u1ee3t, s\u1edd v\u00e0o th\u1ea5y m\u00e1t tay kh\u00f4ng gi\u1ed1ng nh\u01b0 c\u00e1c lo\u1ea1i v\u1ea3i d\u1ec7t t\u1eeb s\u1ee3i nh\u00e2n t\u1ea1o, \u0111\u00f3 ch\u00ednh l\u00e0 \u0111i\u1ec3m \u0111\u1eb7c tr\u01b0ng c\u1ee7a v\u1ea3i l\u1ee5a.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">Trang ph\u1ee5c b\u1eb1ng t\u01a1 t\u1eb1m v\u1eeba nh\u1eb9, v\u1eeba b\u1ec1n, c\u00f3 m\u00e0u s\u00e1ng b\u00f3ng t\u1ef1 nhi\u00ean, khi m\u1eb7c v\u00e0o m\u00f9a h\u00e8 cho ta c\u1ea3m gi\u00e1c tho\u00e1ng m\u00e1t, m\u00f9a \u0111\u00f4ng th\u00ec s\u1ebd c\u00f3 c\u1ea3m gi\u00e1c \u1ea5m \u00e1p v\u00ec l\u1ee5a d\u1eabn nhi\u1ec7t k\u00e9m l\u00e0m cho ng\u01b0\u1eddi m\u1eb7c \u1ea5m h\u01a1n.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">\n<div dir=\"auto\">Ch\u1ea5t li\u1ec7u: L\u1ee5a t\u01a1 t\u1eb1m<\/div>\n<div dir=\"auto\">K\u00edch th\u01b0\u1edbc: S, M, L ho\u1eb7c may theo s\u1ed1 \u0111o kh\u00e1ch h\u00e0ng<\/div>\n<div dir=\"auto\">Ki\u1ec3u d\u00e1ng: \u00c1o d\u00e0i xu\u00f4ng ho\u1eb7c theo y\u00eau c\u1ea7u kh\u00e1ch h\u00e0ng<\/div>\n<div dir=\"auto\">Ch\u01b0a bao g\u1ed3m qu\u1ea7n<\/div>\n<\/div>\n<div dir=\"auto\">\n\n\t\t\n\t\t\t#gallery-2 {\n\t\t\t\tmargin: auto;\n\t\t\t}\n\t\t\t#gallery-2 .galler