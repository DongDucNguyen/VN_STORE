0\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[{"id":0,"name":"Lo\u1ea1i","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"\u00c1o Xanh","slug":"\u00c1o Xanh"},{"id":0,"name":"\u00c1o T\u00edm","slug":"\u00c1o T\u00edm"},{"id":0,"name":"Qu\u1ea7n xanh","slug":"Qu\u1ea7n xanh"},{"id":0,"name":"Qu\u1ea7n t\u00edm","slug":"Qu\u1ea7n t\u00edm"}]}],"variations":[{"id":3167,"attributes":[{"name":"Lo\u1ea1i","value":"\u00c1o Xanh"}]},{"id":3168,"attributes":[{"name":"Lo\u1ea1i","value":"\u00c1o T\u00edm"}]},{"id":3169,"attributes":[{"name":"Lo\u1ea1i","value":"Qu\u1ea7n xanh"}]},{"id":3170,"attributes":[{"name":"Lo\u1ea1i","value":"Qu\u1ea7n t\u00edm"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;\u00c1o s\u01a1 mi l\u1ee5a ng\u1eafn tay &amp; qu\u1ea7n l\u1ee5a Satin \u1ed1ng r\u1ed9ng&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/ao-so-mi-lua-ngan-tay-quan-lua-satin-ong-rong\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3142,"name":"\u00c1o h\u1edf l\u01b0ng \u2013 K\u1ebft h\u1ee3p ch\u00e2n v\u00e1y l\u1ee5a","slug":"ao-ho-lung-ket-hop-chan-vay-lua","parent":0,"type":"variable","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/ao-ho-lung-ket-hop-chan-vay-lua\/","sku":"","short_description":"<h3 data-start=\"266\" data-end=\"381\">\ud83c\uddfb\ud83c\uddf3 <strong data-start=\"275\" data-end=\"379\">\u00c1o h\u1edf l\u01b0ng \u2013 L\u1ee5a t\u01a1 t\u1eb1m &amp; \u0111\u0169i v\u1ebd tay \u2013 K\u1ebft h\u1ee3p ch\u00e2n v\u00e1y l\u1ee5a d\u00e1ng l\u01b0\u1ee3n s\u00f3ng &amp; \u0111ai th\u1ed5 c\u1ea9m ng\u01b0\u1eddi M\u01b0\u1eddng<\/strong><\/h3>\n<p data-start=\"383\" data-end=\"657\">Chi\u1ebfc <strong data-start=\"389\" data-end=\"403\">\u00e1o h\u1edf l\u01b0ng<\/strong> \u0111\u01b0\u1ee3c l\u00e0m t\u1eeb <strong data-start=\"416\" data-end=\"457\">l\u1ee5a t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean v\u00e0 l\u1ee5a \u0111\u0169i v\u1ebd tay<\/strong> \u2013 bu\u1ed9c nh\u1eb9 ph\u00eda sau, v\u1eeba bay b\u1ed5ng v\u1eeba quy\u1ebfn r\u0169. Trong \u1ea3nh, s\u1ea3n ph\u1ea9m \u0111\u01b0\u1ee3c ph\u1ed1i c\u00f9ng <strong data-start=\"541\" data-end=\"572\">ch\u00e2n v\u00e1y l\u1ee5a d\u00e1ng l\u01b0\u1ee3n s\u00f3ng<\/strong> t\u1eeb <strong data-start=\"576\" data-end=\"595\">l\u1ee5a nguy\u00ean ch\u1ea5t<\/strong>, \u0111i k\u00e8m <strong data-start=\"604\" data-end=\"654\">\u0111ai l\u01b0ng b\u1eb1ng th\u1ed5 c\u1ea9m th\u1ee7 c\u00f4ng c\u1ee7a ng\u01b0\u1eddi M\u01b0\u1eddng<\/strong>.<\/p>\n<p data-start=\"659\" data-end=\"935\">C\u00e1c ch\u1ea5t li\u1ec7u \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec1u c\u00f3 <strong data-start=\"693\" data-end=\"715\">s\u1ea3n l\u01b0\u1ee3ng gi\u1edbi h\u1ea1n<\/strong>, ch\u00fa tr\u1ecdng tuy\u1ec7t \u0111\u1ed1i v\u00e0o ch\u1ea5t l\u01b0\u1ee3ng v\u00e0 k\u1ef9 thu\u1eadt th\u1ee7 c\u00f4ng.<\/p>\n<p data-start=\"659\" data-end=\"935\">Thi\u1ebft k\u1ebf b\u1edfi <strong data-start=\"386\" data-end=\"429\">NTK Malaika Barbara Ebbli \u0111\u1ebfn t\u1eeb Italia<\/strong><\/p>","description":"<h3 data-start=\"942\" data-end=\"1052\">\ud83c\uddec\ud83c\udde7 <strong data-start=\"951\" data-end=\"1050\">Backless Top in Pure &amp; Painted Tussah Silk \u2013 Paired with Wavy Silk Skirt and Muong Brocade Belt<\/strong><\/h3>\n<p data-start=\"1054\" data-end=\"1370\">This <strong data-start=\"1059\" data-end=\"1075\">backless top<\/strong> is crafted from <strong data-start=\"1092\" data-end=\"1134\">pure silk and hand-painted Tussah silk<\/strong>, designed to be gently tied at the back for a soft, flowing, and sensual silhouette.<br data-start=\"1219\" data-end=\"1222\" \/>In this photo, it is paired with a <strong data-start=\"1257\" data-end=\"1288\">wavy-cut skirt in pure silk<\/strong>, accentuated by a <strong data-start=\"1307\" data-end=\"1367\">handwoven brocade belt made by the Muong ethnic artisans<\/strong>.<\/p>\n<p data-start=\"1372\" data-end=\"1652\">These fabrics are <strong data-start=\"1390\" data-end=\"1424\">produced in limited quantities<\/strong>, with a focus on craftsmanship and quality over mass production.<\/p>\n<p data-start=\"1372\" data-end=\"1652\">Designed by <strong data-start=\"1054\" data-end=\"1096\">Italian designer Malaika Barbara Ebbli<\/strong><\/p>","on_sale":false,"prices":{"price":"8000000","regular_price":"8000000","sale_price":"8000000","price_range":{"min_amount":"8000000","max_amount":"10000000"},"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">8,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span> \u2013 <span class=\"woocommerce-Price-amount amount\">10,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3239,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787285901149_a3361de10a0a55a95389194c84316749.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787285901149_a3361de10a0a55a95389194c84316749-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787285901149_a3361de10a0a55a95389194c84316749.jpg 1587w, https:\/\/hanhsilk.com\/wp-content\/uplo