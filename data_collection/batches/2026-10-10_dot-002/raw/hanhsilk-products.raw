s:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/"}],"tags":[{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[{"id":0,"name":"Lo\u1ea1i","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"Qu\u1ea7n Satin","slug":"Qu\u1ea7n Satin"},{"id":0,"name":"\u00c1o s\u01a1 mi","slug":"\u00c1o s\u01a1 mi"}]}],"variations":[{"id":3113,"attributes":[{"name":"Lo\u1ea1i","value":"Qu\u1ea7n Satin"}]},{"id":3114,"attributes":[{"name":"Lo\u1ea1i","value":"\u00c1o s\u01a1 mi"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;\u00c1o s\u01a1 mi v\u1ebd tay &amp; Qu\u1ea7n l\u1ee5a Satin \u1ed1ng r\u1ed9ng&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/ao-so-mi-ve-tay-quan-lua-satin-ong-rong\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3103,"name":"Cho\u00e0ng Kaftan &#8211; Multi functional (3 ways) Kaftan","slug":"choang-kaftan-nau-multi-functional-3-ways-kaftan","parent":0,"type":"variable","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/choang-kaftan-nau-multi-functional-3-ways-kaftan\/","sku":"","short_description":"<h3 data-start=\"138\" data-end=\"203\">\ud83c\uddfb\ud83c\uddf3 <strong data-start=\"147\" data-end=\"201\">Kaftan 3 c\u00e1ch m\u1eb7c \u2013 Ch\u1ea5t li\u1ec7u th\u1ed5 c\u1ea9m l\u1ee5a th\u1ee7 c\u00f4ng<\/strong><\/h3>\n<p data-start=\"205\" data-end=\"414\">Chi\u1ebfc <strong data-start=\"211\" data-end=\"242\">Kaftan \u0111a n\u0103ng (3 c\u00e1ch m\u1eb7c)<\/strong> \u0111\u01b0\u1ee3c thi\u1ebft k\u1ebf v\u1edbi d\u00e2y bu\u1ed9c b\u00ean h\u00f4ng tinh t\u1ebf, s\u1eed d\u1ee5ng <strong data-start=\"296\" data-end=\"336\">v\u1ea3i th\u1ed5 c\u1ea9m th\u1ee7 c\u00f4ng c\u1ee7a ng\u01b0\u1eddi M\u01b0\u1eddng<\/strong> k\u1ebft h\u1ee3p c\u00f9ng <strong data-start=\"350\" data-end=\"411\">l\u1ee5a t\u01a1 t\u1eb1m 100% d\u1ec7t t\u1ea1i H\u1ee3p t\u00e1c x\u00e3 \u0110\u0169i Nam Cao \u2013 Hanhsilk<\/strong>.<\/p>\n<p data-start=\"416\" data-end=\"712\">S\u1ea3n ph\u1ea9m l\u00e0 s\u1ef1 giao thoa gi\u1eefa di s\u1ea3n v\u0103n ho\u00e1 b\u1ea3n \u0111\u1ecba v\u00e0 thi\u1ebft k\u1ebf hi\u1ec7n \u0111\u1ea1i, c\u00f3 th\u1ec3 ph\u1ed1i linh ho\u1ea1t nh\u01b0 \u00e1o kho\u00e1c, v\u00e1y su\u00f4ng ho\u1eb7c \u0111\u1ea7m th\u1eaft eo. \u0110\u1eb7c bi\u1ec7t, kaftan tr\u1edf n\u00ean ho\u00e0n h\u1ea3o khi k\u1ebft h\u1ee3p c\u00f9ng <strong data-start=\"606\" data-end=\"660\">ph\u1ee5 ki\u1ec7n g\u1ed1m th\u1ee7 c\u00f4ng c\u1ee7a ngh\u1ec7 s\u0129 Stefania Mairano<\/strong> \u2013 t\u1ea1o n\u00ean t\u1ed5ng th\u1ec3 thanh l\u1ecbch, \u0111\u1eadm ch\u1ea5t ngh\u1ec7 thu\u1eadt.<\/p>\n<p data-start=\"416\" data-end=\"712\">Thi\u1ebft k\u1ebf b\u1edfi NTK Malaika Barbara Ebbli \u0111\u1ebfn t\u1eeb Italia<\/p>","description":"<p data-start=\"416\" data-end=\"712\">\ud83c\uddec\ud83c\udde7 <strong data-start=\"728\" data-end=\"798\">Multi-functional Kaftan with Side Belts \u2013 Handwoven Brocade &amp; Silk<\/strong><\/p>\n<p data-start=\"800\" data-end=\"1034\">This <strong data-start=\"805\" data-end=\"837\">3-way multifunctional kaftan<\/strong> features elegant side ties and is crafted from <strong data-start=\"885\" data-end=\"939\">handmade brocade fabric by the Muong ethnic people<\/strong>, blended with <strong data-start=\"954\" data-end=\"1031\">100% natural silk woven by the Nam Cao Tussah Silk Cooperative \u2013 Hanhsilk<\/strong>.<\/p>\n<p data-start=\"1036\" data-end=\"1308\">A harmonious fusion of indigenous heritage and modern design, it can be styled as a robe, a relaxed tunic, or a belted dress. Complete the look with a <strong data-start=\"1187\" data-end=\"1244\">handmade ceramic accessory by artist Stefania Mairano<\/strong>, for an ensemble that is both refined and artfully distinctive.<\/p>\n<p data-start=\"1036\" data-end=\"1308\">Design by Ms Malaika Barbara Ebbli from Italia<\/p>","on_sale":false,"prices":{"price":"10000000","regular_price":"10000000","sale_price":"10000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">10,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3265,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296663490_2b332ef7093ab917caafac918f86d168-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296663490_2b332ef7093ab917caafac918f86d168-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296663490_2b332ef7093ab917caafac918f86d168-scaled.jpg 1810w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296663490_2b332ef7093ab917caafac918f86d168-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296663490_2b332ef7093ab917caafac918f86d168-724x1024.jpg 724w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296663490_2b332ef7093ab917caafac918f86d168