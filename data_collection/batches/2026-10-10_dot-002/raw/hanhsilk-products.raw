es":"(max-width: 1536px) 100vw, 1536px","name":"z4614698208628_1257dbdfbfc1e31806026e8dfc97f93e","alt":""},{"id":4242,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-scaled.jpg 1536w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-225x300.jpg 225w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-768x1024.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-1152x1536.jpg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-9x12.jpg 9w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/z4614698731955_d8ef3050a4c274f18e86600045b5fabf-600x800.jpg 600w","sizes":"(max-width: 1536px) 100vw, 1536px","name":"z4614698731955_d8ef3050a4c274f18e86600045b5fabf","alt":""}],"categories":[{"id":157,"name":"V\u1ea3i Cao C\u1ea5p","slug":"vai-cao-cap","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/vai-cao-cap\/"},{"id":169,"name":"V\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/vai-cao-cap\/vai-dui-cao-cap\/"}],"tags":[{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":184,"name":"mua v\u1ea3i \u0111\u0169i \u1edf \u0111\u00e2u","slug":"mua-vai-dui-o-dau","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/mua-vai-dui-o-dau\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":183,"name":"v\u1ea3i l\u1ee5a","slug":"vai-lua","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-lua\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;V\u1ea3i \u0111\u0169i may vest m\u00e0u mu\u1ed1i ti\u00eau&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=4232","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":4165,"name":"\u00c1o d\u00e0i \u0111\u0169i t\u01a1 t\u1eb1m v\u1ebd hoa sen tr\u1eafng","slug":"ao-dai-dui-to-tam-ve-hoa-sen-trang","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/ao-dai-dui-to-tam-ve-hoa-sen-trang\/","sku":"","short_description":"<p><strong>\u00c1o d\u00e0i \u0111\u0169i<\/strong> t\u01a1 t\u1eb1m v\u1ebd hoa sen<\/p>\n<p>Chi\u1ebfc \u00e1o d\u00e0i n\u00e0y \u0111\u01b0\u1ee3c t\u1ea1o n\u00ean t\u1eeb s\u1ee3i \u0111\u0169i t\u01a1 t\u1eb1m th\u1ee7 c\u00f4ng, n\u01a1i hoa v\u0103n kh\u00f4ng n\u1eb1m tr\u00ean b\u1ec1 m\u1eb7t m\u00e0 \u1ea9n s\u00e2u trong k\u1ebft c\u1ea5u s\u1ee3i. M\u1ed7i h\u1ecda ti\u1ebft hi\u1ec7n l\u00ean nh\u1eb9 nh\u00e0ng khi \u00e1nh s\u00e1ng ch\u1ea1m v\u00e0o, \u0111\u1ee7 tinh t\u1ebf \u0111\u1ec3 ng\u01b0\u1eddi m\u1eb7c c\u1ea3m nh\u1eadn, \u0111\u1ee7 k\u00edn \u0111\u00e1o \u0111\u1ec3 gi\u1eef tr\u1ecdn v\u1ebb trang nh\u00e3. \u0110\u00e2y l\u00e0 lo\u1ea1i v\u1ea3i \u0111\u00f2i h\u1ecfi\u00a0 s\u1ef1 k\u1ef3 c\u00f4ng, s\u1ef1 ch\u00ednh x\u00e1c v\u00e0 ki\u00ean nh\u1eabn c\u1ee7a b\u00e0 con ngh\u1ec7 nh\u00e2n \u0111\u0169i Nam Cao<\/p>\n<p>Chi\u1ebfc \u00e1o kh\u00f4ng t\u00ecm c\u00e1ch g\u00e2y \u1ea5n t\u01b0\u1ee3ng m\u1ea1nh. N\u00f3 k\u1ec3 m\u1ed9t c\u00e2u chuy\u1ec7n l\u1eb7ng l\u1ebd h\u01a1n: v\u1ec1 l\u1ee5a \u0111\u0169i \u0111\u01b0\u1ee3c d\u1ec7t ch\u1eadm, h\u1ecda ti\u1ebft hoa sen \u0111\u01b0\u1ee3c g\u00ecn gi\u1eef, v\u00e0 v\u1ec1 m\u1ed9t v\u1ebb \u0111\u1eb9p Vi\u1ec7t Nam tr\u01b0\u1edfng th\u00e0nh c\u00e0ng nh\u00ecn c\u00e0ng th\u1ea5m, c\u00e0ng m\u1eb7c c\u00e0ng th\u1ea5y gi\u00e1 tr\u1ecb.<\/p>","description":"<p data-start=\"143\" data-end=\"760\">Chi\u1ebfc <strong data-start=\"149\" data-end=\"186\">\u00e1o d\u00e0i \u0111\u0169i Nam Cao \u2013 Hanhsilk<\/strong> l\u00e0 k\u1ebft tinh c\u1ee7a <strong data-start=\"203\" data-end=\"230\">90 ng\u00e0y lao \u0111\u1ed9ng b\u1ec1n b\u1ec9<\/strong> v\u00e0 <strong data-start=\"234\" data-end=\"263\">h\u01a1n 20 c\u00f4ng \u0111o\u1ea1n th\u1ee7 c\u00f4ng<\/strong> kh\u1eaft khe, b\u1eaft \u0111\u1ea7u t\u1eeb tr\u1ed3ng d\u00e2u, nu\u00f4i t\u1eb1m, k\u00e9o s\u1ee3i cho \u0111\u1ebfn d\u1ec7t v\u1ea3i, nhu\u1ed9m v\u00e0 ho\u00e0n thi\u1ec7n.<br data-start=\"351\" data-end=\"354\" \/>M\u1ed7i th\u01b0\u1edbc l\u1ee5a \u0111\u01b0\u1ee3c t\u1ea1o n\u00ean b\u1eb1ng s\u1ef1 ki\u00ean nh\u1eabn v\u00e0 \u0111\u00f4i tay l\u00e0nh ngh\u1ec1 c\u1ee7a nh\u1eefng ngh\u1ec7 nh\u00e2n g\u1eafn b\u00f3 tr\u1ecdn \u0111\u1eddi v\u1edbi l\u00e0ng ngh\u1ec1.<br data-start=\"470\" data-end=\"473\" \/>Ch\u1ea5t l\u1ee5a \u0111\u0169i m\u1ed9c m\u1ea1c nh\u01b0ng tinh t\u1ebf, tho\u00e1ng nh\u1eb9, th\u00e2n thi\u1ec7n v\u1edbi l\u00e0n da v\u00e0 mang h\u01a1i th\u1edf c\u1ee7a t\u1ef1 nhi\u00ean.<br data-start=\"572\" data-end=\"575\" \/>T\u1eebng \u0111\u01b0\u1eddng kim, n\u1ebfp v\u1ea3i tr\u00ean t\u00e0 \u00e1o l\u00e0 s\u1ef1 tr\u00e2n tr\u1ecdng d\u00e0nh cho di s\u1ea3n v\u00e0 v\u1ebb \u0111\u1eb9p ng\u01b0\u1eddi ph\u1ee5 n\u1eef Vi\u1ec7t.<br data-start=\"671\" data-end=\"674\" \/>Kh\u00f4ng ch\u1ec9 l\u00e0 trang ph\u1ee5c, \u0111\u00f3 l\u00e0 <strong data-start=\"705\" data-end=\"759\">m\u1ed9t gi\u00e1 tr\u1ecb v\u0103n h\u00f3a \u0111\u01b0\u1ee3c kho\u00e1c l\u00ean h\u00ecnh h\u00e0i \u00e1o d\u00e0i<\/strong>.<\/p>\n<p>S\u1ea3n ph\u1ea9m \u00c1o d\u00e0i \u0111\u0169i t\u01a1 t\u1eb1m hoa sen v\u00e0 bi\u1ec3n c\u1ea3<\/p>\n<p>Ch\u1ea5t li\u1ec7u: L\u1ee5a t\u01a1 t\u1eb1m 100% t\u01a1 t\u1eb1m<\/p>\n<p>M\u00e0u s\u1eafc: m\u00e0u xanh da tr\u1eddi<\/p>\n<p>H\u1ecda ti\u1ebft: hoa sen<\/p>\n<p>Kh\u00e1ch h\u00e0ng c\u00f3 th\u1ec3 Inbox h\u1eb7c gh\u00e9 th\u0103m Hanhsilk \u0111\u1ec3 l\u1ef1a ch\u1ecdn v\u1ea3i, may \u0111o theo s\u1ed1 \u0111o kh\u00e1ch h\u00e0ng.<\/p>\n<p>&nbsp;<\/p>","on_sale":false,"prices":{"price":"6000000","regular_price":"6000000","sale_price":"6000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">6,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":4166,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/1wupukysnkbkxkwtsbhjkw2fzvb89lg0hllqx7ect0kf3thqncvmwgai03ct0k5fxzn1-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/1wupukysnkbkxkwtsbhjkw2fzvb89lg0hllqx7ect0kf3thqncvmwgai03ct0k5fxzn1-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/1wupukysnkbkxkwtsbhjkw2fzvb89lg0hllqx7ect0kf3thqncvmwgai03ct0k5fxzn1-scaled.jpg 1536w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/1wupukysnkbkxkwtsbhjkw2fzvb89lg0hllqx7ect0kf3thqncvmwgai03ct0k5fxzn1-225x300.jpg 225w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/1wupukysnkbkxkwtsbhjkw2fzvb89lg0hllqx7ect0kf3thqncvmwgai03ct0k5fxzn1-768x1024.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06