om\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296012691_5c0483cd6f66a037fdcaf7064af60d8f-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296012691_5c0483cd6f66a037fdcaf7064af60d8f-724x1024.jpg 724w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296012691_5c0483cd6f66a037fdcaf7064af60d8f-768x1086.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296012691_5c0483cd6f66a037fdcaf7064af60d8f-1086x1536.jpg 1086w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296012691_5c0483cd6f66a037fdcaf7064af60d8f-8x12.jpg 8w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296012691_5c0483cd6f66a037fdcaf7064af60d8f-600x848.jpg 600w","sizes":"(max-width: 1191px) 100vw, 1191px","name":"z6787296012691_5c0483cd6f66a037fdcaf7064af60d8f","alt":""},{"id":3275,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db.jpg 1191w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db-724x1024.jpg 724w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db-768x1086.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db-1086x1536.jpg 1086w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db-8x12.jpg 8w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db-600x848.jpg 600w","sizes":"(max-width: 1191px) 100vw, 1191px","name":"z6787292327852_1550f66f28c749ff22dbeb40f4b5d8db","alt":""}],"categories":[{"id":338,"name":"BST thi\u1ebft k\u1ebf Italia","slug":"bst","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/bst\/"},{"id":80,"name":"Th\u1eddi trang n\u1eef","slug":"thoi-trang-nu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/"}],"tags":[{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"\u0110\u1ecf","slug":"\u0110\u1ecf"},{"id":0,"name":"\u0110en","slug":"\u0110en"}]}],"variations":[{"id":3186,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"\u0110\u1ecf"}]},{"id":3187,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"\u0110en"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;\u00c1o kho\u00e1c \u0111\u0169i t\u01a1 t\u1eb1m &#8211; Duster coat&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/ao-khoac-dui-to-tam-duster-coat\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3172,"name":"Jumpsuit l\u1ee5a t\u01a1 t\u1eb1m \u2013 K\u1ebft h\u1ee3p l\u1ee5a v\u1ebd tay","slug":"jumpsuit-lua-to-tam-ket-hop-lua-ve-tay","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/jumpsuit-lua-to-tam-ket-hop-lua-ve-tay\/","sku":"","short_description":"<h3 data-start=\"868\" data-end=\"973\">\ud83c\uddec\ud83c\udde7 <strong data-start=\"877\" data-end=\"973\">Jumpsuit in Pure Silk &amp; Hand-Painted Tussah Silk \u2013 Designed by Malaika Barbara Ebbli (Italy)<\/strong><\/h3>\n<p data-start=\"975\" data-end=\"1210\">This elegant <strong data-start=\"988\" data-end=\"1000\">jumpsuit<\/strong> is designed by <strong data-start=\"1016\" data-end=\"1058\">Italian designer Malaika Barbara Ebbli<\/strong>, crafted from a luxurious blend of <strong data-start=\"1094\" data-end=\"1136\">pure silk and hand-painted Tussah silk<\/strong>, woven by artisans at the <strong data-start=\"1163\" data-end=\"1209\">Nam Cao Tussah Silk Cooperative \u2013 Hanhsilk<\/strong>.<\/p>\n<p data-start=\"1212\" data-end=\"1489\">The silhouette features <strong data-start=\"1236\" data-end=\"1272\">double-layered wide-leg trousers<\/strong> with graceful <strong data-start=\"1287\" data-end=\"1320\">pleats at both front and back<\/strong>, offering fluidity, refinement, and bold femininity. A contemporary design rooted in Vietnamese heritage\u2014this piece is where tradition meets modern artistic expression.<\/p>","description":"<h3 data-start=\"232\" data-end=\"349\">\ud83c\uddfb\ud83c\uddf3 <strong data-start=\"241\" data-end=\"349\">Jumpsuit l\u1ee5a t\u01a1 t\u1eb1m \u2013 K\u1ebft h\u1ee3p l\u1ee5a v\u1ebd tay &amp; \u0111\u0169i Nam Cao \u2013 Thi\u1ebft k\u1ebf b\u1edfi NTK Malaika Barbara Ebbli (Italia)<\/strong><\/h3>\n<p data-start=\"351\" data-end=\"589\">M\u1eabu <strong data-start=\"355\" data-end=\"367\">jumpsuit<\/strong> hi\u1ec7n \u0111\u1ea1i \u0111\u01b0\u1ee3c thi\u1ebft k\u1ebf b\u1edfi <strong data-start=\"395\" data-end=\"438\">NTK Malaika Barbara Ebbli \u0111\u1ebfn t\u1eeb Italia<\/strong>, s\u1eed d\u1ee5ng ch\u1ea5t li\u1ec7u k\u1ebft h\u1ee3p gi\u1eefa <strong data-start=\"471\" data-end=\"515\">l\u1ee5a t\u01a1 t\u1eb1m nguy\u00ean ch\u1ea5t v\u00e0 l\u1ee5a \u0111\u0169i v\u1ebd tay<\/strong> \u2013 t\u1ea5t c\u1ea3 \u0111\u1ec1u \u0111\u01b0\u1ee3c d\u1ec7t th\u1ee7 c\u00f4ng t\u1ea1i <strong data-start=\"551\" data-end=\"588\">H\u1ee3p t\u00e1c x\u00e3 \u0110\u0169i Nam Cao \u2013 Hanhsilk<\/strong>.<\/p>\n<p data-start=\"591\" data-end=\"861\">Thi\u1ebft k\u1ebf n\u1ed5i b\u1eadt v\u1edbi <strong data-start=\"612\" data-end=\"635\">qu\u1ea7n \u1ed1ng r\u1ed9ng 2 l\u1edbp<\/strong>, t\u1ea1o \u0111\u1ed9 bay t\u1ef1 nhi\u00ean; ph\u1ea7n <strong data-start=\"663\" data-end=\"697\">nh\u00fan x\u1ebfp n\u1ebfp ph\u00eda tr\u01b0\u1edbc v\u00e0 sau<\/strong> mang l\u1ea1i v\u1ebb thanh tho\u00e1t, n\u1eef t\u00ednh m\u00e0 v\u1eabn \u0111\u1ea7y c\u00e1 t\u00ednh. \u0110\u00e2y l\u00e0 m\u1ed9t thi\u1ebft k\u1ebf v\u1eeba t\u00f4n vinh ch\u1ea5t li\u1ec7u truy\u1ec1n th\u1ed1ng, v\u1eeba th\u1ec3 hi\u1ec7n tinh th\u1ea7n s\u00e1ng t\u1ea1o th\u1eddi trang \u0111\u01b0\u01a1ng \u0111\u1ea1i.<\/p>","on_sale":false,"prices":{"price":"15000000","regular_price":"15000000","sale_price":"15000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">15,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3234,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292101931_4085e8f9d73d3f78e2859c00cb2deedb.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787292101931_4085e8f9d73d3f78e2859