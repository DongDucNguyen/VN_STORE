hu c\u1ea7u c\u1ee7a kh\u00e1ch h\u00e0ng ngay c\u1ea3 nh\u1eefng ng\u01b0\u1eddi kh\u00f3 t\u00ednh nh\u1ea5t<\/p>","on_sale":false,"prices":{"price":"3500000","regular_price":"3500000","sale_price":"3500000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">3,500,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":4191,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-scaled.jpg 1536w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-225x300.jpg 225w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-768x1024.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-1152x1536.jpg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-9x12.jpg 9w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28-600x800.jpg 600w","sizes":"(max-width: 1536px) 100vw, 1536px","name":"2aoboqatirswpxvo5rxis0j19r28z9gkg0myl8ws28","alt":""},{"id":4172,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/07\/2aoboqatir5vkhw9roebfio3n8jowa88xftpebbu7-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/up