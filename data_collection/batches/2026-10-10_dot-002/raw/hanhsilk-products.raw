.com\/danh-muc-san-pham\/thoi-trang-nu\/"}],"tags":[{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;Jumpsuit l\u1ee5a t\u01a1 t\u1eb1m \u2013 K\u1ebft h\u1ee3p l\u1ee5a v\u1ebd tay&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=3172","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3156,"name":"\u00c1o s\u01a1 mi l\u1ee5a ng\u1eafn tay &amp; qu\u1ea7n l\u1ee5a Satin \u1ed1ng r\u1ed9ng","slug":"ao-so-mi-lua-ngan-tay-quan-lua-satin-ong-rong","parent":0,"type":"variable","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/ao-so-mi-lua-ngan-tay-quan-lua-satin-ong-rong\/","sku":"","short_description":"<h3 data-start=\"934\" data-end=\"1051\">\ud83c\uddec\ud83c\udde7 <strong data-start=\"943\" data-end=\"1049\">Short-Sleeved Silk Shirt &amp; Malaika Fluid Trousers \u2013 Designed by Italian Designer Malaika Barbara Ebbli<\/strong><\/h3>\n<p data-start=\"1053\" data-end=\"1225\">Designed by <strong data-start=\"1065\" data-end=\"1107\">Italian designer Malaika Barbara Ebbli<\/strong>, this set features a <strong data-start=\"1129\" data-end=\"1152\">short-sleeved shirt<\/strong> made from a combination of <strong data-start=\"1180\" data-end=\"1222\">pure silk and hand-painted Tussah silk<\/strong>.<\/p>\n<p data-start=\"1227\" data-end=\"1491\">It is paired with <strong data-start=\"1245\" data-end=\"1282\">double-layered, wide-leg trousers<\/strong> in the signature Malaika style, using <strong data-start=\"1321\" data-end=\"1386\">handwoven Tussah silk from the Nam Cao Cooperative \u2013 Hanhsilk<\/strong>.<br data-start=\"1387\" data-end=\"1390\" \/>The trousers include <strong data-start=\"1411\" data-end=\"1439\">rounded contrast pockets<\/strong>, offering both visual interest and functionality.<\/p>\n<p data-start=\"1493\" data-end=\"1642\">A <strong data-start=\"1495\" data-end=\"1551\">handmade brocade belt woven by Muong ethnic artisans<\/strong> completes the look\u2014merging cultural heritage with a free-spirited, contemporary aesthetic.<\/p>","description":"<h3 data-start=\"296\" data-end=\"410\">\ud83c\uddfb\ud83c\uddf3 <strong data-start=\"305\" data-end=\"408\">Set \u00e1o s\u01a1 mi l\u1ee5a ng\u1eafn tay &amp; qu\u1ea7n l\u1ee5a Satin \u1ed1ng r\u1ed9ng \u2013 Thi\u1ebft k\u1ebf b\u1edfi NTK Malaika Barbara Ebbli (Italia)<\/strong><\/h3>\n<p data-start=\"412\" data-end=\"571\">Thi\u1ebft k\u1ebf b\u1edfi <strong data-start=\"425\" data-end=\"468\">NTK Malaika Barbara Ebbli \u0111\u1ebfn t\u1eeb Italia<\/strong>, set trang ph\u1ee5c g\u1ed3m <strong data-start=\"489\" data-end=\"510\">\u00e1o s\u01a1 mi ng\u1eafn tay<\/strong> k\u1ebft h\u1ee3p gi\u1eefa <strong data-start=\"524\" data-end=\"568\">l\u1ee5a t\u01a1 t\u1eb1m nguy\u00ean ch\u1ea5t v\u00e0 l\u1ee5a \u0111\u0169i v\u1ebd tay<\/strong>.<\/p>\n<p data-start=\"573\" data-end=\"765\">Ph\u1ed1i c\u00f9ng <strong data-start=\"583\" data-end=\"606\">qu\u1ea7n \u1ed1ng r\u1ed9ng 2 l\u1edbp<\/strong> d\u00e1ng Malaika, ch\u1ea5t li\u1ec7u <strong data-start=\"631\" data-end=\"661\">l\u1ee5a \u0111\u0169i Nam Cao \u2013 Hanhsilk<\/strong>, m\u1ec1m r\u0169 t\u1ef1 nhi\u00ean. Qu\u1ea7n \u0111\u01b0\u1ee3c nh\u1ea5n b\u1eb1ng <strong data-start=\"700\" data-end=\"732\">t\u00fai tr\u00f2n ph\u1ed1i m\u00e0u t\u01b0\u01a1ng ph\u1ea3n<\/strong>, v\u1eeba ngh\u1ec7 thu\u1eadt v\u1eeba th\u1ef1c d\u1ee5ng.<\/p>\n<p data-start=\"767\" data-end=\"927\">Chi\u1ebfc <strong data-start=\"773\" data-end=\"827\">\u0111ai l\u01b0ng b\u1eb1ng v\u1ea3i th\u1ed5 c\u1ea9m th\u1ee7 c\u00f4ng c\u1ee7a ng\u01b0\u1eddi M\u01b0\u1eddng<\/strong> ho\u00e0n thi\u1ec7n t\u1ed5ng th\u1ec3, t\u1ea1o n\u00ean m\u1ed9t v\u1ebb \u0111\u1eb9p hi\u1ec7n \u0111\u1ea1i, bay b\u1ed5ng m\u00e0 v\u1eabn g\u1eafn k\u1ebft v\u1edbi b\u1ea3n s\u1eafc v\u0103n h\u00f3a Vi\u1ec7t.<\/p>","on_sale":false,"prices":{"price":"8000000","regular_price":"8000000","sale_price":"8000000","price_range":{"min_amount":"8000000","max_amount":"10000000"},"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">8,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span> \u2013 <span class=\"woocommerce-Price-amount amount\">10,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3238,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787288462927_208b5c006dc15058db388dc36a87b722.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787288462927_208b5c006dc15058db388dc36a87b722-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787288462927_208b5c006dc15058db388dc36a87b722.jpg 1191w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787288462927_208b5c006dc15058db388dc36a87b722-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\