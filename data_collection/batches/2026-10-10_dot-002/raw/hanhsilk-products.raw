25\/07\/z6787278197793_b7a1ee2311dbce2f37f355795caad49d-7x12.jpg 7w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278197793_b7a1ee2311dbce2f37f355795caad49d-600x1067.jpg 600w","sizes":"(max-width: 1350px) 100vw, 1350px","name":"z6787278197793_b7a1ee2311dbce2f37f355795caad49d","alt":""},{"id":3225,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30.jpg 1350w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-169x300.jpg 169w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-576x1024.jpg 576w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-768x1365.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-864x1536.jpg 864w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-1152x2048.jpg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-7x12.jpg 7w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30-600x1067.jpg 600w","sizes":"(max-width: 1350px) 100vw, 1350px","name":"z6787278800873_4c24ff561b62f2f6cea2e78b5640aa30","alt":""},{"id":3226,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b.jpg 1350w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-169x300.jpg 169w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-576x1024.jpg 576w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-768x1365.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-864x1536.jpg 864w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-1152x2048.jpg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-7x12.jpg 7w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787277947945_299575298dde855fa1f6095a08d9db9b-600x1067.jpg 600w","sizes":"(max-width: 1350px) 100vw, 1350px","name":"z6787277947945_299575298dde855fa1f6095a08d9db9b","alt":""}],"categories":[{"id":338,"name":"BST thi\u1ebft k\u1ebf Italia","slug":"bst","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/bst\/"},{"id":80,"name":"Th\u1eddi trang n\u1eef","slug":"thoi-trang-nu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/"}],"tags":[{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;V\u00e1y c\u00e1nh l\u1ee5a t\u01a1 t\u1eb1m d\u00e0i &#8211; Wing Long Dress&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=3093","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3047,"name":"D\u00c2Y BU\u1ed8C T\u00d3C T\u01a0 T\u1eb0M &#8211; Silk Scrunchies","slug":"day-buoc-toc-to-tam-silk-scrunchies","parent":0,"type":"variable","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/day-buoc-toc-to-tam-silk-scrunchies\/","sku":"","short_description":"<p>D\u00e2y bu\u1ed9c t\u00f3c nhi\u1ec1u m\u00e0u, \u0111a d\u1ea1ng nhi\u1ec1u size<\/p>\n<p>IB Zalo: 0977 241 282 \u0111\u1ec3 ch\u1ecdn m\u00e0u v\u00e0 ch\u1ecdn size s\u1eb5n<\/p>\n<p>Ho\u1eb7c b\u1ea1n ch\u1ecdn theo c\u00e1c tone m\u00e0u c\u01a1 b\u1ea3n b\u00ean d\u01b0\u1edbi<\/p>","description":"<div class=\"xdj266r x11i5rnm xat24cr x1mh8g0r x1vvkbs x126k92a\">\n<div dir=\"auto\">\n<div dir=\"auto\">Nh\u1eefng chi\u1ebfc scrunchies l\u1ee5a t\u01a1 t\u1eb1m t\u1eeb Hanhsilk l\u00e0 m\u00f3n ph\u1ee5 ki\u1ec7n nh\u1ecf xinh nh\u01b0ng \u0111\u1ea7y tinh t\u1ebf, gi\u00fap b\u1ea1n v\u1eeba l\u00e0m \u0111\u1eb9p, v\u1eeba ch\u0103m s\u00f3c m\u00e1i t\u00f3c m\u1ed9t c\u00e1ch d\u1ecbu d\u00e0ng.<\/div>\n<div dir=\"auto\"><span class=\"html-span xexx8yu x4uap5 x18d9i69 xkhd6sd x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xgzva0m xhhsvwb xxymvpz xlup9mm x1kky2od\"><img class=\"xz74otr x168nmei x13lgxp2 x5pf9jr xo71vjh\" src=\"https:\/\/static.xx.fbcdn.net\/images\/emoji.php\/v9\/tf4\/1\/16\/2728.png\" alt=\"\u2728\" width=\"16\" height=\"16\" \/><\/span> V\u00ec sao b\u1ea1n n\u00ean ch\u1ecdn Scrunchies l\u1ee5a t\u01a1 t\u1eb1m?<\/div>\n<div dir=\"auto\">100% t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean: Ch\u1ea5t li\u1ec7u m\u1ec1m m\u1ea1i, an to\u00e0n, kh\u00f4ng g\u00e2y h\u01b0 t\u1ed5n cho t\u00f3c.B\u1ea3o v\u1ec7 m\u00e1i t\u00f3c: Kh\u00f4ng l\u00e0m g\u00e3y r\u1ee5ng t\u00f3c nh\u01b0 c\u00e1c lo\u1ea1i d\u00e2y thun th\u00f4ng th\u01b0\u1eddng.B\u1ec1n \u0111\u1eb9p, d\u1ec5 ph\u1ed1i \u0111\u1ed3: T\u1eeb phong c\u00e1ch nh\u1eb9 nh\u00e0ng \u0111\u1ebfn c\u00e1 t\u00ednh \u0111\u1ec1u c\u00f3 th\u1ec3 t\u1ecfa s\u00e1ng v\u1edbi scrunchies l\u1ee5a t\u01a1.Th\u00e2n thi\u1ec7n v\u1edbi m\u00f4i tr\u01b0\u1eddng: M\u1ed9t s\u1ef1 l\u1ef1a ch\u1ecdn b\u1ec1n v\u1eefng, g\u00f3p ph\u1ea7n b\u1ea3o v\u1ec7 thi\u00ean nhi\u00ean.<\/div>\n<div dir=\"auto\"><span class=\"html-span xexx8yu x4uap5 x18d9i69 xkhd6sd x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xgzva0m xhhsvwb xxymvpz xlup9mm x1kky2od\"><img class=\"xz74otr x168nmei x13lgxp2 x5pf9jr xo71vjh\" src=\"https:\/\/static.xx.fbcdn.net\/images\/emoji.php\/v9\/ted\/1\/16\/1f4ab.png\" alt=\"\ud83d\udcab\" width=\"16\" height=\"16\" \/><\/span> \u0110\u1ee7 m\u00e0u s\u1eafc, \u0111a phong c\u00e1ch, scrunchies l\u1ee5a t\u01a1 t\u1eb1m kh\u00f4ng ch\u1ec9 gi\u00fap b\u1ea1n c\u1ed1 \u0111\u1ecbnh m\u00e1i t\u00f3c g\u1ecdn g\u00e0ng m\u00e0 c\u00f2n l\u00e0 \u0111i\u1ec3m nh\u1ea5n th\u1eddi trang n\u1ed5i b\u1eadt.<\/div>\n<div dir=\"auto\">\n<div class=\"xdj266r x11i5rnm xat24cr x1mh8g0r x1vvkbs x126k92a\">\n<div dir=\"auto\">Scrunchies t\u01a1 t\u1eb1m &#8211; D\u1ecbu d\u00e0ng n\u00e2ng niu m\u00e1i t\u00f3c c\u1ee7a b\u1ea1n<\/div>\n<div dir=\"auto\">Nh\u1eefng chi\u1ebfc bu\u1ed9c t\u00f3c \u0111\u1ea7y s\u1eafc m\u00e0u n\u00e0y kh\u00f4ng ch\u1ec9 l\u00e0 m\u1ed9t ph\u1ee5 ki\u1ec7n, m\u00e0 c\u00f2n l\u00e0 s\u1ef1 ch\u0103m s\u00f3c nh\u1eb9 nh\u00e0ng cho m\u00e1i t\u00f3c c\u1ee7a b\u1ea1n. \u0110\u01b0\u1ee3c l\u00e0m t\u1eeb ch\u1ea5t li\u1ec7u l\u1ee5a t\u01a1 t\u1eb1m 100% t\u1ef1 nhi\u00ean, d\u00e2y bu\u1ed9c t\u00f3c c\u1ee7a Hanhsilk m\u1ec1m m\u1ea1i, \u00eam \u00e1i v\u00e0 ho\u00e0n to\u00e0n kh\u00f4ng g\u00e2y h\u1ea1i cho t\u00f3c. S\u1ef1 k\u1ebft h\u1ee3p tinh t\u1ebf gi\u1eefa m\u00e0u s\u1eafc t\u01b0\u01a1i s\u00e1ng v\u00e0 ch\u1ea5t li\u1ec7u t\u1ef1 nhi\u00ean mang \u0111\u1ebfn c\u1ea3m gi\u00e1c nh\u1eb9 nh\u00e0ng, tho\u1ea3i m\u00e1i khi s\u1eed d\u1ee5ng, \u0111\u1ed3ng th\u1eddi t\u00f4n l\u00ean n\u00e9t duy\u00ean d\u00e1ng, n\u1eef t\u00ednh c\u1ee7a ng\u01b0\u1eddi ph\u1ee5 n\u1eef.<\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">M\u1ed7i chi\u1ebfc bu\u1ed9c t\u00f3c kh\u00f4ng ch\u1ec9 \u0111\u1eb9p m\u00e0 c\u00f2n mang trong m\u00ecnh s\u1ef1 t\u1ec9 m\u1ec9 t\u1eeb b\u00e0n tay c\u1ee7a c\u00e1c ngh\u1ec7 nh\u00e2n, gi\u00fap b\u1ea1n v\u1eeba gi\u1eef g\u00ecn m\u00e1i t\u00f3c \u00f3ng \u1ea3, v\u1eeba th\u1ec3 hi\u1ec7n gu th\u1ea9m m\u1ef9 tinh t\u1ebf<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>","on_sale":false,"prices":{"price":"80000","regular_price":"80000","sale_price":"80000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">80,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3052,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/05\/z5863725206229_505281ecdae84ca1243f7d1f9b46d125.jpg-e1748339942693.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/05\/z5863725206229_505281ecdae84ca1243f7d1f9b46d125.jpg-e1748339942693-300