\/"},{"id":40,"name":"t\u01a1 t\u1eb1m","slug":"to-tam","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;K\u00e9n massage t\u01a1 t\u1eb1m&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=337","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":328,"name":"Caravat l\u1ee5a h\u1ecda ti\u1ebft k\u1ebb s\u1ecdc","slug":"caravat-lua-hoa-tiet-ke-soc","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/caravat-lua-hoa-tiet-ke-soc\/","sku":"","short_description":"<div class=\"product-short-description\">\n<p>T\u01a1 t\u1eb1m \u0111\u01b0\u1ee3c nhu\u1ed9m ri\u00eang t\u1ec9 m\u1ec9 t\u1eebng s\u1ee3i m\u00e0u v\u00e0 d\u1ec7t l\u1ea1i v\u1edbi nhau cho \u0111\u1ed9 b\u00f3ng t\u1ef1 nhi\u00ean, thu h\u00fat \u00e1nh nh\u00ecn ng\u01b0\u1eddi \u0111\u1ed1i di\u1ec7n.<\/p>\n<p>\u0110\u1ed3ng th\u1eddi cho form chu\u1ea9n, d\u00e1ng \u0111\u1ee9ng, kh\u00f4ng b\u1ecb r\u1ee7. Ch\u1ea5t li\u1ec7u kh\u00f4ng phai m\u00e0u, kh\u00f4ng x\u00f9 v\u1ea3i, b\u1ec1n, \u0111\u1eb9p v\u00e0 th\u1eddi trang.<\/p>\n<\/div>","description":"<p>Caravat t\u01a1 t\u1eb1m h\u1ecda ti\u1ebft k\u1ebb s\u1ecdc<\/p>\n<ul>\n<li>S\u1ea3n ph\u1ea9m: Caravat l\u1ee5a k\u00e8m h\u1ed9p \u0111\u1ef1ng cao c\u1ea5p<\/li>\n<li>M\u00e0u s\u1eafc, hoa v\u0103n: \u0110a d\u1ea1ng m\u00e0u s\u1eafc v\u00e0 hoa v\u0103n gi\u00fap qu\u00fd \u00f4ng d\u1ec5 d\u00e0ng l\u1ef1a ch\u1ecdn<\/li>\n<li>Ch\u1ea5t li\u1ec7u: L\u1ee5a t\u01a1 t\u1eb1m 100%<\/li>\n<li>\u1ee8ng d\u1ee5ng: \u0110i h\u1ecdp, ti\u1ec7c c\u01b0\u1edbi, \u0111i l\u00e0m\u2026.<\/li>\n<li>K\u00edch th\u01b0\u1edbc: D\u00e0i 80cm, b\u1ea3n r\u1ed9ng 8cm<\/li>\n<li>\u01afu \u0111i\u1ec3m: Thi\u1ebft k\u1ebf tinh t\u1ebf v\u00e0 \u0111\u1ed9c \u0111\u00e1o. Ch\u1ea5t li\u1ec7u l\u1ee5a t\u01a1 t\u1eb1m mang \u0111\u1ebfn s\u1ee9c kh\u1ecfe c\u0169ng nh\u01b0 s\u1ef1 may m\u1eafn cho ng\u01b0\u1eddi \u0111eo.<\/li>\n<\/ul>\n<p><a href=\"https:\/\/luatotamvietnam.com\/shop\/\">Caravat l\u1ee5a<\/a>\u00a0\u0111\u01b0\u1ee3c nhu\u1ed9m ri\u00eang t\u1ec9 m\u1ec9 t\u1eebng s\u1ee3i m\u00e0u v\u00e0\u00a0<a href=\"https:\/\/vi.wikipedia.org\/wiki\/Th%E1%BB%83_lo%E1%BA%A1i:D%E1%BB%87t_may\">d\u1ec7t<\/a>\u00a0l\u1ea1i v\u1edbi nhau cho \u0111\u1ed9 b\u00f3ng t\u1ef1 nhi\u00ean, thu h\u00fat \u00e1nh nh\u00ecn ng\u01b0\u1eddi \u0111\u1ed1i di\u1ec7n. \u0110\u1ed3ng th\u1eddi cho form chu\u1ea9n, d\u00e1ng \u0111\u1ee9ng, kh\u00f4ng b\u1ecb r\u1ee7. Ch\u1ea5t li\u1ec7u kh\u00f4ng phai m\u00e0u, kh\u00f4ng x\u00f9 v\u1ea3i, b\u1ec1n, \u0111\u1eb9p v\u00e0 th\u1eddi trang.<\/p>\n<p>L\u1ee5a l\u00e0 m\u1ed9t lo\u1ea1i v\u1ea3i m\u1ecfng, m\u1ecbn \u0111\u01b0\u1ee3c d\u1ec7t b\u1eb1ng t\u01a1. V\u00e0 lo\u1ea1i l\u1ee5a t\u1ed1t nh\u1ea5t \u0111\u1eb9p nh\u1ea5t ch\u00ednh l\u00e0 l\u1ee5a t\u01a1 t\u1eb1m. T\u01a1 t\u1eb1m ch\u00ednh l\u00e0 m\u1ed9t trong nh\u1eefng lo\u1ea1i x\u01a1 thi\u00ean nhi\u00ean r\u1ea5t c\u00f3 gi\u00e1 tr\u1ecb. \u0110\u01b0\u1ee3c h\u00ecnh th\u00e0nh t\u1eeb s\u1ef1 \u0111\u00fac k\u1ebft b\u1ec1n b\u1ec9 c\u1ee7a t\u1eb1m trong ho\u1ea1t \u0111\u1ed9ng nh\u1ea3 k\u00e9n. L\u1ee5a t\u01a1 t\u1eb1m th\u1eadt \u0111\u01b0\u1ee3c t\u1ea1o th\u00e0nh t\u1eeb vi\u1ec7c t\u00e1ch l\u1ea5y t\u01a1 do t\u1eb1m nh\u1ea3 ra v\u00e0 se s\u1ee3i, d\u1ec7t th\u00e0nh l\u1ee5a. \u0110\u00e2y v\u1ed1n l\u00e0 ngh\u1ec1 c\u00f3 t\u1eeb r\u1ea5t l\u00e2u \u0111\u1eddi \u1edf n\u01b0\u1edbc ta.<\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_min