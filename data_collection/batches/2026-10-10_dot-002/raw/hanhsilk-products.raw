d":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"T\u00edm","slug":"T\u00edm"},{"id":0,"name":"Xanh","slug":"Xanh"},{"id":0,"name":"Tr\u1eafng","slug":"Tr\u1eafng"},{"id":0,"name":"H\u1ed3ng","slug":"H\u1ed3ng"}]}],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;KH\u0102N \u0110\u0168I TH\u00caU HOA SEN NHI\u1ec0U M\u00c0U&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=3487","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3456,"name":"\u00c1o d\u00e0i l\u1ee5a xanh ng\u1ecdc 100% t\u01a1 t\u1eb1m","slug":"ao-dai-lua-xanh-ngoc-100-to-tam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/ao-dai-lua-xanh-ngoc-100-to-tam\/","sku":"","short_description":"<p>\u00c1o d\u00e0i \u201cXanh Ng\u1ecdc T\u1eb1m\u201d l\u00e0 m\u1ed9t thi\u1ebft k\u1ebf n\u00f3i b\u1eb1ng ch\u1ea5t li\u1ec7u, kh\u00f4ng c\u1ea7n ph\u00f4 di\u1ec5n b\u1eb1ng h\u1ecda ti\u1ebft c\u1ea7u k\u1ef3. T\u00f4ng xanh ng\u1ecdc tr\u1ea7m l\u1eafng \u0111\u01b0\u1ee3c d\u1ec7t tr\u00ean n\u1ec1n l\u1ee5a t\u01a1 t\u1eb1m Jacquard, n\u01a1i hoa v\u0103n hi\u1ec7n l\u00ean t\u1ef1 nhi\u00ean t\u1eeb ch\u00ednh c\u1ea5u tr\u00fac s\u1ee3i v\u1ea3i, tinh t\u1ebf \u0111\u1ebfn m\u1ee9c ch\u1ec9 khi ch\u1ea1m tay v\u00e0 ng\u1eafm th\u1eadt g\u1ea7n m\u1edbi c\u1ea3m nh\u1eadn tr\u1ecdn v\u1eb9n.<\/p>\n<p>L\u1ee5a t\u01a1 t\u1eb1m nguy\u00ean ch\u1ea5t mang \u0111\u1ed9 r\u1ee7 m\u1ec1m, m\u00e1t tay v\u00e0 \u00e1nh sheen nh\u1eb9, gi\u00fap d\u00e1ng \u00e1o \u0111\u1ee9ng form m\u00e0 v\u1eabn uy\u1ec3n chuy\u1ec3n theo t\u1eebng chuy\u1ec3n \u0111\u1ed9ng. S\u1eafc xanh ng\u1ecdc kh\u00f4ng r\u1ef1c r\u1ee1, kh\u00f4ng l\u1ea1nh, m\u00e0 c\u00e2n b\u1eb1ng gi\u1eefa s\u1ef1 \u0111i\u1ec1m t\u0129nh v\u00e0 sinh kh\u00ed g\u1ee3i c\u1ea3m gi\u00e1c an y\u00ean, sang tr\u1ecdng v\u00e0 r\u1ea5t d\u1ec5 m\u1eb7c trong nhi\u1ec1u kh\u00f4ng gian trang tr\u1ecdng kh\u00e1c nhau.<\/p>\n<p>\u201cXanh Ng\u1ecdc T\u1eb1m\u201d kh\u00f4ng k\u1ec3 c\u00e2u chuy\u1ec7n bay b\u1ed5ng. Chi\u1ebfc \u00e1o ch\u1ecdn c\u00e1ch th\u1ec3 hi\u1ec7n gi\u00e1 tr\u1ecb b\u1eb1ng ch\u1ea5t li\u1ec7u th\u1eadt, k\u1ef9 thu\u1eadt d\u1ec7t Jacquard chu\u1ea9n m\u1ef1c v\u00e0 m\u00e0u s\u1eafc b\u1ec1n v\u1eefng theo th\u1eddi gian. M\u1ed9t thi\u1ebft k\u1ebf d\u00e0nh cho ng\u01b0\u1eddi ph\u1ee5 n\u1eef y\u00eau s\u1ef1 tinh gi\u1ea3n, hi\u1ec3u gi\u00e1 tr\u1ecb th\u1ee7 c\u00f4ng, v\u00e0 tr\u00e2n tr\u1ecdng v\u1ebb \u0111\u1eb9p l\u1eb7ng l\u1ebd nh\u01b0ng l\u00e2u b\u1ec1n c\u1ee7a l\u1ee5a t\u01a1 t\u1eb1m Vi\u1ec7t Nam.<\/p>","description":"<p data-start=\"143\" data-end=\"760\">Chi\u1ebfc <strong data-start=\"149\" data-end=\"186\">\u00e1o d\u00e0i l\u1ee5a \u0111\u0169i Nam Cao \u2013 Hanhsilk<\/strong> l\u00e0 k\u1ebft tinh c\u1ee7a <strong data-start=\"203\" data-end=\"230\">90 ng\u00e0y lao \u0111\u1ed9ng b\u1ec1n b\u1ec9<\/strong> v\u00e0 <strong data-start=\"234\" data-end=\"263\">h\u01a1n 20 c\u00f4ng \u0111o\u1ea1n th\u1ee7 c\u00f4ng<\/strong> kh\u1eaft khe, b\u1eaft \u0111\u1ea7u t\u1eeb tr\u1ed3ng d\u00e2u, nu\u00f4i t\u1eb1m, k\u00e9o s\u1ee3i cho \u0111\u1ebfn d\u1ec7t v\u1ea3i, nhu\u1ed9m v\u00e0 ho\u00e0n thi\u1ec7n.<br data-start=\"351\" data-end=\"354\" \/>M\u1ed7i th\u01b0\u1edbc l\u1ee5a \u0111\u01b0\u1ee3c t\u1ea1o n\u00ean b\u1eb1ng s\u1ef1 ki\u00ean nh\u1eabn v\u00e0 \u0111\u00f4i tay l\u00e0nh ngh\u1ec1 c\u1ee7a nh\u1eefng ngh\u1ec7 nh\u00e2n g\u1eafn b\u00f3 tr\u1ecdn \u0111\u1eddi v\u1edbi l\u00e0ng ngh\u1ec1.<br data-start=\"470\" data-end=\"473\" \/>Ch\u1ea5t l\u1ee5a \u0111\u0169i m\u1ed9c m\u1ea1c nh\u01b0ng tinh t\u1ebf, tho\u00e1ng nh\u1eb9, th\u00e2n thi\u1ec7n v\u1edbi l\u00e0n da v\u00e0 mang h\u01a1i th\u1edf c\u1ee7a t\u1ef1 nhi\u00ean.<br data-start=\"572\" data-end=\"575\" \/>T\u1eebng \u0111\u01b0\u1eddng kim, n\u1ebfp v\u1ea3i tr\u00ean t\u00e0 \u00e1o l\u00e0 s\u1ef1 tr\u00e2n tr\u1ecdng d\u00e0nh cho di s\u1ea3n v\u00e0 v\u1ebb \u0111\u1eb9p ng\u01b0\u1eddi ph\u1ee5 n\u1eef Vi\u1ec7t.<br data-start=\"671\" data-end=\"674\" \/>Kh\u00f4ng ch\u1ec9 l\u00e0 trang ph\u1ee5c, \u0111\u00f3 l\u00e0 <strong data-start=\"705\" data-end=\"759\">m\u1ed9t gi\u00e1 tr\u1ecb v\u0103n h\u00f3a \u0111\u01b0\u1ee3c kho\u00e1c l\u00ean h\u00ecnh h\u00e0i \u00e1o d\u00e0i<\/strong>.<\/p>\n<p>S\u1ea3n ph\u1ea9m \u00c1o d\u00e0i l\u1ee5a t\u01a1 t\u1eb1m<\/p>\n<p>Ch\u1ea5t li\u1ec7u: L\u1ee5a t\u01a1 t\u1eb1m 100% t\u01a1 t\u1eb1m<\/p>\n<p>M\u00e0u s\u1eafc: m\u00e0u xanh ng\u1ecdc<\/p>\n<p>H\u1ecda ti\u1ebft: kh\u00f4ng<\/p>\n<p>Kh\u00e1ch h\u00e0ng c\u00f3 th\u1ec3 Inbox h\u1eb7c gh\u00e9 th\u0103m Hanhsilk \u0111\u1ec3 l\u1ef1a ch\u1ecdn v\u1ea3i, may \u0111o theo s\u1ed1 \u0111o kh\u00e1ch h\u00e0ng.<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>","on_sale":false,"prices":{"price":"4000000","regular_price":"4000000","sale_price":"4000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">4,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3458,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/01\/2C7EE95F-4F90-4723-A2E0-9B1FD5193758.png","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/01\/2C7EE95F-4F90-4723-A2E0-9B1FD5193758-300x300.png","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2