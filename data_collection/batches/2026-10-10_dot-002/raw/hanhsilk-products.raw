73\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-scaled.jpg 2131w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-250x300.jpg 250w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-852x1024.jpg 852w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-768x923.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-1279x1536.jpg 1279w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-1705x2048.jpg 1705w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/AAFBF70F-DD80-4451-BA81-552815203280-600x721.jpg 600w","sizes":"(max-width: 2131px) 100vw, 2131px","name":"Processed with VSCO with a10 preset","alt":""},{"id":1025,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/08\/8A105F64-71A0-4FD5-83DA-73066CC195EF-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/08\/8A105F64-71A0-4FD5-83DA-73066CC195EF-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/8A105F64-71A0-4FD5-83DA-73066CC195EF-scaled.jpg 1707w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/8A105F64-71A0-4FD5-83DA-73066CC195EF-200x300.jpg 200w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/8A105F64-71A0-4FD5-83DA-73066CC195EF-683x1024.jpg 683w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/08\/8A105F64-71A0-4FD5-83DA-73066CC195EF-768x1152.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads