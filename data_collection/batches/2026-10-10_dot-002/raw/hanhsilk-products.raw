u","slug":"khan-lua-theu","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/khan-lua-theu\/"},{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"T\u00edm","slug":"T\u00edm"},{"id":0,"name":"Xanh","slug":"Xanh"},{"id":0,"name":"Tr\u1eafng","slug":"Tr\u1eafng"},{"id":0,"name":"H\u1ed3ng","slug":"H\u1ed3ng"}]}],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;KH\u0102N L\u1ee4A \u0110\u0168I CAO C\u1ea4P TH\u00caU HOA SEN&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=361","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":352,"name":"B\u00f4ng t\u1ea9y trang t\u01a1 t\u1eb1m","slug":"bong-tay-trang-to-tam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/bong-tay-trang-to-tam\/","sku":"","short_description":"<h2><span style=\"font-size: 16px\">B\u00f4ng T\u1ea9y Trang t\u01a1 t\u1eb1m Hanhsilk , 100% T\u01a1 T\u1eb1m T\u1ef1 Nhi\u00ean (6 Mi\u1ebfng)<\/span><\/h2>\n<p>\u2728K\u00edch th\u01b0\u1edbc b\u00f4ng t\u1ea9y trang t\u01a1 t\u1eb1m: 8x8cm<br \/>\n\u2728Ch\u1ea5t li\u1ec7u: T\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean 100%<br \/>\n\u2728M\u00e0u s\u1eafc: Tr\u1eafng, V\u00e0ng kem (g\u1eedi l\u1ef1a ch\u1ecdn ng\u1eabu nhi\u00ean)<br \/>\n\u2728\u0110\u00f3ng g\u00f3i B\u00f4ng t\u1ea9y trang t\u01a1 t\u1eb1m: 6 Mi\u1ebfng\/ 1 t\u00fai<br \/>\n\u2728Xu\u1ea5t x\u1ee9: Hanhsilk ch\u00ednh h\u00e3ng, L\u00e0ng ngh\u1ec1 \u0111\u0169i Nam Cao, Th\u00e1i B\u00ecnh.<br \/>\nSau khi kh\u00f4ng d\u00f9ng B\u00f4ng t\u1ea9y trang t\u01a1 t\u1eb1m Hanhsilk th\u00ec khi b\u1ecf \u0111i, s\u1ea3n ph\u1ea9m h\u00f2a v\u00e0o \u0111\u1ea5t t\u1ed1t, th\u00e2n thi\u1ec7n b\u1ea3o v\u1ec7 m\u00f4i tr\u01b0\u1eddng s\u1ed1ng xanh \ud83c\udf0d<\/p>","description":"<div class=\"title-bl\">\n<h2><span style=\"font-size: 16px\">B\u00f4ng T\u1ea9y Trang t\u01a1 t\u1eb1m Hanhsilk g\u1ed3m 6 mi\u1ebfng b\u00f4ng t\u1ea9y trang t\u01a1 t\u1eb1m m\u1ec1m m\u1ea1i, t\u1ea9y s\u1ea1ch b\u00e3 nh\u1eddn tr\u00ean da, l\u1edbp trang \u0111i\u1ec3m, gi\u00fap ti\u1ebft ki\u1ec7m dung d\u1ecbch t\u1ea9y trang.<\/span><\/h2>\n<\/div>\n<div class=\"description-content\">\n<div class=\"description-productdetail\">\n<p>B\u00f4ng t\u1ea9y trang t\u01a1 t\u1eb1m Hanhsilk sau khi d\u00f9ng xong th\u00ec r\u1eeda s\u1ea1ch v\u1edbi x\u00e0 b\u00f4ng sinh h\u1ecdc v\u00e0 l\u1ea7n sau t\u00e1i s\u1eed d\u1ee5ng \u0111\u01b0\u1ee3c. Keo Secirin tr\u00ean t\u01a1 t\u1eb1m gi\u00fap c\u1ea5p \u1ea9m, t\u0103ng \u0111\u1ed9 \u0111\u00e0n h\u1ed3i cho da.<br \/>\nB\u00f4ng t\u1ea9y trang c\u00f3 th\u1ec3 t\u00e1i s\u1eed d\u1ee5ng nhi\u1ec1u l\u1ea7n, gi\u00fap ti\u1ebft ki\u1ec7m chi ph\u00ed v\u00e0 b\u1ea3o v\u1ec7 m\u00f4i tr\u01b0\u1eddng.<\/p>\n<p>&nbsp;<\/p>\n<\/div>\n<\/div>","on_sale":false,"prices":{"price":"200000","regular_price":"200000","sale_price":"200000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">200,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":353,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/Ban-sao-cua-05B2FC14-A556-4BD8-A8F1-A40425E5FB24-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/Ban-sao-cua-05B2FC14-A556-4BD8-A8F1-A40425E5FB24-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploa