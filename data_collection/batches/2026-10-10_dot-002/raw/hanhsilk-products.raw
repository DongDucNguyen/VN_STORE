0.png","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/112.png.png 512w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/112.png-212x300.png 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/112.png-8x12.png 8w","sizes":"(max-width: 512px) 100vw, 512px","name":"112.png","alt":""},{"id":3291,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/113.png.png","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/113.png-300x300.png","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/113.png.png 512w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/113.png-212x300.png 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/113.png-8x12.png 8w","sizes":"(max-width: 512px) 100vw, 512px","name":"113.png","alt":""},{"id":3292,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/114.png.png","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/114.png-300x300.png","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/114.png.png 512w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/114.png-212x300.png 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/114.png-8x12.png 8w","sizes":"(max-width: 512px) 100vw, 512px","name":"114.png","alt":""}],"categories":[{"id":157,"name":"V\u1ea3i Cao C\u1ea5p","slug":"vai-cao-cap","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/vai-cao-cap\/"},{"id":170,"name":"V\u1ea3i l\u1ee5a cao c\u1ea5p","slug":"vai-lua-cao-cap","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/vai-cao-cap\/vai-lua-cao-cap\/"}],"tags":[{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":41,"name":"l\u1ee5a t\u1ef1 nhi\u00ean","slug":"lua-tu-nhien","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-tu-nhien\/"},{"id":179,"name":"luatotamvietnam","slug":"luatotamvietnam","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/luatotamvietnam\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":183,"name":"v\u1ea3i l\u1ee5a","slug":"vai-lua","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-lua\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;V\u1ea3i l\u1ee5a d\u1ec7t h\u1ecda ti\u1ebft &#8211; L\u1ee5a Jacquard h\u1ecda ti\u1ebft tr\u1ed1ng \u0111\u1ed3ng&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=2918","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3192,"name":"V\u00e1y s\u00f3ng &#8211; Wavy dress","slug":"vay-song-wavy-dress","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/vay-song-wavy-dress\/","sku":"","short_description":"<h3 data-start=\"904\" data-end=\"984\">\ud83c\uddec\ud83c\udde7 <strong data-start=\"913\" data-end=\"982\">Wavy Asymmetrical Dress in Pure Silk \u2013 Minimal, Elegant, and Free<\/strong><\/h3>\n<p data-start=\"986\" data-end=\"1154\">This flowing, <strong data-start=\"1000\" data-end=\"1026\">asymmetrical-cut dress<\/strong> is crafted from <strong data-start=\"1043\" data-end=\"1064\">pure natural silk<\/strong>, with <strong data-start=\"1071\" data-end=\"1097\">no zippers, no buttons<\/strong> \u2014 a tribute to simplicity and the essence of material.<\/p>\n<p data-start=\"1156\" data-end=\"1384\">The <strong data-start=\"1160\" data-end=\"1182\">wide boat neckline<\/strong> adds grace and balance, allowing the fabric to move freely with the body. Designed by <strong data-start=\"1269\" data-end=\"1302\">Malaika Barbara Ebbli (Italy)<\/strong>, the dress is made from <strong data-start=\"1327\" data-end=\"1383\">handwoven Tussah silk by Hanhsilk \u2013 Nam Cao, Vietnam<\/strong>.<\/p>\n<p data-start=\"1386\" data-end=\"1476\">An ideal choice for those who embrace quiet elegance and the philosophy of &#8220;less is more.&#8221;<\/p>\n<p data-start=\"1478\" data-end=\"1574\">\ud83d\udccd Fabric: Handmade Tussah silk by Hanhsilk \u2013 Vietnam<br data-start=\"1531\" data-end=\"1534\" \/>\ud83d\udc57 Design: Malaika Barbara Ebbli \u2013 Italy<\/p>","description":"<h3 data-start=\"234\" data-end=\"311\">\ud83c\uddfb\ud83c\uddf3 <strong data-start=\"243\" data-end=\"309\">V\u00e1y l\u1ee5a d\u00e1ng l\u01b0\u1ee3n b\u1ea5t \u0111\u1ed1i x\u1ee9ng \u2013 Thi\u1ebft k\u1ebf t\u1ed1i gi\u1ea3n, sang tr\u1ecdng<\/strong><\/h3>\n<p data-start=\"313\" data-end=\"466\">Chi\u1ebfc v\u00e1y d\u00e1ng su\u00f4ng b\u1ea5t \u0111\u1ed1i x\u1ee9ng \u0111\u01b0\u1ee3c may t\u1eeb <strong data-start=\"359\" data-end=\"385\">l\u1ee5a t\u01a1 t\u1eb1m nguy\u00ean ch\u1ea5t<\/strong>, kh\u00f4ng kho\u00e1 k\u00e9o, kh\u00f4ng n\u00fat \u2013 t\u00f4n vinh tuy\u1ec7t \u0111\u1ed1i v\u1ebb \u0111\u1eb9p t\u1ef1 nhi\u00ean c\u1ee7a ch\u1ea5t li\u1ec7u.<\/p>\n<p data-start=\"468\" data-end=\"701\">Ph\u1ea7n c\u1ed5 <strong data-start=\"476\" data-end=\"496\">r\u1ed9ng d\u00e1ng thuy\u1ec1n<\/strong> t\u1ea1o s\u1ef1 thanh tho\u00e1t, m\u1ec1m m\u1ea1i, cho ph\u00e9p ng\u01b0\u1eddi m\u1eb7c chuy\u1ec3n \u0111\u1ed9ng t\u1ef1 do v\u00e0 duy\u00ean d\u00e1ng. \u0110\u00e2y l\u00e0 thi\u1ebft k\u1ebf c\u1ee7a <strong data-start=\"598\" data-end=\"636\">NTK Malaika Barbara Ebbli (Italia)<\/strong>, s\u1eed d\u1ee5ng <strong data-start=\"646\" data-end=\"698\">l\u1ee5a \u0111\u0169i th\u1ee7 c\u00f4ng t\u1eeb Hanhsilk \u2013 Nam Cao, Vi\u1ec7t Nam<\/strong>.<\/p>\n<p data-start=\"703\" data-end=\"799\">M\u1ed9t l\u1ef1a ch\u1ecdn l\u00fd t\u01b0\u1edfng cho nh\u1eefng ai y\u00eau v\u1ebb \u0111\u1eb9p \u0111\u01a1n gi\u1ea3n, s\u00e2u s\u1eafc v\u00e0 mang tinh th\u1ea7n \u201c\u00edt l\u00e0 nhi\u1ec1u\u201d.<\/p>\n<p data-start=\"801\" data-end=\"897\">\ud83d\udccd Ch\u1ea5t li\u1ec7u: L\u1ee5a \u0111\u0169i th\u1ee7 c\u00f4ng Hanhsilk \u2013 Vi\u1ec7t Nam<br data-start=\"851\" data-end=\"854\" \/>\ud83d\udc57 Thi\u1ebft k\u1ebf: Malaika Barbara Ebbli \u2013 Italia<\/p>","on_sale":false,"prices":{"price":"10000000","regular_price":"10000000","sale_price":"10000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">10,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3228,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1.jpg 1191w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1-724x1024.jpg 724w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1-768x1086.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1-1086x1536.jpg 1086w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1-8x12.jpg 8w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293368888_d3f261f71fb482ed074d551f59e61bd1-600x848.jpg 600w","sizes":"(max-width: 1191px) 100vw, 1191px","name":"z6787293368888_d3f261f71fb482ed074d551f59e61bd1","alt":""},{"id":3277,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd.jpg 1191w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd-724x1024.jpg 724w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd-768x1086.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd-1086x1536.jpg 1086w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd-8x12.jpg 8w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293934581_8630f54847548baa11ab84bc9a8dd6cd-600x848.jpg 600w","sizes":"(max-width: 1191px) 100vw, 1191px","name":"z6787293934581_8630f54847548baa11ab84bc9a8dd6cd","alt":""},{"id":3278,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160.jpg 1191w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160-724x1024.jpg 724w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160-768x1086.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160-1086x1536.jpg 1086w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160-8x12.jpg 8w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787294938181_48e1eb6a67227accc8b1dd25c019b160-600x848.jpg 600w","sizes":"(max-width: 1191px) 100vw, 1191px","name":"z6787294938181_48e1eb6a67227accc8b1dd25c019b160","alt":""}],"categories":[{"id":338,"name":"BST thi\u1ebft k\u1ebf Italia","slug":"bst","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/bst\/"},{"id":80,"name":"Th\u1eddi trang n\u1eef","slug":"thoi-trang-nu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/"}],"tags":[{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;V\u00e1y s\u00f3ng &#8211; Wavy dress&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=3192","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3177,"name":"\u00c1o kho\u00e1c \u0111\u0169i t\u01a1 t\u1eb1m &#8211; Duster coat","slug":"ao-khoac-dui-to-tam-duster-coat","parent":0,"type":"variable","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/ao-khoac-dui-to-tam-duster-coat\/","sku":"","short_description":"<h3 data-start=\"221\" data-end=\"284\">\ud83c\uddec\ud83c\udde7 <strong data-start=\"230\" data-end=\"282\">When Vietnamese Tussah Silk Meets Italian Design<\/strong><\/h3>\n<p data-start=\"286\" data-end=\"559\">The <strong data-start=\"290\" data-end=\"329\">hand-painted Duster coat and \u00c1o d\u00e0i<\/strong> are crafted from Vietnamese Tussah silk \u2014 a fully handmade material from the Nam Cao craft village \u2014 and <strong data-start=\"435\" data-end=\"456\">infused with soul<\/strong> by an Italian designer, resulting in a one-of-a-kind creation that embodies cross-cultural dialogue.<\/p>\n<p data-start=\"561\" data-end=\"800\">\ud83d\udcab This is the fruit of collaboration between <strong data-start=\"607\" data-end=\"619\">Hanhsilk<\/strong> and <strong data-start=\"624\" data-end=\"666\">designer Malaika Barbara Ebbli (Italy)<\/strong>, inspired by the essence of Nam Cao Tussah silk, traditional <strong data-start=\"728\" data-end=\"754\">Muong brocade patterns<\/strong>, and refined European tailoring techniques.<\/p>\n<p data-start=\"802\" data-end=\"1018\">Every detail \u2014 from the <strong data-start=\"826\" data-end=\"854\">handmade ceramic buttons<\/strong> to the free-flowing, modern silhouette \u2014 is brought to life by skilled artisans, delivering a design that is <strong data-start=\"964\" data-end=\"1015\">elegant, expressive, and effortlessly versatile<\/strong>.<\/p>\n<p data-start=\"1020\" data-end=\"1116\">\ud83c\udf8b A piece that carries the spirit of slow fashion, aesthetic depth, and cultural sensitivity.<\/p>\n<p data-start=\"1118\" data-end=\"1321\">\ud83d\udcf8 Photo: @sofia.tnv<br data-start=\"1138\" data-end=\"1141\" \/>\ud83d\udc57 Design: Malaika Barbara Ebbli \u2013 Italy<br data-start=\"1181\" data-end=\"1184\" \/>\ud83d\udccd Fabric: Handmade Tussah silk by Hanhsilk \u2013 Vietnam<br data-start=\"1237\" data-end=\"1240\" \/>\ud83e\udea1 Ceramic button: @stefaniamairano (Handmade in Hanoi)<br data-start=\"1295\" data-end=\"1298\" \/>\ud83d\udc64 Model: @vicobeatrice<\/p>","description":"<p>Khi L\u1ee5a \u0110\u0169i Vi\u1ec7t V\u00e0 Thi\u1ebft K\u1ebf T\u1eeb Italia<br \/>\nChi\u1ebfc \u00e1o kho\u00e1c Duster l\u00e0m t\u1eeb l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m Vi\u1ec7t Nam \u2013 ch\u1ea5t li\u1ec7u th\u1ee7 c\u00f4ng t\u1eeb l\u00e0ng ngh\u1ec1 Nam Cao \u2013 \u0111\u01b0\u1ee3c \u201cth\u1ed5i h\u1ed3n\u201d b\u1edfi nh\u00e0 thi\u1ebft k\u1ebf \u0111\u1ebfn t\u1eeb Italia, t\u1ea1o n\u00ean m\u1ed9t s\u1ea3n ph\u1ea9m \u0111\u1ed9c b\u1ea3n, \u0111\u1eadm t\u00ednh giao thoa v\u0103n h\u00f3a.<br \/>\n\ud83d\udcab \u0110\u00e2y l\u00e0 th\u00e0nh qu\u1ea3 c\u1ee7a s\u1ef1 h\u1ee3p t\u00e1c gi\u1eefa Hanhsilk v\u00e0 Nh\u00e0 thi\u1ebft k\u1ebf Malaika (Italia) \u2013 v\u1edbi c\u1ea3m h\u1ee9ng t\u1eeb l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m Nam Cao, h\u1ecda ti\u1ebft th\u1ed5 c\u1ea9m d\u00e2n t\u1ed9c M\u01b0\u1eddng v\u00e0 k\u1ef9 thu\u1eadt may m\u1eb7c ch\u00e2u \u00c2u tinh t\u1ebf.<br \/>\nT\u1eebng \u0111\u01b0\u1eddng n\u00e9t \u2013 t\u1eeb n\u00fat g\u1ed1m th\u1ee7 c\u00f4ng \u0111\u1ebfn form d\u00e1ng t\u1ef1 do, hi\u1ec7n \u0111\u1ea1i \u2013 \u0111\u1ec1u \u0111\u01b0\u1ee3c ho\u00e0n thi\u1ec7n b\u1edfi nh\u1eefng \u0111\u00f4i tay l\u00e0nh ngh\u1ec1, mang \u0111\u1ebfn v\u1ebb \u0111\u1eb9p thanh l\u1ecbch, c\u00e1 t\u00ednh v\u00e0 d\u1ec5 d\u00e0ng \u1ee9ng d\u1ee5ng trong nhi\u1ec1u ho\u00e0n c\u1ea3nh.<br \/>\n\ud83c\udf8b M\u1ed9t thi\u1ebft k\u1ebf mang trong m\u00ecnh tinh th\u1ea7n ch\u1eadm r\u00e3i \u2013 duy m\u1ef9 \u2013 v\u00e0 th\u1ea5u hi\u1ec3u v\u0103n h\u00f3a.<br \/>\n\ud83d\udcf8 \u1ea2nh: @sofia.tnv<br \/>\n\ud83d\udc57 Thi\u1ebft k\u1ebf: Malaika Barbara Ebbli \u2013 \u0111\u1ebfn t\u1eeb Italia<br \/>\n\ud83d\udccd Ch\u1ea5t li\u1ec7u: L\u1ee5a \u0111\u0169i th\u1ee7 c\u00f4ng Hanhsilk \u2013 Vi\u1ec7t Nam<br \/>\n\ud83e\udea1 N\u00fat g\u1ed1m: @stefaniamairano (Handmade in Hanoi)<br \/>\n\ud83d\udc64 Ng\u01b0\u1eddi m\u1eabu: @vicobeatrice<\/p>","on_sale":false,"prices":{"price":"15000000","regular_price":"15000000","sale_price":"15000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">15,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3276,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293564829_f23af8de4e562e2389a7bf0186aa8091-1.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293564829_f23af8de4e562e2389a7bf0186aa8091-1-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787293564829_f23af8de4e562e2389a7bf0186aa8091-1.jpg 1191w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/0