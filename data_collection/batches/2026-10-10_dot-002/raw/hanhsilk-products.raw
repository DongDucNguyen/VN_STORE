silk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/2C10BAB3-7D51-4B74-8D11-272160EC2DA0-683x1024.jpeg 683w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/2C10BAB3-7D51-4B74-8D11-272160EC2DA0-768x1152.jpeg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/2C10BAB3-7D51-4B74-8D11-272160EC2DA0-1024x1536.jpeg 1024w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/2C10BAB3-7D51-4B74-8D11-272160EC2DA0-1365x2048.jpeg 1365w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/2C10BAB3-7D51-4B74-8D11-272160EC2DA0-600x900.jpeg 600w","sizes":"(max-width: 1707px) 100vw, 1707px","name":"Processed with VSCO with 4 preset","alt":""},{"id":396,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-scaled.jpeg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-300x300.jpeg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-scaled.jpeg 1695w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-199x300.jpeg 199w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-678x1024.jpeg 678w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-768x1160.jpeg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-1017x1536.jpeg 1017w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-1356x2048.jpeg 1356w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/1E56ACDA-5783-4CFE-B90B-4B463EF84BAD-600x906.jpeg 600w","sizes":"(max-width: 1695px) 100vw, 1695px","name":"Processed with VSCO with 4 preset","alt":""},{"id":401,"src":"https:\/\/hanhsi