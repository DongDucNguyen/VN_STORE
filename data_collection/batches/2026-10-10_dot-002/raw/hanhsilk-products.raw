30*50"}]},{"id":1121,"attributes":[{"name":"K\u00edch th\u01b0\u1edbc","value":"50*70"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;V\u1ece G\u1ed0I L\u1ee4A T\u01a0 T\u1eb0M KH\u00d4NG CH\u1ea6N&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/vo-goi-lua-to-tam-khong-chan\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":1046,"name":"G\u1ed0I VU\u00d4NG \u0110\u0168I T\u01a0 T\u1eb0M V\u1ebc TAY","slug":"goi-vuong-dui-to-tam-ve-tay","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/goi-vuong-dui-to-tam-ve-tay\/","sku":"","short_description":"<p>G\u1ed1i \u0111\u0169i l\u1ee5a t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean \u0111\u01b0\u1ee3c h\u1ecda s\u1ef9 v\u1ebd tay.<\/p>\n<p>K\u00edch th\u01b0\u1edbc: 45cm x 45cm<\/p>","description":"<p>G\u1ed1i t\u01a1 t\u1eb1m \u0111\u01b0\u1ee3c l\u00e0m t\u1eeb \u0111\u0169i t\u01a1 t\u1eb1m do h\u1ecda s\u0129 v\u1ebd tay.<\/p>\n<p>T\u1eeb nh\u1eefng k\u00e9n \u0111\u00e3 c\u1eaft m\u1ed9t \u0111\u1ea7u \u0111\u1ec3 l\u1ea5y nh\u1ed9ng s\u1ed1ng, c\u00e1c ngh\u1ec7 nh\u00e2n ti\u1ebfn h\u00e0nh x\u1eed l\u00fd k\u00e9n b\u1eb1ng c\u00e1ch \u0111un s\u00f4i v\u1edbi n\u01b0\u1edbc nhi\u1ec1u l\u1ea7n v\u00e0 \u0111\u1ee7 th\u1eddi gian \u0111\u1ec3 thu \u0111\u01b0\u1ee3c t\u01a1 th\u00f4<em>.\u00a0<\/em>Sau \u0111\u00f3, t\u1eebng c\u1ee5m t\u01a1 t\u1eb1m th\u00f4 nh\u1ecf \u0111\u01b0\u1ee3c l\u00e0m b\u00f4ng b\u1eb1ng tay r\u1ed3i k\u00e9o th\u00e0nh d\u1ea3i b\u00f4ng t\u01a1 t\u1eb1m d\u00e0i v\u00e0 c\u1eaft \u0111o\u1ea1n ph\u00f9 h\u1ee3p v\u1edbi k\u00edch th\u01b0\u1edbc g\u1ed1i \u0111\u1ec3 l\u00e0m v\u1ecf g\u1ed1i. Ph\u1ea7n ru\u1ed9t b\u00f4ng g\u1ed1i \u0111\u01b0\u1ee3c l\u00e0m b\u1eb1ng Polyeste th\u00f4ng th\u01b0\u1eddng.<\/p>\n<p>G\u1ed1i \u0111\u1ed9c b\u1ea3n \u0111\u01b0\u1ee3c h\u1ecda s\u1ef9 v\u1ebd tay nh\u1eefng h\u1ecda ti\u1ebft hoa n\u1ed5i b\u1eadt, th\u00edch h\u1ee3p \u0111\u1ec3 Decor cho c\u0103n ph\u00f2ng c\u1ee7a b\u1ea1n.<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>","on_sale":false,"prices":{"price":"1500000","regular_price":"1500000","sale_price":"1500000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">1,500,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":1051,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-scaled.jpg 2560w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-300x225.jpg 300w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-1024x768.jpg 1024w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-768x576.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-1536x1152.jpg 1536w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-2048x1536.jpg 2048w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/09\/z4661495410704_03d143e472cc600090077c66467810f5-600x450.jpg 600w","sizes":"(max-width: 2560px) 1