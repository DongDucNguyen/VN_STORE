tags":[{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":130,"name":"kh\u0103n l\u1ee5a th\u1ee7y \u1ea5n","slug":"khan-lua-thuy-an","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/khan-lua-thuy-an\/"},{"id":133,"name":"kh\u0103n l\u1ee5a vu\u00f4ng Th\u1ee7y \u1ea4n","slug":"khan-lua-vuong-thuy-an","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/khan-lua-vuong-thuy-an\/"},{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"1","slug":"1"},{"id":0,"name":"2","slug":"2"},{"id":0,"name":"3","slug":"3"},{"id":0,"name":"4","slug":"4"},{"id":0,"name":"5","slug":"5"},{"id":0,"name":"6","slug":"6"},{"id":0,"name":"7","slug":"7"},{"id":0,"name":"8","slug":"8"}]}],"variations":[{"id":4004,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"1"}]},{"id":4005,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"2"}]},{"id":4006,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"3"}]},{"id":4007,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"4"}]},{"id":4008,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"5"}]},{"id":4009,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"6"}]},{"id":4010,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"7"}]},{"id":4011,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"8"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;KH\u0102N L\u1ee4A VU\u00d4NG TH\u1ee6Y \u1ea4N&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/khan-lua-vuong-thuy-an\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":570,"name":"KH\u0102N L\u1ee4A TH\u1ee6Y \u1ea4N D\u00c0I","slug":"khan-lua-hoa-si-ve-tay","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/khan-lua-hoa-si-ve-tay\/","sku":"","short_description":"<p>T\u1ef1 h\u00e0o l\u00e0 m\u1ed9t trong nh\u1eefng th\u01b0\u01a1ng hi\u1ec7u L\u1ee5a Vi\u1ec7t mang \u0111\u1eadm d\u1ea5u \u1ea5n v\u00e0 tinh th\u1ea7n c\u1ee7a Ng\u01b0\u1eddi Vi\u1ec7t, Hanhsilk cam k\u1ebft t\u1ea5t c\u1ea3 c\u00e1c d\u00f2ng kh\u0103n l\u1ee5a v\u1ebd tay Hanhsilk nh\u01b0: Kh\u0103n l\u1ee5a qu\u00e0ng c\u1ed5, kh\u0103n cho\u00e0ng c\u1ed5 l\u1ee5a \u0111\u1ec1u l\u00e0m t\u1eeb L\u1ee5a \u0111\u0169i 100% t\u01a1 t\u1eb1m. V\u1edbi t\u00f4n ch\u1ec9 n\u00e0y, ch\u00fang t\u00f4i mang trong m\u00ecnh kh\u00e1t v\u1ecdng v\u1ef1c d\u1eady t\u01a1 l\u1ee5a Thu\u1ea7n Vi\u1ec7t \u1edf trong n\u01b0\u1edbc v\u00e0 vinh danh L\u1ee5a Vi\u1ec7t tr\u00ean tr\u01b0\u1eddng qu\u1ed1c t\u1ebf, x\u1ee9ng danh ng\u00e0n n\u0103m s\u00f3ng l\u1ee5a t\u01a1 t\u1eb1m Vi\u1ec7t Nam.<\/p>\n<p>Size: 80*180cm<\/p>","description":"<h1>Kh\u0103n l\u1ee5a v\u1ebd Th\u1ee7y \u1ea4n Hanhsilk \u2013<\/h1>\n<p>V\u1edbi ch\u1ea5t li\u1ec7u L\u1ee5a t\u01a1 t\u1eb1m \u00f3ng \u1ea3, m\u1ec1m m\u1ea1i v\u00e0 sang tr\u1ecdng c\u00f9ng n\u00e9t v\u1ebd tay \u0111\u1ed9c b\u1ea3n c\u1ee7a c\u00e1c h\u1ecda s\u0129 h\u00e0ng \u0111\u1ea7u Vi\u1ec7t Nam. C\u00e1c thi\u1ebft k\u1ebf mang t\u00ednh \u1ee9ng d\u1ee5ng th\u1eddi trang cao v\u00e0 l\u00e0 xu h\u01b0\u1edbng th\u1ecbnh h\u00e0nh hi\u1ec7n nay.<br \/>\nV\u1edbi nh\u1eefng thi\u1ebft k\u1ebf sang tr\u1ecdng, tinh t\u1ebf, m\u1ed7i chi\u1ebfc kh\u0103n l\u1ee5a qu\u00e0ng c\u1ed5, kh\u0103n cho\u00e0ng c\u1ed5 l\u1ee5a c\u1ee7a Hanhsilk d\u01b0\u1edbi n\u00e9t v\u1ebd c\u1ee7a h\u1ecda s\u0129 \u0111\u1ec1u tr\u1edf n\u00ean s\u1ed1ng \u0111\u1ed9ng, n\u00ean th\u01a1 v\u00e0 l\u00e0 l\u1ef1a ch\u1ecdn h\u00e0ng \u0111\u1ea7u c\u1ee7a c\u00e1c B\u1ed9 ban ng\u00e0nh, c\u00e1c T\u1eadp \u0111o\u00e0n l\u1edbn \u0111\u1ec3 l\u00e0m<strong>\u00a0qu\u00e0 t\u1eb7ng \u0111\u1ed1i t\u00e1c, qu\u00e0 t\u1eb7ng ngo\u1ea1i giao, qu\u00e0 t\u1eb7ng \u0111\u1ed1i t\u00e1c n\u01b0\u1edbc ngo\u00e0i, qu\u00e0 t\u1eb7ng doanh nghi\u1ec7p\u2026.<\/strong><\/p>\n<div dir=\"auto\">Kh\u0103n l\u1ee5a Th\u1ee7y \u1ea4n Hanhsilk mang s\u1eafc xanh pha nh\u1eb9 nh\u00e0ng, m\u00e1t l\u00e0nh nh\u01b0 nh\u1eefng con th\u00e1c trong v\u1eaft \u0111ang ch\u1ea3y. \u0110i\u1ec3m \u0111\u1eb7c bi\u1ec7t c\u1ee7a d\u00f2ng kh\u0103n n\u00e0y kh\u00f4ng ch\u1ec9 n\u1eb1m \u1edf m\u00e0u s\u1eafc, m\u00e0 c\u00f2n \u1edf ph\u01b0\u01a1ng ph\u00e1p th\u1ee7y \u1ea5n \u0111\u1ed9c \u0111\u00e1o \u2013 t\u1ea1o n\u00ean nh\u1eefng h\u1ecda ti\u1ebft kh\u00f4ng bao gi\u1edd l\u1eb7p l\u1ea1i.<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">Kh\u00e1c v\u1edbi c\u00e1ch in, th\u00eau hay v\u1ebd tr\u00ean l\u1ee5a th\u00f4ng th\u01b0\u1eddng, ngh\u1ec7 thu\u1eadt Th\u1ee7y \u1ea5n l\u00e0 s\u1ef1 k\u1ebft h\u1ee3p gi\u1eefa \u0111\u00f4i tay t\u00e0i hoa c\u1ee7a ng\u01b0\u1eddi h\u1ecda s\u0129 v\u00e0 s\u1ef1 chuy\u1ec3n \u0111\u1ed9ng t\u1ef1 nhi\u00ean c\u1ee7a m\u1eb7t n\u01b0\u1edbc. M\u00e0u s\u1eafc \u0111\u01b0\u1ee3c th\u1ea3 tr\u00ean dung d\u1ecbch \u0111\u1eb7c bi\u1ec7t, v\u00e0 t\u1eebng chuy\u1ec3n \u0111\u1ed9ng nh\u1eb9 nh\u00e0ng t\u1ea1o n\u00ean b\u1ee9c tranh ng\u1eabu h\u1ee9ng. L\u1ee5a \u0111\u01b0\u1ee3c th\u1ea5m m\u00e0u theo c\u00e1ch \u1ea5y, \u0111em \u0111\u1ebfn m\u1ed9t t\u00e1c ph\u1ea9m kh\u00f4ng ch\u1ec9 \u0111\u1eb9p m\u00e0 c\u00f2n \u0111\u1ea7y c\u1ea3m x\u00fac, m\u00e0u xanh d\u1ecbu d\u00e0ng nh\u01b0 d\u00f2ng th\u00e1c tu\u00f4n ch\u1ea3y m\u00e3i kh\u00f4ng ng\u1eebng.<\/div>","on_sale":false,"prices":{"price":"900000","regular_price":"900000","sale_price":"900000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocomm