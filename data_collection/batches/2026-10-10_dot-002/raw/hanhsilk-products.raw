84-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabozandysjk200i1etgd4cw69nce4ukow484-scaled.jpg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabozandysjk200i1etgd4cw69nce4ukow484-169x300.jpg 169w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabozandysjk200i1etgd4cw69nce4ukow484-576x1024.jpg 576w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabozandysjk200i1etgd4cw69nce4ukow484-768x1365.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabozandysjk200i1etgd4cw69nce4ukow484-864x1536.jpg 864w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabozandysjk200i1etgd4cw69nce4ukow484-7x12.jpg 7w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabozandysjk200i1etgd4cw69nce4ukow484-600x1067.jpg 600w","sizes":"(max-width: 1152px) 100vw, 1152px","name":"2aoboqabozandysjk200i1etgd4cw69nce4ukow484","alt":""}],"categories":[{"id":153,"name":"Ch\u0103n\/ga\/g\u1ed1i ng\u1ee7","slug":"chan-ga-goi-ngu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/decor\/chan-ga-goi-ngu\/"},{"id":81,"name":"Decor","slug":"decor","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/decor\/"}],"tags":[{"id":123,"name":"ch\u0103n l\u1ee5a t\u01a1 t\u1eb1m","slug":"chan-lua-to-tam","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/chan-lua-to-tam\/"},{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":89,"name":"r\u00e8m l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m","slug":"rem-lua-dui-to-tam","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/rem-lua-dui-to-tam\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":true,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;CH\u0102N L\u1ee4A SATIN V\u00c0 2 V\u1ece G\u1ed0I CH\u1ea6N B\u00d4NG&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=4144","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":4143,"name":"CH\u0102N L\u1ee4A H\u1eccA S\u0128 V\u1ebc TAY V\u00c0 2 V\u1ece G\u1ed0I CH\u1ea6N B\u00d4NG","slug":"chan-lua-hoa-si-ve-tay-va-2-vo-goi-chan-bong","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/chan-lua-hoa-si-ve-tay-va-2-vo-goi-chan-bong\/","sku":"","short_description":"<p>Ch\u0103n L\u1ee5a t\u01a1 t\u1eb1m h\u1ecda s\u0129 v\u1ebd tay ch\u1ea5t li\u1ec7u 100% v\u1ea3i t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean, m\u00f9a \u0111\u00f4ng \u1ea5m m\u00f9a h\u00e8 m\u00e1t nh\u1eb9 tho\u00e1ng, s\u1eed d\u1ee5ng 4 m\u00f9a. \u0110\u1eb7c bi\u1ec7t ch\u0103n l\u1ee5a t\u01a1 t\u1eb1m h\u00e8 thu s\u1eed d\u1ee5ng \u0111i\u1ec1u ho\u00e0 n\u1eb1m nh\u1eb9 c\u1ea3m gi\u00e1c \u0111\u1eafp nh\u01b0 kh\u00f4ng \u0111\u1eafp.<\/p>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Ch\u1ea5t li\u1ec7u: v\u1ea3i 100% t\u01a1 t\u1eb1m Vi\u1ec7t Nam<\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">K\u00edch th\u01b0\u1edbc: 2m3 x 2m4<\/div>\n<\/div>\n<div dir=\"auto\">&#8211; V\u1ecf g\u1ed1i ch\u1ea7n b\u00f4ng:<\/div>\n<div dir=\"auto\">Ch\u1ea7n b\u00f4ng xu\u1ea5t H\u00e0n Qu\u1ed1c<\/div>\n<div dir=\"auto\">S\u1ed1 l\u01b0\u1ee3ng 2 v\u1ecf g\u1ed1i<\/div>\n<p>Th\u1eddi gian \u0111\u1eb7t ch\u0103n t\u1eeb 7 &#8211; 10 ng\u00e0y. Qu\u00fd kh\u00e1ch order ch\u0103n theo k\u00edch th\u01b0\u1edbc, m\u00e0u s\u1eafc, h\u1ecda ti\u1ebft kh\u00e2u tay ri\u00eang c\u00f3 th\u1ec3 li\u00ean h\u1ec7 Hotline: 0977 241 182 \u0111\u1ec3 \u0111\u01b0\u1ee3c t\u01b0 v\u1ea5n<\/p>","description":"<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Th\u1eddi ti\u1ebft thu se l\u1ea1nh c\u1ea7n chi\u1ebfc ch\u0103n m\u1ecfng nh\u1eb9 nh\u01b0ng \u0111\u1ee7 ti\u00eau ch\u00ed c\u00f4ng n\u0103ng: \u0110\u00f4ng \u1ea5m, h\u00e8 m\u00e1t, thu ph\u1ea3i nh\u1eb9 nh\u00e0ng. Ch\u1ec9 c\u00f3 ch\u0103n l\u1ee5a m\u1edbi \u0111\u1ee7 ti\u00eau ch\u00ed th\u1eddi ti\u1ebft 4 m\u00f9a nh\u01b0 v\u1eady.<\/div>\n<div dir=\"auto\"><\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Ch\u0103n kh\u00e2u tay t\u1ec9 m\u1ec9 t\u1eebng \u0111\u01b0\u1eddng kim m\u0169i ch\u1ec9, th\u1eddi gian 10-15 ng\u00e0y ho\u00e0n th\u00e0nh 1c ch\u0103n, \u0111o Th\u01b0\u1edbc c\u1eaft v\u1ea3i h\u1ebft 17-18 m v\u1ea3i l\u1edbn h\u01a1n nhi\u1ec1u so v\u1edbi may b\u1ed9 \u0111\u1ed3 v\u1eady m\u00e0 gi\u00e1 b\u00e1n ch\u1ec9 b\u1eb1ng 1c v\u00e1y. Nh\u01b0ng kh\u00f4ng ph\u1ea3i v\u00ec v\u1eady m\u00e0 ngh\u0129 \u0111\u1eaft ngh\u0129 r\u1ebb Hanhsilk mong mu\u1ed1n ng\u01b0\u1eddi Vi\u1ec7t \u0111\u01b0\u1ee3c ch\u1ea1m l\u1ee5a Vi\u1ec7t Th\u1eadt v\u00e0 quan tr\u1ecdng h\u01a1n h\u1ebft th\u1eddi \u0111i\u1ec3m n\u00e0y gi\u00fap b\u00e0 con n\u00f4ng d\u00e2n, nh\u1eefng ng\u01b0\u1eddi l\u00e0m ngh\u1ec1 th\u1ee7 c\u00f4ng t\u01a1 l\u1ee5a c\u00f3 vi\u1ec7c l\u00e0m \u1ed5n \u0111\u1ecbnh<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">&#8211; Ch\u1ea5t li\u1ec7u: v\u1ea3i 100% t\u01a1 t\u1eb1m Vi\u1ec7t Nam<\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">&#8211; K\u00edch th\u01b0\u1edbc: 2m3 x 2m4<\/div>\n<\/div>\n<div dir=\"auto\">&#8211; V\u1ecf g\u1ed1i ch\u1ea7n b\u00f4ng: Ch\u1ea7n b\u00f4ng xu\u1ea5t H\u00e0n Qu\u1ed1c. S\u1ed1 l\u01b0\u1ee3ng 2 v\u1ecf g\u1ed1i<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\"><\/div>\n<\/div>\n<\/div>\n<\/div>\n<div dir=\"auto\">Kh\u00e1ch h\u00e0ng ch\u1ecdn ki\u1ec3u, m\u00e0u vui l\u00f2ng ghi l\u1ea1i ch\u00fa th\u00edch ho\u1eb7c g\u1ecdi \u0111i\u1ec7n \u0111\u1ebfn s\u1ed1 Hotline: 0985969864 &#8211; 0977241182 \u0111\u1ec3 \u0111\u01b0\u1ee3c t\u01b0 v\u1ea5n.<\/div>","on_sale":false,"prices":{"price":"14000000","regular_price":"14000000","sale_price":"14000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">14,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":4115,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-scaled.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-scaled.jpg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-169x300.jpg 169w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-576x1024.jpg 576w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-768x1365.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-864x1536.jpg 864w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabpkpoxvv6f5ctadd28xvjutvvokwkq4xo148-7x