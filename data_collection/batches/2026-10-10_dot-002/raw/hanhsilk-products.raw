u-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":183,"name":"v\u1ea3i l\u1ee5a","slug":"vai-lua","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-lua\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;V\u1ea3i l\u1ee5a d\u1ec7t h\u1ecda ti\u1ebft &#8211; L\u1ee5a Jacquard h\u1ecda ti\u1ebft hoa h\u1ed3ng&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=2919","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":2910,"name":"Kh\u0103n l\u1ee5a t\u01a1 t\u1eb1m d\u1ec7t h\u1ecda ti\u1ebft &#8211; Jacquard Scarf","slug":"khan-lua-to-tam-det-hoa-tiet-jacquard-scarf","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/khan-lua-to-tam-det-hoa-tiet-jacquard-scarf\/","sku":"","short_description":"<p data-start=\"540\" data-end=\"586\"><strong data-start=\"540\" data-end=\"586\">\u0110\u1eb7c \u0110i\u1ec3m N\u1ed5i B\u1eadt c\u1ee7a Kh\u0103n Jacquard T\u01a1 T\u1eb1m:<\/strong><\/p>\n<ul data-start=\"587\" data-end=\"1204\">\n<li data-start=\"587\" data-end=\"691\"><strong data-start=\"589\" data-end=\"603\">Ch\u1ea5t li\u1ec7u:<\/strong> 100% t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean, m\u1ec1m m\u1ea1i v\u00e0 b\u1ec1n b\u1ec9, \u0111\u1ea3m b\u1ea3o s\u1ef1 tho\u1ea3i m\u00e1i t\u1ed1i \u01b0u cho ng\u01b0\u1eddi s\u1eed d\u1ee5ng.<\/li>\n<li data-start=\"692\" data-end=\"933\"><strong data-start=\"694\" data-end=\"707\">Thi\u1ebft k\u1ebf:<\/strong> H\u1ecda ti\u1ebft Jacquard n\u1ed5i b\u1eadt v\u1edbi c\u00e1c \u0111\u01b0\u1eddng n\u00e9t tinh x\u1ea3o, ph\u1ee9c t\u1ea1p \u0111\u01b0\u1ee3c d\u1ec7t tr\u1ef1c ti\u1ebfp v\u00e0o v\u1ea3i, kh\u00f4ng ph\u1ea3i l\u00e0 in \u1ea5n hay th\u00eau. M\u1ed7i chi\u1ebfc kh\u0103n l\u00e0 k\u1ebft qu\u1ea3 c\u1ee7a h\u00e0ng gi\u1edd lao \u0111\u1ed9ng t\u1ec9 m\u1ec9 v\u00e0 ch\u00ednh x\u00e1c t\u1eeb c\u00e1c ngh\u1ec7 nh\u00e2n d\u00e0y d\u1eb7n kinh nghi\u1ec7m.<\/li>\n<li data-start=\"934\" data-end=\"1073\"><strong data-start=\"936\" data-end=\"962\">M\u00e0u s\u1eafc v\u00e0 k\u00edch th\u01b0\u1edbc:<\/strong> S\u1ea3n ph\u1ea9m c\u00f3 s\u1eb5n trong nhi\u1ec1u m\u00e0u s\u1eafc th\u1eddi trang v\u00e0 k\u00edch th\u01b0\u1edbc ti\u00eau chu\u1ea9n l\u00e0m n\u1ed5i b\u1eadt m\u1ecdi phong c\u00e1ch trang ph\u1ee5c.<\/li>\n<li data-start=\"1074\" data-end=\"1204\"><strong data-start=\"1076\" data-end=\"1088\">\u0110a n\u0103ng:<\/strong> Ph\u00f9 h\u1ee3p \u0111\u1ec3 s\u1eed d\u1ee5ng trong nhi\u1ec1u ho\u00e0n c\u1ea3nh kh\u00e1c nhau, t\u1eeb nh\u1eefng b\u1eefa ti\u1ec7c sang tr\u1ecdng, s\u1ef1 ki\u1ec7n quan tr\u1ecdng \u0111\u1ebfn h\u00e0ng ng\u00e0y.<\/li>\n<\/ul>","description":"<p data-start=\"120\" data-end=\"194\"><strong data-start=\"120\" data-end=\"194\">Kh\u00e1m Ph\u00e1 V\u1ebb \u0110\u1eb9p Ho\u00e0n M\u1ef9 c\u1ee7a Kh\u0103n Jacquard T\u01a1 T\u1eb1m &#8211; Ch\u1ec9 C\u00f3 T\u1ea1i Hanhsilk<\/strong><\/p>\n<p data-start=\"196\" data-end=\"538\">T\u1ea1i Hanhsilk, ch\u00fang t\u00f4i t\u1ef1 h\u00e0o mang \u0111\u1ebfn cho b\u1ea1n nh\u1eefng t\u00e1c ph\u1ea9m ngh\u1ec7 thu\u1eadt t\u1eeb t\u01a1 t\u1eb1m kh\u00f4ng ch\u1ec9 t\u00f4n vinh v\u1ebb \u0111\u1eb9p truy\u1ec1n th\u1ed1ng m\u00e0 c\u00f2n ph\u00f9 h\u1ee3p v\u1edbi phong c\u00e1ch th\u1eddi trang hi\u1ec7n \u0111\u1ea1i. Kh\u0103n Jacquard t\u01a1 t\u1eb1m l\u00e0 minh ch\u1ee9ng r\u00f5 r\u00e0ng nh\u1ea5t cho s\u1ef1 k\u1ebft h\u1ee3p gi\u1eefa c\u00f4ng ngh\u1ec7 d\u1ec7t hi\u1ec7n \u0111\u1ea1i v\u00e0 ngh\u1ec7 thu\u1eadt th\u1ee7 c\u00f4ng truy\u1ec1n th\u1ed1ng, t\u1ea1o ra m\u1ed9t s\u1ea3n ph\u1ea9m \u0111\u1ed9c \u0111\u00e1o v\u00e0 \u0111\u1eb3ng c\u1ea5p.<\/p>\n<p data-start=\"1422\" data-end=\"1653\">Kh\u0103n Jacquard t\u01a1 t\u1eb1m t\u1eeb Hanhsilk l\u00e0 s\u1ef1 l\u1ef1a ch\u1ecdn ho\u00e0n h\u1ea3o cho nh\u1eefng ai \u0111\u00e1nh gi\u00e1 cao ch\u1ea5t l\u01b0\u1ee3ng v\u00e0 v\u1ebb \u0111\u1eb9p trong t\u1eebng s\u1ea3n ph\u1ea9m. H\u00e3y s\u1edf h\u1eefu ngay chi\u1ebfc kh\u0103n n\u00e0y \u0111\u1ec3 th\u00eam m\u1ed9t n\u00e9t \u0111\u1eb9p sang tr\u1ecdng v\u00e0 qu\u00fd ph\u00e1i cho b\u1ed9 s\u01b0u t\u1eadp ph\u1ee5 ki\u1ec7n c\u1ee7a b\u1ea1n.<\/p>\n<p data-start=\"1655\" data-end=\"1875\"><strong data-start=\"1655\" data-end=\"1680\">\u0110\u1eb7t h\u00e0ng ngay h\u00f4m nay<\/strong> \u0111\u1ec3 c\u1ea3m nh\u1eadn s\u1ef1 kh\u00e1c bi\u1ec7t m\u00e0 ch\u1ec9 Hanhsilk m\u1edbi c\u00f3 th\u1ec3 mang l\u1ea1i. B\u1ea1n c\u0169ng c\u00f3 th\u1ec3 gh\u00e9 qua showroom c\u1ee7a ch\u00fang t\u00f4i t\u1ea1i \u0111\u1ecba ch\u1ec9 sau ho\u1eb7c li\u00ean h\u1ec7 tr\u1ef1c ti\u1ebfp qua hotline \u0111\u1ec3 \u0111\u01b0\u1ee3c t\u01b0 v\u1ea5n v\u00e0 h\u1ed7 tr\u1ee3 t\u1ed1t nh\u1ea5t.<\/p>","on_sale":false,"prices":{"price":"1800000","regular_price":"1800000","sale_price":"1800000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">1,800,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":2941,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/02\/IMG_3562-scaled-e1748340098939.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/02\/IMG_3562-scaled-e1748340098939-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/02\/IMG_3562-scaled-e1748340098939.jpg 1440w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/02\/IMG_3562-scaled-e17483400989