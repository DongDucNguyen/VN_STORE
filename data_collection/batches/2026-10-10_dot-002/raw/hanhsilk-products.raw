o-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":378,"name":"qu\u00e0 t\u1eb7ng 8\/3","slug":"qua-tang-8-3","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/qua-tang-8-3\/"},{"id":379,"name":"qu\u00e0 t\u1eb7ng ph\u1ee5 n\u1eef","slug":"qua-tang-phu-nu","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/qua-tang-phu-nu\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;Set qu\u00e0 t\u1eb7ng: Kh\u0103n t\u01a1 \u00f3ng \u1ea3, kh\u1ea9u trang v\u00e0 d\u00e2y bu\u1ed9c t\u00f3c&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=3632","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3613,"name":"Set qu\u00e0 t\u1eb7ng &#8211; Kh\u0103n hoa Th\u1ee7y \u1ea4n v\u00e0 v\u00f2ng l\u1ee5a","slug":"set-qua-tang-8-3-hoa-va-vong-lua-tri-an-phu-nu","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/set-qua-tang-8-3-hoa-va-vong-lua-tri-an-phu-nu\/","sku":"","short_description":"<p data-start=\"587\" data-end=\"603\">B\u1ed9 s\u1ea3n ph\u1ea9m Set qu\u00e0 t\u1eb7ng 8\/3 &#8211; D\u1ea5u \u1ea5n d\u1ecbu d\u00e0ng g\u1ed3m:<\/p>\n<ul data-start=\"605\" data-end=\"1038\">\n<li data-start=\"605\" data-end=\"849\">\n<p data-start=\"607\" data-end=\"849\"><strong data-start=\"609\" data-end=\"646\">01 Kh\u0103n l\u1ee5a vu\u00f4ng Th\u1ee7y \u1ea4n 87x87cm<\/strong><br data-start=\"646\" data-end=\"649\" \/>Thi\u1ebft k\u1ebf theao k\u1ef9 thu\u1eadt nhu\u1ed9m Th\u1ee7y \u1ea4n \u0111\u1ed9c \u0111\u00e1o, m\u1ed7i chi\u1ebfc kh\u0103n l\u00e0 m\u1ed9t b\u1ea3n v\u1ebd kh\u00f4ng l\u1eb7p l\u1ea1i. M\u00e0u s\u1eafc h\u00f2a quy\u1ec7n t\u1ef1 nhi\u00ean nh\u01b0 nh\u1eefng l\u1edbp c\u1ea3m x\u00fac d\u1ecbu d\u00e0ng c\u1ee7a ng\u01b0\u1eddi ph\u1ee5 n\u1eef \u2013 s\u00e2u s\u1eafc nh\u01b0ng kh\u00f4ng ph\u00f4 tr\u01b0\u01a1ng.<\/p>\n<\/li>\n<li data-start=\"851\" data-end=\"1038\">\n<p data-start=\"853\" data-end=\"1038\"><strong data-start=\"855\" data-end=\"889\">01 V\u00f2ng l\u1ee5a size Trung (~60cm)<\/strong><br data-start=\"889\" data-end=\"892\" \/>V\u00f2ng g\u1ed7 t\u1ef1 nhi\u00ean \u0111\u01b0\u1ee3c b\u1ecdc l\u1ee5a th\u1ee7 c\u00f4ng, m\u1ec1m m\u1ea1i, nh\u1eb9 nh\u00e0ng v\u00e0 thanh l\u1ecbch. Ph\u00f9 h\u1ee3p \u0111eo c\u1ed5, ph\u1ed1i \u00e1o d\u00e0i, v\u00e1y, s\u01a1 mi ho\u1eb7c l\u00e0m \u0111i\u1ec3m nh\u1ea5n trang ph\u1ee5c.<\/p>\n<\/li>\n<\/ul>\n<p>Set \u0111\u00e3 bao g\u1ed3m h\u1ed9p v\u00e0 t\u00fai l\u00e0m qu\u00e0 t\u1eb7ng. Kh\u00e1ch h\u00e0ng ch\u1ecdn kh\u0103n v\u00e0 v\u00f2ng vui l\u00f2ng IB ho\u1eb7c nh\u1eafn tin Zalo\/ Hotline: 098 596 98 64<\/p>","description":"<p data-start=\"459\" data-end=\"585\"><strong data-start=\"459\" data-end=\"492\">Set Qu\u00e0 t\u1eb7ng 8\/3 \u2013 D\u1ea5u \u1ea4n D\u1ecbu D\u00e0ng<\/strong> l\u00e0 s\u1ef1 k\u1ebft h\u1ee3p gi\u1eefa ngh\u1ec7 thu\u1eadt th\u1ee7 c\u00f4ng v\u00e0 v\u1ebb \u0111\u1eb9p n\u1eef t\u00ednh thu\u1ea7n khi\u1ebft t\u1eeb l\u1ee5a t\u01a1 t\u1eb1m Vi\u1ec7t Nam.<\/p>\n<p data-start=\"587\" data-end=\"603\">B\u1ed9 s\u1ea3n ph\u1ea9m Set qu\u00e0 t\u1eb7ng 8\/3 &#8211; D\u1ea5u \u1ea5n d\u1ecbu d\u00e0ng g\u1ed3m:<\/p>\n<ul data-start=\"605\" data-end=\"1038\">\n<li data-start=\"605\" data-end=\"849\">\n<p data-start=\"607\" data-end=\"849\">\u2728 <strong data-start=\"609\" data-end=\"646\">01 Kh\u0103n l\u1ee5a vu\u00f4ng Th\u1ee7y \u1ea4n 87x87cm<\/strong><br data-start=\"646\" data-end=\"649\" \/>Thi\u1ebft k\u1ebf theao k\u1ef9 thu\u1eadt nhu\u1ed9m Th\u1ee7y \u1ea4n \u0111\u1ed9c \u0111\u00e1o, m\u1ed7i chi\u1ebfc kh\u0103n l\u00e0 m\u1ed9t b\u1ea3n v\u1ebd kh\u00f4ng l\u1eb7p l\u1ea1i. M\u00e0u s\u1eafc h\u00f2a quy\u1ec7n t\u1ef1 nhi\u00ean nh\u01b0 nh\u1eefng l\u1edbp c\u1ea3m x\u00fac d\u1ecbu d\u00e0ng c\u1ee7a ng\u01b0\u1eddi ph\u1ee5 n\u1eef \u2013 s\u00e2u s\u1eafc nh\u01b0ng kh\u00f4ng ph\u00f4 tr\u01b0\u01a1ng.<\/p>\n<\/li>\n<li data-start=\"851\" data-end=\"1038\">\n<p data-start=\"853\" data-end=\"1038\">\u2728 <strong data-start=\"855\" data-end=\"889\">01 V\u00f2ng l\u1ee5a size Trung (~60cm)<\/strong><br data-start=\"889\" data-end=\"892\" \/>V\u00f2ng g\u1ed7 t\u1ef1 nhi\u00ean \u0111\u01b0\u1ee3c b\u1ecdc l\u1ee5a th\u1ee7 c\u00f4ng, m\u1ec1m m\u1ea1i, nh\u1eb9 nh\u00e0ng v\u00e0 thanh l\u1ecbch. Ph\u00f9 h\u1ee3p \u0111eo c\u1ed5, ph\u1ed1i \u00e1o d\u00e0i, v\u00e1y, s\u01a1 mi ho\u1eb7c l\u00e0m \u0111i\u1ec3m nh\u1ea5n trang ph\u1ee5c.<\/p>\n<\/li>\n<\/ul>\n<p>Set \u0111\u00e3 bao g\u1ed3m h\u1ed9p v\u00e0 t\u00fai l\u00e0m qu\u00e0 t\u1eb7ng. Kh\u00e1ch h\u00e0ng ch\u1ecdn kh\u0103n v\u00e0 v\u00f2ng vui l\u00f2ng IB ho\u1eb7c nh\u1eafn tin Zalo\/ Hotline: 098 596 98 64<\/p>\n<p data-start=\"1040\" data-end=\"1171\">Ch\u1ea5t li\u1ec7u l\u1ee5a t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean m\u1ec1m, tho\u00e1ng, th\u00e2n thi\u1ec7n v\u1edbi l\u00e0n da.<br data-start=\"1105\" data-end=\"1108\" \/>T\u1eebng s\u1ea3n ph\u1ea9m \u0111\u01b0\u1ee3c ho\u00e0n thi\u1ec7n th\u1ee7 c\u00f4ng b\u1edfi ngh\u1ec7 nh\u00e2n l\u00e0ng ngh\u1ec1.<\/p>\n<p data-start=\"1173\" data-end=\"1297\">\ud83d\udc9d Ph\u00f9 h\u1ee3p l\u00e0m qu\u00e0 t\u1eb7ng m\u1eb9, v\u1ee3, \u0111\u1ed1i t\u00e1c n\u1eef, c\u00f4 gi\u00e1o ho\u1eb7c ch\u00ednh b\u1ea3n th\u00e2n b\u1ea1n \u2013 nh\u01b0 m\u1ed9t l\u1eddi tri \u00e2n d\u1ecbu d\u00e0ng m\u00e0 \u0111\u1ea7y tr\u00e2n tr\u1ecdng.<\/p>\n<p data-start=\"1299\" data-end=\"1353\">\ud83c\udf81 <strong data-start=\"1302\" data-end=\"1353\">\u01afu \u0111\u00e3i \u0111\u1eb7c bi\u1ec7t 8\/3: Gi\u1ea3m ngay 10% cho Set Qu\u00e0.<\/strong><\/p>\n<p data-start=\"1299\" data-end=\"1353\">(\u00c1p d\u1ee5ng cho c\u00e1c \u0111\u01a1n h\u00e0ng t\u1eeb ng\u00e0y 24\/02-08\/03)<\/p>","on_sale":false,"prices":{"price":"800000","regular_price":"80