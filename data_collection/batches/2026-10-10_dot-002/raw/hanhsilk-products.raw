hsilk.com\/tu-khoa-san-pham\/to-tam-100\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"xanh n\u01b0\u1edbc bi\u1ec3n","slug":"xanh n\u01b0\u1edbc bi\u1ec3n"},{"id":0,"name":"h\u1ed3ng","slug":"h\u1ed3ng"},{"id":0,"name":"v\u00e0ng","slug":"v\u00e0ng"},{"id":0,"name":"xanh l\u00e1 c\u00e2y","slug":"xanh l\u00e1 c\u00e2y"}]}],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;G\u1ed0I B\u00cd L\u1ee4A TR\u00d2N&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=2309","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":2290,"name":"GI\u00c0Y \u0110\u0168I T\u01a0 T\u1eb0M","slug":"giay-dui-to-tam","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/giay-dui-to-tam\/","sku":"","short_description":"<p>Gi\u00e0y \u0111\u0169i t\u01a1 t\u1eb1m<\/p>\n<p>Ch\u1ea5t li\u1ec7u: \u0110\u0169i t\u01a1 t\u1eb1m<\/p>\n<p>K\u00edch th\u01b0\u1edbc: Size 35-Size 40<\/p>\n<p>Ki\u1ec3u d\u00e1ng: Slip on<\/p>\n<p>Kh\u00e1ch h\u00e0ng ch\u1ecdn ki\u1ec3u, m\u00e0u vui l\u00f2ng ghi l\u1ea1i ch\u00fa th\u00edch ho\u1eb7c g\u1ecdi \u0111i\u1ec7n \u0111\u1ebfn s\u1ed1 Hotline: 0985969864 \u2013 0977241182 \u0111\u1ec3 \u0111\u01b0\u1ee3c t\u01b0 v\u1ea5n.<\/p>","description":"<div dir=\"auto\">\n<div dir=\"auto\">De\u0309o &#8211; E\u0302m &#8211; Me\u0302\u0300m &#8211; Cho\u0302\u0301ng tro\u031bn tru\u031bo\u031b\u0323t. \u0110e\u0323p khi \u0111i la\u0300m, tie\u0323\u0302n khi \u0111i la\u0301i xe, thoa\u0309i ma\u0301i khi da\u0323o pho\u0302\u0301.<\/div>\n<div dir=\"auto\">Gia\u0300y \u0110u\u0303i To\u031b Ta\u0306\u0300m cha\u0302\u0301t lie\u0323\u0302u Va\u0309i \u0110u\u0303i Lu\u0323a To\u031b Ta\u0306\u0300m, \u0111e\u0302\u0301 cao su non Vie\u0323\u0302t Nam.<\/div>\n<\/div>\n<div dir=\"auto\">B\u1ea1n th\u00e2n m\u1ebfn, n\u1ebfu l\u00e0 m\u1ed9t t\u00edn \u0111\u1ed3 y\u00eau th\u1eddi trang , ch\u1eafc ch\u1eafn trong t\u1ee7 gi\u00e0y c\u1ee7a c\u00e1c b\u1ea1n s\u1ebd c\u00f3 m\u1ed9t \u0111\u00f4i gi\u00e0y d\u00e1ng slip on v\u00ec s\u1ef1 tho\u1ea3i m\u00e1i, ti\u1ec7n d\u1ee5ng, th\u00edch h\u1ee3p cho vi\u1ec7c \u0111i h\u1ecdc, \u0111i ch\u01a1i v\u00e0 c\u1ea3 \u0111i l\u00e0m..<\/div>\n<div dir=\"auto\">T\u1ea1i Hanhsilk, ch\u00fang m\u00ecnh c\u00f3 nh\u1eefng \u0111\u00f4i gi\u00e0y \u0111\u0169i \u0111\u01b0\u1ee3c l\u00e0m th\u1ee7 c\u00f4ng ho\u00e0n to\u00e0n, ch\u1eafc ch\u1eafn v\u00e0 \u00eam ch\u00e2n, th\u00f4ng tho\u00e1ng kh\u00ed, th\u1ea5m h\u00fat m\u1ed3 h\u00f4i. M\u00e0u s\u1eafc trang nh\u00e3, d\u1ec5 k\u1ebft h\u1ee3p v\u1edbi nhi\u1ec1u lo\u1ea1i ph\u1ee5c trang kh\u00e1c nhau.<\/div>\n<div dir=\"auto\">Kh\u00e1ch h\u00e0ng ch\u1ecdn ki\u1ec3u, m\u00e0u vui l\u00f2ng ghi l\u1ea1i ch\u00fa th\u00edch ho\u1eb7c g\u1ecdi \u0111i\u1ec7n \u0111\u1ebfn s\u1ed1 Hotline: 0985969864 \u2013 0977241182 \u0111\u1ec3 \u0111\u01b0\u1ee3c t\u01b0 v\u1ea5n.<\/div>","on_sale":false,"prices":{"price":"950000","regular_price":"950000","sale_price":"950000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">950,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":2294,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/11\/49342109_2381731005235465_5768538534801571840_n.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/11\/49342109_2381731005235465_5768538534801571840_n-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/site