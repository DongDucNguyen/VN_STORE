.png","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/02\/79.png.png 512w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/02\/79.png-212x300.png 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/02\/79.png-8x12.png 8w","sizes":"(max-width: 512px) 100vw, 512px","name":"79.png","alt":""}],"categories":[{"id":157,"name":"V\u1ea3i Cao C\u1ea5p","slug":"vai-cao-cap","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/vai-cao-cap\/"},{"id":170,"name":"V\u1ea3i l\u1ee5a cao c\u1ea5p","slug":"vai-lua-cao-cap","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/vai-cao-cap\/vai-lua-cao-cap\/"}],"tags":[],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;V\u1ea3i l\u1ee5a d\u1ec7t h\u1ecda ti\u1ebft &#8211; L\u1ee5a Jacquard h\u1ecda ti\u1ebft S\u00f2&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=2921","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":2919,"name":"V\u1ea3i l\u1ee5a d\u1ec7t h\u1ecda ti\u1ebft &#8211; L\u1ee5a Jacquard h\u1ecda ti\u1ebft hoa h\u1ed3ng","slug":"vai-lua-det-hoa-tiet-lua-jacquard-hoa-tiet-hoa-hong","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/vai-lua-det-hoa-tiet-lua-jacquard-hoa-tiet-hoa-hong\/","sku":"","short_description":"<p data-start=\"335\" data-end=\"358\">\u2728 <strong data-start=\"337\" data-end=\"357\">\u0110\u1eb7c \u0111i\u1ec3m n\u1ed5i b\u1eadt<\/strong>:<\/p>\n<ul data-start=\"359\" data-end=\"681\">\n<li data-start=\"359\" data-end=\"431\"><strong data-start=\"361\" data-end=\"372\">M\u00e0u s\u1eafc<\/strong>: \u0110a d\u1ea1ng, s\u1eb7c s\u1ee1, ph\u00f9 h\u1ee3p v\u1edbi nhi\u1ec1u phong c\u00e1ch th\u1eddi trang.<\/li>\n<li data-start=\"432\" data-end=\"505\"><strong data-start=\"434\" data-end=\"447\">Ch\u1ea5t li\u1ec7u<\/strong>: 100% t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean, m\u1ec1m m\u1ea1i, nh\u1eb9 nh\u00e0ng, v\u00e0 tho\u00e1ng kh\u00ed.<\/li>\n<li data-start=\"506\" data-end=\"599\"><strong data-start=\"508\" data-end=\"522\">K\u00edch th\u01b0\u1edbc<\/strong>: Kh\u1ed5 v\u1ea3i 115cm, th\u00edch h\u1ee3p \u0111\u1ec3 may \u00e1o d\u00e0i, v\u00e1y, ho\u1eb7c c\u00e1c lo\u1ea1i trang ph\u1ee5c kh\u00e1c.<\/li>\n<\/ul>","description":"<p data-start=\"460\" data-end=\"514\"><strong data-start=\"460\" data-end=\"514\">T\u00ednh N\u0103ng N\u1ed5i B\u1eadt c\u1ee7a V\u1ea3i L\u1ee5a Jacquard:<\/strong><\/p>\n<ul data-start=\"515\" data-end=\"1214\">\n<li data-start=\"515\" data-end=\"638\"><strong data-start=\"517\" data-end=\"539\">Ch\u1ea5t li\u1ec7u cao c\u1ea5p:<\/strong> 100% t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean, qua qu\u00e1 tr\u00ecnh x\u1eed l\u00fd k\u1ef9 l\u01b0\u1ee1ng \u0111\u1ec3 \u0111\u1ea3m b\u1ea3o \u0111\u1ed9 m\u1ec1m m\u1ea1i, nh\u1eb9 nh\u00e0ng v\u00e0 tho\u00e1ng kh\u00ed.<\/li>\n<li data-start=\"639\" data-end=\"839\"><strong data-start=\"641\" data-end=\"662\">H\u1ecda ti\u1ebft \u0111\u1eb7c s\u1eafc:<\/strong> H\u1ecda ti\u1ebft hoa h\u1ed3ng sang tr\u1ecdng, n\u1ed3ng n\u00e0n, n\u1eef t\u00ednh.<\/li>\n<li data-start=\"840\" data-end=\"1041\"><strong data-start=\"842\" data-end=\"854\">\u0110a d\u1ee5ng:<\/strong> Ph\u00f9 h\u1ee3p \u0111\u1ec3 may c\u00e1c lo\u1ea1i trang ph\u1ee5c t\u1eeb truy\u1ec1n th\u1ed1ng \u0111\u1ebfn hi\u1ec7n \u0111\u1ea1i, v\u1ea3i Jacquard l\u00e0 l\u1ef1a ch\u1ecdn l\u00fd t\u01b0\u1edfng \u0111\u1ec3 t\u1ea1o n\u00ean nh\u1eefng b\u1ed9 \u00e1o d\u00e0i, \u0111\u1ea7m<\/li>\n<li data-start=\"1042\" data-end=\"1214\"><strong data-start=\"1044\" data-end=\"1063\">\u0110\u1ed9 b\u1ec1n m\u00e0u cao:<\/strong> S\u1eed d\u1ee5ng c\u00f4ng ngh\u1ec7 nhu\u1ed9m ti\u00ean ti\u1ebfn gi\u00fap m\u00e0u s\u1eafc c\u1ee7a v\u1ea3i b\u1ec1n \u0111\u1eb9p theo th\u1eddi gian, kh\u00f4ng phai m\u00e0u d\u01b0\u1edbi t\u00e1c \u0111\u1ed9ng c\u1ee7a \u00e1nh s\u00e1ng hay trong qu\u00e1 tr\u00ecnh gi\u1eb7t gi\u0169.<\/li>\n<\/ul>\n<p data-start=\"1216\" data-end=\"1277\"><strong data-start=\"1216\" data-end=\"1277\">V\u00ec Sao N\u00ean Ch\u1ecdn V\u1ea3i L\u1ee5a Jacquard T\u1ea1i Hanhsilk?<\/strong><\/p>\n<ul data-start=\"1278\" data-end=\"1597\">\n<li data-start=\"1278\" data-end=\"1427\"><strong data-start=\"1280\" data-end=\"1295\">S\u1ef1 \u0111\u1ed9c \u0111\u00e1o:<\/strong> M\u1ed7i th\u01b0\u1edbc v\u1ea3i kh\u00f4ng ch\u1ec9 l\u00e0 s\u1ea3n ph\u1ea9m th\u1eddi trang m\u00e0 c\u00f2n l\u00e0 t\u00e1c ph\u1ea9m ngh\u1ec7 thu\u1eadt, mang \u0111\u1ebfn s\u1ef1 kh\u00e1c bi\u1ec7t v\u00e0 \u0111\u1ed9c quy\u1ec1n cho ng\u01b0\u1eddi s\u1eed d\u1ee5ng.<\/li>\n<li data-start=\"1428\" data-end=\"1597\"><strong data-start=\"1430\" data-end=\"1453\">Ch\u1ea5t l\u01b0\u1ee3ng \u0111\u1ea3m b\u1ea3o:<\/strong> Cam k\u1ebft t\u1eeb Hanhsilk v\u1ec1 ch\u1ea5t l\u01b0\u1ee3ng v\u1ea3i t\u01a1 t\u1eb1m, t\u1ea5t c\u1ea3 \u0111\u1ec1u \u0111\u01b0\u1ee3c s\u1ea3n xu\u1ea5t th\u1ee7 c\u00f4ng b\u1edfi c\u00e1c ngh\u1ec7 nh\u00e2n l\u00e0ng ngh\u1ec1, \u0111\u1ea3m b\u1ea3o m\u1ed7i chi ti\u1ebft \u0111\u1ec1u ho\u00e0n h\u1ea3o.<\/li>\n<\/ul>\n<p data-start=\"1599\" data-end=\"1797\"><strong data-start=\"1599\" data-end=\"1668\">H\u00e3y \u0111\u1ec3 Hanhsilk c\u00f9ng b\u1ea1n t\u1ea1o n\u00ean phong c\u00e1ch \u0111\u1eb7c tr\u01b0ng v\u00e0 \u1ea5n t\u01b0\u1ee3ng<\/strong>. V\u1ea3i l\u1ee5a Jacquard h\u1ecda ti\u1ebft tr\u1ed1ng \u0111\u1ed3ng kh\u00f4ng ch\u1ec9 l\u00e0 l\u1ef1a ch\u1ecdn th\u1eddi trang m\u00e0 c\u00f2n l\u00e0 c\u00e1ch b\u1ea1n g\u1eedi g\u1eafm t\u00ecnh y\u00eau v\u1edbi v\u0103n h\u00f3a Vi\u1ec7t Nam.<\/p>","on_sale":false,"prices":{"price":"650000","regular_price":"650000","sale_price":"650000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_