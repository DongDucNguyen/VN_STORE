.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787295700753_a6dab029b2ab412a94051305fd5d7fbb-1086x1536.jpg 1086w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787295700753_a6dab029b2ab412a94051305fd5d7fbb-8x12.jpg 8w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787295700753_a6dab029b2ab412a94051305fd5d7fbb-600x848.jpg 600w","sizes":"(max-width: 1191px) 100vw, 1191px","name":"z6787295700753_a6dab029b2ab412a94051305fd5d7fbb","alt":""},{"id":3268,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf.jpg 1191w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf-212x300.jpg 212w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf-724x1024.jpg 724w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf-768x1086.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf-1086x1536.jpg 1086w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf-8x12.jpg 8w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf-600x848.jpg 600w","sizes":"(max-width: 1191px) 100vw, 1191px","name":"z6787296100691_f3cd2cd09aa3b62629a049e7354d5aaf","alt":""}],"categories":[{"id":338,"name":"BST thi\u1ebft k\u1ebf Italia","slug":"bst","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/bst\/"},{"id":80,"name":"Th\u1eddi trang n\u1eef","slug":"thoi-trang-nu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/"}],"tags":[{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"},{"id":182,"name":"v\u1ea3i \u0111\u0169i","slug":"vai-dui","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui\/"},{"id":181,"name":"v\u1ea3i \u0111\u0169i cao c\u1ea5p","slug":"vai-dui-cao-cap","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vai-dui-cao-cap\/"},{"id":339,"name":"v\u00e1y thi\u1ebft k\u1ebf","slug":"vay-thiet-ke","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/vay-thiet-ke\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"\u0110\u1ecf","slug":"\u0110\u1ecf"},{"id":0,"name":"N\u00e2u","slug":"N\u00e2u"}]}],"variations":[{"id":3190,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"\u0110\u1ecf"}]},{"id":3191,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"N\u00e2u"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;Cho\u00e0ng Kaftan &#8211; Multi functional (3 ways) Kaftan&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/choang-kaftan-nau-multi-functional-3-ways-kaftan\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":3093,"name":"V\u00e1y c\u00e1nh l\u1ee5a t\u01a1 t\u1eb1m d\u00e0i &#8211; Wing Long Dress","slug":"vay-canh-lua-to-tam-dai-wing-long-dress","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/vay-canh-lua-to-tam-dai-wing-long-dress\/","sku":"","short_description":"<h3 data-start=\"95\" data-end=\"159\">\u2728 <em data-start=\"101\" data-end=\"157\">Wing Long Dress \u2013 Khi v\u0103n h\u00f3a g\u1eb7p g\u1ee1 trong t\u1eebng s\u1ee3i t\u01a1<\/em><\/h3>\n<p data-start=\"161\" data-end=\"325\">Chi\u1ebfc v\u00e1y <em data-start=\"171\" data-end=\"188\">Wing Long Dress<\/em> l\u00e0 s\u1ef1 h\u00f2a quy\u1ec7n gi\u1eefa <strong data-start=\"210\" data-end=\"235\">l\u1ee5a t\u01a1 t\u1eb1m nguy\u00ean b\u1ea3n<\/strong> v\u00e0 <strong data-start=\"239\" data-end=\"253\">l\u1ee5a v\u1ebd tay<\/strong>, \u0111\u01b0\u1ee3c thi\u1ebft k\u1ebf theo d\u00e1ng d\u00e0i t\u1ef1 nhi\u00ean, bay b\u1ed5ng v\u00e0 \u0111\u1ea7y t\u00ednh ngh\u1ec7 thu\u1eadt.<\/p>\n<p data-start=\"161\" data-end=\"325\">Ch\u1ea5t li\u1ec7u l\u1ee5a v\u00e0 \u0111\u0169i t\u01a1 t\u1eb1m t\u1eeb <strong>HTX l\u1ee5a \u0110\u0169i Nam Cao Hanhsilk<\/strong> &#8211; Vi\u1ec7t Nam. <strong data-start=\"330\" data-end=\"350\">Chi ti\u1ebft th\u1ed5 c\u1ea9m<\/strong> \u0111\u01b0\u1ee3c d\u1ec7t th\u1ee7 c\u00f4ng b\u1edfi <strong data-start=\"373\" data-end=\"401\">ng\u01b0\u1eddi M\u01b0\u1eddng l\u00e0ng Nam Cao<\/strong> \u2013 v\u00f9ng \u0111\u1ea5t n\u1ed5i ti\u1ebfng v\u1edbi l\u1ee5a \u0111\u0169i truy\u1ec1n th\u1ed1ng Vi\u1ec7t Nam.<br data-start=\"457\" data-end=\"460\" \/><strong data-start=\"463\" data-end=\"484\">Khuy g\u1ed1m th\u1ee7 c\u00f4ng<\/strong> do <strong data-start=\"488\" data-end=\"526\">ngh\u1ec7 s\u0129 ng\u01b0\u1eddi \u00dd \u2013 Stefania Mairano<\/strong> ch\u1ebf t\u00e1c, v\u1eeba l\u00e0 \u0111i\u1ec3m nh\u1ea5n, v\u1eeba l\u00e0 m\u00f3n trang s\u1ee9c mang gi\u00e1 tr\u1ecb t\u1ea1o h\u00ecnh \u0111\u1ed9c \u0111\u00e1o.<br data-start=\"605\" data-end=\"608\" \/>T\u1eebng \u0111\u01b0\u1eddng kim m\u0169i ch\u1ec9 \u0111\u01b0\u1ee3c ho\u00e0n thi\u1ec7n b\u1edfi b\u00e0n tay nh\u1eefng ng\u01b0\u1eddi th\u1ee3 th\u1ee7 c\u00f4ng l\u00e0nh ngh\u1ec1, truy\u1ec1n t\u1ea3i tinh th\u1ea7n ch\u1eadm r\u00e3i, duy m\u1ef9 v\u00e0 t\u00f4n tr\u1ecdng v\u0103n h\u00f3a.<\/p>\n<p data-start=\"161\" data-end=\"325\">Nh\u00e0 thi\u1ebft k\u1ebf b\u1edfi b\u00e0 Malaika Barbara Ebbli ( \u0111\u1ebfn t\u1eeb Italia)<\/p>\n<p data-start=\"759\" data-end=\"874\">M\u1ed9t thi\u1ebft k\u1ebf \u0111\u1ed9c b\u1ea3n \u2013 nh\u01b0 v\u00f2ng tay m\u1ec1m m\u1ea1i \u00f4m l\u1ea5y h\u00ecnh th\u1ec3 v\u00e0 k\u1ec3 l\u1ea1i c\u00e2u chuy\u1ec7n c\u1ee7a nh\u1eefng b\u00e0n tay, nh\u1eefng v\u00f9ng \u0111\u1ea5t.<\/p>","description":"<h3 data-start=\"130\" data-end=\"180\">\u2728 <em data-start=\"136\" data-end=\"178\">Wing Long Dress \u2013 A Dialogue of Cultures<\/em><\/h3>\n<p data-start=\"182\" data-end=\"352\">A flowing silhouette crafted in <strong data-start=\"214\" data-end=\"249\">pure silk and hand-painted silk<\/strong>, the <em data-start=\"255\" data-end=\"272\">Wing Long Dress<\/em> celebrates the harmony between Vietnamese craftsmanship and Italian creativity. <strong data-start=\"394\" data-end=\"429\">Material from Dui Nam Cao village<\/strong>, home of traditional tussah silk in Vietnam.<\/p>\n<p data-start=\"354\" data-end=\"726\"><strong data-start=\"357\" data-end=\"376\">Brocade details<\/strong> are woven by the <strong data-start=\"394\" data-end=\"429\">Muong people<\/strong><\/p>\n<p data-start=\"354\" data-end=\"726\">\u00a0The <strong data-start=\"484\" data-end=\"511\">handmade ceramic button<\/strong> is designed by <strong data-start=\"527\" data-end=\"562\">Italian artist Stefania Mairano<\/strong>, adding a sculptural soul to the garment.<br data-start=\"604\" data-end=\"607\" \/>Every stitch is carefully made by artisans, reflecting the spirit of slowness, elegance, and cross-cultural respect.<\/p>\n<p data-start=\"354\" data-end=\"726\">Design by Ms Malaika Barbara Ebbli from Italia<\/p>\n<p data-start=\"728\" data-end=\"822\">A one-of-a-kind piece that gently embraces the body \u2013 and the story of many hands, many lands.<\/p>","on_sale":false,"prices":{"price":"10000000","regular_price":"10000000","sale_price":"10000000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">10,000,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":3224,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be.jpg 1350w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-169x300.jpg 169w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-576x1024.jpg 576w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-768x1365.jpg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-864x1536.jpg 864w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-1152x2048.jpg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-7x12.jpg 7w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787278480177_f9c4d3eae7d60f9d62093201457d06be-600x1067.jpg 600w","sizes":"(max-width: 1350px) 100vw, 1350px","name":"z6787278480177_f9c4d3eae7d60f9d62093201457d06be","alt":""},{"id":3221,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2025\/07\/z6787279261544_9881ac85f27d5