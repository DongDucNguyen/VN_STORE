boqabp6ethylbibd6rflfcmfcca5gsbxxpkoy113","alt":""}],"categories":[{"id":153,"name":"Ch\u0103n\/ga\/g\u1ed1i ng\u1ee7","slug":"chan-ga-goi-ngu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/decor\/chan-ga-goi-ngu\/"},{"id":81,"name":"Decor","slug":"decor","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/decor\/"}],"tags":[{"id":123,"name":"ch\u0103n l\u1ee5a t\u01a1 t\u1eb1m","slug":"chan-lua-to-tam","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/chan-lua-to-tam\/"},{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"},{"id":89,"name":"r\u00e8m l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m","slug":"rem-lua-dui-to-tam","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/rem-lua-dui-to-tam\/"},{"id":37,"name":"t\u01a1 t\u1eb1m 100%","slug":"to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/to-tam-100\/"}],"attributes":[],"variations":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":true,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"Th\u00eam v\u00e0o gi\u1ecf h\u00e0ng","description":"Th\u00eam &ldquo;CH\u0102N L\u1ee4A H\u1eccA S\u0128 V\u1ebc TAY V\u00c0 2 V\u1ece G\u1ed0I CH\u1ea6N B\u00d4NG&rdquo; v\u00e0o gi\u1ecf h\u00e0ng","url":"?add-to-cart=4143","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":4139,"name":"Tranh l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m h\u1ecda s\u0129 v\u1ebd hoa sen","slug":"tranh-lua-dui-to-tam-hoa-si-ve-hoa-sen","parent":0,"type":"simple","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/tranh-lua-dui-to-tam-hoa-si-ve-hoa-sen\/","sku":"","short_description":"<p>Tranh l\u1ee5a c\u00f3 th\u1ec3 t\u00f4 \u0111i\u1ec3m v\u00e0 l\u00e0m n\u1ed5i b\u1eadt, \u1ea5m \u00e1p kh\u00f4ng gian ph\u00f2ng, l\u00e0m \u0111i\u1ec3m nh\u1ea5n.<\/p>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Tranh l\u1ee5a v\u1ebd hoa, th\u00eau tr\u00ean ch\u1ea5t li\u1ec7u t\u01a1 t\u1eb1m, t\u1ec9 m\u1ec9 ch\u1ec9n chu. Ch\u1ea5t li\u1ec7u 100% t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean d\u1ec7t th\u1ee7 c\u00f4ng, h\u1ecda ti\u1ebft hoa v\u0103n, ki\u1ec3u d\u00e1ng \u0111\u01b0\u1ee3c thi\u1ebft k\u00ea ri\u00eang bi\u1ec7t theo y\u00eau c\u1ea7u kh\u00e1ch h\u00e0ng.<\/div>\n<\/div>","description":"<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">TRANH L\u1ee4A \u0110\u0168I V\u1ebc TAY HOA SEN T\u01a0 T\u1eb0M &#8211; N\u00c9T \u0110\u1ed8C \u0110\u00c1O TRONG TRANG TR\u00cd N\u1ed8I TH\u1ea4T<\/div>\n<div dir=\"auto\"><\/div>\n<\/div>\n<div dir=\"auto\">\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Ch\u1ea5t li\u1ec7u r\u00e8m 100% v\u1ea3i t\u01a1 t\u1eb1m, m\u00e0u t\u1ef1 nhi\u00ean l\u00e0m ho\u00e0n to\u00e0n th\u1ee7 c\u00f4ng s\u1ee3i t\u01a1 t\u1eb1m Vi\u1ec7t Nam.<\/div>\n<div dir=\"auto\">C\u00f4ng n\u0103ng: L\u00e0m qu\u00e0 t\u1eb7ng trang tr\u00ed n\u1ed9i th\u1ea5t cho ng\u00f4i nh\u00e0 tr\u1edf n\u00ean sang tr\u1ecdng, truy\u1ec1n th\u1ed1ng v\u00e0 \u0111\u1ed9c \u0111\u00e1o<\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Trang tr\u00ed: Ph\u00f2ng kh\u00e1ch, b\u00e0n th\u1edd, ph\u00f2ng thi\u1ec1n, th\u01b0\u1edfng tr\u00e0, \u0111i\u1ec3m nh\u1ea5n b\u1ee9c t\u01b0\u1eddng, l\u00e0m b\u00ecnh phong ng\u0103n c\u00e1c kh\u00f4ng gian&#8230; T\u1ea1o \u0111i\u1ec3m nh\u1ea5n \u1ea5n t\u01b0\u1ee3ng v\u1edbi h\u1ecda ti\u1ebft v\u1ebd theo y\u00eau c\u1ea7u kh\u00e1ch h\u00e0ng.<\/div>\n<\/div>\n<div class=\"x11i5rnm xat24cr x1mh8g0r x1vvkbs xtlvy1s x126k92a\">\n<div dir=\"auto\">Tranh l\u1ee5a \u0111\u0169i t\u01a1 t\u1eb1m \u0111\u01b0\u1ee3c l\u00e0m t\u1eeb nh\u1eefng ng\u01b0\u1eddi ngh\u1ec7 nh\u00e2n HanhSilk ph\u1ea3i l\u00e0m 30-40 ng\u00e0y t\u1eeb c\u00f4ng \u0111o\u1ea1n tr\u1ed3ng d\u00e2u nu\u00f4i t\u1eb1m, d\u1ec7t v\u1ea3i v\u00e0 may ra s\u1ea3n ph\u1ea9m. Nh\u1eefng t\u1ea5m v\u1ea3i l\u1ee5a \u0111\u0169i \u0111\u01b0\u1ee3c l\u00e0m t\u1eeb t\u00ecnh y\u00eau v\u00e0 tr\u00e1i tim m\u1ec9 t\u1eebng chi ti\u1ebft nh\u1ecf.<\/div>\n<\/div>\n<\/div>\n<div dir=\"auto\"><\/div>\n<div dir=\"auto\">K\u00edch th\u01b0\u1edbc: 50*105cm<\/div>","on_sale":false,"prices":{"price":"2500000","regular_price":"2500000","sale_price":"2500000","price_range":null,"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">2,500,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span>","average_rating":"0","review_count":0,"images":[{"id":4140,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/img3239-17473148964191600615099-0-0-1125-2000-crop-17473298772241960543881.jpg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/img3239-17473148964191600615099-0-0-1125-2000-crop-17473298772241960543881-300x300.jpg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/img3239-17473148964191600615099-0-0-1125-2000-crop-17473298772241960543881.jpg 489w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/img3239-17473148964191600615099-0-0-1125-2000-crop-17473298772241960543881-284x300.jpg 284w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2026\/06\/img3239-17473148964191600615099-0-0-1125-2000-crop-17473298772241960543881-11x12.jpg 11w","sizes":"(max-width: 489px) 100vw, 489px","name":"img3239-17473148964191600615099-0-0-1125-2000-crop-17473298772241960543881","alt":""},{"id":4128,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2026\/06\/2aoboqabowt70uqgxp