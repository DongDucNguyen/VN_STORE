d8e99120809eab22994f55131cf67d","alt":""}],"categories":[{"id":80,"name":"Th\u1eddi trang n\u1eef","slug":"thoi-trang-nu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/"},{"id":165,"name":"V\u00e1y n\u1eef","slug":"vay-nu","link":"https:\/\/hanhsilk.com\/danh-muc-san-pham\/thoi-trang-nu\/vay-nu\/"}],"tags":[{"id":45,"name":"hanhsilk","slug":"hanhsilk","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/hanhsilk\/"},{"id":38,"name":"l\u1ee5a t\u01a1 t\u1eb1m 100%","slug":"lua-to-tam-100","link":"https:\/\/hanhsilk.com\/tu-khoa-san-pham\/lua-to-tam-100\/"}],"attributes":[{"id":0,"name":"M\u00e0u s\u1eafc","taxonomy":null,"has_variations":true,"terms":[{"id":0,"name":"N\u00e2u nh\u1ea1t","slug":"N\u00e2u nh\u1ea1t"},{"id":0,"name":"N\u00e2u \u0111\u1eadm","slug":"N\u00e2u \u0111\u1eadm"},{"id":0,"name":"H\u1ed3ng","slug":"H\u1ed3ng"},{"id":0,"name":"Xanh","slug":"Xanh"}]}],"variations":[{"id":644,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"N\u00e2u nh\u1ea1t"}]},{"id":645,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"N\u00e2u \u0111\u1eadm"}]},{"id":646,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"H\u1ed3ng"}]},{"id":647,"attributes":[{"name":"M\u00e0u s\u1eafc","value":"Xanh"}]}],"has_options":true,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"sold_individually":false,"add_to_cart":{"text":"C\u00e1c t\u00f9y ch\u1ecdn","description":"L\u1ef1a ch\u1ecdn cho &ldquo;V\u00c1Y \u0110\u0168I TH\u00caU HOA&rdquo;","url":"https:\/\/hanhsilk.com\/san-pham\/vay-dui-theu\/","minimum":1,"maximum":9999,"multiple_of":1},"extensions":{}},{"id":612,"name":"KH\u0102N \u0110\u0168I T\u01a0 T\u1eb0M","slug":"khan-dui-to-tam","parent":0,"type":"variable","variation":"","permalink":"https:\/\/hanhsilk.com\/san-pham\/khan-dui-to-tam\/","sku":"","short_description":"<p><em><strong>Kh\u0103n \u0111\u0169i t\u01a1 t\u1eb1m \u2013 Phong c\u00e1ch hi\u1ec7n \u0111\u1ea1i k\u1ebft tinh t\u1eeb s\u1ef1 m\u1ed9c m\u1ea1c<\/strong><\/em><\/p>\n<ul>\n<li>Ch\u1ea5t li\u1ec7u: 100% s\u1ee3i t\u01a1 t\u1eb1m t\u1ef1 nhi\u00ean, v\u1ebd tay th\u1ee7 c\u00f4ng.<\/li>\n<li>Size: 80x180cm, 50*180cm<\/li>\n<li>M\u00e0u s\u1eafc: m\u00e0u s\u1eafc \u0111a d\u1ea1ng, nh\u1eb9 nh\u00e0ng, hi\u1ec7n \u0111\u1ea1i, d\u1ec5 k\u1ebft h\u1ee3p v\u1edbi trang ph\u1ee5c<\/li>\n<\/ul>\n<p>Kh\u00e1ch h\u00e0ng ch\u1ecdn ki\u1ec3u, m\u00e0u vui l\u00f2ng ghi l\u1ea1i ch\u00fa th\u00edch ho\u1eb7c g\u1ecdi \u0111i\u1ec7n \u0111\u1ebfn s\u1ed1 Hotline: 0985969864 \u2013 0977241182 \u0111\u1ec3 \u0111\u01b0\u1ee3c t\u01b0 v\u1ea5n.<\/p>","description":"<p><em><strong>Kh\u0103n \u0111\u0169i t\u01a1 t\u1eb1m<\/strong><\/em><\/p>\n<p>Hanhsilk l\u00e0 th\u01b0\u01a1ng hi\u1ec7u \u0111\u00e3 \u0111\u01b0\u1ee3c nhi\u1ec1u ng\u01b0\u1eddi \u0111am m\u00ea t\u01a1 t\u1eb1m bi\u1ebft \u0111\u1ebfn v\u00e0 y\u00eau th\u00edch. L\u00e0 th\u01b0\u01a1ng hi\u1ec7u chuy\u00ean v\u1ec1 kh\u0103n 100% t\u01a1 t\u1eb1m \u0111\u01b0\u1ee3c s\u1ea3n xu\u1ea5t t\u1ea1i l\u00e0ng ngh\u1ec1 truy\u1ec1n th\u1ed1ng Vi\u1ec7t Nam. Kh\u0103n \u0111\u0169i t\u01a1 t\u1eb1m l\u00e0 d\u00f2ng kh\u0103n t\u01a1 t\u1eb1m truy\u1ec1n th\u1ed1ng c\u1ee7a l\u00e0ng \u0111\u0169i Nam Cao. N\u01a1i \u0111\u00e2y \u0111\u00e3 c\u00f3 truy\u1ec1n th\u1ed1ng bao \u0111\u1eddi v\u1ec1 d\u1ec7t \u0111\u0169i t\u01a1 t\u1eb1m v\u00e0 \u0111\u00e3 xu\u1ea5t kh\u1ea9u \u0111i nhi\u1ec1u n\u01b0\u1edbc tr\u00ean th\u1ebf gi\u1edbi.<\/p>\n<p>S\u1ee3i \u0111\u0169i t\u01a1 t\u1eb1m \u0111\u01b0\u1ee3c ng\u01b0\u1eddi d\u00e2n n\u01a1i \u0111\u00e2y v\u00ea tay ho\u00e0n to\u00e0n. Ch\u00ednh c\u00e1ch l\u00e0m n\u00e0y khi\u1ebfn cho s\u1ee3 t\u01a1 t\u1eb1m gi\u1eef \u0111\u01b0\u1ee3c v\u1ebb m\u1ed9c m\u1ea1c, g\u1ea7n g\u0169i v\u00e0 kh\u00e1c bi\u1ec7t so v\u1edbi c\u00e1c s\u1ea3n ph\u1ea9m kh\u00e1c l\u00e0m t\u1eeb t\u01a1 t\u1eb1m. Hanhsilk v\u1edbi s\u1ef1 ti\u1ebfp thu nhu c\u1ea7u th\u1ef1c t\u1ebf c\u1ee7a ng\u01b0\u1eddi d\u00f9ng, v\u00e0 ti\u00eau chu\u1ea9n ch\u1ea5t l\u01b0\u1ee3ng kh\u00e1c bi\u1ec7t. \u0110\u00e3 c\u00f9ng ng\u01b0\u1eddi th\u1ee3 d\u1ec7t t\u1ea1i \u1edf \u0111\u00e2y t\u1ea1o nh\u1eefng chi\u1ebfc kh\u0103n \u0111\u0169i t\u01a1 t\u1eb1m th\u1eadt \u0111\u1eb9p, th\u1eadt \u1ea5m, v\u00e0 th\u1eadt t\u01a1 t\u1eb1m.<\/p>\n<p>Kh\u0103n \u0111\u0169i t\u01a1 t\u1eb1m \u0111\u01b0\u1ee3c d\u1ec7t t\u1eeb nh\u1eefng s\u1ee3i t\u01a1 t\u1eb1m m\u1ed9c m\u1ea1c. S\u01a1i t\u01a1 t\u1eb1m \u0111\u01b0\u1ee3c v\u00ea l\u1ea1i th\u00e0nh c\u00e1c s\u1ee3i to, x\u1ed1p. Chi\u1ebfc kh\u0103n qu\u00e0ng \u0111\u0169i t\u01a1 t\u1eb1m c\u00f3 s\u1ef1 m\u1ec1m m\u1ea1i, d\u1ec5 ch\u1ecbu, th\u00e2n thi\u1ec7n v\u1edbi da.<\/p>\n<p>M\u00e0u s\u1eafc c\u1ee7a kh\u0103n v\u00f4 c\u00f9ng t\u1ef1 nhi\u00ean v\u00e0 \u0111\u1eb9p, c\u00f3 nhi\u1ec1u m\u00e0u s\u1eafc \u0111\u1ec3 b\u1ea1n l\u1ef1a ch\u1ecdn.<\/p>\n<p>\u0110\u1eb7c t\u00ednh: Kh\u0103n t\u1ea1o c\u1ea3m gi\u00e1c nh\u1eb9 nh\u00e0ng, m\u1ed9c m\u1ea1c nh\u01b0ng khi d\u00f9ng l\u1ea1i r\u1ea5t m\u1ec1m, kh\u00f4ng g\u00e2y d\u1ecb \u1ee9ng cho da, kh\u00f4ng g\u00e2y b\u1ee9c b\u00ed khi qu\u00e0ng l\u00e2u.<\/p>\n<p>Kh\u0103n \u0111\u0169i t\u01a1 t\u1eb1m s\u1ebd l\u00e0 m\u00f3n qu\u00e0 v\u00f4 c\u00f9ng \u00fd ngh\u0129a cho ng\u01b0\u1eddi th\u00e2n, b\u1ea1n b\u00e8, \u0111\u1eb7c bi\u1ec7t l\u00e0 nh\u1eefng ng\u01b0\u1eddi b\u1ea1n ngo\u1ea1i qu\u1ed1c.<\/p>","on_sale":false,"prices":{"price":"850000","regular_price":"850000","sale_price":"850000","price_range":{"min_amount":"850000","max_amount":"1250000"},"currency_code":"VND","currency_symbol":"\u20ab","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":"\u20ab"},"price_html":"<span class=\"woocommerce-Price-amount amount\">850,000<span class=\"woocommerce-Price-currencySymbol\">&#8363;<\/span><\/span> \u2013 <span class=\"woocommerce-Price-amount amount\">1,250,000<span class=\"woo