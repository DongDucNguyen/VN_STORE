x1536.jpeg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/4FA0BE58-C64E-497C-AFEE-DF30A1723CFC-1536x2048.jpeg 1536w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/4FA0BE58-C64E-497C-AFEE-DF30A1723CFC-600x800.jpeg 600w","sizes":"(max-width: 1920px) 100vw, 1920px","name":"Processed with VSCO with fa1 preset","alt":""},{"id":455,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-scaled.jpeg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-300x300.jpeg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-scaled.jpeg 1920w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-225x300.jpeg 225w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-768x1024.jpeg 768w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-1152x1536.jpeg 1152w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-1536x2048.jpeg 1536w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/9C8868F9-5757-4F01-B04B-16980B708E9C-600x800.jpeg 600w","sizes":"(max-width: 1920px) 100vw, 1920px","name":"Processed with VSCO with fa1 preset","alt":""},{"id":459,"src":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/8D6C1F4E-8FEA-483E-82BA-8895F5776495-scaled.jpeg","thumbnail":"https:\/\/hanhsilk.giahanweb.com\/wp-content\/uploads\/sites\/273\/2023\/06\/8D6C1F4E-8FEA-483E-82BA-8895F5776495-300x300.jpeg","srcset":"https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/8D6C1F4E-8FEA-483E-82BA-8895F5776495-scaled.jpeg 1920w, https:\/\/hanhsilk.com\/wp-content\/uploads\/sites\/273\/2023\/06\/8D6C1F4E-8