    <!-- WebMCP Tool Schema & Model Context Declaration -->
    <script type="application/webmcp+json">
    {
      "$schema": "https://webmcp.org/schemas/v1/manifest.json",
      "name": "SenSilk Web Agent Interface",
      "version": "1.0.0",
      "description": "Thương hiệu lụa tơ tằm thủ công cao cấp SenSilk.vn - AI Model Context Protocol Tools",
      "tools": [
        {
          "name": "searchProducts",
          "description": "Tìm kiếm khăn lụa tơ tằm, cà vạt và quà tặng theo từ khóa và danh mục",
          "parameters": {
            "type": "object",
            "properties": {
              "query": { "type": "string", "description": "Tên sản phẩm hoặc họa tiết (hoa sen, hoa đào, khăn vuông, cà vạt)" },
              "category": { "type": "string", "description": "Slug danh mục sản phẩm (khan-lua-ve-tay, khan-lua-dai, ca-vat-lua)" }
            },
            "required": ["query"]
          },
          "endpoint": "https://sensilk.vn/wp-json/wc/v3/products"
        },
        {
          "name": "getStoreLocations",
          "description": "Lấy thông tin địa chỉ showroom SenSilk tại Hà Nội và TP. Hồ Chí Minh",
          "parameters": { "type": "object", "properties": {} }
        },
        {
          "name": "getSilkCareInstructions",
          "description": "Hướng dẫn giặt ủi và bảo quản khăn lụa tơ tằm 100% tự nhiên",
          "parameters": { "type": "object", "properties": {} }
        }
      ],
      "forms": [
        {
          "id": "searchProducts",
          "name": "Tìm kiếm tác phẩm lụa",
          "action": "https://sensilk.vn/",
          "method": "GET"
        },
        {
          "id": "contact_consultation",
          "name": "Tư vấn quà tặng lụa & Báo giá doanh nghiệp",
          "action": "https://sensilk.vn/lien-he/",
          "method": "POST"
        }
      ]
    }
    </script>
