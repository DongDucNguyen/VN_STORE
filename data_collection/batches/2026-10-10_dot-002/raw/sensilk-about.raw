    <style id="sensilk-critical-css">
    @font-face {
      font-family: 'UTM Avo';
      src: url('https://sensilk.vn/wp-content/themes/sensilk/font/UTM%20Avo.woff') format('woff'),
           url('https://sensilk.vn/wp-content/themes/sensilk/font/UTM%20Avo.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'UTM Avo';
      src: url('https://sensilk.vn/wp-content/themes/sensilk/font/UTM%20AvoBold.woff') format('woff'),
           url('https://sensilk.vn/wp-content/themes/sensilk/font/UTM%20AvoBold.ttf') format('truetype');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    body {
      font-family: 'UTM Avo', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      color: #2D2723;
      background-color: #fff;
      -webkit-font-smoothing: antialiased;
    }
    #wpadminbar, #wpadminbar *, #wpadminbar .ab-item, #wpadminbar .ab-label, #wpadminbar .ab-icon {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif !important;
    }
    #wpadminbar .ab-icon:before, #wpadminbar .ab-item:before, #wpadminbar .dashicons:before, .dashicons, .dashicons-before:before {
      font-family: dashicons !important;
    }
    i[class^="icon-"], i[class*=" icon-"], [class^="icon-"]:before, [class*=" icon-"]:before, .flatsome-icon {
      font-family: "fl-icons", inherit !important;
    }

    .header-main{min-height:75px}
    .header-logo img, .header-logo-dark img{max-height:50px;width:auto;height:auto;aspect-ratio:240/50;display:block}
    .home #content.page-wrapper, .home .page-wrapper{padding-top:0!important;padding-bottom:15px!important}
    .home .entry-content > p:empty, .home #content > p:empty, .home .entry-content > br{display:none!important;margin:0!important;padding:0!important}
    .home .text, .home .ux_text{margin:8px 0 4px!important;padding:0!important}
    .home .text h1, .home .ux_text h1, .home h1{margin:6px 0 4px!important;padding:0!important;font-size:1.35rem!important;line-height:1.25!important}
    .sensilk-hero-slider-section{position:relative;width:100%;overflow:hidden;background:transparent;margin-top:0!important;margin-bottom:0!important;contain:layout}
    .sensilk-hero-slider-viewport{position:relative;width:100%;height:auto;overflow:hidden}
    .sensilk-hero-slide-item{position:relative;width:100%}
    .sensilk-hero-slide-item.mode-blend-banner{min-height:380px;max-height:420px;display:flex;align-items:center}
    .sensilk-hero-slide-item.mode-full-banner,
    .sensilk-hero-slide-item.no-text-content{min-height:0;height:auto;display:block}
    .hero-bg-blend-layer{position:absolute;top:0;right:0;bottom:0;width:68%;height:100%;z-index:1;overflow:hidden;pointer-events:none}
    .sensilk-hero-slide-item.mode-full-banner .hero-bg-blend-layer,
    .sensilk-hero-slide-item.no-text-content .hero-bg-blend-layer{position:relative;inset:auto;width:100%;height:auto;display:block}
    .hero-main-img{width:100%;height:auto;display:block;max-width:100%}
    .sensilk-hero-slide-item.mode-blend-banner .hero-main-img{height:100%;object-fit:cover;object-position:center 30%}
    .hero-slider-inner{position:relative;z-index:5;width:100%}
    .hero-title{font-size:2.4rem;font-weight:700;color:#2B231D;line-height:1.15;margin:0 0 10px}
    .btn-sensilk-gold{display:inline-block;background-color:#B68A35;color:#fff!important;font-weight:700;padding:12px 28px;border-radius:4px;text-decoration:none}
    .sensilk-trust-bar-5{padding:14px 22px!important;margin:8px 0 16px!important}
    .sensilk-trust-badges{min-height:75px;margin-top:0!important;contain:layout}
    .hero-full-clickable-link{position:absolute;inset:0;z-index:8;cursor:pointer;font-size:0!important;color:transparent!important;line-height:0!important;overflow:hidden!important}
    .screen-reader-text{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
    @media(max-width:768px){
      .header-main{min-height:60px}
      .home .text h1, .home .ux_text h1, .home h1{font-size:1.05rem!important;margin:8px 0 6px!important;text-align:center!important}
      .sensilk-hero-slider-section{margin-bottom:0!important;min-height:0}
      .sensilk-hero-slide-item.mode-blend-banner{min-height:260px}
      .hero-main-img{height:auto;object-fit:cover}
      .hero-title{font-size:1.65rem}
      .sensilk-trust-badges{min-height:90px}
    }






    </style>
