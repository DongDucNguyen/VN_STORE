							currency: "VND",
							discount: 0,
							item_brand: "Minh Long",
							item_category: "Minh Long",
							item_category2: "Tượng",
							item_variant: "Default Title",
							price: 0,
							quantity: 1
						}					]
				});
				
				
				
				
			},5000);
		}
	});
</script>
