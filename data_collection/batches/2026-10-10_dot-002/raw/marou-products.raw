oncakes, and enjoying a warm and cozy holiday season!\u003c\/span\u003e\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2025-08-20T17:19:28+07:00","created_at":"2025-06-17T15:47:50+07:00","updated_at":"2026-10-10T20:34:33+07:00","vendor":"Maison Marou","product_type":"event","tags":["Academy Class","masterclass","seasonal"],"variants":[{"id":44669955342544,"title":"HANOI \/ Sat 19 September (9:15AM)","option1":"HANOI","option2":"Sat 19 September (9:15AM)","option3":null,"sku":"MMVMTC35","requires_shipping":false,"taxable":true,"featured_image":null,"available":false,"price":"1290000","grams":0,"compare_at_price":"0","position":1,"product_id":8326457917648,"created_at":"2025-08-20T17:15:06+07:00","updated_at":"2026-10-10T20:34:33+07:00"},{"id":44669955408080,"title":"HANOI \/ Sat 26 September (9:15AM)","option1":"HANOI","option2":"Sat 26 September (9:15AM)","option3":null,"sku":"MMVMTC35","requires_shipping":false,"taxable":true,"featured_image":null,"available":false,"price":"1290000","grams":0,"compare_at_price":"0","position":2,"product_id":8326457917648,"created_at":"2025-08-20T17:15:06+07:00","updated_at":"2026-10-10T20:34:33+07:00"},{"id":45139758252240,"title":"HANOI \/ Sat 19 September (2:15 PM)","option1":"HANOI","option2":"Sat 19 September (2:15 PM)","option3":null,"sku":"MMVMTC35","requires_shipping":false,"taxable":true,"featured_image":null,"available":false,"price":"1290000","grams":0,"compare_at_price":"0","position":3,"product_id":8326457917648,"created_at":"2026-08-28T13:36:56+07:00","updated_at":"2026-10-10T20:34:33+07:00"},{"id":45139758285008,"title":"HANOI \/ Sat 26 September (2:15 PM)","option1":"HANOI","option2":"Sat 26 September (2:15 PM)","option3":null,"sku":"MMVMTC35","requires_shipping":false,"taxable":true,"featured_image":null,"available":false,"price":"1290000","grams":0,"compare_at_price":"0","position":4,"product_id":8326457917648,"created_at":"2026-08-28T13:36:56+07:00","updated_at":"2026-10-10T20:34:33+07:00"},{"id":44669955375