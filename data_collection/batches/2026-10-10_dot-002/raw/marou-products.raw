_html":"Our signature chocolate chunk cookies are chewy, buttery perfection filled with our homemade Vietnam 65% chocolate chunks.","published_at":"2025-02-10T22:20:03+07:00","created_at":"2025-02-10T22:20:01+07:00","updated_at":"2026-10-10T20:34:33+07:00","vendor":"Maison Marou","product_type":"","tags":["best sellers"],"variants":[{"id":44411039514832,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"CAIC0011","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"70000","grams":80,"compare_at_price":null,"position":1,"product_id":8249800720592,"created_at":"2025-02-10T22:20:01+07:00","updated_at":"2026-10-10T20:34:33+07:00"}],"images":[{"id":41265632248016,"created_at":"2025-02-10T22:20:09+07:00","position":1,"updated_at":"2025-02-10T22:20:13+07:00","product_id":8249800720592,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0646\/0955\/0544\/files\/chocolate_chunk_cookie-scaled-e1665578413437.jpg?v=1739200813","width":800,"height":800}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":8249797673168,"title":"Ca Phe Sua Drink","handle":"ca-phe-sua-drink","body_html":"Vietnamese coffee milk, or cà phê sữa, is more than just a traditional drink of Vietnam; it is a reflection of the rich coffee culture. At Maison Marou, you can experience the exquisite taste of Robusta and Arabica coffee, harmoniously blended between bitter and sweet, giving you a boost of energy for your day.","published_at":"2025-02-10T22:09:33+07:00","created_at":"2025-02-10T22:09:31+07:00","updated_at":"2026-10-10T20:34:33+07:00","vendor":"Maison Marou","product_type":"","tags":["Drinks"],"variants":[{"id":44411034730704,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"BECO2007","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"75000","grams":200,"compare_at_price":null,"position":1,"product_id":8249797673168,"cr