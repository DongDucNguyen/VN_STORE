<script>
	document.addEventListener('DOMContentLoaded', function() {
		const sort = (arr, p, o = "asc") => arr.sort((a, b) => {
			if (o !== "asc")[a, b] = [b, a];
			const isNum = typeof b[p] === "number";
			return (isNum ? Number(a[p]) - b[p] : String(a[p]).localeCompare(b[p]));
		});
		const sort2 = (arr, n, p, o = "asc") => arr.sort((a, b) => {
			if (o !== "asc")[a, b] = [b, a];
			if(!isNaN(b[n][3].textContent)){
				var isNum = typeof parseInt(b[n][3].textContent) === "number";
			}
			else{
				var isNum = typeof b[p] === "number";
			}
			return (isNum ? Number(a[n][3].textContent) - b[n][3].textContent : String(a[p]).localeCompare(b[p]));
		});
		$.fn.sortChildren = function(op) {
			op = $.extend({
				by: "textContent",
				order: "asc"
			}, op);
			return this.each(function() {
				const i = $(this).prop("selectedIndex");
				$(this).html(sort($(this).children(), op.by, op.order)).prop({selectedIndex: i});
			});
		};
		$.fn.sortChildren2 = function(op) {
			op = $.extend({
				number: "attributes",
				by: "textContent",
				order: "asc"
			}, op);
			return this.each(function() {
				const i = $(this).prop("selectedIndex");
				$(this).html(sort2($(this).children(), op.number, op.by, op.order)).prop({selectedIndex: i});
			});
		};
		var addressData = window.Countries;
		var option_country = '<option value>Quốc gia</option>';
		var countries = addressData.countries;
		addressData.countries.map(function(item){
			option_country += '<option data-id="'+item.i+'" data-code="'+item.c+'" value="'+item.n+'">'+item.n+'</option>';
		});
		$('.select-country').html(option_country);
		$('.select-country').html(option_country);
		$('.select-country').change(function(){
			var $this = $(this);
			var option_province = '<option value>Tỉnh/Thành</option>';
			var option_districts = '<option value>Quận/Huyện</option>';
			var option_ward = '<option value>Phường/Xã</option>';
			var select_districts = $this.parents('form').find('.select-district');
			var select_ward = $this.parents('form').find('.select-ward');
			select_districts.html(option_districts);
			select_ward.html(option_ward);

			var select_districts_shipping = $this.parents('form').find('.select-district-shipping');
			var select_ward_shipping = $this.parents('form').find('.select-ward-shipping');
			select_districts_shipping.html(option_districts);
			select_ward_shipping.html(option_ward);

			var countryId = $this.find('option:selected').attr('data-id');
			var select_province = $this.parents('form').find('.select-province');
			var select_province_shipping = $this.parents('form').find('.select-province-shipping');
			var countryData = addressData[countryId];
			countryData.provinces.map(function(item){
				option_province += '<option data-id="'+item.i+'" data-code="'+item.c+'" value="'+item.n+'">'+item.n+'</option>';
			});
			select_province.html(option_province);
			select_province_shipping.html(option_province);
		});
		$('.select-province').change(function(){
			var $this = $(this);
			var option_districts = '';
			var option_ward = '<option value>Phường/Xã</option>';
			var select_ward = $this.parents('form').find('.select-ward');
			select_ward.html(option_ward);
			var countryId = $this.parents('form').find('.select-country option:selected').attr('data-id');
			var provinceId = $this.find('option:selected').attr('data-id');
			var select_districts = $this.parents('form').find('.select-district');
			$.when(addressData.getProvince(countryId, provinceId)).done(function(provinceData){
				provinceData.districts.map(function(item){
					var title_sort = item.n;
					var format_sort = parseInt(title_sort.replace('Quận ','').replace('Huyện ',''));
					if(Number(format_sort)){
						title_sort = format_sort;
					}
					if(item.n != 'Quận 2' && item.n != 'Quận 9' && item.n != 'Quận Thủ Đức'){
						option_districts += '<option data-id="'+item.i+'" data-code="'+item.c+'" data-title="'+item.n+'" data-sort="'+format_sort+'" value="'+item.c+'">'+item.n+'</option>';
					}
				})
				select_districts.html(option_districts);
				select_districts.sortChildren2({order: "asc"});
				select_districts.prepend('<option value>Quận/Huyện</option>');
				select_districts.change();
			});
		});
		$('.select-district').change(function(){
			var $this = $(this);
			var option_ward = '';
			var countryId = $this.parents('form').find('.select-country option:selected').attr('data-id');
			var provinceId = $this.parents('form').find('.select-province option:selected').attr('data-id');
			var districtId = $this.find('option:selected').attr('data-id');
			var select_ward = $this.parents('form').find('.select-ward');
			$.when(addressData.getProvince(countryId, provinceId)).done(function(data){
				var ward = data[districtId].wards;
				ward.map(function(item){
					option_ward += '<option data-id="'+item.i+'" data-title="'+item.n+'" data-code="'+item.c+'" value="'+item.c+'">'+item.n+'</option>';
				})
				select_ward.html(option_ward);
				select_ward.sortChildren({order: "asc"});
				select_ward.prepend('<option value>Phường/Xã</option>');
			});
		});
		$('.select-country').each(function(){
			var $this = $(this);
			$(this).val('Vietnam').change();
			var this_province = $this.parents('form').find('.select-province');
			if (this_province.attr("data-title")){
				var get_province = this_province.attr("data-title");
				this_province.val(get_province).change();
			}
			setTimeout(function(){
				var this_districts = $this.parents('form').find('.select-district');
				if (this_districts.attr("data-value")){
					var get_districts = this_districts.attr("data-value");
					var val_districts = this_districts.find('option[data-title="'+get_districts+'"]').val();
					this_districts.val(val_districts).change();
					setTimeout(function(){
						var this_ward = $this.parents('form').find('.select-ward');
						if (this_ward.attr("data-value")){
							var get_ward = this_ward.attr("data-value");
							this_ward.val(get_ward).change();
						}
					},200);
				}
			},1000);
		});
		$('.select-province-shipping').change(function(){
			var $this = $(this);
			var option_districts = '';
			var option_ward = '<option value>Phường/Xã</option>';
			var select_ward = $this.parents('form').find('.select-ward-shipping');
			select_ward.html(option_ward);
			var countryId = $this.parents('form').find('.select-country option:selected').attr('data-id');
			var provinceId = $this.find('option:selected').attr('data-id');
			var select_districts = $this.parents('form').find('.select-district-shipping');
			$.when(addressData.getProvince(countryId, provinceId)).done(function(provinceData){
				provinceData.districts.map(function(item){
					var title_sort = item.n;
					var format_sort = parseInt(title_sort.replace('Quận ','').replace('Huyện ',''));
					if(Number(format_sort)){
						title_sort = format_sort;
					}
					console.log(item.n);
					if(item.n != 'Quận 2' && item.n != 'Quận 9' && item.n != 'Quận Thủ Đức'){
						option_districts += '<option data-id="'+item.i+'" data-code="'+item.c+'" data-title="'+item.n+'" data-sort="'+format_sort+'" value="'+item.c+'">'+item.n+'</option>';
					}
				})
				select_districts.html(option_districts);
				select_districts.sortChildren2({order: "asc"});
				select_districts.prepend('<option value>Quận/Huyện</option>');
				select_districts.change();
			});
		});
		$('.select-district-shipping').change(function(){
			var $this = $(this);
			var option_ward = '';
			var countryId = $this.parents('form').find('.select-country option:selected').attr('data-id');
			var provinceId = $this.parents('form').find('.select-province-shipping option:selected').attr('data-id');
			var districtId = $this.find('option:selected').attr('data-id');
			var select_ward = $this.parents('form').find('.select-ward-shipping');
			$.when(addressData.getProvince(countryId, provinceId)).done(function(data){
				var ward = data[districtId].wards;
				ward.map(function(item){
					option_ward += '<option data-id="'+item.i+'" data-title="'+item.n+'" data-code="'+item.c+'" value="'+item.c+'">'+item.n+'</option>';
				})
				select_ward.html(option_ward);
				select_ward.sortChildren({order: "asc"});
				select_ward.prepend('<option value>Phường/Xã</option>');
			});
		});
	});
</script>
<!-- Cookie Overlay -->
<div class="cookie-overlay d-none"></div>
<!-- Cookie Modal -->
<div class="cookie-modal d-none">
  <div class="cookie-content">
    <h2>Thông báo về cookie</h2>

    <p><strong>Minh Long</strong> sử dụng trình theo dõi (như Cookie hoặc SDK) cho:</p>
    <ul>
      <li>Mục đích hoàn toàn cần thiết</li>
      <li>Mục đích hiệu suất</li>
      <li>Mục đích chức năng</li>
      <li>Mục đích nhắm mục tiêu</li>
    </ul>

    <p>
      Trước khi bạn đồng ý, chỉ những trình theo dõi hoàn toàn cần thiết mới được triển khai.
    </p>

    <p>
      <strong>Chấp nhận tất cả</strong>: đồng ý sử dụng tất cả trình theo dõi.<br>
      <strong>Từ chối tất cả</strong>: từ chối các trình theo dõi không cần thiết.<br>
    </p>

    <p>
      Bạn có thể rút lại sự đồng ý bất kỳ lúc nào tại
      <a href="/pages/policy-privacy" class="cookie-setting-link">Tùy chỉnh Cookie</a>.
    </p>
  </div>

  <div class="cookie-actions">
    <button class="btn btn-accept">Chấp nhận tất cả</button>
    <button class="btn btn-reject">Từ chối tất cả</button>
  </div>
</div>


